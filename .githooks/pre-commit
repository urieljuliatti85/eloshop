#!/usr/bin/env bash
# Git hook: procura termos sensíveis e roda RuboCop e a suíte de testes antes
# de permitir o commit.
# Instalado automaticamente por bin/setup — ver .githooks/README.md.
set -e

cd "$(git rev-parse --show-toplevel)"

echo "== pre-commit: termos sensíveis (repositório público) =="
bin/check-sensitive-terms

echo "== pre-commit: RuboCop =="
bin/rubocop

echo "== pre-commit: bundle exec rspec =="
bundle exec rspec
