<% content_for :title, "#{@product.name} | #{current_seller.name}" %>
<% product = @product %>

<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <%= link_to "← Insumos", distributor_products_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-brand-600" %>
      <h1 class="mt-3 text-3xl font-black tracking-tight"><%= product.name %></h1>
      <p class="mt-3 flex items-center gap-2 text-sm text-ink-muted">SKU <%= product.sku %> <%= seller_product_status_badge(product) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Editar", edit_distributor_product_path(product), class: "inline-flex min-h-11 items-center rounded-full border border-brand-200 bg-white px-5 py-2 text-sm font-semibold text-stone-700 transition hover:bg-brand-50" %>
      <% if product.draft? %>
        <%= button_to "Publicar", publish_distributor_product_path(product), method: :patch, class: "inline-flex min-h-11 items-center rounded-full bg-brand-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700" %>
      <% elsif product.active? %>
        <%= button_to "Despublicar", unpublish_distributor_product_path(product), method: :patch, class: "inline-flex min-h-11 items-center rounded-full border border-brand-200 bg-white px-5 py-2 text-sm font-semibold text-stone-700 transition hover:bg-brand-50" %>
      <% end %>
    </div>
  </header>

  <%= render "shared/publication_blockers", blockers: @publication_blockers, edit_path: edit_distributor_product_path(product) %>

  <% if product.below_minimum_stock? %>
    <p class="rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm leading-6 text-amber-950" role="status">
      <strong>Indisponível para compra:</strong> a quantidade mínima (<%= product.min_order_quantity %>) é maior que o estoque (<%= product.stock_for_minimum %>). Aumente o estoque ou reduza o mínimo.
    </p>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="seller-card"><p class="text-sm text-ink-muted">Preço</p><p class="mt-2 text-2xl font-bold"><%= format_price(product.price_cents) %></p><p class="mt-1 text-sm text-ink-muted">por <%= product.sale_unit_name %><%= " (#{product.sale_unit_detail})" if product.sale_unit_detail.present? %></p></div>
    <div class="seller-card"><p class="text-sm text-ink-muted">Estoque</p><p class="mt-2 text-2xl font-bold"><%= product.stock_quantity %></p><p class="mt-1 text-sm text-ink-muted"><%= product.sale_unit_name(product.stock_quantity) %></p></div>
    <div class="seller-card"><p class="text-sm text-ink-muted">Quantidade mínima</p><p class="mt-2 text-2xl font-bold"><%= product.min_order_quantity %></p><p class="mt-1 text-sm text-ink-muted"><%= product.min_order_quantity > 1 ? product.sale_unit_name(product.min_order_quantity) : "sem mínimo" %></p></div>
  </div>

  <%# A mesma tabela que a página pública do insumo vai mostrar (PR C): o
      preço de cada faixa já calculado (Product#unit_price_for). %>
  <section class="seller-card" aria-labelledby="faixas-titulo">
    <h2 id="faixas-titulo" class="text-xl font-bold">Desconto por quantidade</h2>
    <% if product.price_tiers.any? %>
      <table class="mt-4 w-full text-sm">
        <thead><tr class="text-left text-ink-muted"><th class="py-2 font-semibold">A partir de</th><th class="py-2 font-semibold">Desconto</th><th class="py-2 font-semibold">Preço por <%= product.sale_unit_name %></th></tr></thead>
        <tbody class="divide-y divide-brand-100">
          <tr><td class="py-2"><%= [ product.min_order_quantity, 1 ].max %> <%= product.sale_unit_name(product.min_order_quantity) %></td><td class="py-2">—</td><td class="py-2 font-semibold"><%= format_price(product.price_cents) %></td></tr>
          <% product.price_tiers.each do |tier| %>
            <tr><td class="py-2"><%= tier.min_quantity %> <%= product.sale_unit_name(tier.min_quantity) %></td><td class="py-2"><%= tier.discount_percent_input %>%</td><td class="py-2 font-semibold"><%= format_price(tier.apply_to(product.price_cents)) %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="mt-3 text-sm text-ink-muted">Sem desconto por quantidade. Você pode criar faixas ao editar o insumo.</p>
    <% end %>
  </section>

  <section class="seller-card" aria-labelledby="navegacao-titulo">
    <h2 id="navegacao-titulo" class="text-xl font-bold">Material e técnica</h2>
    <p class="mt-3 text-sm text-stone-800"><strong>Material:</strong> <%= product.materials.map(&:name).to_sentence.presence || "não informado" %></p>
    <p class="mt-1 text-sm text-stone-800"><strong>Técnica:</strong> <%= product.techniques.map(&:name).to_sentence.presence || "não informada" %></p>
  </section>

  <section class="seller-card">
    <h2 class="text-xl font-bold">Galeria</h2>
    <p class="mt-1 text-sm text-ink-muted">Adicione novas fotos ao editar o insumo. A foto principal é gerenciada separadamente.</p>
    <% if product.images.attached? %>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <% product.images.each do |image| %>
          <div class="overflow-hidden rounded-xl border border-brand-100">
            <%= image_tag image, alt: "Foto de #{product.name}", class: "aspect-square w-full object-cover" %>
            <%= button_to "Remover foto", distributor_product_product_image_path(product, image), method: :delete, class: "w-full px-3 py-2 text-sm font-semibold text-red-600", form: { data: { turbo_confirm: "Remover esta foto?" } } %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-5 text-sm text-ink-muted">Nenhuma foto adicional.</p>
    <% end %>
  </section>
</div>
