<%
  label_class = "text-sm font-semibold text-stone-700"
  field_class = "seller-input mt-2"
  file_class = "mt-2 block w-full rounded-xl border border-dashed border-stone-300 bg-brand-50/30 p-3 text-sm file:mr-3 file:cursor-pointer file:rounded-full file:border-0 file:bg-stone-900 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white"
  section_class = "grid gap-5 border-t border-brand-100 pt-6"
  # Faixas: as que já existem mais linhas vazias até o limite (uma linha em
  # branco não vira faixa: Product rejeita no `accepts_nested_attributes_for`).
  tiers = product.price_tiers.to_a
  tiers += Array.new([ ProductPriceTier::MAX_PER_PRODUCT - tiers.size, 0 ].max) { product.price_tiers.build }
  unit_options = Product.sale_units.keys.map { |unit| [ t(unit, scope: "products.sale_units", count: 1).capitalize, unit ] }
%>
<%# Formulário do insumo (ADR 007, Fase 26). Mesmo desenho do formulário do
    ateliê (seller_portal/products/_form), com o que é do insumo: unidade de
    venda e o que vem nela, quantidade mínima, faixas de desconto por
    quantidade e material/técnica (a navegação da vitrine de insumos). Sem
    categoria de peça, peça única, sob encomenda, retirada e personalização. %>
<%= form_with model: product, url: (product.persisted? ? distributor_product_path(product) : distributor_products_path), class: "seller-card-lg grid gap-6", html: { novalidate: true }, data: { controller: "required-fields", action: "submit->required-fields#validate focusout->required-fields#touch input->required-fields#touch change->required-fields#touch" } do |form| %>
  <p class="text-xs text-stone-500"><span class="text-red-600" aria-hidden="true">*</span> Campo obrigatório · <span class="font-semibold text-stone-700">Para publicar</span>: pode salvar como rascunho sem ele</p>
  <% if product.errors.any? %><div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert"><ul class="list-disc pl-5"><% product.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>

  <section class="grid gap-5" aria-labelledby="supply-section-item">
    <h2 id="supply-section-item" class="text-lg font-bold text-stone-950">O insumo</h2>
    <div><%= form.label :name, class: label_class do %>Nome<%= required_marker %><% end %><%= form.text_field :name, aria: field_error_aria(form, :name), required: true, placeholder: "Fio de algodão cru", data: { required_fields_target: "field" }, class: field_class %><%= field_error(form, :name) %></div>
    <div><%= form.label :main_image, "Foto principal", class: label_class %><%= form.file_field :main_image, aria: field_error_aria(form, :main_image), accept: "image/png,image/jpeg,image/webp", class: file_class %><%= field_error(form, :main_image) %><p class="mt-1 text-xs text-stone-500">Pode enviar a foto direto do celular: ela é reduzida automaticamente.</p></div>
    <div><%= form.label :images, "Mais fotos", class: label_class %><%= form.file_field :images, aria: field_error_aria(form, :images), multiple: true, accept: "image/png,image/jpeg,image/webp", class: file_class %><%= field_error(form, :images) %><p class="mt-1 text-xs text-stone-500">PNG, JPEG ou WEBP, até 5 MB por foto e <%= Product::IMAGES_MAX_COUNT %> fotos no total.</p></div>
    <div><%= form.label :description, "Descrição", class: label_class %><%= form.text_area :description, aria: field_error_aria(form, :description), rows: 5, class: field_class %><%= field_error(form, :description) %></div>
    <%# Material e técnica são a navegação da vitrine de insumos ("insumos
        para crochê", "algodão"), no lugar da categoria de peça. %>
    <div class="grid gap-5 sm:grid-cols-2">
      <fieldset>
        <legend class="<%= label_class %>">Material</legend>
        <div class="mt-2 grid gap-1">
          <%= form.collection_check_boxes :material_ids, Material.order(:name), :id, :name do |box| %>
            <label class="flex min-h-11 items-center gap-2 text-sm text-stone-800"><%= box.check_box(class: "size-4 rounded border-stone-300 text-brand-500") %> <%= box.text %></label>
          <% end %>
        </div>
      </fieldset>
      <fieldset>
        <legend class="<%= label_class %>">Para qual técnica</legend>
        <div class="mt-2 grid gap-1">
          <%= form.collection_check_boxes :technique_ids, Technique.order(:name), :id, :name do |box| %>
            <label class="flex min-h-11 items-center gap-2 text-sm text-stone-800"><%= box.check_box(class: "size-4 rounded border-stone-300 text-brand-500") %> <%= box.text %></label>
          <% end %>
        </div>
      </fieldset>
    </div>
  </section>

  <section class="<%= section_class %>" aria-labelledby="supply-section-sale">
    <h2 id="supply-section-sale" class="text-lg font-bold text-stone-950">Como você vende</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      <div><%= form.label :sale_unit, "Unidade de venda", class: label_class %><%= form.select :sale_unit, unit_options, {}, aria: field_error_aria(form, :sale_unit), class: field_class %><%= field_error(form, :sale_unit) %></div>
      <div><%= form.label :sale_unit_detail, "O que vem em cada unidade (opcional)", class: label_class %><%= form.text_field :sale_unit_detail, aria: field_error_aria(form, :sale_unit_detail), maxlength: Product::SALE_UNIT_DETAIL_MAX_LENGTH, placeholder: "Pacote com 100 g", class: field_class %><%= field_error(form, :sale_unit_detail) %></div>
    </div>
    <div class="grid gap-5 sm:grid-cols-3">
      <div><%= form.label :price, class: label_class do %>Preço por unidade (R$)<%= required_marker %><% end %><%= form.text_field :price, aria: field_error_aria(form, :price), value: price_field_value(form.object.price_cents), inputmode: "decimal", placeholder: "0,00", data: { controller: "price-input", action: "input->price-input#format", required_fields_target: "field" }, required: true, class: field_class %><%= field_error(form, :price) %></div>
      <div><%= form.label :stock_quantity, "Estoque (unidades)", class: label_class %><%= form.number_field :stock_quantity, aria: field_error_aria(form, :stock_quantity), min: 0, class: field_class %><%= field_error(form, :stock_quantity) %></div>
      <div><%= form.label :min_order_quantity, "Quantidade mínima", class: label_class %><%= form.number_field :min_order_quantity, aria: field_error_aria(form, :min_order_quantity), min: 1, max: Product::MAX_ORDER_QUANTITY, class: field_class %><%= field_error(form, :min_order_quantity) %><p class="mt-1 text-xs text-stone-500">1 = sem mínimo. Mínimo maior que o estoque deixa o insumo indisponível.</p></div>
    </div>
    <div><%= form.label :sku, "Código (SKU, opcional)", class: label_class %><%= form.text_field :sku, aria: field_error_aria(form, :sku), placeholder: "Em branco, a EloShop gera", class: field_class %><%= field_error(form, :sku) %></div>

    <%# Faixas de desconto (decisão de 2026-11-07): "a partir de N unidades, X%
        de desconto", até 50%, crescentes e acima da quantidade mínima. Valem
        para o produto inteiro e aparecem na página do insumo. %>
    <fieldset class="grid gap-3">
      <legend class="<%= label_class %>">Desconto por quantidade (opcional)</legend>
      <p class="text-xs leading-5 text-stone-500">Até <%= ProductPriceTier::MAX_PER_PRODUCT %> faixas. Cada faixa precisa começar acima da quantidade mínima e dar mais desconto que a anterior, até <%= ProductPriceTier::MAX_DISCOUNT_BPS / 100 %>%.</p>
      <%= form.fields_for :price_tiers, tiers do |tier_form| %>
        <% tier = tier_form.object %>
        <div class="grid grid-cols-[1fr_1fr_auto] items-end gap-3" data-price-tier>
          <div><%= tier_form.label :min_quantity, "A partir de (unidades)", class: "text-xs font-semibold text-stone-600" %><%= tier_form.number_field :min_quantity, min: 2, max: Product::MAX_ORDER_QUANTITY, class: "seller-input mt-1" %></div>
          <div><%= tier_form.label :discount_percent, "Desconto (%)", class: "text-xs font-semibold text-stone-600" %><%= tier_form.text_field :discount_percent, value: tier.discount_percent_input, inputmode: "decimal", placeholder: "10", class: "seller-input mt-1" %></div>
          <div class="pb-2">
            <% if tier.persisted? %>
              <label class="flex min-h-11 items-center gap-2 text-xs font-semibold text-red-700"><%= tier_form.check_box :_destroy, class: "size-4 rounded border-stone-300" %> Remover</label>
            <% end %>
          </div>
        </div>
        <% if tier.errors.any? %><p class="text-sm text-red-700"><%= tier.errors.full_messages.to_sentence %></p><% end %>
      <% end %>
    </fieldset>
  </section>

  <section class="<%= section_class %>" aria-labelledby="supply-section-shipping">
    <h2 id="supply-section-shipping" class="text-lg font-bold text-stone-950">Envio</h2>
    <p class="text-xs leading-5 text-stone-500">Até 30 kg por pedido, em um volume. Peso e medidas são da unidade de venda.</p>
    <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :weight_grams, class: label_class do %>Peso (g) <%= publish_marker %><% end %><%= form.number_field :weight_grams, aria: field_error_aria(form, :weight_grams), min: 1, data: { required_fields_target: "field", publish_required: true }, class: field_class %><%= field_error(form, :weight_grams) %></div><div><%= form.label :length_cm, class: label_class do %>Comprimento (cm) <%= publish_marker %><% end %><%= form.number_field :length_cm, aria: field_error_aria(form, :length_cm), min: 1, data: { required_fields_target: "field", publish_required: true }, class: field_class %><%= field_error(form, :length_cm) %></div><div><%= form.label :width_cm, class: label_class do %>Largura (cm) <%= publish_marker %><% end %><%= form.number_field :width_cm, aria: field_error_aria(form, :width_cm), min: 1, data: { required_fields_target: "field", publish_required: true }, class: field_class %><%= field_error(form, :width_cm) %></div><div><%= form.label :height_cm, class: label_class do %>Altura (cm) <%= publish_marker %><% end %><%= form.number_field :height_cm, aria: field_error_aria(form, :height_cm), min: 1, data: { required_fields_target: "field", publish_required: true }, class: field_class %><%= field_error(form, :height_cm) %></div></div>
    <%# Frete fixo do distribuidor: a alternativa à cotação da SuperFrete
        (Fase 28), nunca a tabela interna (ADR 007). %>
    <div>
      <p class="text-sm font-semibold text-stone-700">Frete deste insumo <%= publish_marker %></p>
      <p class="mt-1 text-xs leading-5 text-stone-500">Quanto o comprador paga de frete, por unidade. Para publicar, preencha o frete para o seu estado ou marque frete grátis.</p>
    </div>
    <fieldset class="space-y-3">
      <legend class="text-sm font-semibold text-stone-800">Para o seu estado<%= " (#{form.object.seller.origin_state})" if form.object.seller&.origin_state.present? %></legend>
      <div class="grid gap-5 sm:grid-cols-2">
        <div><%= form.label :fixed_shipping, "Valor por unidade (R$)", class: label_class %><%= form.text_field :fixed_shipping, aria: field_error_aria(form, :fixed_shipping), value: price_field_value(form.object.fixed_shipping_cents), inputmode: "decimal", placeholder: "20,00", data: { controller: "price-input", action: "input->price-input#format" }, class: field_class %><%= field_error(form, :fixed_shipping) %></div>
        <div><%= form.label :fixed_shipping_estimated_days, "Prazo máximo (dias úteis)", class: label_class %><%= form.number_field :fixed_shipping_estimated_days, aria: field_error_aria(form, :fixed_shipping_estimated_days), min: 1, step: 1, placeholder: "8", class: field_class %><%= field_error(form, :fixed_shipping_estimated_days) %></div>
      </div>
    </fieldset>
    <fieldset class="space-y-3">
      <legend class="text-sm font-semibold text-stone-800">Para outros estados <span class="font-normal text-stone-500">(opcional)</span></legend>
      <div class="grid gap-5 sm:grid-cols-2">
        <div><%= form.label :fixed_shipping_interstate, "Valor por unidade (R$)", class: label_class %><%= form.text_field :fixed_shipping_interstate, aria: field_error_aria(form, :fixed_shipping_interstate), value: price_field_value(form.object.fixed_shipping_interstate_cents), inputmode: "decimal", placeholder: "35,00", data: { controller: "price-input", action: "input->price-input#format" }, class: field_class %><%= field_error(form, :fixed_shipping_interstate) %></div>
        <div><%= form.label :fixed_shipping_interstate_estimated_days, "Prazo máximo (dias úteis)", class: label_class %><%= form.number_field :fixed_shipping_interstate_estimated_days, aria: field_error_aria(form, :fixed_shipping_interstate_estimated_days), min: 1, step: 1, placeholder: "12", class: field_class %><%= field_error(form, :fixed_shipping_interstate_estimated_days) %></div>
      </div>
    </fieldset>
    <label class="flex cursor-pointer items-start gap-3">
      <%= form.check_box :free_shipping, class: "mt-1 size-4 rounded border-stone-300 text-brand-500 focus:ring-brand-400" %>
      <span><span class="block text-sm font-semibold text-stone-800">Frete grátis para este insumo</span><span class="mt-1 block text-xs leading-5 text-stone-500">O comprador não paga frete. <strong>Você assume o custo do envio</strong>: o valor é descontado do seu repasse, não da comissão da EloShop.</span></span>
    </label>
  </section>

  <%= form.hidden_field :currency, value: product.currency.presence || "BRL" %>
  <div class="flex flex-col gap-3 border-t border-brand-100 pt-6 sm:flex-row sm:items-center">
    <%= form.submit "Salvar insumo", class: "seller-button seller-button--primary justify-center" %>
    <% if product.new_record? %>
      <p class="text-sm text-stone-600">O insumo é salvo como rascunho. Você publica na página dele.</p>
    <% end %>
  </div>
<% end %>
