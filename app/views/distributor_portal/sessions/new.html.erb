<% content_for :title, "Entrar no painel do armarinho | EloShop" %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>
<div class="mx-auto w-full max-w-md">
  <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">EloShop Atacado</p>
  <h1 class="mb-8 mt-2 text-2xl font-bold text-ink">Entrar no painel do armarinho</h1>

  <%= form_with url: distributor_login_path, class: "flex flex-col gap-4" do |form| %>
    <div>
      <%= form.label :email_address, "E-mail", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address],
            class: "w-full rounded-xl border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, "Senha", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: "w-full rounded-xl border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <div class="mt-2 flex flex-wrap items-center gap-4">
      <%= form.submit "Entrar", class: "cursor-pointer rounded-full bg-brand-600 px-8 py-3 text-sm font-semibold text-white hover:bg-brand-700" %>
      <%= link_to "Esqueceu a senha?", new_password_path, class: "text-sm text-ink-muted hover:text-brand-600" %>
    </div>
  <% end %>

  <p class="mt-8 text-sm text-ink-muted">
    É artesão? <%= link_to "Entre pelo painel do ateliê", seller_login_path, class: "font-medium text-brand-600 hover:underline" %>.
    <% if DistributorRegistrationsController.signup_enabled? %>
      Ainda não tem cadastro de armarinho? <%= link_to "Cadastre-se", new_distributor_registration_path, class: "font-medium text-brand-600 hover:underline" %>.
    <% end %>
  </p>
</div>
