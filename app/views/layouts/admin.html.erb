<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin — Eloshop" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body">
    <div class="admin-shell">
      <%= render "layouts/admin_nav" %>

      <div class="admin-workspace">
        <header class="admin-topbar">
          <div>
            <p class="admin-eyebrow">EloShop</p>
            <p class="text-sm font-semibold text-slate-800">Área administrativa</p>
          </div>

          <div class="flex items-center gap-3 sm:gap-5">
            <% recent_notifications = Current.user.notifications.chronological.limit(5)
               unread_count = Current.user.notifications.unread.count %>
            <div class="relative" data-controller="account-menu"
                 data-action="click@window->account-menu#closeOnOutsideClick keydown.esc@window->account-menu#closeOnEscape turbo:load@document->account-menu#closeOnNavigation">
              <button type="button"
                      class="relative grid size-9 cursor-pointer place-items-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-800"
                      aria-expanded="false" aria-haspopup="true"
                      aria-label="Notificações"
                      data-account-menu-target="button"
                      data-action="account-menu#toggle">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M6 8a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5h-15S6 12 6 8Z" stroke-linejoin="round" />
                  <path d="M9.5 16a2.5 2.5 0 0 0 5 0" stroke-linecap="round" />
                </svg>
                <% if unread_count.positive? %>
                  <span class="absolute right-0 top-0.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-red-500 px-1 text-xs font-semibold text-white">
                    <%= unread_count %>
                  </span>
                <% end %>
              </button>

              <div class="absolute right-0 top-full z-20 mt-3 w-80 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg"
                   data-account-menu-target="panel" hidden>
                <p class="border-b border-slate-100 px-4 py-3 text-sm font-semibold text-slate-900">Notificações</p>

                <% if recent_notifications.any? %>
                  <ul class="max-h-96 overflow-y-auto">
                    <% recent_notifications.each do |notification| %>
                      <li>
                        <%= button_to mark_as_read_admin_notification_path(notification), method: :patch,
                              class: "block w-full px-4 py-3 text-left transition hover:bg-slate-50 #{'bg-slate-50' unless notification.read?}" do %>
                          <p class="text-sm font-semibold text-slate-900"><%= notification.title %></p>
                          <p class="mt-0.5 truncate text-xs text-slate-500"><%= notification.body %></p>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="px-4 py-6 text-center text-sm text-slate-500">Você ainda não tem notificações.</p>
                <% end %>

                <div class="border-t border-slate-100">
                  <%= link_to "Ver todas", admin_notifications_path, class: "block px-4 py-2.5 text-center text-sm font-medium text-slate-700 hover:bg-slate-50" %>
                </div>
              </div>
            </div>

            <div class="admin-user-chip">
              <span class="admin-user-avatar"><%= Current.user.email_address.first.upcase %></span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-slate-900">Administrador</span>
                <span class="block max-w-52 truncate text-xs text-slate-500"><%= Current.user.email_address %></span>
              </span>
            </div>
          </div>
        </header>

        <%= render "layouts/flash_message", message: flash[:notice], variant: :success %>
        <%= render "layouts/flash_message", message: flash[:alert], variant: :error %>

        <main class="admin-main">
          <div class="admin-content"><%= yield %></div>
        </main>
      </div>
    </div>
  </body>
</html>
