<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin — Eloshop" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-gray-50 text-ink">
    <%= render "layouts/admin_nav" %>

    <main class="container mx-auto flex-1 px-5 py-10">
      <% if flash[:notice] %>
        <p class="mb-6 rounded bg-green-50 px-4 py-3 text-sm text-green-800"><%= flash[:notice] %></p>
      <% end %>

      <% if flash[:alert] %>
        <p class="mb-6 rounded bg-red-50 px-4 py-3 text-sm text-red-800"><%= flash[:alert] %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
