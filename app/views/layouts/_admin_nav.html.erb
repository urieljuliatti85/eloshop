<%# No celular, as áreas do dia a dia são abas no rodapé
    (layouts/_admin_mobile_tabs) e as demais, esta faixa de rolagem
    horizontal. O header não é sticky: a navegação fixa é o rodapé, e
    prender topo + rodapé tiraria quase um terço da altura da tela. %>
<header class="admin-mobile-header topo-serrilhado">
  <div class="flex items-center justify-between gap-3">
    <%= link_to admin_root_path, class: "admin-brand" do %>
      <span class="admin-brand-mark">E</span>
      <span>
        <span class="block text-base font-bold text-white">EloShop</span>
        <span class="block text-[0.65rem] uppercase tracking-[0.18em] text-slate-400">Administração</span>
      </span>
    <% end %>
    <%= button_to session_path, method: :delete, class: "admin-mobile-logout" do %><%= admin_icon :logout %><span>Sair</span><% end %>
  </div>

  <nav class="admin-mobile-areas" aria-label="Outras áreas da administração" data-controller="center-active">
    <% admin_nav_items(except: AdminHelper::ADMIN_MOBILE_TAB_KEYS).each do |item| %>
      <% active = admin_nav_active?(item[:controllers]) %>
      <%= link_to item[:label], item[:path], class: "admin-area-chip #{'admin-area-chip--active' if active}", aria: { current: ("page" if active) } %>
    <% end %>
    <%= link_to "Ver loja", root_path, class: "admin-area-chip" %>
  </nav>
</header>

<aside class="admin-sidebar">
  <%= link_to admin_root_path, class: "admin-brand" do %>
    <span class="admin-brand-mark">E</span>
    <span>
      <span class="block text-lg font-bold text-white">EloShop</span>
      <span class="block text-[0.65rem] uppercase tracking-[0.2em] text-slate-400">Administração</span>
    </span>
  <% end %>

  <nav class="admin-nav" aria-label="Navegação administrativa">
    <p class="admin-nav-label">Gestão</p>
    <%= admin_nav_links %>
  </nav>

  <div class="admin-sidebar-footer">
    <%= link_to root_path, class: "admin-nav-link" do %>
      <%= admin_icon :store %>
      <span>Ver loja</span>
    <% end %>
    <%= button_to session_path, method: :delete, class: "admin-nav-link w-full" do %>
      <%= admin_icon :logout %>
      <span>Sair</span>
    <% end %>
  </div>
</aside>
