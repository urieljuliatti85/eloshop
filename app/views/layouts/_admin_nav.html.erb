<%# No celular a navegação fica nas abas inferiores (layouts/_admin_mobile_tabs). %>
<header class="admin-mobile-header topo-serrilhado">
  <%= link_to admin_root_path, class: "admin-brand" do %>
    <span class="admin-brand-mark">E</span>
    <span>
      <span class="block text-base font-bold text-white">EloShop</span>
      <span class="block text-[0.65rem] uppercase tracking-[0.18em] text-slate-400">Administração</span>
    </span>
  <% end %>
</header>

<aside class="admin-sidebar">
  <%= link_to admin_root_path, class: "admin-brand" do %>
    <span class="admin-brand-mark">E</span>
    <span>
      <span class="block text-lg font-bold text-white">EloShop</span>
      <span class="block text-[0.65rem] uppercase tracking-[0.2em] text-slate-400">Administração</span>
    </span>
  <% end %>

  <nav class="admin-nav" aria-label="Navegação administrativa">
    <p class="admin-nav-label">Gestão</p>
    <%= admin_nav_links %>
  </nav>

  <div class="admin-sidebar-footer">
    <%= link_to root_path, class: "admin-nav-link" do %>
      <%= admin_icon :store %>
      <span>Ver loja</span>
    <% end %>
    <%= button_to session_path, method: :delete, class: "admin-nav-link w-full" do %>
      <%= admin_icon :logout %>
      <span>Sair</span>
    <% end %>
  </div>
</aside>
