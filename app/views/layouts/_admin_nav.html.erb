<%# No celular, as áreas do dia a dia são abas no rodapé
    (layouts/_admin_mobile_tabs); aqui ficam outras quatro
    (`ADMIN_MOBILE_TOP_KEYS`) e "Mais", que abre a lista com o resto. O
    header fica preso no topo (sticky), como o rodapé fica embaixo. %>
<% more_items = admin_nav_items(except: AdminHelper::ADMIN_MOBILE_TAB_KEYS + AdminHelper::ADMIN_MOBILE_TOP_KEYS)
   more_active = more_items.any? { |item| admin_nav_active?(item[:controllers]) } %>
<header class="admin-mobile-header topo-serrilhado">
  <div class="flex items-center justify-between gap-3">
    <%= link_to admin_root_path, class: "admin-brand" do %>
      <span class="admin-brand-mark">E</span>
      <span>
        <span class="block text-base font-bold text-white">EloShop</span>
        <span class="block text-[0.65rem] uppercase tracking-[0.18em] text-slate-400">Administração</span>
      </span>
    <% end %>
    <%= button_to session_path, method: :delete, class: "admin-mobile-logout" do %><%= admin_icon :logout %><span>Sair</span><% end %>
  </div>

  <nav class="admin-top-tabs" aria-label="Outras áreas da administração"
       data-controller="account-menu"
       data-action="click@window->account-menu#closeOnOutsideClick keydown.esc@window->account-menu#closeOnEscape turbo:load@document->account-menu#closeOnNavigation">
    <ul class="admin-tabs-list">
      <% admin_nav_items_for(AdminHelper::ADMIN_MOBILE_TOP_KEYS).each do |tab| %>
        <li><%= render "layouts/admin_mobile_tab", tab: tab %></li>
      <% end %>
      <li>
        <button type="button" class="admin-tab w-full cursor-pointer <%= 'admin-tab--active' if more_active %>"
                aria-expanded="false" aria-controls="admin-more-menu"
                data-account-menu-target="button" data-action="account-menu#toggle">
          <%= admin_icon :menu, class_name: "size-6" %>
          <span>Mais</span>
        </button>
      </li>
    </ul>

    <div class="admin-more-menu" id="admin-more-menu" data-account-menu-target="panel" hidden>
      <% more_items.each do |item| %>
        <%= admin_nav_link item[:label], item[:path], icon: item[:icon], controllers: item[:controllers] %>
      <% end %>
      <div class="mt-2 border-t border-white/10 pt-2">
        <%= link_to root_path, class: "admin-nav-link" do %><%= admin_icon :store %><span>Ver loja</span><% end %>
      </div>
    </div>
  </nav>
</header>

<aside class="admin-sidebar">
  <%= link_to admin_root_path, class: "admin-brand" do %>
    <span class="admin-brand-mark">E</span>
    <span>
      <span class="block text-lg font-bold text-white">EloShop</span>
      <span class="block text-[0.65rem] uppercase tracking-[0.2em] text-slate-400">Administração</span>
    </span>
  <% end %>

  <nav class="admin-nav" aria-label="Navegação administrativa">
    <p class="admin-nav-label">Gestão</p>
    <%= admin_nav_links %>
  </nav>

  <div class="admin-sidebar-footer">
    <%= link_to root_path, class: "admin-nav-link" do %>
      <%= admin_icon :store %>
      <span>Ver loja</span>
    <% end %>
    <%= button_to session_path, method: :delete, class: "admin-nav-link w-full" do %>
      <%= admin_icon :logout %>
      <span>Sair</span>
    <% end %>
  </div>
</aside>
