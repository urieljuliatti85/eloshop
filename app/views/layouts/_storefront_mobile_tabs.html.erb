<%# Abas inferiores da loja no celular (abaixo de `md`, o mesmo corte em que o
    topo troca as pílulas pelo hambúrguer). Mesmo desenho das abas do painel
    do artesão e da área do cliente: ícone sobre rótulo e traço no topo da aba
    da página atual. Os quatro destinos são os do menu principal, que o
    hambúrguer continua oferecendo. Na área do cliente o layout não renderiza
    esta barra, porque lá as abas da conta ocupam o mesmo lugar. O body ganha
    `storefront-tabs-area`, que reserva a altura da barra no fim da página
    (ver application.css). %>
<% tabs = [
     { label: "Início", path: root_path, controllers: "home",
       icon: '<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z"/>' },
     { label: "Loja", path: products_path, controllers: "products",
       icon: '<path d="M5 8h14l-1 12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>' },
     { label: "Ateliês", path: sellers_path, controllers: "sellers",
       icon: '<path d="M4 9 5.5 4h13L20 9"/><path d="M4 9a2.67 2.67 0 0 0 5.33 0 2.67 2.67 0 0 0 5.34 0A2.67 2.67 0 0 0 20 9"/><path d="M5 11.5V20h14v-8.5"/><path d="M10 20v-5h4v5"/>' },
     { label: "Como funciona", path: how_it_works_path, controllers: "how_it_works",
       icon: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6"/><path d="M12 17h.01"/>' }
   ] %>
<nav class="storefront-tabs" aria-label="Navegação da loja">
  <ul class="grid h-16 grid-cols-4">
    <% tabs.each do |tab| %>
      <% active = storefront_nav_active?(tab[:controllers]) %>
      <li>
        <%= link_to tab[:path], class: "account-tab #{'account-tab--active' if active}", aria: { current: ("page" if active) } do %>
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= tab[:icon].html_safe %></svg>
          <span><%= tab[:label] %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
