<footer class="border-t border-gray-100 bg-white">
  <div class="container mx-auto grid grid-cols-1 gap-10 px-5 py-16 md:grid-cols-4">
    <div>
      <%= image_tag "logo.png", alt: "EloShop", class: "h-8" %>
      <p class="mt-4 max-w-xs text-sm text-ink-muted">
        Artesanato e peças feitas à mão, com processo e materiais que você pode conhecer antes de comprar.
      </p>
    </div>

    <div>
      <p class="mb-4 text-sm font-semibold text-ink">Links</p>
      <ul class="space-y-3 text-sm text-ink-muted">
        <li><%= link_to "Início", root_path, class: "hover:text-brand-600" %></li>
        <li><%= link_to "Loja", products_path, class: "hover:text-brand-600" %></li>
        <li><%= link_to "Contato", new_contact_path, class: "hover:text-brand-600" %></li>
        <li><%= link_to "Créditos das imagens", credits_path, class: "hover:text-brand-600" %></li>
        <li><%= link_to "Venda na EloShop", new_seller_registration_path, class: "hover:text-brand-600" %></li>
      </ul>
    </div>

    <div>
      <p class="mb-4 text-sm font-semibold text-ink">Ajuda</p>
      <ul class="space-y-3 text-sm text-ink-muted">
        <li><%= link_to "Meus pedidos", "#", class: "hover:text-brand-600" %></li>
        <li><%= link_to "Favoritos", wishlist_path, class: "hover:text-brand-600" %></li>
      </ul>
    </div>

    <div>
      <p class="mb-4 text-sm font-semibold text-ink">EloShop</p>
      <p class="text-sm text-ink-muted">Loja online de artesanato e produtos feitos à mão.</p>
    </div>
  </div>

  <div class="bg-ink">
    <p class="container mx-auto px-5 py-5 text-xs text-white/70">
      &copy; <%= Date.current.year %> EloShop. Todos os direitos reservados.
    </p>
  </div>
</footer>
