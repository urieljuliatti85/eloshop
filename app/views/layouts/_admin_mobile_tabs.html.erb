<%# Abas inferiores do admin no celular e no tablet (abaixo de `lg`, mesmo
    corte da lateral — acima dele a lateral assume). As áreas do trabalho do
    dia (`AdminHelper::ADMIN_MOBILE_TAB_KEYS`) mais Notificações, que vivem
    aqui porque o sino do topo é só do desktop. As outras áreas ficam na
    faixa do topo (layouts/_admin_nav). A altura (h-16) é a
    `--admin-tabs-height` que o `.admin-body` define para o `.admin-main`
    abrir espaço no fim da página. %>
<% labels = { dashboard: "Início" }
   tabs = admin_nav_items.select { |item| AdminHelper::ADMIN_MOBILE_TAB_KEYS.include?(item[:key]) }
     .sort_by { |item| AdminHelper::ADMIN_MOBILE_TAB_KEYS.index(item[:key]) }
     .map { |item| item.merge(label: labels.fetch(item[:key], item[:label])) }
   tabs << { label: "Notificações", path: admin_notifications_path, icon: :notifications, controllers: %w[notifications], count: unread_count } %>
<nav class="admin-tabs" aria-label="Atalhos da administração">
  <ul class="admin-tabs-list">
    <% tabs.each do |tab| %>
      <% active = admin_nav_active?(tab[:controllers]) %>
      <li>
        <%= link_to tab[:path], class: "admin-tab #{'admin-tab--active' if active}", aria: { current: ("page" if active) } do %>
          <span class="relative">
            <%= admin_icon tab[:icon], class_name: "size-6" %>
            <% if tab[:count].to_i.positive? %>
              <span class="admin-tab-count" aria-hidden="true"><%= tab[:count] > 9 ? "9+" : tab[:count] %></span>
            <% end %>
          </span>
          <span><%= tab[:label] %></span>
          <% if tab[:count].to_i.positive? %><span class="sr-only">(<%= tab[:count] %> não lidas)</span><% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
