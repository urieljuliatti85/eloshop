<%# Abas inferiores do admin no celular e no tablet (abaixo de `lg`, mesmo
    corte da lateral — acima dele a lateral assume). Quatro áreas do trabalho
    do dia mais "Menu", que abre a lista completa (`admin_nav_items`) com
    "Ver loja" e "Sair". A altura (h-16) é a `--admin-tabs-height` que o
    `.admin-body` define para o `.admin-main` abrir espaço no fim da página.
    Notificações vivem aqui porque o sino do topo é só do desktop. %>
<% items = admin_nav_items.index_by { |item| item[:key] }
   tabs = [
     items.fetch(:dashboard).merge(label: "Início"),
     items.fetch(:orders),
     items.fetch(:sellers),
     { label: "Notificações", path: admin_notifications_path, icon: :notifications, controllers: %w[notifications], count: unread_count }
   ] %>
<nav class="admin-tabs" aria-label="Atalhos da administração"
     data-controller="account-menu"
     data-action="click@window->account-menu#closeOnOutsideClick keydown.esc@window->account-menu#closeOnEscape turbo:load@document->account-menu#closeOnNavigation">
  <div class="admin-tabs-sheet" id="admin-tabs-sheet" data-account-menu-target="panel" hidden>
    <p class="admin-nav-label mb-1 mt-1">Todas as áreas</p>
    <%= admin_nav_links %>
    <div class="mt-2 border-t border-white/10 pt-2">
      <%= link_to root_path, class: "admin-nav-link" do %><%= admin_icon :store %><span>Ver loja</span><% end %>
      <%= button_to session_path, method: :delete, class: "admin-nav-link w-full" do %><%= admin_icon :logout %><span>Sair</span><% end %>
    </div>
  </div>

  <ul class="admin-tabs-list">
    <% tabs.each do |tab| %>
      <% active = admin_nav_active?(tab[:controllers]) %>
      <li>
        <%= link_to tab[:path], class: "admin-tab #{'admin-tab--active' if active}", aria: { current: ("page" if active) } do %>
          <span class="relative">
            <%= admin_icon tab[:icon], class_name: "size-6" %>
            <% if tab[:count].to_i.positive? %>
              <span class="admin-tab-count" aria-hidden="true"><%= tab[:count] > 9 ? "9+" : tab[:count] %></span>
            <% end %>
          </span>
          <span><%= tab[:label] %></span>
          <% if tab[:count].to_i.positive? %><span class="sr-only">(<%= tab[:count] %> não lidas)</span><% end %>
        <% end %>
      </li>
    <% end %>
    <li>
      <button type="button" class="admin-tab w-full"
              aria-expanded="false" aria-controls="admin-tabs-sheet"
              data-account-menu-target="button" data-action="account-menu#toggle">
        <%= admin_icon :menu, class_name: "size-6" %>
        <span>Menu</span>
      </button>
    </li>
  </ul>
</nav>
