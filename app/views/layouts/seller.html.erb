<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Painel do artesão | EloShop" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Tour guiado: abre sozinho enquanto o vendedor não o concluiu e também por
      qualquer elemento com `data-action="tour#start"` (ver Primeiros passos). %>
  <body class="min-h-screen bg-gradient-to-b from-brand-50 via-[#fdf1e7] to-[#fdf1e7] text-ink antialiased"
        data-controller="tour"
        data-tour-steps-value="<%= seller_tour_steps.to_json %>"
        data-tour-complete-url-value="<%= seller_tour_completion_path %>"
        data-tour-auto-value="<%= current_seller.tour_completed_at.nil? %>">
    <%# Navegação do painel: lista única, usada na barra horizontal (lg+) e no
        painel do hambúrguer (celular). Antes era uma faixa com rolagem lateral,
        e "Novo produto" ficava fora da tela sem indício de arrastar. %>
    <% nav_items = [
         [ "Visão geral", seller_root_path ],
         [ "Primeiros passos", seller_getting_started_path ],
         [ "Conta Vendedor no Mercado Pago", seller_mercado_pago_guide_path ],
         [ "Cadastro da Chave Pix", seller_pix_key_guide_path ],
         [ "Produtos", seller_products_path ],
         [ "Pedidos", seller_orders_path ],
         [ "Mensagens", seller_messages_path ],
         [ "Avaliações", seller_reviews_path ],
         [ "Dados do Ateliê", seller_atelier_path ],
         [ "Novo produto", new_seller_product_path ]
       ] %>
    <%# "Ver a loja" leva à página do próprio ateliê (/artesaos/:slug). Enquanto
        ela não existe (cadastro pendente, suspenso ou escondido), cai na loja
        geral: a página própria responderia 404 ou "indisponível". %>
    <% store_path = current_seller.public_page_available? ? seller_path(current_seller) : products_path %>
    <header class="sticky top-0 z-40 border-b border-brand-100 bg-white/90 backdrop-blur"
            data-controller="mobile-menu"
            data-action="keydown.esc@window->mobile-menu#closeOnEscape turbo:load@document->mobile-menu#closeOnNavigation">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-4 py-3 sm:px-6 lg:flex-nowrap lg:px-8">
        <%= link_to seller_root_path, class: "flex min-h-11 shrink-0 items-center gap-3", aria: { label: "Início do painel" } do %>
          <%= image_tag "logo.png", alt: "EloShop", class: "h-7 w-auto" %>
          <span class="hidden border-l border-brand-200 pl-3 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-brand-600 sm:block">Ateliê</span>
        <% end %>

        <%= form_with url: seller_products_path, method: :get, class: "order-3 flex w-full min-w-0 items-center rounded-full border border-brand-200 bg-brand-50/60 px-4 focus-within:border-brand-400 focus-within:ring-2 focus-within:ring-brand-100 lg:order-none lg:mx-5 lg:flex-1" do %>
          <label for="seller-search" class="sr-only">Buscar no seu catálogo</label>
          <%= search_field_tag :q, params[:q], id: "seller-search", placeholder: "Buscar no seu catálogo", class: "min-h-10 w-full border-0 bg-transparent px-0 text-sm outline-none focus:ring-0" %>
          <button type="submit" class="grid size-11 shrink-0 cursor-pointer place-items-center text-brand-500" aria-label="Buscar">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
          </button>
        <% end %>

        <div class="ml-auto flex shrink-0 items-center gap-2 sm:gap-5">
          <%= link_to "Ver a loja", store_path, class: "inline-flex min-h-11 items-center whitespace-nowrap text-xs font-semibold text-stone-600 hover:text-brand-600" %>

          <% recent_notifications = current_seller.notifications.chronological.limit(5)
             unread_count = current_seller.notifications.unread.count %>
          <div class="relative" data-controller="account-menu"
               data-action="click@window->account-menu#closeOnOutsideClick keydown.esc@window->account-menu#closeOnEscape turbo:load@document->account-menu#closeOnNavigation">
            <button type="button"
                    class="relative grid size-9 cursor-pointer place-items-center rounded-full text-stone-600 transition hover:bg-brand-50 hover:text-brand-600"
                    aria-expanded="false" aria-haspopup="true"
                    aria-label="Notificações"
                    data-account-menu-target="button"
                    data-action="account-menu#toggle">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M6 8a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5h-15S6 12 6 8Z" stroke-linejoin="round" />
                <path d="M9.5 16a2.5 2.5 0 0 0 5 0" stroke-linecap="round" />
              </svg>
              <% if unread_count.positive? %>
                <span class="absolute right-0 top-0.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-brand-500 px-1 text-xs font-semibold text-white">
                  <%= unread_count %>
                </span>
              <% end %>
            </button>

            <div class="absolute right-0 top-full z-20 mt-3 w-80 overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-lg"
                 data-account-menu-target="panel" hidden>
              <p class="border-b border-brand-100 px-4 py-3 text-sm font-semibold text-stone-900">Notificações</p>

              <% if recent_notifications.any? %>
                <ul class="max-h-96 overflow-y-auto">
                  <% recent_notifications.each do |notification| %>
                    <li>
                      <%= button_to mark_as_read_seller_notification_path(notification), method: :patch,
                            class: "block w-full px-4 py-3 text-left transition hover:bg-brand-50 #{'bg-brand-50' unless notification.read?}" do %>
                        <p class="text-sm font-semibold text-stone-900"><%= notification.title %></p>
                        <p class="mt-0.5 truncate text-xs text-stone-500"><%= notification.body %></p>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="px-4 py-6 text-center text-sm text-stone-500">Você ainda não tem notificações.</p>
              <% end %>

              <div class="border-t border-brand-100">
                <%= link_to "Ver todas", seller_notifications_path, class: "block px-4 py-2.5 text-center text-sm font-medium text-brand-600 hover:bg-brand-50" %>
              </div>
            </div>
          </div>

          <div class="hidden h-7 w-px bg-brand-100 sm:block"></div>
          <div class="text-right">
            <p class="max-w-24 truncate sm:max-w-36 text-sm font-bold text-stone-900"><%= current_seller.name %></p>
            <p class="text-[0.65rem] font-semibold uppercase tracking-wider text-brand-600"><%= t(current_seller.status, scope: "sellers.statuses") %></p>
          </div>
          <span class="hidden size-9 place-items-center rounded-full bg-brand-600 text-sm font-bold text-white sm:grid" aria-hidden="true"><%= current_seller.name.first.upcase %></span>
          <%= button_to seller_logout_path, method: :delete, class: "hidden size-11 cursor-pointer place-items-center rounded-full border border-brand-200 text-stone-600 transition hover:border-brand-400 hover:text-brand-600 sm:grid", form: { aria: { label: "Sair" } } do %>
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 5H5v14h5M14 8l4 4-4 4M18 12H9"/></svg>
          <% end %>

          <button type="button"
                  class="grid size-11 cursor-pointer place-items-center text-stone-900 hover:text-brand-600 lg:hidden"
                  aria-expanded="false" aria-controls="seller-nav-panel" aria-label="Abrir menu do painel"
                  data-mobile-menu-target="button"
                  data-action="mobile-menu#toggle">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>

      <%# Celular e tablet: painel do hambúrguer, fechado ao carregar. Sem
          JavaScript ele não abre; a barra horizontal só existe a partir de lg. %>
      <div id="seller-nav-panel" class="border-t border-brand-100 bg-white lg:hidden" data-mobile-menu-target="panel" hidden>
        <nav class="mx-auto flex max-w-7xl flex-col px-4 sm:px-6" aria-label="Navegação do painel">
          <%= link_to store_path, class: "flex min-h-11 items-center gap-2 border-b border-brand-100 py-1 text-base font-semibold text-stone-900" do %>
            Ver a loja
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          <% end %>
          <% nav_items.each do |label, path| %>
            <%= render "layouts/seller_nav_link", label: label, path: path, mobile: true %>
          <% end %>
        </nav>
        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 pb-5 pt-3 sm:px-6">
          <p class="px-1 text-sm text-stone-500"><span class="font-semibold text-stone-900"><%= current_seller.name %></span> · <%= t(current_seller.status, scope: "sellers.statuses") %></p>
          <%= button_to "Sair", seller_logout_path, method: :delete, class: "w-full cursor-pointer rounded-full bg-stone-900 px-5 py-3 text-base font-semibold text-white" %>
        </div>
      </div>

      <%# Telas largas: a barra horizontal de antes. %>
      <div class="mx-auto hidden max-w-7xl lg:block">
        <nav class="flex gap-2 overflow-x-auto px-8 pb-3 text-xs font-semibold" aria-label="Navegação do painel">
          <% nav_items.each do |label, path| %>
            <%= render "layouts/seller_nav_link", label: label, path: path, mobile: false %>
          <% end %>
        </nav>
      </div>
    </header>

    <%= render "layouts/flash_message", message: flash[:notice], variant: :success %>
    <%= render "layouts/flash_message", message: flash[:alert], variant: :error %>

    <main class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
      <div class="seller-content"><%= yield %></div>
    </main>
  </body>
</html>
