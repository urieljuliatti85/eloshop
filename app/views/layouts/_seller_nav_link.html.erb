<%# Um item da navegação do painel. Usado na barra horizontal (lg+) e no painel
    do hambúrguer (celular), que só diferem no formato do alvo de toque.
    min-h-11: no celular estes são os alvos de toque principais do painel. %>
<% active = current_page?(path) || (label == "Mensagens" && controller_name == "order_messages") %>
<%= link_to path,
      class: (mobile ?
        "flex min-h-11 items-center justify-between gap-3 border-b border-brand-100 py-1 text-base font-medium #{active ? 'text-brand-600' : 'text-stone-900'}" :
        "inline-flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap rounded-full px-4 transition #{active ? 'bg-brand-500 text-white shadow-sm' : 'text-stone-600 hover:bg-brand-50 hover:text-brand-700'}"),
      aria: (active ? { current: "page" } : {}) do %>
  <%= label %>
  <%# Passo obrigatório: sem a conta conectada não há publicação. O texto
      carrega o significado (não só a cor) para leitores de tela. %>
  <% if path == seller_mercado_pago_guide_path %>
    <% case current_seller.mercado_pago_account_state %>
    <% when :ready %>
      <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[0.65rem] font-bold uppercase text-emerald-800">✓ Conectado</span>
    <% when :not_accepted %>
      <span class="inline-flex items-center gap-1 rounded-full bg-amber-500 px-2 py-0.5 text-[0.65rem] font-bold uppercase text-white">
        <%= render "seller_portal/mercado_pago_guides/alert_icon", class_name: "size-3" %>
        Conta não aceita
      </span>
    <% else %>
      <span class="inline-flex items-center gap-1 rounded-full bg-red-600 px-2 py-0.5 text-[0.65rem] font-bold uppercase text-white">
        <%= render "seller_portal/mercado_pago_guides/alert_icon", class_name: "size-3" %>
        Obrigatório
      </span>
    <% end %>
  <% end %>
<% end %>
