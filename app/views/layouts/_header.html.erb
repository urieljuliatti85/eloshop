<header class="sticky top-0 z-10 border-b border-gray-100 bg-white/90 backdrop-blur"
        data-controller="mobile-menu"
        data-action="keydown.esc@window->mobile-menu#closeOnEscape turbo:load@document->mobile-menu#closeOnNavigation">
  <div class="container mx-auto flex items-center justify-between gap-6 px-5 py-4">
    <%= link_to root_path, class: "flex items-center" do %>
      <%= image_tag "logo.png", alt: "EloShop", class: "h-9" %>
    <% end %>

    <nav class="hidden items-center gap-1 rounded-full border border-gray-200 bg-gray-50 p-1 text-sm font-medium text-ink md:flex">
      <%# O convite ao artesão só para quem ainda não tem painel:
          `authenticated?` é a sessão de `User` (admin ou vendedor),
          independente da sessão de cliente — um comprador logado continua
          vendo o convite. O rótulo repete o título da página de destino. %>
      <% items = [ [ "Início", root_path, "home" ],
                   [ "Loja", products_path, "products" ],
                   [ "Ateliês", sellers_path, "sellers" ],
                   [ "Contato", new_contact_path, "contacts" ],
                   [ "Painel do Artesão", seller_root_path, "seller_portal/dashboard" ] ]
         items << [ "Cadastre seu Ateliê", new_seller_registration_path, "seller_registrations" ] unless authenticated? %>
      <% items.each do |label, path, controllers| %>
        <% active = storefront_nav_active?(controllers) %>
        <%= link_to label, path,
              class: "rounded-full px-4 py-2 transition #{active ? 'bg-white text-brand-600 shadow-sm' : 'hover:bg-white hover:shadow-sm'}",
              aria: { current: ("page" if active) } %>
      <% end %>
    </nav>

    <%# Em telas estreitas os rótulos de conta saem do topo (a 390px "Criar
        conta" quebrava em duas linhas) e passam para o painel do hambúrguer;
        no topo ficam só o carrinho e o menu, com 44px de alvo de toque. %>
    <%# Mesma pílula do menu de navegação ao lado: borda, fundo cinza e cantos
        arredondados, para os dois blocos do topo lerem como um par. No mobile
        a moldura sai — lá dentro ficam só o carrinho e o hambúrguer. %>
    <div class="flex items-center gap-1 text-sm md:gap-0.5 md:rounded-full md:border md:border-gray-200 md:bg-gray-50 md:px-2 md:py-1">
      <%# Quem está logado aparece pelo primeiro nome, com a inicial no avatar
          — mesma identificação que o painel do artesão já usa. O nome abre um
          painel com os dados da conta e seus destinos.

          Sem JavaScript o painel não abre, mas nada se perde: Pedidos,
          Favoritos e Sair continuam no menu do hambúrguer. %>
      <% if respond_to?(:customer_authenticated?) && customer_authenticated? && Current.customer %>
        <div class="relative hidden md:block" data-controller="account-menu"
             data-action="click@window->account-menu#closeOnOutsideClick keydown.esc@window->account-menu#closeOnEscape turbo:load@document->account-menu#closeOnNavigation">
          <button type="button"
                  class="flex cursor-pointer items-center gap-2 font-medium text-ink hover:text-brand-600"
                  aria-expanded="false" aria-haspopup="true"
                  data-account-menu-target="button"
                  data-action="account-menu#toggle">
            <span class="grid size-8 place-items-center rounded-full bg-ink text-xs font-bold text-white" aria-hidden="true"><%= Current.customer.name.first.upcase %></span>
            <span class="max-w-28 truncate"><%= Current.customer.name.split.first %></span>
            <svg class="size-4 text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div class="absolute right-0 top-full z-20 mt-3 w-64 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-lg"
               data-account-menu-target="panel" hidden>
            <div class="flex items-center gap-3 border-b border-gray-100 px-4 py-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-ink text-sm font-bold text-white" aria-hidden="true"><%= Current.customer.name.first.upcase %></span>
              <div class="min-w-0">
                <p class="truncate font-semibold text-ink"><%= Current.customer.name %></p>
                <p class="truncate text-xs text-ink-muted"><%= Current.customer.email %></p>
              </div>
            </div>

            <div class="py-1">
              <%= link_to "Minha conta", account_root_path, class: "block px-4 py-2.5 text-sm text-ink hover:bg-sand-50 hover:text-brand-600" %>
              <%= link_to "Meus pedidos", orders_path, class: "block px-4 py-2.5 text-sm text-ink hover:bg-sand-50 hover:text-brand-600" %>
              <%= link_to "Endereços", addresses_path, class: "block px-4 py-2.5 text-sm text-ink hover:bg-sand-50 hover:text-brand-600" %>
              <%= link_to "Favoritos", wishlist_path, class: "block px-4 py-2.5 text-sm text-ink hover:bg-sand-50 hover:text-brand-600" %>
            </div>

            <div class="border-t border-gray-100">
              <%= button_to "Sair da conta", customer_session_path, method: :delete, class: "w-full cursor-pointer px-4 py-2.5 text-left text-sm font-medium text-ink hover:bg-sand-50 hover:text-brand-600" %>
            </div>
          </div>
        </div>
      <% elsif respond_to?(:customer_authenticated?) %>
        <%# "Quero comprar" no lugar de "Entrar / Criar conta": com o cadastro
            de artesão no menu ao lado, dois pares de "entrar/criar" no mesmo
            topo não diziam qual porta é de quem. O destino é o login, que já
            leva ao cadastro por link. %>
        <%= link_to "Quero comprar", new_customer_session_path, class: "hidden rounded-full px-4 py-2 font-medium text-ink transition hover:bg-white hover:shadow-sm md:inline-block" %>
      <% end %>

      <%= link_to cart_path, class: "relative flex h-11 min-w-11 items-center justify-center gap-1.5 font-medium text-ink transition hover:text-brand-600 md:h-auto md:min-w-0 md:rounded-full md:px-4 md:py-2 md:hover:bg-white md:hover:shadow-sm", aria: { label: "Carrinho" } do %>
        <span class="hidden md:inline">Carrinho</span>
        <svg class="h-6 w-6 md:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M6 7h12l-1 13H7L6 7Z" stroke-linejoin="round" />
          <path d="M9 7a3 3 0 0 1 6 0" stroke-linecap="round" />
        </svg>
        <% if Current.cart&.cart_items&.any? %>
          <%# Sobre o ícone o badge flutua no canto; ao lado do rótulo, fica em linha. %>
          <span class="absolute right-0 top-0.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-brand-500 px-1 text-xs font-semibold text-white md:static">
            <%= Current.cart.cart_items.sum(:quantity) %>
          </span>
        <% end %>
      <% end %>

      <%# A lupa abre um campo que envia para a Loja pelo parâmetro `q`, que o
          ProductsController já trata. Sem JavaScript nada se perde: a busca
          continua dentro do filtro da vitrine. %>
      <div class="relative flex items-center" data-controller="header-search"
           data-action="click@window->header-search#closeOnOutsideClick keydown.esc@window->header-search#closeOnEscape">
        <button type="button"
                class="flex h-11 w-11 cursor-pointer items-center justify-center text-ink transition hover:text-brand-600 md:h-9 md:w-9 md:rounded-full md:hover:bg-white md:hover:shadow-sm"
                aria-expanded="false" aria-label="Buscar produtos"
                data-action="header-search#toggle">
          <svg class="h-6 w-6 md:h-5 md:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
        </button>

        <div class="absolute right-0 top-full z-10 mt-3 w-[min(20rem,calc(100vw-2.5rem))] rounded-2xl border border-gray-200 bg-white p-3 shadow-lg"
             data-header-search-target="panel" hidden>
          <%= form_with url: products_path, method: :get, class: "flex items-center gap-2" do |form| %>
            <%= form.search_field :q, value: params[:q], placeholder: "Buscar produtos", id: nil,
                  class: "w-full rounded-full border border-gray-200 bg-sand-50 px-4 py-2 text-sm text-ink placeholder:text-ink-muted focus:border-brand-500 focus:outline-none",
                  data: { header_search_target: "input" } %>
            <%= form.submit "Buscar", class: "cursor-pointer rounded-full bg-brand-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-600" %>
          <% end %>
        </div>
      </div>

      <button type="button"
              class="flex h-11 w-11 cursor-pointer items-center justify-center text-ink hover:text-brand-600 md:hidden"
              aria-expanded="false" aria-label="Abrir menu"
              data-mobile-menu-target="button"
              data-action="mobile-menu#toggle">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <%# Sem JavaScript o painel não abre, mas o rodapé repete Início, Loja e
      Contato — nenhum destino fica inalcançável. %>
  <div class="border-t border-gray-100 bg-white md:hidden" data-mobile-menu-target="panel" hidden>
    <nav class="container mx-auto flex flex-col px-5">
      <% mobile_items = [ [ "Início", root_path, "home", true ],
                          [ "Loja", products_path, "products", true ],
                          [ "Ateliês", sellers_path, "sellers", true ],
                          [ "Contato", new_contact_path, "contacts", true ],
                          [ "Painel do Artesão", seller_root_path, "seller_portal/dashboard", authenticated? ? false : true ] ]
         mobile_items << [ "Cadastre seu Ateliê", new_seller_registration_path, "seller_registrations", false ] unless authenticated? %>
      <% mobile_items.each do |label, path, controllers, divider| %>
        <% active = storefront_nav_active?(controllers) %>
        <%= link_to label, path,
              class: "flex min-h-11 items-center py-1 text-base font-medium #{divider ? 'border-b border-gray-100 ' : ''}#{active ? 'text-brand-600' : 'text-ink'}",
              aria: { current: ("page" if active) } %>
      <% end %>
    </nav>

    <div class="container mx-auto flex flex-col gap-3 px-5 pb-5 pt-2">
      <% if respond_to?(:customer_authenticated?) && customer_authenticated? %>
        <%# No painel do hambúrguer o nome é só rótulo: os destinos de conta
            já estão logo abaixo, e um link a mais para "Pedidos" seria ruído. %>
        <% if Current.customer %>
          <%= link_to account_root_path, class: "flex items-center gap-2 px-1 pb-1 text-base font-semibold text-ink" do %>
            <span class="grid size-8 place-items-center rounded-full bg-ink text-xs font-bold text-white" aria-hidden="true"><%= Current.customer.name.first.upcase %></span>
            <span class="truncate"><%= Current.customer.name %></span>
          <% end %>
        <% end %>
        <%= link_to "Pedidos", orders_path, class: "flex min-h-11 items-center justify-center rounded-full border border-gray-200 px-5 text-base font-medium text-ink" %>
        <%= link_to "Endereços", addresses_path, class: "flex min-h-11 items-center justify-center rounded-full border border-gray-200 px-5 text-base font-medium text-ink" %>
        <%= link_to "Favoritos", wishlist_path, class: "flex min-h-11 items-center justify-center rounded-full border border-gray-200 px-5 text-base font-medium text-ink" %>
        <%= button_to "Sair", customer_session_path, method: :delete, class: "w-full cursor-pointer rounded-full bg-ink px-5 py-3 text-base font-semibold text-white" %>
      <% elsif respond_to?(:customer_authenticated?) %>
        <%# No painel há espaço para as duas ações, então elas continuam
            separadas — o rótulo acima é que diz para quem servem. %>
        <p class="px-1 pb-1 text-sm font-semibold text-ink-muted">Quero comprar</p>
        <%= link_to "Entrar", new_customer_session_path, class: "flex min-h-11 items-center justify-center rounded-full border border-gray-200 px-5 text-base font-medium text-ink" %>
        <%= link_to "Criar conta", new_customer_path, class: "flex min-h-11 items-center justify-center rounded-full bg-ink px-5 text-base font-semibold text-white" %>
      <% end %>
    </div>
  </div>
</header>
