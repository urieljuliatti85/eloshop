<%# Abas inferiores do painel no celular. O layout escolhe a lista: as
    etapas dos Primeiros passos enquanto o cadastro não está pronto
    (`seller_setup_tabs`), o trabalho do dia depois (`seller_work_tabs`). A
    aba da página atual fica destacada (traço no topo, como a faixa de
    etapas). `mark`: :done (✓ verde), :next (ponto vermelho) ou um número
    (contagem em vermelho, com `mark_label` para o leitor de tela). A altura
    (h-16) é a `--seller-tabs-height` que o layout define para o resto da
    página abrir espaço. As duas listas têm cinco abas (`grid-cols-5`). %>
<% icons = {
     home: '<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z"/>',
     address: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
     mercado_pago: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/>',
     pix_key: '<circle cx="8" cy="15" r="4"/><path d="m11 12 8-8"/><path d="m16 7 2 2"/><path d="m14 9 2 2"/>',
     product: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
     orders: '<path d="M4 8 12 4l8 4v8l-8 4-8-4z"/><path d="m4 8 8 4 8-4"/><path d="M12 12v8"/>',
     new_product: '<circle cx="12" cy="12" r="9"/><path d="M12 8v8"/><path d="M8 12h8"/>',
     products: '<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>',
     messages: '<path d="M20 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2z"/>'
   } %>
<nav aria-label="<%= label %>" data-mobile-tabs class="fixed inset-x-0 bottom-0 z-40 border-t border-brand-100 bg-white pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_24px_rgba(120,40,10,0.08)] sm:hidden">
  <ul class="grid h-16 grid-cols-5">
    <% tabs.each do |tab| %>
      <% mark = tab[:mark] %>
      <li>
        <%= link_to tab[:path], aria: { current: (tab[:active] ? "page" : nil) },
              class: "relative flex h-full flex-col items-center justify-center gap-1 border-t-2 text-[0.6875rem] font-semibold leading-none transition focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-600 #{tab[:active] ? 'border-brand-600 text-brand-700' : 'border-transparent text-stone-600'}" do %>
          <span class="relative">
            <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= icons.fetch(tab[:icon]).html_safe %></svg>
            <% if mark == :done %>
              <span class="absolute -top-1 -right-2 flex size-4 items-center justify-center rounded-full bg-emerald-600 text-white ring-2 ring-white" aria-hidden="true"><svg viewBox="0 0 20 20" class="size-2.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 10.5 3.2 3L15 7"/></svg></span>
            <% elsif mark == :next %>
              <span class="absolute -top-0.5 -right-1 size-2.5 rounded-full bg-brand-600 ring-2 ring-white" aria-hidden="true"></span>
            <% elsif mark.is_a?(Integer) %>
              <span class="absolute -top-1.5 -right-3 flex h-4 min-w-4 items-center justify-center rounded-full bg-brand-600 px-1 text-[0.625rem] font-bold tabular-nums text-white ring-2 ring-white" aria-hidden="true"><%= mark > 9 ? "9+" : mark %></span>
            <% end %>
          </span>
          <span><%= tab[:label] %></span>
          <% if mark == :done %><span class="sr-only">(feita)</span>
          <% elsif mark == :next %><span class="sr-only">(próxima etapa)</span>
          <% elsif mark.is_a?(Integer) %><span class="sr-only">(<%= tab[:mark_label] %>)</span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
