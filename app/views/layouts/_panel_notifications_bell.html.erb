<%# Sino de avisos dos painéis do vendedor (ateliê e distribuidor): os
    cinco mais recentes, a contagem de não lidos e "Ver todas". Os caminhos
    vêm de `panel_path`, então o mesmo sino serve aos dois painéis. %>
<% recent_notifications = current_seller.notifications.chronological.limit(5)
   unread_count = current_seller.notifications.unread.count %>
<div class="relative" data-controller="account-menu"
     data-action="click@window->account-menu#closeOnOutsideClick keydown.esc@window->account-menu#closeOnEscape turbo:load@document->account-menu#closeOnNavigation">
  <button type="button"
          class="relative grid size-11 cursor-pointer place-items-center rounded-full text-stone-600 transition hover:bg-brand-50 hover:text-brand-600"
          aria-expanded="false" aria-haspopup="true"
          aria-label="Notificações"
          data-account-menu-target="button"
          data-action="account-menu#toggle">
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M6 8a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5h-15S6 12 6 8Z" stroke-linejoin="round" />
      <path d="M9.5 16a2.5 2.5 0 0 0 5 0" stroke-linecap="round" />
    </svg>
    <% if unread_count.positive? %>
      <span class="absolute right-0 top-0.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-brand-600 px-1 text-xs font-semibold text-white">
        <%= unread_count %>
      </span>
    <% end %>
  </button>

  <%# Celular: folha que sobe da base da tela, com fundo escurecido que
      fecha ao toque; antes era um painel de 20rem preso ao sininho, que
      fica no meio do cabeçalho e saía pela esquerda em 320-390px. Do
      `sm` em diante volta a ser o painel flutuante sob o sininho. O
      alvo `panel` é o conjunto (fundo + folha), então abrir/fechar
      continua sendo só o `hidden` do account-menu. O `fixed` só é
      relativo à tela porque o cabeçalho não tem `backdrop-blur`
      abaixo de `sm` (backdrop-filter vira contêiner do `fixed`). %>
  <div class="fixed inset-0 z-50 sm:absolute sm:inset-auto sm:right-0 sm:top-full sm:z-20 sm:mt-3 sm:w-80"
       data-account-menu-target="panel" hidden>
    <div class="absolute inset-0 bg-stone-900/40 sm:hidden" data-action="click->account-menu#close" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 flex max-h-[75vh] flex-col overflow-hidden rounded-t-2xl border-t border-brand-100 bg-white pb-[env(safe-area-inset-bottom)] shadow-lg sm:static sm:max-h-none sm:rounded-2xl sm:border sm:pb-0">
    <div class="flex items-center justify-between border-b border-brand-100 px-4 py-3">
      <p class="text-sm font-semibold text-stone-900">Notificações</p>
      <button type="button" class="grid size-11 -my-2 -mr-2 cursor-pointer place-items-center rounded-full text-stone-500 hover:bg-brand-50 sm:hidden" aria-label="Fechar notificações" data-action="account-menu#close">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"/></svg>
      </button>
    </div>

    <% if recent_notifications.any? %>
      <ul class="min-h-0 flex-1 overflow-y-auto sm:max-h-96">
        <% recent_notifications.each do |notification| %>
          <li>
            <%= button_to panel_path(:mark_as_read_notification, notification), method: :patch,
                  class: "block w-full px-4 py-3 text-left transition hover:bg-brand-50 #{'bg-brand-50' unless notification.read?}" do %>
              <p class="text-sm font-semibold text-stone-900"><%= notification.title %></p>
              <p class="mt-0.5 truncate text-xs text-stone-500"><%= notification.body %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-4 py-6 text-center text-sm text-stone-500">Você ainda não tem notificações.</p>
    <% end %>

    <div class="border-t border-brand-100">
      <%= link_to "Ver todas", panel_path(:notifications), class: "block px-4 py-3 text-center text-sm font-medium text-brand-600 hover:bg-brand-50" %>
    </div>
    </div>
  </div>
</div>
