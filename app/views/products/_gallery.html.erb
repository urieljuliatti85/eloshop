<%
  photos = product.gallery_images
  # Foto principal, miniaturas e ampliação apontam para o mesmo endereço
  # (caminho da rota do Active Storage, que não expira), para o navegador
  # reaproveitar o que já baixou.
  # A ampliação reusa a mesma versão da foto principal: já está no cache do
  # navegador, não gera variante nova nem ocupa mais o volume. O ganho é ver a
  # peça inteira — a moldura abaixo corta a foto (object-cover).
  photo_variant = { resize_to_limit: [ 1200, 1200 ] }
  photo_url = ->(photo) { url_for(photo.variant(photo_variant)) }
  photo_alt = ->(index) { photos.size > 1 ? "#{product.name} — foto #{index} de #{photos.size}" : product.name }
%>

<div data-controller="gallery" data-action="turbo:before-cache@document->gallery#close" class="flex flex-col gap-4">
  <%# 4:3 no celular: a foto quadrada empurrava nome, preço e botão de compra
      para fora da primeira tela. No desktop, onde há espaço, segue quadrada. %>
  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-brand-100 md:aspect-square">
    <% if photos.any? %>
      <button type="button" data-action="gallery#open" aria-haspopup="dialog" aria-label="Ampliar foto"
              class="group block h-full w-full cursor-zoom-in focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
        <%= image_tag photo_url.call(photos.first), class: "h-full w-full object-cover", alt: photo_alt.call(1), width: 800, height: 800, data: { "gallery-target": "main" } %>
        <%# Sinal visível de que a foto amplia: no celular não há cursor. %>
        <span aria-hidden="true" class="pointer-events-none absolute right-3 bottom-3 inline-flex items-center gap-1 rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold text-stone-800 shadow-sm">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="size-4"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M12.5 12.5 17 17M8.5 6v5M6 8.5h5" stroke-linecap="round"/></svg>
          Ampliar
        </span>
      </button>
    <% end %>
  </div>

  <% if photos.size > 1 %>
    <div class="flex gap-3 overflow-x-auto">
      <% photos.each.with_index(1) do |photo, index| %>
        <button type="button" data-action="gallery#show" data-gallery-src-param="<%= photo_url.call(photo) %>" data-gallery-alt-param="<%= photo_alt.call(index) %>"
                class="h-16 w-16 flex-none overflow-hidden rounded-lg border-2 border-transparent hover:border-brand-500">
          <%= image_tag photo.variant(resize_to_fill: [ 128, 128 ]), class: "h-full w-full object-cover", alt: photo_alt.call(index), width: 64, height: 64 %>
        </button>
      <% end %>
    </div>
  <% end %>

  <% if photos.any? %>
    <%# <dialog> nativo com showModal(): fundo inerte, Esc e foco preso sem
        biblioteca. Clicar fora da foto fecha. O próprio dialog cobre a tela e
        escurece o fundo: pelo ::backdrop, a camada saía quase transparente. %>
    <dialog data-gallery-target="dialog" data-action="click->gallery#closeOnBackdrop close->gallery#closed" aria-label="Foto ampliada de <%= product.name %>"
            class="m-0 h-dvh max-h-none w-screen max-w-none bg-stone-950/90 p-0 backdrop:bg-transparent">
      <div class="flex h-full w-full items-center justify-center p-4 sm:p-8">
        <%# `touch-action` deixa a pinça do celular ampliar o detalhe. %>
        <img data-gallery-target="zoom" src="<%= photo_url.call(photos.first) %>" alt="<%= photo_alt.call(1) %>"
             class="max-h-[calc(100dvh-2rem)] max-w-full rounded-lg touch-pinch-zoom object-contain shadow-2xl sm:max-h-[calc(100dvh-4rem)]">
      </div>
      <button type="button" data-action="gallery#close" autofocus
              class="fixed top-4 right-4 inline-flex min-h-11 items-center gap-2 rounded-full bg-white px-4 text-sm font-semibold text-stone-900 shadow-lg focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-white">
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="size-4"><path d="M5 5l10 10M15 5 5 15" stroke-linecap="round"/></svg>
        Fechar
      </button>
    </dialog>
  <% end %>
</div>
