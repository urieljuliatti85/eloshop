<div class="w-full">
  <section class="relative mb-16 overflow-hidden rounded-3xl bg-gradient-to-br from-brand-700 via-brand-500 to-brand-300">
    <div class="pointer-events-none absolute -right-16 -top-24 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 left-1/3 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>

    <div class="relative flex flex-col items-start gap-6 px-8 py-20 md:px-16 md:py-28">
      <span class="rounded-full bg-white/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-white">Feito à mão</span>
      <h1 class="max-w-2xl text-5xl font-black leading-[1.05] text-white md:text-7xl">
        Peças com história, feitas à mão
      </h1>
      <p class="max-w-md text-lg text-white/90">
        Cada produto é feito à mão, em pequenas tiragens ou sob encomenda. Conheça o processo antes de comprar.
      </p>
      <%= link_to "Ver produtos", products_path, class: "rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 transition hover:bg-brand-50" %>
    </div>
  </section>

  <h2 class="mb-8 text-2xl font-bold text-ink">Produtos</h2>

  <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
    <% @products.each do |product| %>
      <%= render "product_card", product: product %>
    <% end %>
  </div>

  <% if @products.none? %>
    <p class="text-ink-muted">Nenhum produto disponível no momento.</p>
  <% end %>

  <div class="mt-12 flex justify-center gap-3">
    <% if @page > 1 %>
      <%= link_to "Anterior", products_path(page: @page - 1), class: "rounded-full border border-gray-300 px-4 py-2 text-sm font-medium hover:border-brand-500 hover:text-brand-600" %>
    <% end %>

    <% if @page < @total_pages %>
      <%= link_to "Próxima", products_path(page: @page + 1), class: "rounded-full border border-gray-300 px-4 py-2 text-sm font-medium hover:border-brand-500 hover:text-brand-600" %>
    <% end %>
  </div>
</div>
