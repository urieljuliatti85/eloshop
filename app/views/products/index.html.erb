<%
  index_title = if @category
    "#{@category.breadcrumb_name} | EloShop"
  elsif params[:q].present?
    "Busca por \"#{params[:q]}\" | EloShop"
  else
    "Loja | EloShop — Artesanato e produtos feitos à mão"
  end
  index_description = @category ? "Produtos artesanais da categoria #{@category.breadcrumb_name} na EloShop." : SeoHelper::DEFAULT_DESCRIPTION

  heading = @category&.name || (params[:q].present? ? "Busca por \"#{params[:q]}\"" : "Loja")
  first_result = @total_count.zero? ? 0 : (@page - 1) * @per_page + 1
  last_result = [ @page * @per_page, @total_count ].min
%>
<% content_for :title, index_title %>
<% content_for :meta_description, index_description %>
<% content_for :canonical_url, products_url(category: @category&.slug) %>

<div class="w-full">
  <%# As faixas de topo e de destaques sangram até a borda da janela; o <main>
      da aplicação é um container centralizado, daí a margem negativa. %>
  <section class="-mt-12 mx-[calc(50%-50vw)] bg-sand-100">
    <div class="container mx-auto px-5 py-16 text-center md:py-20">
      <h1 class="text-4xl font-bold text-ink md:text-5xl"><%= heading %></h1>

      <nav aria-label="Você está aqui" class="mt-3 text-sm text-ink-muted">
        <%= link_to "Início", root_path, class: "font-medium text-ink hover:text-brand-600" %>
        <span class="mx-2" aria-hidden="true">&rsaquo;</span>
        <% if @category %>
          <%= link_to "Loja", products_path, class: "font-medium text-ink hover:text-brand-600" %>
          <span class="mx-2" aria-hidden="true">&rsaquo;</span>
          <span><%= @category.breadcrumb_name %></span>
        <% else %>
          <span><%= heading %></span>
        <% end %>
      </nav>
    </div>
  </section>

  <section class="mx-[calc(50%-50vw)] bg-sand-50">
    <div class="container mx-auto px-5 py-5">
      <div class="relative flex flex-wrap items-center gap-x-8 gap-y-4">
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center gap-2 text-base font-medium text-ink marker:content-['']">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 7h10M18 7h2M4 17h2M10 17h10" stroke-linecap="round" />
              <circle cx="16" cy="7" r="2" /><circle cx="8" cy="17" r="2" />
            </svg>
            Filtro
            <span class="text-ink-muted transition group-open:rotate-180" aria-hidden="true">&#9662;</span>
          </summary>

          <div class="absolute left-0 right-0 top-full z-20 mt-4 border border-gray-200 bg-white p-6 shadow-lg">
            <%= form_with url: products_path, method: :get, class: "flex flex-wrap items-end gap-4" do |form| %>
              <%# id: nil para não colidir com os selects "Ordenar por"/"Mostrar" da barra. %>
              <%= form.hidden_field :sort, value: @sort, id: nil %>
              <%= form.hidden_field :per_page, value: @per_page, id: nil %>

              <div>
                <%= form.label :q, "Buscar", class: "block text-sm font-medium text-ink" %>
                <%= form.search_field :q, value: params[:q], placeholder: "Nome ou descrição", class: "mt-1 border border-gray-300 px-3 py-2" %>
              </div>
              <div>
                <%= form.label :availability, "Disponibilidade", class: "block text-sm font-medium text-ink" %>
                <%= form.select :availability, options_for_select([ [ "Todas", "" ], [ "Estoque padrão", "standard" ], [ "Peça única", "one_of_a_kind" ], [ "Sob encomenda", "made_to_order" ] ], params[:availability]), {}, class: "mt-1 border border-gray-300 px-3 py-2" %>
              </div>
              <div>
                <%= form.label :material, "Material", class: "block text-sm font-medium text-ink" %>
                <%= form.select :material, options_for_select([ [ "Todos", "" ] ] + @materials.map { |material| [ material.name, material.slug ] }, params[:material]), {}, class: "mt-1 border border-gray-300 px-3 py-2" %>
              </div>
              <div>
                <%= form.label :technique, "Técnica", class: "block text-sm font-medium text-ink" %>
                <%= form.select :technique, options_for_select([ [ "Todas", "" ] ] + @techniques.map { |technique| [ technique.name, technique.slug ] }, params[:technique]), {}, class: "mt-1 border border-gray-300 px-3 py-2" %>
              </div>
              <%= form.submit "Filtrar", class: "bg-ink px-6 py-2.5 text-sm font-semibold text-white cursor-pointer hover:bg-brand-600" %>
            <% end %>

            <div class="mt-6 border-t border-gray-100 pt-5">
              <p class="mb-3 text-sm font-medium text-ink">Categorias</p>
              <div class="flex flex-wrap gap-2">
                <%= link_to "Todos", products_path, class: "rounded-full border border-gray-300 px-4 py-1.5 text-sm text-ink hover:border-brand-500 hover:text-brand-600" %>
                <% @categories.each do |category| %>
                  <%= link_to category.breadcrumb_name, products_path(request.query_parameters.merge(category: category.slug, page: nil)), class: "rounded-full border border-gray-300 px-4 py-1.5 text-sm text-ink hover:border-brand-500 hover:text-brand-600" %>
                <% end %>
              </div>

              <% if @tags.any? %>
                <p class="mb-3 mt-5 text-sm font-medium text-ink">Tags</p>
                <div class="flex flex-wrap gap-2">
                  <% @tags.each do |tag| %>
                    <%= link_to "##{tag.name}", products_path(request.query_parameters.merge(tag: tag.slug, page: nil)), class: "rounded-full border border-gray-300 px-4 py-1.5 text-sm text-ink hover:border-brand-500 hover:text-brand-600" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </details>

        <div class="hidden h-8 w-px bg-gray-300 sm:block"></div>

        <p class="text-base text-ink">
          <% if @total_count.zero? %>
            Nenhum produto encontrado
          <% else %>
            Mostrando <%= first_result %>–<%= last_result %> de <%= @total_count %> <%= "resultado".pluralize(@total_count) %>
          <% end %>
        </p>

        <%= form_with url: products_path, method: :get, data: { controller: "auto-submit" },
              class: "flex flex-wrap items-center gap-x-4 gap-y-3 sm:ml-auto" do |form| %>
          <% request.query_parameters.except("sort", "per_page", "page").each do |name, value| %>
            <%= hidden_field_tag name, value %>
          <% end %>

          <div class="flex items-center gap-2">
            <%= form.label :per_page, "Mostrar", class: "text-base text-ink" %>
            <%= form.select :per_page,
                  options_for_select(ProductsController::PER_PAGE_OPTIONS, @per_page),
                  {},
                  class: "bg-white px-4 py-2 text-ink-muted", data: { action: "change->auto-submit#submit" } %>
          </div>

          <div class="flex items-center gap-2">
            <%= form.label :sort, "Ordenar por", class: "text-base text-ink" %>
            <%= form.select :sort,
                  options_for_select(ProductsController::SORT_OPTIONS.map { |value, config| [ config[:label], value ] }, @sort),
                  {},
                  class: "bg-white px-4 py-2 text-ink-muted", data: { action: "change->auto-submit#submit" } %>
          </div>

          <%# Fallback sem JavaScript (e para teclado): o Stimulus envia o
              formulário na mudança do select, este botão só aparece no foco. %>
          <%= form.submit "Aplicar", class: "sr-only focus:not-sr-only focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </section>

  <div class="py-14">
    <% if @products.any? %>
      <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-8 sm:gap-y-10 lg:grid-cols-3 xl:grid-cols-4">
        <% @products.each do |product| %>
          <%= render "product_card", product: product %>
        <% end %>
      </div>
    <% else %>
      <p class="py-10 text-center text-ink-muted">Nenhum produto disponível no momento.</p>
    <% end %>

    <% if @total_pages > 1 %>
      <nav aria-label="Paginação" class="mt-16 flex flex-wrap items-center justify-center gap-4">
        <% if @page > 1 %>
          <%= link_to "Anterior", products_path(request.query_parameters.merge(page: @page - 1)),
                class: "bg-sand-100 px-6 py-4 text-base text-ink transition hover:bg-brand-500 hover:text-white" %>
        <% end %>

        <% ([ 1, @page - 1 ].max..[ @page + 1, @total_pages ].min).each do |number| %>
          <% if number == @page %>
            <span aria-current="page" class="bg-brand-500 px-6 py-4 text-base font-medium text-white"><%= number %></span>
          <% else %>
            <%= link_to number, products_path(request.query_parameters.merge(page: number)),
                  class: "bg-sand-100 px-6 py-4 text-base text-ink transition hover:bg-brand-500 hover:text-white" %>
          <% end %>
        <% end %>

        <% if @page < @total_pages %>
          <%= link_to "Próxima", products_path(request.query_parameters.merge(page: @page + 1)),
                class: "bg-sand-100 px-6 py-4 text-base text-ink transition hover:bg-brand-500 hover:text-white" %>
        <% end %>
      </nav>
    <% end %>
  </div>

  <section class="-mb-12 mx-[calc(50%-50vw)] bg-sand-50">
    <div class="container mx-auto grid grid-cols-1 gap-8 px-5 py-14 sm:grid-cols-2 xl:grid-cols-4">
      <div class="flex items-start gap-4">
        <svg class="h-9 w-9 flex-none text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 20h12M9 20v-3M15 20v-3M5 4h14v4a7 7 0 0 1-14 0V4Z" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M19 5h2v2a3 3 0 0 1-3 3M5 5H3v2a3 3 0 0 0 3 3" stroke-linecap="round" />
        </svg>
        <div>
          <p class="text-xl font-semibold text-ink">Feito à mão</p>
          <p class="mt-1 text-ink-muted">peças autorais de artesãos</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <svg class="h-9 w-9 flex-none text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 3 4 6v6c0 4 3.4 7.4 8 9 4.6-1.6 8-5 8-9V6l-8-3Z" stroke-linejoin="round" />
          <path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div>
          <p class="text-xl font-semibold text-ink">Peças únicas</p>
          <p class="mt-1 text-ink-muted">pequenas tiragens e sob encomenda</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <svg class="h-9 w-9 flex-none text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 8h16v11H4zM4 8l2-4h12l2 4M12 4v4M9 12h6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div>
          <p class="text-xl font-semibold text-ink">Processo transparente</p>
          <p class="mt-1 text-ink-muted">materiais e técnicas descritos</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <svg class="h-9 w-9 flex-none text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 13a8 8 0 0 1 16 0M4 13v3a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 2Zm16 0v3a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Z" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M18 18v1a3 3 0 0 1-3 3h-2" stroke-linecap="round" />
        </svg>
        <div>
          <p class="text-xl font-semibold text-ink">Atendimento</p>
          <p class="mt-1 text-ink-muted"><%= link_to "fale com a gente", new_contact_path, class: "underline underline-offset-4 hover:text-brand-600" %></p>
        </div>
      </div>
    </div>
  </section>
</div>
