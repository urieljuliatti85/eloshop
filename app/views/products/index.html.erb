<%
  index_title = if @category
    "#{@category_tree.breadcrumb_name(@category)} | EloShop"
  elsif params[:q].present?
    "Busca por \"#{params[:q]}\" | EloShop"
  else
    "Loja | EloShop — Artesanato e produtos feitos à mão"
  end
  index_description = @category ? "Produtos artesanais da categoria #{@category_tree.breadcrumb_name(@category)} na EloShop." : SeoHelper::DEFAULT_DESCRIPTION

  heading = @category&.name || (params[:q].present? ? "Busca por \"#{params[:q]}\"" : "Loja")
  first_result = @total_count.zero? ? 0 : (@page - 1) * @per_page + 1
  last_result = [ @page * @per_page, @total_count ].min

  # "A partir de" resume a faixa de preço da página como a referência resume a
  # do produto: o menor preço entre os que estão à vista.
  cheapest = @products.map(&:starting_price_cents).min

  # Um filtro além da categoria significa que o painel precisa nascer aberto —
  # senão o cliente não vê por que a vitrine está recortada.
  advanced_filters = params.values_at(:q, :availability, :material, :technique).any?(&:present?)
%>
<% content_for :title, index_title %>
<% content_for :meta_description, index_description %>
<% content_for :canonical_url, products_url(category: @category&.slug) %>

<div class="w-full">
  <nav aria-label="Você está aqui" class="text-sm text-ink-muted">
    <%= link_to "Início", root_path, class: "hover:text-ink" %>
    <span class="mx-2" aria-hidden="true">/</span>
    <% if @category %>
      <%= link_to "Loja", products_path, class: "hover:text-ink" %>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-ink"><%= @category_tree.breadcrumb_name(@category) %></span>
    <% else %>
      <span class="text-ink"><%= heading %></span>
    <% end %>
  </nav>

  <%# Título grande e alinhado à esquerda, com o preço de entrada logo abaixo. %>
  <header class="mt-6">
    <h1 class="text-4xl font-bold tracking-tight text-ink md:text-6xl"><%= heading %></h1>
    <% if cheapest %>
      <p class="mt-3 text-lg text-ink-muted">
        A partir de <%= number_to_currency(cheapest / 100.0) %>
      </p>
    <% end %>
  </header>

  <%# As categorias deixam de morar dentro do dropdown: viram uma faixa sempre
      visível, que é como o cliente navega o catálogo. As demais dimensões
      (busca, material, técnica, disponibilidade) seguem recolhidas. %>
  <nav aria-label="Categorias" class="mt-10 flex gap-2 overflow-x-auto pb-1">
    <%= link_to "Todos", products_path,
          class: "flex-none rounded-full border px-5 py-2 text-sm transition #{@category ? 'border-gray-200 text-ink hover:border-ink' : 'border-ink bg-ink text-white'}" %>
    <%# A árvore vem ordenada por nome simples; como a pill mostra o caminho
        inteiro, ordenar pelo texto exibido é o que mantém pai e filhas juntos
        ("Casa", "Casa > Cozinha", "Casa > Decoração"). %>
    <% @categories.sort_by { |category| @category_tree.breadcrumb_name(category) }.each do |category| %>
      <%= link_to @category_tree.breadcrumb_name(category),
            products_path(request.query_parameters.merge(category: category.slug, page: nil)),
            class: "flex-none rounded-full border px-5 py-2 text-sm transition #{@category == category ? 'border-ink bg-ink text-white' : 'border-gray-200 text-ink hover:border-ink'}" %>
    <% end %>
  </nav>

  <% if @tags.any? %>
    <nav aria-label="Tags" class="mt-3 flex gap-2 overflow-x-auto pb-1">
      <% @tags.each do |tag| %>
        <%= link_to "##{tag.name}",
              products_path(request.query_parameters.merge(tag: tag.slug, page: nil)),
              class: "flex-none rounded-full px-4 py-1.5 text-sm transition #{params[:tag] == tag.slug ? 'bg-brand-50 text-brand-600' : 'text-ink-muted hover:text-ink'}" %>
      <% end %>
    </nav>
  <% end %>

  <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4 border-y border-gray-200 py-4">
    <p class="text-sm text-ink-muted">
      <% if @total_count.zero? %>
        Nenhum produto encontrado
      <% else %>
        Mostrando <%= first_result %>–<%= last_result %> de <%= @total_count %> <%= "resultado".pluralize(@total_count) %>
      <% end %>
    </p>

    <%= form_with url: products_path, method: :get, data: { controller: "auto-submit" },
          class: "flex flex-wrap items-center gap-x-5 gap-y-3 sm:ml-auto" do |form| %>
      <% request.query_parameters.except("sort", "per_page", "page").each do |name, value| %>
        <%= hidden_field_tag name, value %>
      <% end %>

      <div class="flex items-center gap-2">
        <%= form.label :per_page, "Mostrar", class: "text-sm text-ink-muted" %>
        <%= form.select :per_page,
              options_for_select(ProductsController::PER_PAGE_OPTIONS, @per_page),
              {},
              class: "border-0 bg-transparent py-1 text-sm font-medium text-ink focus:outline-none", data: { action: "change->auto-submit#submit" } %>
      </div>

      <div class="flex items-center gap-2">
        <%= form.label :sort, "Ordenar por", class: "text-sm text-ink-muted" %>
        <%= form.select :sort,
              options_for_select(ProductsController::SORT_OPTIONS.map { |value, config| [ config[:label], value ] }, @sort),
              {},
              class: "border-0 bg-transparent py-1 text-sm font-medium text-ink focus:outline-none", data: { action: "change->auto-submit#submit" } %>
      </div>

      <%# Fallback sem JavaScript (e para teclado): o Stimulus envia o
          formulário na mudança do select, este botão só aparece no foco. %>
      <%= form.submit "Aplicar", class: "sr-only focus:not-sr-only focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white cursor-pointer" %>
    <% end %>
  </div>

  <details class="group border-b border-gray-200" <%= "open" if advanced_filters %>>
    <summary class="flex cursor-pointer list-none items-center gap-2 py-4 text-sm font-medium text-ink marker:content-['']">
      Filtros
      <span class="text-ink-muted transition group-open:rotate-180" aria-hidden="true">&#9662;</span>
    </summary>

    <%= form_with url: products_path, method: :get, class: "flex flex-wrap items-end gap-5 pb-6" do |form| %>
      <%# id: nil para não colidir com os selects "Ordenar por"/"Mostrar" da barra. %>
      <%= form.hidden_field :sort, value: @sort, id: nil %>
      <%= form.hidden_field :per_page, value: @per_page, id: nil %>
      <%= form.hidden_field :category, value: @category&.slug, id: nil %>

      <div>
        <%= form.label :q, "Buscar", class: "block text-sm text-ink-muted" %>
        <%= form.search_field :q, value: params[:q], placeholder: "Nome ou descrição",
              class: "mt-1 rounded-xl border border-gray-200 px-4 py-2.5 text-sm focus:border-ink focus:outline-none" %>
      </div>
      <div>
        <%= form.label :availability, "Disponibilidade", class: "block text-sm text-ink-muted" %>
        <%= form.select :availability, options_for_select([ [ "Todas", "" ], [ "Estoque padrão", "standard" ], [ "Peça única", "one_of_a_kind" ], [ "Sob encomenda", "made_to_order" ] ], params[:availability]), {}, class: "mt-1 rounded-xl border border-gray-200 px-4 py-2.5 text-sm focus:border-ink focus:outline-none" %>
      </div>
      <div>
        <%= form.label :material, "Material", class: "block text-sm text-ink-muted" %>
        <%= form.select :material, options_for_select([ [ "Todos", "" ] ] + @materials.map { |material| [ material.name, material.slug ] }, params[:material]), {}, class: "mt-1 rounded-xl border border-gray-200 px-4 py-2.5 text-sm focus:border-ink focus:outline-none" %>
      </div>
      <div>
        <%= form.label :technique, "Técnica", class: "block text-sm text-ink-muted" %>
        <%= form.select :technique, options_for_select([ [ "Todas", "" ] ] + @techniques.map { |technique| [ technique.name, technique.slug ] }, params[:technique]), {}, class: "mt-1 rounded-xl border border-gray-200 px-4 py-2.5 text-sm focus:border-ink focus:outline-none" %>
      </div>

      <%= form.submit "Filtrar", class: "cursor-pointer rounded-full bg-ink px-7 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600" %>
      <% if advanced_filters %>
        <%= link_to "Limpar", products_path(category: @category&.slug), class: "py-2.5 text-sm text-ink-muted underline underline-offset-4 hover:text-ink" %>
      <% end %>
    <% end %>
  </details>

  <div class="py-14">
    <% if @products.any? %>
      <div class="grid grid-cols-2 gap-x-6 gap-y-14 lg:grid-cols-3 xl:grid-cols-4">
        <% @products.each do |product| %>
          <%= render "product_card", product: product %>
        <% end %>
      </div>
    <% else %>
      <p class="py-10 text-center text-ink-muted">Nenhum produto disponível no momento.</p>
    <% end %>

    <% if @total_pages > 1 %>
      <nav aria-label="Paginação" class="mt-20 flex flex-wrap items-center justify-center gap-2">
        <% if @page > 1 %>
          <%= link_to "Anterior", products_path(request.query_parameters.merge(page: @page - 1)),
                class: "rounded-full px-5 py-2.5 text-sm text-ink-muted transition hover:text-ink" %>
        <% end %>

        <% ([ 1, @page - 1 ].max..[ @page + 1, @total_pages ].min).each do |number| %>
          <% if number == @page %>
            <span aria-current="page" class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-white"><%= number %></span>
          <% else %>
            <%= link_to number, products_path(request.query_parameters.merge(page: number)),
                  class: "rounded-full px-5 py-2.5 text-sm text-ink-muted transition hover:text-ink" %>
          <% end %>
        <% end %>

        <% if @page < @total_pages %>
          <%= link_to "Próxima", products_path(request.query_parameters.merge(page: @page + 1)),
                class: "rounded-full px-5 py-2.5 text-sm text-ink-muted transition hover:text-ink" %>
        <% end %>
      </nav>
    <% end %>
  </div>

  <%# Os selos perdem a faixa creme: sobram a divisória de topo e o espaço,
      como nos blocos da referência. Sem fundo cinza no grid — ele vazaria
      pelo padding do container, que aqui sangra até a borda da janela. %>
  <section class="-mb-12 mx-[calc(50%-50vw)] border-t border-gray-200">
    <div class="container mx-auto grid grid-cols-1 gap-x-8 gap-y-10 px-5 py-14 sm:grid-cols-2 xl:grid-cols-4">
      <% [
           [ "Feito à mão", "peças autorais de artesãos" ],
           [ "Peças únicas", "pequenas tiragens e sob encomenda" ],
           [ "Processo transparente", "materiais e técnicas descritos" ],
           [ "Atendimento", nil ]
         ].each do |title, subtitle| %>
        <div>
          <p class="text-base font-semibold text-ink"><%= title %></p>
          <p class="mt-1 text-sm text-ink-muted">
            <% if subtitle %>
              <%= subtitle %>
            <% else %>
              <%= link_to "fale com a gente", new_contact_path, class: "underline underline-offset-4 hover:text-brand-600" %>
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  </section>
</div>
