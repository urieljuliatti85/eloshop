<%= link_to product_path(product), class: "group block" do %>
  <div class="relative aspect-square overflow-hidden rounded bg-brand-100">
    <% if product.main_image.attached? %>
      <%= image_tag product.main_image, class: "h-full w-full object-cover transition group-hover:scale-105", alt: product.name %>
    <% end %>

    <% if product.availability_type_one_of_a_kind? %>
      <span class="absolute left-3 top-3 rounded-full bg-brand-500 px-2 py-1 text-xs font-semibold text-white">Peça única</span>
    <% elsif product.availability_type_made_to_order? %>
      <span class="absolute left-3 top-3 rounded-full bg-ink px-2 py-1 text-xs font-semibold text-white">Sob encomenda</span>
    <% end %>

    <% unless product.available_for_purchase? %>
      <div class="absolute inset-0 flex items-center justify-center bg-white/70">
        <span class="rounded-full bg-ink px-3 py-1 text-xs font-semibold text-white">Indisponível</span>
      </div>
    <% end %>
  </div>

  <p class="mt-3 font-semibold text-ink"><%= product.name %></p>
  <p class="text-brand-600 font-medium"><%= number_to_currency(product.price_cents / 100.0, unit: product.currency) %></p>
<% end %>
