<%# Faixa de categorias da vitrine: "Todos" e uma entrada por categoria de topo.
    Quem tem subcategorias abre um dropdown com "Ver tudo" e as filhas; quem não
    tem é um link direto. Era uma pílula por categoria, com rolagem lateral, e
    deixou de caber com a árvore completa de artesanato.

    A faixa quebra em várias linhas em vez de rolar: um container com
    overflow-x cortaria o painel do dropdown. %>
<%
  pill = "flex-none rounded-full border px-5 py-2 text-sm transition"
  idle = "border-gray-200 text-ink hover:border-ink"
  current = "border-ink bg-ink text-white"
  menu_params = ->(category) { products_path(request.query_parameters.merge(category: category.slug, page: nil)) }
%>
<nav aria-label="Categorias" class="relative flex flex-wrap gap-2">
  <%= link_to "Todos", products_path, class: "#{pill} #{@category ? idle : current}" %>

  <%# Todas as categorias num só menu, com as filhas abrindo à direita. %>
  <%= render "category_browser" %>

  <% @category_tree.visible_roots.sort_by(&:name).each do |root| %>
    <% children = @category_tree.visible_children(root).sort_by(&:name)
       active = @category && @category_tree.self_and_descendant_ids(root).include?(@category.id) %>

    <% if children.empty? %>
      <%= link_to root.name, menu_params.call(root), class: "#{pill} #{active ? current : idle}", aria: { current: ("page" if active) } %>
    <% else %>
      <%# Celular: o wrapper some (`contents`) e o painel vira um item da própria
          faixa, em linha inteira logo depois da pílula — abre colado nela e
          empurra as seguintes para baixo, sem estourar a borda da tela.
          A partir de `sm` o painel flutua sob a pílula. %>
      <div class="contents sm:relative sm:block" data-controller="account-menu"
           data-action="click@window->account-menu#closeOnOutsideClick keydown.esc@window->account-menu#closeOnEscape turbo:load@document->account-menu#closeOnNavigation">
        <button type="button" class="<%= pill %> inline-flex cursor-pointer items-center gap-2 <%= active ? current : idle %>"
                aria-expanded="false" aria-haspopup="true"
                data-account-menu-target="button" data-action="account-menu#toggle">
          <%= root.name %>
          <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="max-h-80 w-full basis-full overflow-y-auto rounded-2xl border border-gray-200 bg-white p-2 shadow-sm sm:absolute sm:left-0 sm:top-full sm:z-20 sm:mt-2 sm:w-72 sm:basis-auto sm:shadow-lg"
             data-account-menu-target="panel" hidden>
          <%= link_to "Ver tudo em #{root.name}", menu_params.call(root),
                class: "flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold #{@category == root ? 'bg-brand-50 text-brand-600' : 'text-ink hover:bg-gray-50'}",
                aria: { current: ("page" if @category == root) } %>
          <% children.each do |child| %>
            <%= link_to child.name, menu_params.call(child),
                  class: "flex min-h-11 items-center rounded-xl px-3 text-sm #{@category == child ? 'bg-brand-50 font-semibold text-brand-600' : 'text-ink hover:bg-gray-50'}",
                  aria: { current: ("page" if @category == child) } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</nav>
