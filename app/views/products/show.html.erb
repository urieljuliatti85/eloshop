<div class="w-full">
  <nav class="mb-8 text-sm text-ink-muted">
    <%= link_to "Início", root_path, class: "hover:text-brand-600" %>
    <span class="mx-2">/</span>
    <%= link_to "Loja", products_path, class: "hover:text-brand-600" %>
    <span class="mx-2">/</span>
    <span class="text-ink"><%= @product.name %></span>
  </nav>

  <div class="grid grid-cols-1 gap-16 md:grid-cols-2">
    <%= render "gallery", product: @product %>

    <div>
      <% if @product.availability_type_one_of_a_kind? %>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Peça única</p>
      <% elsif @product.availability_type_made_to_order? %>
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Sob encomenda</p>
      <% end %>

      <h1 class="mt-1 text-4xl font-bold text-ink"><%= @product.name %></h1>

      <% unless @product.has_variants? %>
        <p class="mt-3 text-2xl text-brand-600"><%= number_to_currency(@product.price_cents / 100.0, unit: @product.currency) %></p>
      <% end %>

      <% if @product.availability_type_made_to_order? %>
        <p class="mt-2 text-sm text-ink-muted">Produção em <%= @product.production_time_range %> após a compra.</p>
      <% end %>

      <p class="mt-6 leading-relaxed text-ink-muted"><%= @product.description %></p>

      <div class="mt-8 border-t border-gray-200 pt-8">
        <% if @product.available_for_purchase? %>
          <p class="mb-4 text-sm font-medium text-green-700">Disponível</p>

          <% if @product.has_variants? %>
            <%= render "variant_selector", product: @product %>
          <% else %>
            <%= form_with url: cart_items_path, method: :post, class: "flex flex-col gap-6" do |form| %>
              <%= form.hidden_field :product_id, value: @product.id %>

              <%= render "personalization_fields", product: @product %>

              <div class="flex items-center gap-4">
                <div class="flex items-center rounded-full border border-gray-300">
                  <% if @product.availability_type_made_to_order? %>
                    <%= form.number_field :quantity, value: 1, min: 1, class: "w-16 rounded-full px-3 py-2 text-center focus:outline-none" %>
                  <% else %>
                    <%= form.number_field :quantity, value: 1, min: 1, max: @product.stock_quantity, class: "w-16 rounded-full px-3 py-2 text-center focus:outline-none" %>
                  <% end %>
                </div>

                <%= form.submit "Adicionar ao carrinho", class: "flex-1 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-600 cursor-pointer" %>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <p class="text-sm font-medium text-red-700">Indisponível</p>
        <% end %>
      </div>

      <div class="mt-8 divide-y divide-gray-200 border-t border-gray-200">
        <details class="group py-4" open>
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-ink">
            Detalhes do produto
            <span class="text-ink-muted transition group-open:rotate-45">+</span>
          </summary>

          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex gap-2">
              <dt class="w-24 text-ink-muted">SKU</dt>
              <dd class="text-ink"><%= @product.sku %></dd>
            </div>
          </dl>
        </details>

        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-ink">
            Envio
            <span class="text-ink-muted transition group-open:rotate-45">+</span>
          </summary>

          <div class="mt-3 space-y-1 text-sm text-ink-muted">
            <p>Frete calculado no checkout.</p>
            <% if @product.availability_type_made_to_order? %>
              <p>Produção: <%= @product.production_time_range %> antes do envio.</p>
            <% end %>
          </div>
        </details>
      </div>
    </div>
  </div>

  <% if @related_products.any? %>
    <div class="mt-20">
      <h2 class="mb-8 text-2xl font-bold text-ink">Você também pode gostar</h2>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
        <% @related_products.each do |related_product| %>
          <%= render "product_card", product: related_product %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
