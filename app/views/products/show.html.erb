<div class="w-full max-w-xl">
  <% if @product.main_image.attached? %>
    <%= image_tag @product.main_image, class: "mb-4 max-w-md" %>
  <% end %>

  <h1 class="text-2xl font-bold mb-2"><%= @product.name %></h1>
  <p class="text-xl mb-4"><%= number_to_currency(@product.price_cents / 100.0, unit: @product.currency) %></p>

  <% if @product.availability_type_one_of_a_kind? %>
    <p class="text-sm text-gray-600 mb-2">Peça única</p>
  <% elsif @product.availability_type_made_to_order? %>
    <p class="text-sm text-gray-600 mb-2">Feito sob encomenda — prazo de produção: <%= @product.production_time_range %></p>
  <% end %>

  <% if @product.available_for_purchase? %>
    <p class="text-green-700 mb-4">Disponível</p>

    <%= form_with url: cart_items_path, method: :post, class: "flex items-end gap-2 mb-6" do |form| %>
      <%= form.hidden_field :product_id, value: @product.id %>
      <div>
        <%= form.label :quantity, "Quantidade" %>
        <% if @product.availability_type_made_to_order? %>
          <%= form.number_field :quantity, value: 1, min: 1, class: "border rounded w-20 px-1" %>
        <% else %>
          <%= form.number_field :quantity, value: 1, min: 1, max: @product.stock_quantity, class: "border rounded w-20 px-1" %>
        <% end %>
      </div>
      <%= form.submit "Adicionar ao carrinho", class: "bg-black text-white px-4 py-2 rounded" %>
    <% end %>
  <% else %>
    <p class="text-red-700 mb-4">Indisponível</p>
  <% end %>

  <p><%= @product.description %></p>
</div>
