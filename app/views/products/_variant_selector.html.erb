<%
  active_variants = product.product_variants.select(&:active?)
  variants_json = active_variants.map { |variant|
    {
      id: variant.id,
      size: variant.size,
      color: variant.color,
      material: variant.material,
      stockQuantity: variant.stock_quantity,
      formattedPrice: format_price(variant.price_cents)
    }
  }
  sizes = active_variants.filter_map(&:size).uniq
  colors = active_variants.filter_map(&:color).uniq
  materials = active_variants.filter_map(&:material).uniq
%>

<div data-controller="variant-selector" data-variant-selector-variants-value="<%= variants_json.to_json %>">
  <p id="variant_price" class="mt-2 text-2xl text-brand-600" data-variant-selector-target="price">
    <%= format_price(product.starting_price_cents) %>
  </p>

  <%= form_with url: cart_items_path, method: :post, class: "mt-6 flex flex-col gap-6" do |form| %>
    <%= form.hidden_field :product_id, value: product.id %>
    <%= form.hidden_field :product_variant_id, data: { "variant-selector-target": "variantId" } %>

    <% if sizes.any? %>
      <fieldset>
        <legend class="mb-2 text-sm font-medium text-ink">Tamanho</legend>
        <div class="flex flex-wrap gap-2">
          <% sizes.each_with_index do |size, index| %>
            <label class="cursor-pointer">
              <input type="radio" name="variant_size" value="<%= size %>" <%= "checked" if index.zero? %>
                     data-variant-selector-target="size" data-action="change->variant-selector#update" class="peer sr-only">
              <span class="flex h-11 min-w-11 items-center justify-center rounded-full border border-gray-300 px-4 text-sm font-medium text-ink peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2">
                <%= size %>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <% if colors.any? %>
      <fieldset>
        <legend class="mb-2 text-sm font-medium text-ink">Cor</legend>
        <div class="flex flex-wrap gap-2">
          <% colors.each_with_index do |color, index| %>
            <label class="cursor-pointer">
              <input type="radio" name="variant_color" value="<%= color %>" <%= "checked" if index.zero? %>
                     data-variant-selector-target="color" data-action="change->variant-selector#update" class="peer sr-only">
              <span class="flex h-11 items-center justify-center rounded-full border border-gray-300 px-4 text-sm font-medium text-ink peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2">
                <%= color %>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <% if materials.any? %>
      <fieldset>
        <legend class="mb-2 text-sm font-medium text-ink">Material</legend>
        <div class="flex flex-wrap gap-2">
          <% materials.each_with_index do |material, index| %>
            <label class="cursor-pointer">
              <input type="radio" name="variant_material" value="<%= material %>" <%= "checked" if index.zero? %>
                     data-variant-selector-target="material" data-action="change->variant-selector#update" class="peer sr-only">
              <span class="flex h-11 items-center justify-center rounded-full border border-gray-300 px-4 text-sm font-medium text-ink peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2">
                <%= material %>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <%= render "personalization_fields", product: product %>

    <% if sales_open? %>
      <div class="flex items-center gap-4">
        <div class="flex items-center rounded-full border border-gray-300">
          <%= form.number_field :quantity, value: 1, min: 1, aria: { label: "Quantidade" }, class: "min-h-11 w-16 rounded-full px-3 py-2 text-center focus:outline-2 focus:outline-offset-2 focus:outline-brand-600" %>
        </div>

        <%= form.submit "Adicionar ao carrinho", data: { "variant-selector-target": "submit" },
              class: "flex-1 rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700 cursor-pointer disabled:cursor-not-allowed disabled:opacity-50" %>
      </div>
    <% else %>
      <%= render "products/sales_soon" %>
    <% end %>

    <p class="text-sm text-red-700" data-variant-selector-target="stockNotice"></p>
  <% end %>
</div>
