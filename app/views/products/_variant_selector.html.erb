<%
  active_variants = product.product_variants.select(&:active?)
  variants_json = active_variants.map { |variant|
    {
      id: variant.id,
      size: variant.size,
      color: variant.color,
      material: variant.material,
      stockQuantity: variant.stock_quantity,
      formattedPrice: number_to_currency(variant.price_cents / 100.0, unit: product.currency)
    }
  }
  sizes = active_variants.filter_map(&:size).uniq
  colors = active_variants.filter_map(&:color).uniq
  materials = active_variants.filter_map(&:material).uniq
%>

<div data-controller="variant-selector" data-variant-selector-variants-value="<%= variants_json.to_json %>">
  <p id="variant_price" class="mt-2 text-2xl text-brand-600" data-variant-selector-target="price">
    <%= number_to_currency(product.starting_price_cents / 100.0, unit: product.currency) %>
  </p>

  <%= form_with url: cart_items_path, method: :post, class: "mt-4 flex flex-col gap-4" do |form| %>
    <%= form.hidden_field :product_id, value: product.id %>
    <%= form.hidden_field :product_variant_id, data: { "variant-selector-target": "variantId" } %>

    <% if sizes.any? %>
      <div>
        <label for="variant_size" class="mb-1 block text-sm font-medium text-ink">Tamanho</label>
        <select id="variant_size" data-variant-selector-target="size" data-action="change->variant-selector#update" class="rounded-full border border-gray-300 px-4 py-2">
          <% sizes.each do |size| %>
            <option value="<%= size %>"><%= size %></option>
          <% end %>
        </select>
      </div>
    <% end %>

    <% if colors.any? %>
      <div>
        <label for="variant_color" class="mb-1 block text-sm font-medium text-ink">Cor</label>
        <select id="variant_color" data-variant-selector-target="color" data-action="change->variant-selector#update" class="rounded-full border border-gray-300 px-4 py-2">
          <% colors.each do |color| %>
            <option value="<%= color %>"><%= color %></option>
          <% end %>
        </select>
      </div>
    <% end %>

    <% if materials.any? %>
      <div>
        <label for="variant_material" class="mb-1 block text-sm font-medium text-ink">Material</label>
        <select id="variant_material" data-variant-selector-target="material" data-action="change->variant-selector#update" class="rounded-full border border-gray-300 px-4 py-2">
          <% materials.each do |material| %>
            <option value="<%= material %>"><%= material %></option>
          <% end %>
        </select>
      </div>
    <% end %>

    <%= render "personalization_fields", product: product %>

    <div class="flex items-center gap-4">
      <div class="flex items-center rounded-full border border-gray-300">
        <%= form.number_field :quantity, value: 1, min: 1, class: "w-16 rounded-full px-3 py-2 text-center focus:outline-none" %>
      </div>

      <%= form.submit "Adicionar ao carrinho", data: { "variant-selector-target": "submit" },
            class: "flex-1 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-600 cursor-pointer disabled:cursor-not-allowed disabled:opacity-50" %>
    </div>

    <p class="text-sm text-red-700" data-variant-selector-target="stockNotice"></p>
  <% end %>
</div>
