<%# Ícones SVG de categorias de insumo e técnicas; icon_type é persistido e
    classificado automaticamente pelo nome (Fase 26, UX do armarinho). %>
<% category = local_assigns[:category] || local_assigns[:material]
   icon_type = local_assigns[:icon_type] || category&.icon_type %>
<svg viewBox="0 0 48 48" class="<%= local_assigns[:classes] || 'size-9' %>" fill="none" aria-hidden="true">
  <% case icon_type %>
  <% when "yarn" %>
    <circle cx="15" cy="15" r="9" fill="#ef6153"/><circle cx="33" cy="15" r="9" fill="#f59e0b"/><circle cx="15" cy="33" r="9" fill="#16a085"/><circle cx="33" cy="33" r="9" fill="#6366f1"/>
    <path d="M10 16c2-4 8-4 10 0m8 0c2-4 8-4 10 0M10 34c2-4 8-4 10 0m8 0c2-4 8-4 10 0" stroke="white" stroke-width="2" stroke-linecap="round"/>
  <% when "fabric" %>
    <rect x="6" y="5" width="8" height="38" rx="3" fill="#ec4899"/><rect x="19" y="5" width="8" height="38" rx="3" fill="#8b5cf6"/><rect x="32" y="5" width="8" height="38" rx="3" fill="#06b6d4"/>
  <% when "ribbon" %>
    <rect x="7" y="8" width="34" height="11" rx="5.5" fill="#a855f7"/><circle cx="14" cy="13.5" r="2" fill="white"/><rect x="7" y="25" width="34" height="9" rx="4.5" fill="#ec4899"/><circle cx="14" cy="29.5" r="1.5" fill="white"/><path d="M10 40h28" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-dasharray="1 4"/>
  <% when "notions" %>
    <circle cx="13" cy="15" r="9" fill="#f59e0b"/><circle cx="10" cy="12" r="1.5" fill="white"/><circle cx="16" cy="12" r="1.5" fill="white"/><circle cx="10" cy="18" r="1.5" fill="white"/><circle cx="16" cy="18" r="1.5" fill="white"/><rect x="27" y="6" width="15" height="36" rx="3" stroke="#64748b" stroke-width="3"/><path d="M28 18h13M28 30h13" stroke="#64748b" stroke-width="2"/>
  <% when "wood" %>
    <rect x="7" y="5" width="34" height="38" rx="4" fill="#d6a05d"/><path d="M16 7v34m8-34v34m8-34v34M8 16h32M8 25h32M8 34h32" stroke="#8b5e34" stroke-width="2"/>
  <% when "clay" %>
    <path d="M24 5 42 16v16L24 43 6 32V16z" fill="#a855f7"/><path d="m6 16 18 11 18-11M24 27v16" stroke="white" stroke-width="2"/><circle cx="24" cy="16" r="4" fill="#fde68a"/>
  <% when "needlework" %>
    <path d="M10 8 35 33M8 10l4-4m21 30 6 6" stroke="#64748b" stroke-width="3" stroke-linecap="round"/><path d="M12 31c5-7 10 7 15 0s10 7 15 0" stroke="#ec4899" stroke-width="3" stroke-linecap="round"/><path d="M8 38h32" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="3 3"/>
  <% when "knotting" %>
    <path d="M8 9c10 0 10 10 0 10s-10 10 0 10 10 10 0 10m32-40c-10 0-10 10 0 10s10 10 0 10-10 10 0 10-10 10 0 10M15 7c10 0 8 34 18 34M33 7c-10 0-8 34-18 34" stroke="#8b5cf6" stroke-width="3" stroke-linecap="round"/>
  <% when "paint" %>
    <path d="M24 5a19 19 0 1 0 0 38h3a4 4 0 0 0 2-7c-2-2-1-5 2-5h4a8 8 0 0 0 8-8A18 18 0 0 0 24 5Z" fill="#fef3c7" stroke="#d97706" stroke-width="2"/><circle cx="15" cy="19" r="3" fill="#ef6153"/><circle cx="24" cy="13" r="3" fill="#8b5cf6"/><circle cx="33" cy="18" r="3" fill="#06b6d4"/><circle cx="15" cy="29" r="3" fill="#16a085"/>
  <% else %>
    <path d="M24 5 42 16v16L24 43 6 32V16z" fill="#dbeafe"/><path d="m6 16 18 11 18-11M24 27v16" stroke="#2563eb" stroke-width="2"/><circle cx="24" cy="16" r="4" fill="#60a5fa"/>
  <% end %>
</svg>
