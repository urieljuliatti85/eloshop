<div class="mx-auto w-full max-w-md">
  <%# O título diz de qual porta é este login: o topo tem outra, a do
      comprador, e as duas autenticações são independentes. %>
  <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Painel do Artesão</p>
  <h1 class="mb-8 mt-2 text-2xl font-bold text-ink">Entrar</h1>

  <% if alert = flash[:alert] %>
    <p class="mb-6 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-800" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="mb-6 rounded-xl bg-green-50 px-4 py-3 text-sm text-green-800" id="notice"><%= notice %></p>
  <% end %>

  <%# Labels visíveis, como no login do cliente: o placeholder sozinho some
      quando o campo é preenchido, e some para o leitor de tela (§62). %>
  <%= form_with url: session_url, class: "flex flex-col gap-4" do |form| %>
    <div>
      <%= form.label :email_address, "E-mail", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address],
            class: "w-full rounded-xl border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, "Senha", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: "w-full rounded-xl border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <div class="mt-2 flex flex-wrap items-center gap-4">
      <%= form.submit "Entrar", class: "cursor-pointer rounded-full bg-brand-500 px-8 py-3 text-sm font-semibold text-white hover:bg-brand-600" %>
      <%= link_to "Esqueceu a senha?", new_password_path, class: "text-sm text-ink-muted hover:text-brand-600" %>
    </div>
  <% end %>

  <p class="mt-8 text-sm text-ink-muted">
    Quer vender suas peças? <%= link_to "Cadastre seu ateliê", new_seller_registration_path, class: "font-medium text-brand-600 hover:underline" %>.
  </p>
</div>
