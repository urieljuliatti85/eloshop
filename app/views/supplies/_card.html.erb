<%# Card do insumo na vitrine de insumos e na loja do distribuidor. Preço por
    unidade de venda, o mínimo quando houver e o maior desconto por
    quantidade, para quem compra no atacado comparar de relance. %>
<% best_tier = product.price_tiers.max_by(&:discount_bps)
   available = product.available_for_purchase? || product.purchase_blocker == :seller_not_accepting_orders %>
<article class="group relative flex flex-col">
  <%= link_to supply_path(product.seller.slug, product.slug), class: "flex flex-1 flex-col" do %>
    <div class="relative aspect-square overflow-hidden rounded-2xl bg-mist-100">
      <% if product.main_image.attached? %>
        <%= image_tag product.main_image.variant(Product::CARD_IMAGE_VARIANT), class: "h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]", alt: product.name, loading: "lazy", width: 400, height: 400 %>
      <% end %>
      <% if best_tier %>
        <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white">Até <%= best_tier.discount_percent_input %>% no atacado</span>
      <% end %>
      <% if product.below_minimum_stock? %>
        <div class="absolute inset-0 flex items-center justify-center bg-white/70"><span class="rounded-full bg-ink px-3 py-1 text-xs font-semibold text-white">Indisponível</span></div>
      <% end %>
    </div>
    <div class="flex flex-1 flex-col items-center gap-1 px-2 pt-4 text-center">
      <h3 class="text-lg font-semibold leading-tight text-ink sm:min-h-[3.25rem]"><%= product.name %></h3>
      <p class="text-sm text-ink-muted"><%= product.seller.name %></p>
      <p class="mt-1 text-base font-bold text-ink"><%= format_price(product.price_cents) %> <span class="text-sm font-normal text-ink-muted">por <%= product.sale_unit_name %></span></p>
      <% if product.min_order_quantity > 1 %>
        <p class="text-xs text-ink-muted">Mínimo: <%= product.min_order_quantity %> <%= product.sale_unit_name(product.min_order_quantity) %></p>
      <% end %>
    </div>
  <% end %>
</article>
