<% product = @product
   seller = product.seller
   unit = product.sale_unit_name
   stock = product.stock_for_minimum.to_i
   unavailable = stock < [ product.min_order_quantity, 1 ].max %>
<% content_for :title, "#{product.name} — #{seller.name} | Insumos | EloShop" %>
<%# Texto próprio: o padrão das peças fala em "feito à mão", falso para insumo (ADR 007). %>
<% content_for :meta_description, truncate("#{product.name}, por #{format_price(product.price_cents)} o #{unit}, de #{seller.name}. #{product.description.to_s.squish}", length: 155) %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="container mx-auto max-w-6xl px-5 pb-16 pt-8">
  <nav class="text-sm text-ink-muted" aria-label="Caminho">
    <%= link_to "Insumos", supplies_path, class: "hover:text-brand-600" %> ›
    <%= link_to seller.name, distributor_store_path(seller.slug), class: "hover:text-brand-600" %> ›
    <span aria-current="page"><%= product.name %></span>
  </nav>

  <div class="mt-6 grid gap-10 md:grid-cols-2">
    <%= render "products/gallery", product: product %>

    <div class="flex flex-col gap-6">
      <div>
        <h1 class="text-3xl font-bold text-ink"><%= product.name %></h1>
        <p class="mt-2 text-sm text-ink-muted">Vendido por <%= link_to seller.name, distributor_store_path(seller.slug), class: "font-semibold text-brand-600 hover:underline" %></p>
      </div>

      <div>
        <p class="text-3xl font-bold text-ink"><%= format_price(product.price_cents) %> <span class="text-base font-normal text-ink-muted">por <%= unit %></span></p>
        <% if product.sale_unit_detail.present? %><p class="mt-1 text-sm text-ink-muted"><%= product.sale_unit_detail.upcase_first %></p><% end %>
      </div>

      <% if product.price_tiers.any? %>
        <section class="rounded-2xl border border-brand-100 bg-white p-5" aria-labelledby="faixas-titulo">
          <h2 id="faixas-titulo" class="font-bold text-ink">Preço por quantidade</h2>
          <p class="mt-1 text-xs text-ink-muted">A faixa vale para a quantidade total deste insumo no pedido.</p>
          <div class="mt-3"><%= render "supplies/price_tiers", product: product %></div>
        </section>
      <% end %>

      <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[max-content_1fr]">
        <dt class="font-semibold text-ink">Quantidade mínima</dt>
        <dd class="text-ink-muted"><%= product.min_order_quantity > 1 ? "#{product.min_order_quantity} #{product.sale_unit_name(product.min_order_quantity)}" : "sem mínimo" %></dd>
        <dt class="font-semibold text-ink">Disponibilidade</dt>
        <dd class="text-ink-muted"><%= unavailable ? "Indisponível no momento" : "#{stock} #{product.sale_unit_name(stock)} em estoque" %></dd>
        <dt class="font-semibold text-ink">Envio</dt>
        <dd class="text-ink-muted">Até 30 kg por pedido, em um volume</dd>
        <%# Declaração pública e opcional de nota fiscal (ADR 007). %>
        <dt class="font-semibold text-ink">Nota fiscal</dt>
        <dd class="text-ink-muted"><%= { true => "o distribuidor emite", false => "o distribuidor não emite" }.fetch(seller.issues_invoices, "não informado pelo distribuidor") %></dd>
        <% if product.materials.any? %>
          <dt class="font-semibold text-ink">Material</dt>
          <dd class="text-ink-muted"><%= product.materials.map(&:name).to_sentence %></dd>
        <% end %>
        <% if product.techniques.any? %>
          <dt class="font-semibold text-ink">Para</dt>
          <dd class="text-ink-muted"><%= product.techniques.map(&:name).to_sentence %></dd>
        <% end %>
      </dl>

      <%# A compra de insumos é a Fase 27: até lá, aviso no lugar do botão. %>
      <div class="rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm leading-6 text-amber-950" role="status">
        <strong>Vendas de insumos em breve.</strong> Você já pode conhecer os insumos e os distribuidores; a compra abre numa próxima etapa.
      </div>

      <% if product.description.present? %>
        <section aria-labelledby="descricao-titulo">
          <h2 id="descricao-titulo" class="font-bold text-ink">Descrição</h2>
          <div class="mt-2 whitespace-pre-line text-ink-muted"><%= product.description %></div>
        </section>
      <% end %>
    </div>
  </div>
</div>
