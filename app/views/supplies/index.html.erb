<% content_for :title, "Insumos para artesanato | EloShop" %>
<% content_for :meta_description, "Insumos para quem faz à mão: fios, tecidos, argila, ferragens e embalagens, direto de distribuidores." %>
<%# Fora do Google até o SEO da vitrine de insumos (Fase 26, PR C2). %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="container mx-auto max-w-6xl px-5 pb-16 pt-8">
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Para quem faz à mão</p>
    <h1 class="mt-2 text-3xl font-bold text-ink">Insumos</h1>
    <p class="mt-3 text-ink-muted">Material de produção direto de distribuidores, com preço por quantidade. As compras de insumos abrem em breve.</p>
  </header>

  <%# Navegação por material e técnica (decisão de 2026-11-07, ADR 007). Só
      os que têm insumo publicado aparecem. %>
  <% if @materials.any? || @techniques.any? %>
    <nav class="mt-8 space-y-3" aria-label="Filtrar insumos">
      <% [ [ "Material", @materials, :material, @material ], [ "Técnica", @techniques, :tecnica, @technique ] ].each do |label, options, param, current| %>
        <% next if options.empty? %>
        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 text-sm font-semibold text-ink"><%= label %>:</span>
          <%= link_to "Todos", supplies_path(request.query_parameters.except(param.to_s)), class: "inline-flex min-h-11 items-center rounded-full border px-4 text-sm #{current ? 'border-gray-200 text-ink-muted hover:border-brand-300' : 'border-brand-600 bg-brand-600 text-white'}", aria: { current: (current ? nil : "true") } %>
          <% options.each do |option| %>
            <% active = current == option %>
            <%= link_to option.name, supplies_path(request.query_parameters.merge(param.to_s => option.slug)), class: "inline-flex min-h-11 items-center rounded-full border px-4 text-sm #{active ? 'border-brand-600 bg-brand-600 text-white' : 'border-gray-200 text-ink hover:border-brand-300'}", aria: { current: (active ? "true" : nil) } %>
          <% end %>
        </div>
      <% end %>
    </nav>
  <% end %>

  <% if @supplies.any? %>
    <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
      <% @supplies.each do |supply| %>
        <%= render "supplies/card", product: supply %>
      <% end %>
    </div>
  <% elsif @material || @technique %>
    <p class="mt-10 text-ink-muted">Nenhum insumo com esse filtro. <%= link_to "Ver todos os insumos", supplies_path, class: "font-semibold text-brand-600 underline" %>.</p>
  <% else %>
    <section class="mt-10 rounded-[2rem] border border-sand-200 bg-sand-50 px-6 py-9 sm:px-10" aria-labelledby="insumos-vazio">
      <h2 id="insumos-vazio" class="text-xl font-bold text-ink">Os primeiros insumos chegam em breve</h2>
      <p class="mt-2 max-w-2xl text-ink-muted">Estamos preparando a vitrine de insumos para os artesãos comprarem material de quem fornece.</p>
    </section>
  <% end %>

  <p class="mt-12 text-sm text-ink-muted">
    <%= link_to "Conheça os distribuidores", distributors_path, class: "font-semibold text-brand-600 underline hover:text-brand-700" %>
    · Vende insumos? <%= link_to "Veja como funciona", how_it_works_path(aba: "vende", grupo: "distribuidor"), class: "font-semibold text-brand-600 underline hover:text-brand-700" %>.
  </p>
</div>
