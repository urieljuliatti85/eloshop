<% content_for :title, "Insumos para artesanato | EloShop" %>
<% content_for :meta_description, "Insumos para quem faz à mão: fios, tecidos, argila, ferragens e embalagens, direto de armarinhos." %>
<% content_for :canonical_url, supplies_url %>
<% content_for :structured_data do %>
  <%= tag.script supply_item_list_structured_data(@supplies), type: "application/ld+json" %>
<% end %>

<div class="container mx-auto max-w-6xl px-5 pb-16 pt-8">
  <header class="relative isolate overflow-hidden rounded-[2rem] border border-[#f2dfcf] bg-[#fff2e5] p-6 sm:p-9 lg:p-10">
    <div class="pointer-events-none absolute -right-16 -top-20 -z-10 size-64 rounded-full bg-[#f8cda9] opacity-60 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-24 left-1/3 -z-10 size-64 rounded-full bg-[#fde1cd] opacity-75 blur-3xl" aria-hidden="true"></div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-700">Para quem faz à mão</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">Insumos para criar</h1>
    <p class="mt-3 max-w-2xl text-base leading-7 text-ink-muted">Fios, tecidos, aviamentos e outros materiais de produção, direto de armarinhos parceiros. Compare preços por quantidade e encontre o que seu próximo projeto precisa.</p>
    <p class="mt-5 inline-flex min-h-10 items-center gap-2 rounded-full border border-white/80 bg-white/80 px-4 text-sm font-semibold text-brand-800">
      <span class="size-2 rounded-full bg-brand-600" aria-hidden="true"></span>
      As compras de insumos abrem em breve
    </p>
    <div>
      <%= link_to "Quer ser distribuidor? Deixe seu contato", new_distributor_interest_path, class: "mt-5 inline-flex min-h-12 items-center justify-center rounded-full bg-brand-600 px-6 font-bold text-white transition hover:bg-brand-700" %>
    </div>
  </header>

  <%# Navegação por material e técnica (decisão de 2026-11-07, ADR 007). Só
      os que têm insumo publicado aparecem. %>
  <% if @materials.any? || @techniques.any? %>
    <nav class="mt-7 space-y-4 rounded-[1.75rem] border border-[#f0e4da] bg-white p-4 shadow-[0_2px_12px_rgba(110,65,35,0.04)] sm:p-5" aria-label="Filtrar insumos">
      <% [ [ "Materiais", @materials, :material, @material ], [ "Técnicas", @techniques, :tecnica, @technique ] ].each do |label, options, param, current| %>
        <% next if options.empty? %>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
          <span class="shrink-0 text-xs font-bold uppercase tracking-[0.12em] text-ink-muted"><%= label %></span>
          <div class="flex flex-wrap gap-2">
          <%= link_to "Todos", supplies_path(request.query_parameters.except(param.to_s)), class: "inline-flex min-h-10 items-center rounded-full border px-4 text-sm font-semibold transition #{current ? 'border-[#eadfd6] bg-[#faf7f4] text-ink-muted hover:border-brand-300' : 'border-brand-600 bg-brand-600 text-white shadow-sm'}", aria: { current: (current ? nil : "true") } %>
          <% options.each do |option| %>
            <% active = current == option %>
            <%= link_to option.name, supplies_path(request.query_parameters.merge(param.to_s => option.slug)), class: "inline-flex min-h-10 items-center rounded-full border px-4 text-sm font-semibold transition #{active ? 'border-brand-600 bg-brand-600 text-white shadow-sm' : 'border-[#eadfd6] bg-white text-ink hover:border-brand-300 hover:bg-[#fff8f2]'}", aria: { current: (active ? "true" : nil) } %>
          <% end %>
          </div>
        </div>
      <% end %>
    </nav>
  <% end %>

  <% if @supplies.any? %>
    <section class="mt-10" aria-labelledby="supply-catalog-title">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3 border-b border-[#f0e4da] pb-5">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-600">De armarinhos parceiros</p>
          <h2 id="supply-catalog-title" class="mt-1 text-2xl font-bold text-ink">Catálogo de insumos</h2>
        </div>
        <span class="rounded-full bg-[#fff2e5] px-3 py-1.5 text-sm font-semibold text-brand-800"><%= @supplies.size %> <%= @supplies.size == 1 ? "item" : "itens" %></span>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
      <% @supplies.each do |supply| %>
        <%= render "supplies/card", product: supply %>
      <% end %>
      </div>
    </section>
  <% elsif @material || @technique %>
    <section class="mt-8 rounded-3xl border border-[#f0e4da] bg-[#fff8f2] px-6 py-8 sm:px-8" aria-labelledby="no-filtered-supplies">
      <h2 id="no-filtered-supplies" class="text-xl font-bold text-ink">Nenhum insumo encontrado com esse filtro</h2>
      <p class="mt-2 text-ink-muted">Experimente outra categoria para encontrar materiais para seu projeto.</p>
      <%= link_to "Limpar filtros", supplies_path, class: "mt-4 inline-flex min-h-11 items-center rounded-full bg-brand-600 px-5 font-semibold text-white hover:bg-brand-700" %>
    </section>
  <% else %>
    <section class="mt-8 rounded-[2rem] border border-[#f0e4da] bg-[#fff8f2] px-6 py-9 sm:px-10" aria-labelledby="insumos-vazio">
      <h2 id="insumos-vazio" class="text-xl font-bold text-ink">Os primeiros insumos chegam em breve</h2>
      <p class="mt-2 max-w-2xl text-ink-muted">Estamos preparando a vitrine de insumos para os artesãos comprarem material de quem fornece.</p>
      <%= link_to "Conhecer os armarinhos", distributors_path, class: "mt-5 inline-flex min-h-11 items-center rounded-full bg-brand-600 px-5 font-semibold text-white hover:bg-brand-700" %>
    </section>
  <% end %>

  <p class="mt-10 text-sm text-ink-muted">
    <%= link_to "Conheça os armarinhos", distributors_path, class: "font-semibold text-brand-600 underline hover:text-brand-700" %>
    · <%= link_to "Quer ser distribuidor? Deixe seu contato para receber o aviso do pré-cadastro.", new_distributor_interest_path, class: "font-semibold text-brand-600 underline hover:text-brand-700" %>
  </p>
</div>
