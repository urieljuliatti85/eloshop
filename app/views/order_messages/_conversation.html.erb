<section class="rounded-3xl border border-brand-100 bg-white p-5 shadow-sm sm:p-7" aria-labelledby="conversation-title">
  <div class="flex flex-wrap items-start justify-between gap-3 border-b border-brand-100 pb-5">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-brand-600">Pedido #<%= order.id %></p>
      <h1 id="conversation-title" class="mt-1 text-2xl font-black tracking-tight text-ink">Conversa com <%= counterpart_name %></h1>
      <p class="mt-2 text-sm text-ink-muted">Use este espaço somente para combinar detalhes desta compra.</p>
    </div>
    <%= link_to "Voltar ao pedido", back_path, class: "inline-flex min-h-11 items-center rounded-full border border-brand-200 px-4 text-sm font-semibold text-brand-700 hover:bg-brand-50" %>
  </div>

  <div class="my-6 space-y-4" aria-label="Histórico de mensagens">
    <% if messages.empty? %>
      <div class="rounded-2xl bg-brand-50 p-5 text-center text-sm text-ink-muted">
        Ainda não há mensagens neste pedido. Escreva a primeira abaixo.
      </div>
    <% else %>
      <% messages.each do |item| %>
        <% own_message = item.sender == current_sender %>
        <div class="flex <%= own_message ? 'justify-end' : 'justify-start' %>">
          <article class="max-w-[88%] rounded-2xl px-4 py-3 sm:max-w-[72%] <%= own_message ? 'bg-brand-500 text-white' : 'bg-stone-100 text-ink' %>">
            <p class="mb-1 text-xs font-bold <%= own_message ? 'text-white/80' : 'text-ink-muted' %>"><%= own_message ? "Você" : counterpart_name %></p>
            <p class="whitespace-pre-wrap break-words text-sm"><%= item.body %></p>
            <p class="mt-2 text-right text-[0.7rem] <%= own_message ? 'text-white/70' : 'text-ink-muted' %>"><%= l(item.created_at, format: :short) %></p>
          </article>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= form_with model: message, url: form_url, class: "border-t border-brand-100 pt-5" do |form| %>
    <% if message.errors.any? %>
      <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
        <p class="font-semibold">Não foi possível enviar:</p>
        <ul class="mt-1 list-disc pl-5">
          <% message.errors.full_messages.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.label :body, "Nova mensagem", class: "mb-2 block text-sm font-semibold text-ink" %>
    <%= form.text_area :body,
          rows: 4,
          maxlength: OrderMessage::MAX_BODY_LENGTH,
          required: true,
          placeholder: "Escreva sua mensagem sobre este pedido",
          class: "w-full resize-y rounded-2xl border border-brand-200 px-4 py-3 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" %>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <p class="text-xs text-ink-muted">Não envie senhas, dados de cartão ou códigos de acesso.</p>
      <%= form.submit "Enviar mensagem", class: "min-h-11 cursor-pointer rounded-full bg-brand-500 px-6 text-sm font-bold text-white hover:bg-brand-600" %>
    </div>
  <% end %>
</section>
