<% content_for :title, "#{@seller.name} | Ateliê na EloShop" %>
<% content_for :meta_description, "Conheça as peças feitas à mão pelo ateliê #{@seller.name} na EloShop." %>
<% content_for :canonical_url, seller_url(@seller.slug) %>

<% content_for :structured_data do %>
  <%= tag.script seller_breadcrumb_structured_data(@seller), type: "application/ld+json" %>
<% end %>

<%# Tema do ateliê: paleta e fonte viram variáveis CSS (valores do catálogo
    fechado SellerTheme, nunca texto livre do artesão). %>
<div class="w-full" style="<%= seller_theme_style(@seller) %>; font-family: var(--atelier-font)">
  <%# Mesmo breadcrumb da PDP: o ateliê é alcançado a partir de um produto, e
      sem ele a página vira um beco — não há como voltar à loja pela própria
      página. %>
  <nav class="text-sm text-ink-muted" aria-label="Você está em">
    <%= link_to "Início", root_path, class: "hover:text-brand-600" %>
    <span class="mx-2">/</span>
    <%= link_to "Loja", products_path, class: "hover:text-brand-600" %>
    <span class="mx-2">/</span>
    <span class="text-ink"><%= @seller.name %></span>
  </nav>

  <div class="mt-8 space-y-12">
    <%# O hero repete a linguagem do painel do artesão — fundo terracota,
        cantos de 2rem, tipografia pesada — mas fala com quem compra, não com
        quem vende. A capa é a que o ateliê enviou; sem ela, a foto da peça
        mais recente, e sem nenhuma das duas o fundo geométrico (§5). %>
    <% if @seller.notice_text.present? %>
      <p class="-mb-6 rounded-full bg-[var(--atelier-accent)] px-5 py-2.5 text-center text-sm font-semibold text-white" role="status"><%= @seller.notice_text %></p>
    <% end %>

    <section class="relative isolate overflow-hidden <%= seller_hero_radius_class(@seller.theme_corners) %> bg-[var(--atelier-from)] text-white shadow-sm">
      <% compact = @seller.theme_hero == "compacto" %>
      <%# O fallback usa uma variante, não o original: o topo é o elemento
          mais pesado da página e o original da peça pode ter vários MB. %>
      <% cover_photo = if compact then nil
           elsif @seller.cover_image.attached? then @seller.cover_image.variant(resize_to_limit: [ 1600, 700 ])
           else @products.find { |product| product.main_image.attached? }&.main_image&.variant(resize_to_limit: [ 1600, 700 ])
           end %>
      <% if cover_photo %>
        <%# Está acima da dobra e costuma ser o LCP: nada de lazy aqui. %>
        <%= image_tag cover_photo, alt: "", loading: "eager", fetchpriority: "high", decoding: "async",
              class: "absolute inset-0 -z-20 h-full w-full object-cover" %>
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/80 via-black/45 to-black/20"></div>
      <% else %>
        <%# Mesmo fundo geométrico que o painel usa quando ainda não há foto. %>
        <div class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_75%_25%,var(--atelier-soft)_0,transparent_27%),radial-gradient(circle_at_75%_72%,var(--atelier-glow)_0,transparent_28%),linear-gradient(135deg,var(--atelier-from),var(--atelier-to))]"></div>
        <% unless compact %>
          <div class="absolute right-[12%] top-[12%] -z-10 size-40 rotate-6 border-[1.25rem] border-white/15 sm:size-64"></div>
        <% end %>
      <% end %>

      <div class="flex max-w-2xl flex-col justify-end <%= compact ? "p-6 sm:p-8" : "p-7 sm:p-10 lg:p-12" %>">
        <% if @seller.logo.attached? %>
          <%= image_tag @seller.logo.variant(resize_to_fill: [ 160, 160 ]), alt: "Logo do ateliê #{@seller.name}",
                class: "mb-5 size-20 rounded-full border-2 border-white/60 object-cover sm:size-24" %>
        <% end %>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-[var(--atelier-soft)]">Ateliê na EloShop</p>
        <h1 class="text-4xl font-black leading-[0.98] tracking-tight sm:text-5xl lg:text-6xl"><%= @seller.name %></h1>
        <p class="mt-5 max-w-lg text-sm leading-6 text-white/80 sm:text-base">
          <%= pluralize(@products.size, "peça disponível", plural: "peças disponíveis") %>, <%= @products.any? ? "feitas à mão e prontas para conhecer" : "por enquanto" %>.
        </p>
        <% if @seller.instagram_handle.present? || @seller.whatsapp_number.present? %>
          <div class="mt-5 flex flex-wrap gap-2">
            <% if @seller.instagram_handle.present? %>
              <%= link_to "Instagram", seller_instagram_url(@seller), target: "_blank", rel: "noopener nofollow", class: "inline-flex min-h-11 items-center rounded-full border border-white/50 px-4 text-sm font-semibold hover:bg-white/15" %>
            <% end %>
            <% if @seller.whatsapp_number.present? %>
              <%= link_to "WhatsApp", seller_whatsapp_url(@seller), target: "_blank", rel: "noopener nofollow", class: "inline-flex min-h-11 items-center rounded-full border border-white/50 px-4 text-sm font-semibold hover:bg-white/15" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <% @seller.theme_sections.each do |section| %>
      <%= case section
          when "catalog" then render("sellers/catalog", seller: @seller, products: @products)
          when "about" then render("sellers/about", seller: @seller)
          when "footer" then render("sellers/footer_message", seller: @seller)
          end %>
    <% end %>


    <%# Denúncia: fica discreta no rodapé — não é uma ação que se quer em
        destaque, mas precisa existir e ser fácil de achar para quem procura.
        Exige cliente autenticado (ver SellerReportsController), então quem
        não está logado é levado ao login e volta para cá depois. %>
    <section class="border-t border-sand-200 pt-8">
      <details class="group">
        <summary class="cursor-pointer text-sm font-medium text-ink-muted underline underline-offset-4 hover:text-ink [&::-webkit-details-marker]:hidden">
          Denunciar este ateliê
        </summary>

        <div class="mt-4 max-w-lg rounded-2xl border border-red-100 bg-red-50/50 p-6">
          <p class="text-sm font-semibold text-red-900">Esta loja está realizando atividades fraudulentas e não é confiável</p>
          <p class="mt-1 text-sm text-red-800/80">Sua denúncia é analisada pela equipe da EloShop e não é visível publicamente.</p>

          <%= form_with url: seller_seller_reports_path(@seller.slug), class: "mt-5 space-y-4" do |form| %>
            <div>
              <%= form.label :reason, "Motivo", class: "block text-sm font-semibold text-ink" %>
              <%= form.select :reason,
                    options_for_select(SellerReport::REASON_LABELS.map { |value, label| [ label, value ] }),
                    { include_blank: "Selecione um motivo" },
                    { name: "seller_report[reason]", required: true, class: "mt-2 w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none" } %>
            </div>
            <div>
              <%= form.label :details, "Detalhes (opcional)", class: "block text-sm font-semibold text-ink" %>
              <%= form.text_area :details, name: "seller_report[details]", rows: 4, maxlength: 2000, class: "mt-2 w-full rounded-xl border border-gray-300 px-3 py-2 text-sm focus:border-brand-500 focus:outline-none" %>
            </div>
            <%= form.submit "Enviar denúncia", class: "cursor-pointer rounded-full bg-red-600 px-6 py-3 text-sm font-bold text-white hover:bg-red-700" %>
          <% end %>
        </div>
      </details>
    </section>
  </div>
</div>
