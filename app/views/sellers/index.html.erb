<% content_for :title, "Ateliês | EloShop" %>
<% content_for :description, "Conheça os ateliês que vendem peças feitas à mão na EloShop." %>
<% content_for :canonical_url, sellers_url %>

<div class="w-full">
  <nav class="text-sm text-ink-muted" aria-label="Você está em">
    <%= link_to "Início", root_path, class: "hover:text-brand-600" %>
    <span class="mx-2">/</span>
    <span class="text-ink">Ateliês</span>
  </nav>

  <header class="mt-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Quem faz</p>
    <h1 class="mt-2 text-3xl font-bold text-ink md:text-4xl">Ateliês na EloShop</h1>
    <p class="mt-3 max-w-xl leading-relaxed text-ink-muted">
      Cada peça da loja sai de um ateliê com nome. Conheça quem está por trás delas.
    </p>
  </header>

  <% if @sellers.any? %>
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      <% @sellers.each do |seller| %>
        <li>
          <%# Foto no topo e faixa clara embaixo, como os cards de categoria
              da home: aqui a peça é a informação, e o nome do ateliê fecha o
              bloco em vez de disputar espaço sobre a imagem. %>
          <%= link_to seller_path(seller.slug), class: "group flex h-full flex-col overflow-hidden rounded-[1.75rem] bg-brand-100/70 shadow-sm transition hover:-translate-y-0.5 hover:shadow-xl" do %>
            <div class="relative aspect-[3/4] overflow-hidden">
              <% if (cover = @covers[seller.id]) %>
                <%= image_tag cover.main_image, alt: "", loading: "lazy",
                      class: "h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" %>
              <% else %>
                <%# Sem peça com foto ainda: um fundo da paleta, para o card
                    manter a altura da grade em vez de encolher. %>
                <div class="h-full w-full bg-gradient-to-br from-brand-200 to-brand-100"></div>
              <% end %>
            </div>

            <div class="flex items-center justify-between gap-3 px-5 py-4">
              <div class="min-w-0">
                <strong class="block truncate text-base font-bold text-ink"><%= seller.name %></strong>
                <span class="text-xs text-ink-muted">
                  <%= pluralize(@product_counts.fetch(seller.id, 0), "peça", plural: "peças") %> à venda
                </span>
              </div>
              <svg class="size-5 flex-none text-brand-600 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-10 rounded-2xl bg-sand-50 px-6 py-8 text-center text-ink-muted">
      Nenhum ateliê com peças publicadas por enquanto.
    </p>
  <% end %>
</div>
