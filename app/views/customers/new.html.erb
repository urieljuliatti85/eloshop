<div class="mx-auto w-full max-w-md">
  <h1 class="mb-4 text-2xl font-bold text-ink">Quero comprar</h1>
  <%= render "customers/buy_tabs", active: :signup %>

  <%= form_with model: @customer, url: customers_path, class: "flex flex-col gap-4" do |form| %>
    <% if @customer.errors.any? %>
      <div class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-800">
        <ul class="list-inside list-disc">
          <% @customer.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "mb-1 block text-sm font-medium text-ink" do %>Nome <span class="font-bold text-red-600" aria-hidden="true">*</span><% end %>
      <%= form.text_field :name, required: true, class: "w-full rounded-xl border border-red-400 px-3 py-2 focus:border-red-600 focus:outline-none" %>
    </div>

    <div data-controller="email-availability" data-email-availability-url-value="<%= customer_email_availability_path %>">
      <%= form.label :email, class: "mb-1 block text-sm font-medium text-ink" do %>E-mail <span class="font-bold text-red-600" aria-hidden="true">*</span><% end %>
      <%= form.email_field :email, required: true, autocomplete: "email", maxlength: 254, aria: { describedby: "customer_email_status" }, data: { email_availability_target: "input", action: "input->email-availability#check" }, class: "w-full rounded-xl border border-red-400 px-3 py-2 focus:border-red-600 focus:outline-none" %>
      <p id="customer_email_status" role="status" aria-live="polite" data-email-availability-target="status" class="mt-2 text-sm"></p>
    </div>

    <div>
      <%= form.label :password, class: "mb-1 block text-sm font-medium text-ink" do %>Senha <span class="font-bold text-red-600" aria-hidden="true">*</span><% end %>
      <%= form.password_field :password, required: true, class: "w-full rounded-xl border border-red-400 px-3 py-2 focus:border-red-600 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "mb-1 block text-sm font-medium text-ink" do %>Confirmar senha <span class="font-bold text-red-600" aria-hidden="true">*</span><% end %>
      <%= form.password_field :password_confirmation, required: true, class: "w-full rounded-xl border border-red-400 px-3 py-2 focus:border-red-600 focus:outline-none" %>
    </div>

    <p class="text-xs text-ink-muted"><span class="font-bold text-red-600" aria-hidden="true">*</span> Campo obrigatório</p>

    <%= form.submit "Criar conta", class: "mt-2 w-fit cursor-pointer rounded-full bg-brand-500 px-8 py-3 text-sm font-semibold text-white hover:bg-brand-600" %>
  <% end %>
</div>
