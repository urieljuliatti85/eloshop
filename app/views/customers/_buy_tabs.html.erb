<%# Abas de "Quero comprar": duas páginas (login e cadastro) ligadas por links,
    para erros de formulário e redirecionamentos seguirem funcionando sem
    JavaScript. `active`: :login ou :signup. %>
<% tabs = [
     [ :login, "Já sou cliente", new_customer_session_path ],
     [ :signup, "Quero me cadastrar", new_customer_path ]
   ] %>
<nav class="mb-8 flex gap-1 rounded-full bg-sand-50 p-1" aria-label="Quero comprar">
  <% tabs.each do |key, label, path| %>
    <%= link_to label, path,
          class: "flex min-h-11 flex-1 items-center justify-center rounded-full px-4 text-center text-sm font-semibold transition #{key == active ? 'bg-brand-500 text-white shadow-sm' : 'text-ink hover:bg-white hover:text-brand-600'}",
          aria: (key == active ? { current: "page" } : {}) %>
  <% end %>
</nav>
