<% content_for :title, "Venda insumos para artesãos: cadastro de armarinho | EloShop" %>
<%# Cadastro em teste: ainda não é anunciado nem deve aparecer no Google. %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div id="cadastro" class="mx-auto w-full max-w-xl scroll-mt-24 rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
  <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">EloShop Atacado</p>
  <h1 class="mt-2 text-3xl font-bold text-ink">Cadastre seu armarinho</h1>
  <p class="mt-3 text-ink-muted">Para quem vende insumos para artesãos: fios, tecidos, argila, ferragens, embalagens. O cadastro fica pendente até a validação da plataforma, e a aprovação depende de uma conta Mercado Pago de vendedor conectada no painel.</p>

  <div class="mt-6 rounded-xl border border-brand-100 bg-brand-50/50 p-4 text-sm text-stone-700">
    <p class="font-semibold text-ink">Antes de começar</p>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      <li>Esta conta é só de armarinho. Se você também tem um ateliê na EloShop, ele continua com a conta dele, e esta precisa de outro e-mail.</li>
      <li>Tenha em mãos uma <strong>conta de vendedor do Mercado Pago</strong>, com a identidade já verificada. É nela que você recebe suas vendas.</li>
      <li>A comissão da EloShop é de <strong><%= fee_rate_label(SellerOrder::LAUNCH_PLATFORM_FEE_RATE_BPS) %> nos 3 primeiros meses de vendas</strong> e <%= fee_rate_label(SellerOrder::PLATFORM_FEE_RATE_BPS) %> depois disso, sobre o valor dos produtos, sem o frete. Não há mensalidade, no momento.</li>
      <li>Depois do cadastro, você cadastra os insumos no painel. A loja e os insumos publicados aparecem na vitrine de insumos quando a EloShop liberar a sua vitrine ou aprovar o armarinho; as compras de insumos abrem numa próxima etapa.</li>
      <li>Quer entender antes de se cadastrar? Veja <%= link_to "como funciona para armarinhos", how_it_works_path(aba: "vende", grupo: "armarinho"), class: "font-semibold text-brand-700 underline" %>.</li>
    </ul>
  </div>

  <%# Mesmo tratamento de erros do cadastro do ateliê: todos de uma vez no
      topo, com foco, e cada campo repetindo o próprio erro. %>
  <% errors = registration_errors(@seller, @user) %>
  <% if errors.any? %>
    <div id="erros-cadastro" tabindex="-1" class="mt-6 scroll-mt-24 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700 focus:outline-2 focus:outline-offset-2 focus:outline-red-600" role="alert" aria-labelledby="erros-cadastro-titulo" data-controller="error-summary">
      <p id="erros-cadastro-titulo" class="font-semibold text-red-800"><%= errors.one? ? "Não foi possível criar o cadastro. Corrija 1 erro para continuar:" : "Não foi possível criar o cadastro. Corrija #{errors.size} erros para continuar:" %></p>
      <ul class="mt-2 list-disc space-y-2 pl-5"><% errors.each do |error| %><li><%= render "error_item", error: error %></li><% end %></ul>
    </div>
  <% end %>

  <% field_class = ->(field_errors) { "mt-2 w-full rounded-xl border px-3 py-2 focus:outline-none #{field_errors.any? ? "border-red-500 focus:border-red-600" : "border-gray-300 focus:border-brand-500"}" } %>
  <% name_errors = registration_errors_for(errors, :name, :slug) %>
  <% owner_errors = registration_errors_for(errors, :owner_full_name) %>
  <% cpf_errors = registration_errors_for(errors, :cpf, :cpf_hash) %>
  <% cnpj_errors = registration_errors_for(errors, :cnpj) %>
  <% email_errors = registration_errors_for(errors, :email_address) %>
  <% password_errors = registration_errors_for(errors, :password) %>
  <% confirmation_errors = registration_errors_for(errors, :password_confirmation) %>
  <% base_errors = registration_errors_for(errors, :base) %>
  <% field_error = ->(id, field_errors) { tag.div(id: id, class: "mt-1 space-y-1 text-sm text-red-700") { safe_join(field_errors.map { |error| tag.p(render("error_item", error: error)) }) } if field_errors.any? } %>
  <% described_by = ->(id, field_errors, *others) { [ *others, (id if field_errors.any?) ].compact.join(" ").presence } %>

  <p class="mt-6 text-xs text-ink-muted">* campo obrigatório</p>

  <%= form_with url: distributor_registration_path, class: "mt-4 flex flex-col gap-5" do |form| %>
    <%# Mesma checagem ao vivo do cadastro do ateliê (atelier_name_controller):
        o slug é único entre os dois tipos, então a consulta é a mesma, e o
        texto e o prefixo do endereço vêm dos values. %>
    <div data-controller="atelier-name" data-atelier-name-url-value="<%= seller_registration_name_availability_path %>"
         data-atelier-name-prefix-value="/armarinhos"
         data-atelier-name-invalid-message-value="Use letras ou números no nome do armarinho."
         data-atelier-name-taken-message-value="Já existe um ateliê ou um armarinho com esse nome (ou com o mesmo endereço).">
      <%= form.label :name, "Nome do armarinho *", for: "seller_name" %><%= form.text_field :name, name: "seller[name]", id: "seller_name", value: @seller.name, required: true, autocomplete: "organization", maxlength: 120, data: { atelier_name_target: "input", action: "input->atelier-name#check" }, aria: { describedby: described_by.call("seller_name_error", name_errors, "seller_name_status"), invalid: (name_errors.any? || nil) }, class: field_class.call(name_errors) %>
      <%= field_error.call("seller_name_error", name_errors) %>
      <p id="seller_name_status" role="status" aria-live="polite" data-atelier-name-target="status" class="mt-2 text-sm"></p>
      <%# Endereço público decidido no ADR 007 (2026-11-07); a página entra
          na Fase 26, mas o slug já é reservado aqui e não muda depois. %>
      <p class="mt-2 text-xs text-ink-muted">O nome gera o endereço da sua loja na EloShop: "Aviamentos do Sul", por exemplo, vira https://eloshop.shop/armarinhos/aviamentos-do-sul. A loja vai ao ar quando a EloShop liberar a sua vitrine ou aprovar o armarinho. Se você mudar o nome depois, o endereço não muda, para não quebrar links nem o que os buscadores, como o Google, já guardaram.</p>
    </div>
    <div><%= form.label :owner_full_name, "Nome completo do responsável *", for: "seller_owner_full_name" %><%= form.text_field :owner_full_name, name: "seller[owner_full_name]", id: "seller_owner_full_name", value: @seller.owner_full_name, required: true, aria: { describedby: described_by.call("seller_owner_full_name_error", owner_errors), invalid: (owner_errors.any? || nil) }, class: field_class.call(owner_errors) %><%= field_error.call("seller_owner_full_name_error", owner_errors) %></div>
    <div data-controller="cpf-input">
      <%= form.label :cpf, "CPF do responsável *", for: "seller_cpf" %><%= form.text_field :cpf, name: "seller[cpf]", id: "seller_cpf", value: Seller.format_cpf(@seller.cpf), required: true, inputmode: "numeric", autocomplete: "off", maxlength: 14, placeholder: "000.000.000-00", pattern: '\d{3}\.?\d{3}\.?\d{3}-?\d{2}', title: "Digite os 11 números do CPF, no formato 000.000.000-00", data: { cpf_input_target: "input", action: "input->cpf-input#format blur->cpf-input#validate" }, aria: { describedby: described_by.call("seller_cpf_error", cpf_errors, "seller_cpf_check"), invalid: (cpf_errors.any? || nil) }, class: field_class.call(cpf_errors) %>
      <p id="seller_cpf_check" class="mt-1 text-sm text-red-700" aria-live="polite" data-cpf-input-target="message" hidden></p>
      <%= field_error.call("seller_cpf_error", cpf_errors) %>
    </div>
    <%# Formata e valida na digitação (cnpj_input_controller.js), inclusive o
        CNPJ alfanumérico; o servidor normaliza e valida de novo (Cnpj). %>
    <div data-controller="cnpj-input">
      <%= form.label :cnpj, "CNPJ", for: "seller_cnpj" %><%= form.text_field :cnpj, name: "seller[cnpj]", id: "seller_cnpj", value: (@seller.cnpj.present? ? Cnpj.format(@seller.cnpj) : nil), autocomplete: "off", autocapitalize: "characters", spellcheck: false, maxlength: 18, placeholder: "00.000.000/0000-00", data: { cnpj_input_target: "input", action: "input->cnpj-input#format blur->cnpj-input#validate" }, aria: { describedby: described_by.call("seller_cnpj_error", cnpj_errors, "seller_cnpj_hint", "seller_cnpj_check"), invalid: (cnpj_errors.any? || nil) }, class: field_class.call(cnpj_errors) %>
      <p id="seller_cnpj_check" class="mt-1 text-sm text-red-700" aria-live="polite" data-cnpj-input-target="message" hidden></p>
      <p id="seller_cnpj_hint" class="mt-1 text-xs text-ink-muted">Opcional. Aceita também o CNPJ com letras, emitido desde julho de 2026.</p>
      <%= field_error.call("seller_cnpj_error", cnpj_errors) %>
    </div>
    <fieldset>
      <legend>Você emite nota fiscal nas vendas?</legend>
      <p id="seller_issues_invoices_hint" class="mt-1 text-xs text-ink-muted">Opcional. A resposta poderá ser mostrada aos compradores.</p>
      <% current = @seller.issues_invoices.nil? ? "" : @seller.issues_invoices.to_s %>
      <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2" aria-describedby="seller_issues_invoices_hint">
        <% [ [ "true", "Sim" ], [ "false", "Não" ], [ "", "Prefiro responder depois" ] ].each do |value, label| %>
          <label class="flex min-h-11 items-center gap-2"><%= radio_button_tag "seller[issues_invoices]", value, current == value, id: "seller_issues_invoices_#{value.presence || "blank"}" %> <%= label %></label>
        <% end %>
      </div>
    </fieldset>
    <div><%= form.label :email_address, "E-mail *", for: "user_email_address" %><%= form.email_field :email_address, name: "user[email_address]", id: "user_email_address", value: @user.email_address, required: true, autocomplete: "email", aria: { describedby: described_by.call("user_email_address_error", email_errors), invalid: (email_errors.any? || nil) }, class: field_class.call(email_errors) %><%= field_error.call("user_email_address_error", email_errors) %></div>
    <div><%= form.label :password, "Senha *", for: "user_password" %><%= form.password_field :password, name: "user[password]", id: "user_password", required: true, autocomplete: "new-password", maxlength: 72, aria: { describedby: described_by.call("user_password_error", password_errors), invalid: (password_errors.any? || nil) }, class: field_class.call(password_errors) %><%= field_error.call("user_password_error", password_errors) %></div>
    <div><%= form.label :password_confirmation, "Confirmar senha *", for: "user_password_confirmation" %><%= form.password_field :password_confirmation, name: "user[password_confirmation]", id: "user_password_confirmation", required: true, autocomplete: "new-password", maxlength: 72, aria: { describedby: described_by.call("user_password_confirmation_error", confirmation_errors), invalid: (confirmation_errors.any? || nil) }, class: field_class.call(confirmation_errors) %><%= field_error.call("user_password_confirmation_error", confirmation_errors) %></div>
    <div class="rounded-xl border border-brand-100 bg-brand-50/50 p-4 text-sm text-stone-700">
      <label class="flex items-start gap-3">
        <%= check_box_tag :terms_accepted, "1", params[:terms_accepted] == "1", required: true, class: "mt-1" %>
        <span>Li e aceito os <%= link_to "Termos Comerciais do Distribuidor", distributor_terms_path, target: "_blank", rel: "noopener", class: "font-semibold text-brand-700 underline" %> (<%= SellerTerms.version("distributor") %>), incluindo comissão, reembolsos, chargebacks e responsabilidades fiscais.</span>
      </label>
    </div>
    <%= render "shared/turnstile" %>
    <% if base_errors.any? %>
      <ul class="space-y-2 text-sm text-red-700" id="erros-cadastro-gerais"><% base_errors.each do |error| %><li><%= render "error_item", error: error %></li><% end %></ul>
    <% end %>
    <%= form.submit "Criar cadastro", class: "cursor-pointer rounded-full bg-brand-500 px-6 py-3 font-semibold text-white hover:bg-brand-600" %>
  <% end %>

  <p class="mt-8 text-sm text-ink-muted">
    Já tem cadastro de armarinho? <%= link_to "Entrar", distributor_login_path, class: "font-medium text-brand-600 hover:underline" %>.
  </p>
</div>
