<% distributor = @distributor %>
<% content_for :title, "#{distributor.name} | Armarinho | EloShop" %>
<% content_for :meta_description, @distributor_preview ? "Prévia demonstrativa da vitrine de armarinhos da EloShop." : "Insumos de #{distributor.name} na EloShop, com preço por quantidade para artesãos." %>
<% content_for :canonical_url, distributor_store_url(distributor.slug) %>
<% if @distributor_preview %>
  <% content_for :head do %><meta name="robots" content="noindex,nofollow"><% end %>
<% end %>
<% content_for :structured_data do %>
  <%= tag.script distributor_breadcrumb_structured_data(distributor), type: "application/ld+json" %>
  <% if @supplies.any? %><%= tag.script supply_item_list_structured_data(@supplies), type: "application/ld+json" %><% end %>
<% end %>
<% store_materials = @supplies.flat_map(&:materials).uniq(&:id).first(4) %>
<% fallback_tiles = [
  { title: "Fios & lãs", icon: "yarn", background: "#e3f6f1" },
  { title: "Tecidos", icon: "fabric", background: "#fff0f4" },
  { title: "Fitas", icon: "ribbon", background: "#f2eaff" },
  { title: "Aviamentos", icon: "notions", background: "#fff4dc" }
] %>

<div class="container mx-auto max-w-6xl px-5 pb-16 pt-8">
  <nav class="text-sm text-ink-muted" aria-label="Caminho">
    <%= link_to "Armarinhos", distributors_path, class: "hover:text-brand-600" %> › <span aria-current="page"><%= distributor.name %></span>
  </nav>

  <header class="relative isolate mt-5 overflow-hidden rounded-[2rem] border border-[#eee3d4] bg-[#faf5ec] p-5 sm:p-8 lg:p-10" aria-labelledby="distributor-store-title">
    <div class="pointer-events-none absolute -right-20 -top-24 -z-10 size-72 rounded-full opacity-70 blur-3xl" style="background: #f5d7c9" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-28 left-1/3 -z-10 size-72 rounded-full opacity-60 blur-3xl" style="background: #dcefe6" aria-hidden="true"></div>
    <div class="relative grid gap-7 md:grid-cols-[1fr_0.9fr] md:items-center md:gap-6 lg:gap-12">
      <div>
        <div class="flex flex-wrap gap-2">
          <span class="inline-flex min-h-8 items-center rounded-full bg-white/90 px-3 text-xs font-bold <%= distributor.approved? ? 'text-emerald-800' : 'text-amber-900' %>">
            <%= distributor.approved? ? "✓ Armarinho verificado" : "✦ Em preparação" %>
          </span>
          <span class="inline-flex min-h-8 items-center rounded-full bg-white/90 px-3 text-xs font-semibold text-ink-muted">
            Nota fiscal: <%= { true => "emite", false => "não emite" }.fetch(distributor.issues_invoices, "não informado") %>
          </span>
        </div>
        <p class="mt-6 text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Matéria-prima para quem faz à mão</p>
        <h1 id="distributor-store-title" class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"><%= distributor.name %></h1>
        <p class="mt-3 max-w-xl text-base leading-7 text-ink-muted">
          <% if @distributor_preview %>
            Esta é uma prévia demonstrativa da vitrine. Estamos trabalhando no pré-cadastro de armarinhos.
          <% elsif @supplies.any? %>
            Explore <%= @supplies.size %> <%= @supplies.size == 1 ? "insumo publicado" : "insumos publicados" %> por este armarinho. As compras de insumos abrem em breve.
          <% elsif distributor.approved? %>
            Este armarinho ainda não publicou insumos.
          <% else %>
            Este armarinho está se preparando para começar a vender.
          <% end %>
        </p>
        <% if @supplies.any? %>
          <%= link_to "Explorar insumos", "#insumos-do-armarinho", class: "mt-5 inline-flex min-h-12 items-center justify-center rounded-full bg-ink px-5 text-sm font-bold text-white transition hover:bg-brand-700" %>
        <% end %>
      </div>

      <ul role="list" class="grid grid-cols-2 gap-3 sm:gap-4" aria-label="Materiais deste armarinho">
        <% if store_materials.any? %>
          <% store_materials.each_with_index do |material, index| %>
            <li class="<%= 'translate-y-3 sm:translate-y-5' if index.odd? %> flex min-h-24 items-center gap-3 rounded-2xl border border-white/80 bg-white/75 p-3 shadow-[0_8px_24px_rgba(77,55,40,0.08)] sm:min-h-28 sm:p-4">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-[#faf5ec] sm:size-14" aria-hidden="true">
                <%= render "materials/category_icon", material: material, classes: "size-9" %>
              </span>
              <span class="text-sm font-bold leading-tight text-ink sm:text-base"><%= material.name %></span>
            </li>
          <% end %>
        <% else %>
          <% fallback_tiles.each_with_index do |tile, index| %>
            <li class="<%= 'translate-y-3 sm:translate-y-5' if index.odd? %> flex min-h-24 items-center gap-3 rounded-2xl border border-white/80 p-3 shadow-[0_8px_24px_rgba(77,55,40,0.08)] sm:min-h-28 sm:p-4" style="background: linear-gradient(145deg, <%= tile[:background] %>, #ffffff 88%)">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-white/75 sm:size-14" aria-hidden="true"><%= render "materials/category_icon", icon_type: tile[:icon], classes: "size-9" %></span>
              <span class="text-sm font-bold leading-tight text-ink sm:text-base"><%= tile[:title] %></span>
            </li>
          <% end %>
        <% end %>
      </ul>
    </div>
  </header>

  <% if @distributor_preview %>
    <aside class="mt-8 flex flex-col justify-between gap-4 rounded-3xl border border-brand-100 bg-brand-50/60 p-6 sm:flex-row sm:items-center sm:p-8">
      <div>
        <h2 class="text-xl font-bold text-ink">Quer ser um distribuidor?</h2>
        <p class="mt-2 text-sm text-ink-muted">Estamos em pré-cadastro. Se você já quer adiantar sua loja, informe-nos.</p>
      </div>
      <%= link_to "Quero ser avisado", new_distributor_interest_path, class: "inline-flex min-h-12 shrink-0 items-center justify-center rounded-full bg-brand-600 px-6 font-bold text-white hover:bg-brand-700" %>
    </aside>
  <% end %>

  <% if @supplies.any? %>
    <section id="insumos-do-armarinho" class="mt-12 scroll-mt-24" aria-labelledby="distributor-supplies-title">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3 border-b border-sand-200 pb-5">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-600">Catálogo do armarinho</p>
          <h2 id="distributor-supplies-title" class="mt-1 text-2xl font-bold text-ink">Insumos deste armarinho</h2>
        </div>
        <span class="rounded-full bg-sand-100 px-3 py-1.5 text-sm font-semibold text-ink-muted"><%= @supplies.size %> <%= @supplies.size == 1 ? "item" : "itens" %></span>
      </div>
      <div class="grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
        <% @supplies.each do |supply| %>
          <%= render "supplies/card", product: supply %>
        <% end %>
      </div>
    </section>
  <% else %>
    <section id="insumos-do-armarinho" class="mt-10 rounded-3xl border border-sand-200 bg-sand-50 px-6 py-8 sm:px-8" aria-labelledby="empty-distributor-supplies-title">
      <h2 id="empty-distributor-supplies-title" class="text-xl font-bold text-ink"><%= @distributor_preview ? "Prévia da vitrine" : "Este armarinho ainda não publicou insumos" %></h2>
      <p class="mt-2 max-w-2xl text-ink-muted"><%= @distributor_preview ? "Os produtos demonstrativos ainda não foram cadastrados. Os ícones acima mostram como as categorias de materiais aparecerão." : "Enquanto isso, você pode conhecer outros materiais publicados por armarinhos parceiros." %></p>
      <%= link_to "Ver todos os insumos", supplies_path, class: "mt-4 inline-flex min-h-11 items-center font-semibold text-brand-700 underline underline-offset-4" %>
    </section>
  <% end %>

  <p class="mt-10 text-sm"><%= link_to "← Voltar para armarinhos", distributors_path, class: "font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-600" %></p>
</div>
