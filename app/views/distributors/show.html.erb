<% distributor = @distributor %>
<% content_for :title, "#{distributor.name} | Armarinho | EloShop" %>
<% content_for :meta_description, "Insumos de #{distributor.name} na EloShop, com preço por quantidade para artesãos." %>
<% content_for :canonical_url, distributor_store_url(distributor.slug) %>
<% content_for :structured_data do %>
  <%= tag.script distributor_breadcrumb_structured_data(distributor), type: "application/ld+json" %>
  <%= tag.script supply_item_list_structured_data(@supplies), type: "application/ld+json" %>
<% end %>

<div class="container mx-auto max-w-6xl px-5 pb-16 pt-8">
  <nav class="text-sm text-ink-muted" aria-label="Caminho">
    <%= link_to "Armarinhos", distributors_path, class: "hover:text-brand-600" %> › <span aria-current="page"><%= distributor.name %></span>
  </nav>

  <header class="mt-4 max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Armarinho</p>
    <h1 class="mt-2 text-3xl font-bold text-ink"><%= distributor.name %></h1>
    <p class="mt-3 text-sm text-ink-muted">Nota fiscal: <%= { true => "emite", false => "não emite" }.fetch(distributor.issues_invoices, "não informado") %></p>
    <% unless distributor.approved? %>
      <p class="mt-3 text-sm text-ink-muted">Este armarinho está se preparando para começar a vender.</p>
    <% end %>
  </header>

  <% if @supplies.any? %>
    <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
      <% @supplies.each do |supply| %>
        <%= render "supplies/card", product: supply %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-10 text-ink-muted">Este armarinho ainda não publicou insumos.</p>
  <% end %>

  <p class="mt-12 text-sm"><%= link_to "Ver todos os insumos", supplies_path, class: "font-semibold text-brand-600 underline hover:text-brand-700" %></p>
</div>
