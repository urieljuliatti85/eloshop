<% content_for :title, "Distribuidores de insumos | EloShop" %>
<% content_for :meta_description, "Distribuidores de insumos para artesãos na EloShop: fios, tecidos, argila, ferragens e embalagens." %>
<%# Fora do Google até as lojas e a vitrine de insumos irem ao ar (Fase 26,
    PR C): sem elas a página é só uma lista de nomes. %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="container mx-auto max-w-5xl px-5 pb-16 pt-8">
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Para quem faz à mão</p>
    <h1 class="mt-2 text-3xl font-bold text-ink">Distribuidores de insumos</h1>
    <p class="mt-3 text-ink-muted">
      Fornecedores de material para artesãos: fios, tecidos, argila, ferragens, embalagens. A vitrine de insumos,
      com a loja de cada distribuidor, está em preparação.
    </p>
  </header>

  <% if @distributors.any? %>
    <ul role="list" class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @distributors.each do |distributor| %>
        <li class="flex flex-col rounded-3xl border border-sand-200 bg-white p-6 shadow-[0_1px_2px_rgba(120,40,10,0.04)]">
          <h2 class="text-lg font-bold text-ink"><%= distributor.name %></h2>
          <%# Declaração pública e opcional de nota fiscal (ADR 007). %>
          <p class="mt-2 text-sm text-ink-muted">
            Nota fiscal: <%= { true => "emite", false => "não emite" }.fetch(distributor.issues_invoices, "não informado") %>
          </p>
          <p class="mt-4 text-sm font-semibold text-stone-500">Loja em breve</p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <section class="mt-10 rounded-[2rem] border border-sand-200 bg-sand-50 px-6 py-9 sm:px-10" aria-labelledby="distribuidores-vazio">
      <h2 id="distribuidores-vazio" class="text-xl font-bold text-ink">Os primeiros distribuidores chegam em breve</h2>
      <p class="mt-2 max-w-2xl text-ink-muted">Estamos preparando a vitrine de insumos para os artesãos comprarem material de quem fornece.</p>
    </section>
  <% end %>

  <p class="mt-10 text-sm text-ink-muted">
    Vende insumos para artesãos?
    <%= link_to "Veja como funciona para distribuidores", how_it_works_path(aba: "vende", grupo: "distribuidor"), class: "font-semibold text-brand-600 underline hover:text-brand-700" %>.
  </p>
</div>
