<% content_for :title, "Armarinhos | EloShop" %>
<% content_for :meta_description, "Armarinhos na EloShop: fios, linhas, aviamentos, tecidos e outros insumos para quem faz à mão." %>
<%# Fora do Google até o SEO da vitrine de insumos (Fase 26, PR C2):
    sitemap, dados estruturados e textos revistos antes de indexar. %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="container mx-auto max-w-5xl px-5 pb-16 pt-8">
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Para quem faz à mão</p>
    <h1 class="mt-2 text-3xl font-bold text-ink">Armarinhos</h1>
    <p class="mt-3 text-ink-muted">
      Fornecedores de material para artesãos: fios, tecidos, argila, ferragens, embalagens.
      Veja todos os insumos em <%= link_to "Insumos", supplies_path, class: "font-semibold text-brand-600 underline hover:text-brand-700" %>; as compras abrem em breve.
    </p>
  </header>

  <% if @distributors.any? %>
    <ul role="list" class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @distributors.each do |distributor| %>
        <li class="flex flex-col rounded-3xl border border-sand-200 bg-white p-6 shadow-[0_1px_2px_rgba(120,40,10,0.04)]">
          <h2 class="text-lg font-bold text-ink"><%= link_to distributor.name, distributor_store_path(distributor.slug), class: "hover:text-brand-600" %></h2>
          <%# Declaração pública e opcional de nota fiscal (ADR 007). %>
          <p class="mt-2 text-sm text-ink-muted">
            Nota fiscal: <%= { true => "emite", false => "não emite" }.fetch(distributor.issues_invoices, "não informado") %>
          </p>
          <%= link_to "Ver a loja", distributor_store_path(distributor.slug), class: "mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-brand-600 underline hover:text-brand-700" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <section class="mt-10 rounded-[2rem] border border-sand-200 bg-sand-50 px-6 py-9 sm:px-10" aria-labelledby="distribuidores-vazio">
      <h2 id="distribuidores-vazio" class="text-xl font-bold text-ink">Os primeiros armarinhos chegam em breve</h2>
      <p class="mt-2 max-w-2xl text-ink-muted">Estamos preparando a vitrine de insumos para os artesãos comprarem material de quem fornece.</p>
    </section>
  <% end %>

  <p class="mt-10 text-sm text-ink-muted">
    Vende insumos para artesãos?
    <%= link_to "Veja como funciona para armarinhos", how_it_works_path(aba: "vende", grupo: "armarinho"), class: "font-semibold text-brand-600 underline hover:text-brand-700" %>.
  </p>
</div>
