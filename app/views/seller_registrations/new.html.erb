<div class="mx-auto w-full max-w-xl rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
  <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Marketplace EloShop</p>
  <h1 class="mt-2 text-3xl font-bold text-ink">Cadastre seu ateliê</h1>
  <p class="mt-3 text-ink-muted">Seu cadastro ficará pendente até a validação da plataforma. Você poderá acessar o painel, mas só publicará produtos após a aprovação.</p>

  <% errors = @seller.errors.full_messages + @user.errors.full_messages %>
  <% if errors.any? %>
    <div class="mt-6 rounded-xl bg-red-50 p-4 text-sm text-red-700">
      <ul class="list-disc pl-5"><% errors.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with url: seller_registration_path, class: "mt-8 flex flex-col gap-5" do |form| %>
    <div><%= form.label :name, "Nome do ateliê", for: "seller_name" %><%= form.text_field :name, name: "seller[name]", id: "seller_name", value: @seller.name, required: true, class: "mt-2 w-full rounded-xl border-gray-300" %></div>
    <div><%= form.label :email_address, "E-mail", for: "user_email_address" %><%= form.email_field :email_address, name: "user[email_address]", id: "user_email_address", value: @user.email_address, required: true, autocomplete: "email", class: "mt-2 w-full rounded-xl border-gray-300" %></div>
    <div><%= form.label :password, "Senha", for: "user_password" %><%= form.password_field :password, name: "user[password]", id: "user_password", required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 w-full rounded-xl border-gray-300" %></div>
    <div><%= form.label :password_confirmation, "Confirmar senha", for: "user_password_confirmation" %><%= form.password_field :password_confirmation, name: "user[password_confirmation]", id: "user_password_confirmation", required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 w-full rounded-xl border-gray-300" %></div>
    <%= form.submit "Criar cadastro", class: "cursor-pointer rounded-full bg-brand-500 px-6 py-3 font-semibold text-white hover:bg-brand-600" %>
  <% end %>
</div>
