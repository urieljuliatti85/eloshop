<div class="mx-auto w-full max-w-md">
  <h1 class="mb-2 text-2xl font-bold text-ink">Esqueceu sua senha?</h1>
  <p class="mb-8 text-sm text-ink-muted">Enviamos um link de redefinição para o seu e-mail.</p>

  <% if alert = flash[:alert] %>
    <p class="mb-6 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-800" id="alert"><%= alert %></p>
  <% end %>

  <%= form_with url: passwords_path, class: "flex flex-col gap-4" do |form| %>
    <div>
      <%= form.label :email_address, "E-mail", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address],
            class: "w-full rounded-xl border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <%= form.submit "Enviar instruções por e-mail", class: "mt-2 w-fit cursor-pointer rounded-full bg-brand-500 px-8 py-3 text-sm font-semibold text-white hover:bg-brand-600" %>
  <% end %>

  <p class="mt-8 text-sm text-ink-muted">
    Lembrou? <%= link_to "Voltar para o login", new_session_path, class: "font-medium text-brand-600 hover:underline" %>.
  </p>
</div>
