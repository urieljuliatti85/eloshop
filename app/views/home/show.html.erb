<% content_for :canonical_url, root_url %>
<% content_for :body_class, "home-background" %>
<%# A URL sai daqui, e não do CSS do Tailwind: aquele arquivo é gerado fora
    do pipeline do Propshaft, então o caminho não ganharia o digest e daria
    404. O nonce é o que a CSP (`style_src :self`) exige de um <style>. %>
<% content_for :head do %>
  <%= tag.style nonce: content_security_policy_nonce do %>
    body.home-background { background-image: url("<%= asset_path("home-background.jpg") %>"); }
  <% end %>
<% end %>

<div class="w-full">
  <%# Carrossel de dois banners. A faixa é uma lista rolável com scroll-snap:
      sem JavaScript os dois continuam alcançáveis pela rolagem horizontal, e
      o Stimulus só acrescenta os controles e o avanço automático. Mesmo
      princípio da faixa de categorias abaixo. %>
  <section class="relative" aria-roledescription="carrossel" aria-label="Destaques"
           data-controller="carousel"
           data-carousel-interval-value="<%= Rails.env.test? ? 0 : 7000 %>"
           data-action="keydown.left->carousel#previous keydown.right->carousel#next
                        mouseenter->carousel#stop mouseleave->carousel#start
                        focusin->carousel#stop focusout->carousel#start">
    <ul class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-[2rem] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        data-carousel-target="track">
      <%# Cartão branco sobre a paisagem: o gradiente laranja competia com o
          fundo, que agora é a foto do pôr do sol. O texto inverte junto —
          escuro sobre claro. %>
      <%# Metade transparente: a paisagem atravessa o cartão. O texto ganha
          sombra para sobreviver ao que passa por trás. %>
      <li class="relative w-full flex-none snap-start overflow-hidden bg-white/50"
          data-carousel-target="slide" aria-label="1 de 2">
        <div class="pointer-events-none absolute -right-20 top-1/2 h-96 w-96 -translate-y-1/2 rounded-full bg-brand-100/60 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-24 left-1/4 h-64 w-64 rounded-full bg-sand-100/70 blur-3xl"></div>

        <div class="relative flex max-w-2xl flex-col items-start gap-6 px-8 py-16 md:px-16 md:py-20">
          <span class="rounded-full bg-brand-50 px-5 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">Feito à mão</span>

          <%# Sem <br>: a largura do bloco já quebra o título depois de
              "história,", e o texto segue íntegro para leitores de tela e
              para o teste. %>
          <h1 class="text-4xl font-black leading-[1.05] tracking-tight text-ink sm:text-5xl md:text-6xl">
            Peças com história, feitas à mão
          </h1>

          <%# Texto forte, e não `ink-muted`: sobre o cartão translúcido o
              cinza claro perdia contraste contra o céu que passa por trás. %>
          <p class="max-w-md text-lg font-medium leading-relaxed text-ink">
            Cada produto é feito à mão, em pequenas tiragens ou sob encomenda. Conheça o processo antes de comprar.
          </p>

          <%= link_to "Ver produtos", products_path, class: "rounded-full bg-brand-500 px-8 py-4 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-600" %>
        </div>
      </li>

      <%# O segundo banner fala com o artesão, não com o comprador: foto do
          ateliê no lugar do gradiente puro. O véu escuro por cima existe para
          o texto branco manter contraste sobre qualquer região da foto —
          sem ele, o título cai em cima dos pincéis claros. %>
      <li class="relative w-full flex-none snap-start overflow-hidden bg-ink"
          data-carousel-target="slide" aria-label="2 de 2">
        <%# alt vazio: a foto é decorativa, e o título ao lado já diz do que
            se trata (§62). %>
        <%= image_tag "atelie-banner.jpg", alt: "", loading: "lazy",
              class: "absolute inset-0 h-full w-full object-cover" %>
        <%# Dois véus: no mobile o texto ocupa a largura toda e precisa de um
            escurecimento uniforme; a partir de md ele fica só na metade
            esquerda, e o gradiente horizontal devolve as cores da foto à
            direita. %>
        <div class="absolute inset-0 bg-ink/70 md:bg-gradient-to-r md:from-ink/95 md:via-ink/70 md:to-transparent"></div>

        <div class="relative flex max-w-2xl flex-col items-start gap-6 px-8 py-16 md:px-16 md:py-20">
          <span class="rounded-full bg-white/25 px-5 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white">Para o Artesão</span>

          <h2 class="text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl md:text-6xl">
            Venda suas peças mais criativas através do nosso Ateliê
          </h2>

          <p class="max-w-md text-lg leading-relaxed text-white/90">
            Você pode optar em vender cada peça em pequenas tiragens ou sob encomenda. Conheça o nosso Ateliê e comece a vender!
          </p>

          <%= link_to "Seja um artesão", new_seller_registration_path, class: "rounded-full bg-white px-8 py-4 text-sm font-semibold text-brand-600 shadow-sm transition hover:bg-brand-50" %>
        </div>
      </li>
    </ul>

    <%# Controles só aparecem com JavaScript: sem ele a rolagem da própria
        faixa já dá conta, e um botão inerte seria pior que nenhum. %>
    <div class="mt-4 flex items-center justify-center gap-3" data-carousel-target="controls" hidden>
      <button type="button" class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-brand-500 text-white shadow-sm transition hover:bg-brand-600"
              data-action="carousel#previous" aria-label="Banner anterior">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="m15 5-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div class="flex items-center gap-2" role="tablist">
        <% 2.times do |index| %>
          <%# Branco translúcido: o cinza sumia sobre o céu laranja do fundo.
              O ponto ativo vira `bg-brand-500` pelo controller. %>
          <button type="button" class="h-2.5 w-2.5 cursor-pointer rounded-full bg-white/70 transition"
                  data-carousel-target="dot" data-index="<%= index %>"
                  data-action="carousel#goTo" role="tab"
                  aria-label="Ir para o banner <%= index + 1 %>"></button>
        <% end %>
      </div>

      <button type="button" class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-brand-500 text-white shadow-sm transition hover:bg-brand-600"
              data-action="carousel#next" aria-label="Próximo banner">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </section>

  <% if @categories.any? %>
    <section class="mt-16">
      <%# Branco com sombra: este título fica direto sobre a foto do fundo, e
          o laranja do céu não garante contraste sozinho. %>
      <h2 class="text-3xl font-bold tracking-tight text-white [text-shadow:0_1px_12px_rgba(0,0,0,0.35)] md:text-4xl">Explore por categoria.</h2>

      <%# Faixa horizontal rolável: as categorias ficam em uma linha só, do
          jeito que a vitrine as apresenta, e o excedente é alcançado pelo
          scroll — sem JavaScript, com snap para a rolagem parar alinhada. %>
      <div class="mt-8 flex items-start gap-2">
        <ul class="flex flex-1 snap-x snap-mandatory gap-4 overflow-x-auto pb-4 sm:gap-8">
          <% @categories.each do |category| %>
            <li class="w-28 flex-none snap-start sm:w-32">
              <%= link_to products_path(category: category.slug), class: "group flex flex-col items-center gap-3 text-center" do %>
                <div class="flex h-24 w-24 items-center justify-center overflow-hidden rounded-2xl bg-sand-100 transition group-hover:bg-brand-50 sm:h-28 sm:w-28">
                  <% if (cover = @category_covers[category]) %>
                    <%= image_tag cover.main_image, class: "h-full w-full object-cover transition duration-300 group-hover:scale-105", alt: "", loading: "lazy" %>
                  <% end %>
                </div>
                <span class="text-base font-medium text-white [text-shadow:0_1px_10px_rgba(0,0,0,0.4)] transition group-hover:text-brand-100"><%= category.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <%# Atalho para o catálogo completo, no lugar em que a referência põe a
            seta de avanço da faixa. %>
        <%= link_to products_path, class: "mt-8 hidden h-12 w-12 flex-none items-center justify-center rounded-full border border-gray-200 text-ink transition hover:border-brand-500 hover:text-brand-600 sm:flex", aria: { label: "Ver todas as categorias" } do %>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
