<% content_for :canonical_url, root_url %>

<div class="w-full">
  <%# Composição centralizada sobre o creme da vitrine: o coração de linha
      abre o bloco, e o texto desce em uma coluna estreita até a chamada.
      A borda rasgada no pé separa o hero do resto da página. %>
  <%# Tira a seção da caixa do <main>, que é um container com largura máxima,
      para o hero sangrar de ponta a ponta. O overflow-x-clip do <body> apara
      o que passa da viewport por causa da barra de rolagem. %>
  <section class="relative left-1/2 -mt-12 w-screen -translate-x-1/2 overflow-hidden bg-[#f6ebdd] px-5 pb-28 pt-16 md:pb-36 md:pt-20">
    <div class="relative mx-auto flex max-w-2xl flex-col items-center gap-6 text-center">
      <%# Coração de linha, desenhado em SVG: acompanha a cor da marca e não
          depende de nenhum arquivo de imagem. %>
      <svg class="h-24 w-24 text-brand-500 md:h-28 md:w-28" viewBox="0 0 100 90" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M50 82C50 82 8 58 8 30A22 22 0 0 1 50 20a22 22 0 0 1 42 10c0 28-42 52-42 52Z" stroke-linejoin="round" />
        <%# Fios do novelo: arcos paralelos acompanhando a curva do coração. %>
        <g stroke-width="1.5" stroke-linecap="round" opacity="0.75">
          <path d="M20 34c0 16 15 29 30 38" />
          <path d="M28 24c-2 18 10 33 22 44" />
          <path d="M40 20c-6 16 2 32 10 46" />
          <path d="M60 20c6 16-2 32-10 46" />
          <path d="M72 24c2 18-10 33-22 44" />
          <path d="M80 34c0 16-15 29-30 38" />
        </g>
      </svg>

      <%# Sem <br>: a largura do bloco já quebra o título, e o texto segue
          íntegro para leitores de tela e para o teste. %>
      <h1 class="text-4xl font-black leading-[1.1] tracking-tight text-ink sm:text-5xl md:text-6xl">
        Peças com história, feitas à mão.
      </h1>

      <p class="max-w-lg text-lg leading-relaxed text-ink-muted md:text-xl">
        …e personalize do seu jeito, 100% seu.
      </p>

      <%= link_to "Ver todos os produtos", products_path, class: "rounded-full bg-brand-500 px-9 py-4 text-base font-semibold text-white shadow-sm transition hover:bg-brand-600" %>
    </div>

    <%# Borda rasgada: uma faixa de papel rasgado separando o hero do conteúdo,
        na cor do fundo da página. Decorativa, fora da árvore de acessibilidade. %>
    <svg class="pointer-events-none absolute -inset-x-px bottom-[-1px] block h-10 w-[calc(100%+2px)] text-sand-50 md:h-14" viewBox="0 0 1440 60" preserveAspectRatio="none" fill="currentColor" aria-hidden="true">
      <path d="M0 60V28c40-6 72 4 118 9s78-6 120-9 74 10 118 12 76-13 120-14 78 12 122 12 74-14 118-13 76 15 120 14 74-16 118-14 78 16 120 15 76-14 120-16 78 8 126 4v32Z" />
    </svg>
  </section>

  <% if @categories.any? %>
    <section class="mt-16">
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">Explore por categoria.</h2>

      <%# Faixa horizontal rolável: as categorias ficam em uma linha só, do
          jeito que a vitrine as apresenta, e o excedente é alcançado pelo
          scroll — sem JavaScript, com snap para a rolagem parar alinhada. %>
      <div class="mt-8 flex items-start gap-2">
        <ul class="flex flex-1 snap-x snap-mandatory gap-4 overflow-x-auto pb-4 sm:gap-8">
          <% @categories.each do |category| %>
            <li class="w-28 flex-none snap-start sm:w-32">
              <%= link_to products_path(category: category.slug), class: "group flex flex-col items-center gap-3 text-center" do %>
                <div class="flex h-24 w-24 items-center justify-center overflow-hidden rounded-2xl bg-sand-100 transition group-hover:bg-brand-50 sm:h-28 sm:w-28">
                  <% if (cover = @category_covers[category]) %>
                    <%= image_tag cover.main_image, class: "h-full w-full object-cover transition duration-300 group-hover:scale-105", alt: "", loading: "lazy" %>
                  <% end %>
                </div>
                <span class="text-base font-medium text-ink transition group-hover:text-brand-600"><%= category.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <%# Atalho para o catálogo completo, no lugar em que a referência põe a
            seta de avanço da faixa. %>
        <%= link_to products_path, class: "mt-8 hidden h-12 w-12 flex-none items-center justify-center rounded-full border border-gray-200 text-ink transition hover:border-brand-500 hover:text-brand-600 sm:flex", aria: { label: "Ver todas as categorias" } do %>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
