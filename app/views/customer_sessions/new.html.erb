<div class="w-full max-w-md">
  <h1 class="text-2xl font-bold mb-6">Entrar</h1>

  <% if alert %>
    <p class="mb-4 text-red-700"><%= alert %></p>
  <% end %>

  <%= form_with url: customer_session_path, class: "flex flex-col gap-4" do |form| %>
    <div>
      <%= form.label :email, "E-mail" %>
      <%= form.email_field :email, class: "border rounded w-full px-2 py-1" %>
    </div>

    <div>
      <%= form.label :password, "Senha" %>
      <%= form.password_field :password, class: "border rounded w-full px-2 py-1" %>
    </div>

    <%= form.submit "Entrar", class: "bg-black text-white px-4 py-2 rounded w-fit" %>
  <% end %>

  <p class="mt-4"><%= link_to "Criar conta", new_customer_path %></p>
</div>
