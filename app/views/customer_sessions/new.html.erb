<div class="mx-auto w-full max-w-md">
  <h1 class="mb-8 text-2xl font-bold text-ink">Entrar</h1>

  <% if alert %>
    <p class="mb-6 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-800"><%= alert %></p>
  <% end %>

  <%= form_with url: customer_session_path, class: "flex flex-col gap-4" do |form| %>
    <div>
      <%= form.label :email, "E-mail", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.email_field :email, class: "w-full rounded-xl border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, "Senha", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.password_field :password, class: "w-full rounded-xl border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <%= form.submit "Entrar", class: "mt-2 w-fit cursor-pointer rounded-full bg-brand-500 px-8 py-3 text-sm font-semibold text-white hover:bg-brand-600" %>
  <% end %>

  <p class="mt-6 text-sm text-ink-muted">
    Ainda não tem conta? <%= link_to "Criar conta", new_customer_path, class: "font-medium text-brand-600 hover:underline" %>
  </p>
</div>
