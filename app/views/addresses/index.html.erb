<% content_for :title, "Endereços | Minha conta" %>

<div class="w-full max-w-3xl">
  <nav class="text-sm text-ink-muted">
    <%= link_to "Minha conta", account_root_path, class: "hover:text-brand-600" %>
    <span class="mx-2">/</span>
    <span class="text-ink">Endereços</span>
  </nav>

  <header class="mt-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-ink">Endereços</h1>
      <p class="mt-1 text-sm text-ink-muted">Usados na entrega dos seus pedidos.</p>
    </div>
    <%= link_to "Novo endereço", new_address_path, class: "rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600" %>
  </header>

  <% if @addresses.any? %>
    <ul class="mt-8 space-y-4">
      <% @addresses.each do |address| %>
        <li class="flex items-start justify-between gap-4 rounded-2xl border border-gray-200 px-5 py-4">
          <div class="text-sm">
            <p class="font-medium text-ink"><%= address.street %>, <%= address.number %></p>
            <% if address.complement.present? %>
              <p class="text-ink-muted"><%= address.complement %></p>
            <% end %>
            <p class="text-ink-muted"><%= address.neighborhood %> — <%= address.city %>/<%= address.state %></p>
            <p class="text-ink-muted">CEP <%= address.zip_code %></p>
          </div>

          <div class="flex shrink-0 items-center gap-3 text-sm">
            <%= link_to "Editar", edit_address_path(address), class: "font-medium text-brand-600 hover:underline" %>
            <%# Remover não afeta pedidos já feitos: o pedido guarda o snapshot
                do endereço usado na compra. %>
            <%= button_to "Remover", address_path(address), method: :delete,
                  class: "cursor-pointer font-medium text-ink-muted hover:text-red-700",
                  form: { data: { turbo_confirm: "Remover este endereço?" } } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-8 rounded-2xl bg-sand-50 px-6 py-8 text-center text-ink-muted">
      Você ainda não cadastrou nenhum endereço.
    </p>
  <% end %>
</div>
