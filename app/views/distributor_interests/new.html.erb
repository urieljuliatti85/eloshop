<% content_for :title, "Quero ser distribuidor | EloShop" %>
<% content_for :meta_description, "Deixe seu e-mail e WhatsApp para receber novidades sobre o pré-cadastro de armarinhos na EloShop." %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<div class="mx-auto max-w-xl px-5 py-12 sm:py-16">
  <div class="rounded-[2rem] border border-[#f0e4da] bg-white p-6 shadow-[0_8px_30px_rgba(110,65,35,0.08)] sm:p-9">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Pré-cadastro de armarinhos</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">Quer ser um distribuidor?</h1>
    <p class="mt-4 leading-7 text-ink-muted">Estamos em pré-cadastro. Se você já quer adiantar sua loja, informe seus contatos. Avisaremos quando o cadastro abrir.</p>

    <% if @interest.errors.any? %>
      <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
        <p class="font-semibold">Confira os dados:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <% @interest.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @interest, scope: :distributor_interest, url: distributor_interest_path, class: "mt-7 flex flex-col gap-5" do |form| %>
      <div>
        <%= form.label :email_address, "E-mail", class: "text-sm font-semibold text-ink" %>
        <%= form.email_field :email_address, required: true, autocomplete: "email", maxlength: 254, class: "mt-2 min-h-12 w-full rounded-xl border border-sand-200 px-4 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" %>
      </div>
      <div>
        <%= form.label :whatsapp_number, "Telefone com WhatsApp", class: "text-sm font-semibold text-ink" %>
        <%= form.telephone_field :whatsapp_number, required: true, autocomplete: "tel", inputmode: "tel", maxlength: 18, placeholder: "(11) 99999-9999", class: "mt-2 min-h-12 w-full rounded-xl border border-sand-200 px-4 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" %>
      </div>
      <label class="flex items-start gap-3 text-sm leading-6 text-ink-muted">
        <%= check_box_tag :consent, "1", params[:consent] == "1", required: true, class: "mt-1 size-4 rounded border-sand-300 text-brand-600 focus:ring-brand-500" %>
        <span>Autorizo a EloShop a usar meu e-mail e WhatsApp para me avisar sobre a abertura do pré-cadastro de armarinhos. Consulte a <%= link_to "Política de Privacidade", privacy_policy_path, class: "font-semibold text-brand-700 underline" %>.</span>
      </label>

      <div class="absolute left-[-9999px]" aria-hidden="true">
        <%= label_tag :website, "Não preencha este campo" %>
        <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
      </div>
      <%= hidden_field_tag :form_token, ContactMessage.issue_token %>
      <%= render "shared/turnstile" %>

      <%= form.submit "Quero ser avisado", class: "inline-flex min-h-12 cursor-pointer items-center justify-center rounded-full bg-brand-600 px-6 font-bold text-white transition hover:bg-brand-700" %>
    <% end %>

    <p class="mt-7 text-sm"><%= link_to "← Voltar para armarinhos", distributors_path, class: "font-semibold text-brand-700 underline underline-offset-4" %></p>
  </div>
</div>
