<% content_for :title, "Solicitação do pedido ##{@order.id}" %>

<div class="mx-auto w-full max-w-2xl">
  <%= link_to "← Pedido ##{@order.id}", order_path(@order), class: "mb-6 inline-block text-sm font-semibold text-brand-600 hover:underline" %>

  <header>
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Pós-venda</p>
    <h1 class="mt-1 text-3xl font-black tracking-tight text-ink">Desistir da compra ou relatar um problema</h1>
    <p class="mt-2 text-sm text-ink-muted">Pedido #<%= @order.id %> · <%= @seller_order.seller.name %></p>
  </header>

  <p class="mt-6 text-sm text-ink">
    Ao enviar, você recebe um <strong>protocolo</strong> na hora e uma cópia por e-mail. A EloShop responde em até
    <strong>2 dias úteis</strong>.
  </p>

  <%= form_with model: @return_request, url: order_return_requests_path(@order), class: "mt-8 space-y-6" do |form| %>
    <fieldset>
      <legend class="text-sm font-semibold text-ink">Motivo</legend>
      <div class="mt-3 space-y-3">
        <% ReturnRequest::KIND_LABELS.slice(*@available_kinds).each do |kind, label| %>
          <label class="flex min-h-11 cursor-pointer items-start gap-3 rounded-xl border border-gray-200 p-4 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
            <%= form.radio_button :kind, kind, required: true, class: "mt-1 size-4 shrink-0 accent-brand-600" %>
            <span>
              <span class="block text-sm font-semibold text-ink"><%= label %></span>
              <span class="block text-sm text-ink-muted">
                <%= { "withdrawal" => "Você não quer mais o pedido. Se ele ainda não foi enviado, o ateliê é avisado para não enviar.",
                      "product_issue" => "A peça chegou com defeito, avariada ou diferente do anunciado.",
                      "delivery_issue" => "O pedido atrasou ou não chegou." }.fetch(kind) %>
              </span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div>
      <%= form.label :description, "Conte o que aconteceu (opcional)", class: "block text-sm font-semibold text-ink" %>
      <%= form.text_area :description, rows: 5, maxlength: 2000,
            class: "mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-base text-ink focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200" %>
      <p class="mt-1 text-sm text-ink-muted">Fotos não são obrigatórias. Se quiser mandar, responda o e-mail do protocolo.</p>
    </div>

    <%= form.submit "Enviar solicitação",
          class: "inline-flex min-h-11 cursor-pointer items-center rounded-full bg-brand-600 px-8 text-sm font-semibold text-white hover:bg-brand-700" %>
  <% end %>
</div>
