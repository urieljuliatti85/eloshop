<%# Convite para quem ainda não conectou o Mercado Pago. Some sozinho quando
    `mercado_pago_connected?` vira verdadeiro; o banner de conexão (_banner)
    continua abaixo com o estado detalhado. %>
<section class="flex flex-col gap-5 rounded-2xl border-2 border-red-300 bg-red-50 px-6 py-5 sm:flex-row sm:items-center sm:justify-between" aria-labelledby="mp-required-title">
  <div class="flex items-start gap-4">
    <%= render "seller_portal/mercado_pago_guides/alert_icon", class_name: "mt-0.5 size-7 shrink-0 text-red-600" %>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-700">Passo obrigatório</p>
      <h2 id="mp-required-title" class="mt-1 text-xl font-bold text-red-950">Para vender na EloShop você precisa de uma Conta Vendedor no Mercado Pago</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-red-900">É a conta do Mercado Pago que recebe o pagamento dos seus clientes. Sem ela conectada, seus produtos não podem ser publicados.</p>
    </div>
  </div>
  <div class="flex shrink-0 flex-col gap-3 sm:items-end">
    <% if @mercado_pago_oauth_configured %>
      <%= link_to "Já tenho conta: conectar", seller_mercado_pago_connect_path, class: "inline-flex min-h-11 items-center justify-center rounded-full bg-red-700 px-6 py-3 text-sm font-bold text-white hover:bg-red-800", data: { turbo: false } %>
    <% end %>
    <%= link_to "Ainda não tenho: ver passo a passo", seller_mercado_pago_guide_path, class: "inline-flex min-h-11 items-center justify-center rounded-full border border-red-300 bg-white px-6 py-3 text-sm font-bold text-red-800 hover:bg-red-100" %>
  </div>
</section>
