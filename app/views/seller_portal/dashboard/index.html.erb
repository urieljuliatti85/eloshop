<% content_for :title, "Visão geral | #{current_seller.name}" %>

<div class="space-y-8">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-black tracking-tight text-stone-950">Visão geral</h1>
      <p class="mt-1 text-sm text-stone-600"><%= current_seller.name %></p>
    </div>
    <%= link_to "Adicionar nova peça", new_seller_product_path, class: "seller-button seller-button--primary" %>
  </header>

  <%# Convite ao tour: no topo só para quem ainda não fez. Depois de concluído,
      "Refazer o tour" vai para o fim da página — continua à mão, sem disputar
      espaço com o que precisa de ação. %>
  <%= render "seller_portal/tours/call" unless current_seller.tour_completed_at? %>

  <%# Os avisos vêm antes do resumo de trabalho, na mesma ordem de antes: sem
      chave PIX o pagamento PIX é recusado, e sem a conta do Mercado Pago nada
      pode ser publicado. %>
  <%= render "seller_portal/mercado_pago_connections/pix_key_notice", compact: true %>

  <%# Some quando as quatro etapas estão prontas — depois disso "Para começar a
      vender" seria ruído, e a página segue na navegação. %>
  <% unless @getting_started_steps.values.all? %>
    <%= render "seller_portal/getting_started/banner", steps: @getting_started_steps %>
  <% end %>

  <%# A ordem importa: "Cadastro em análise" remete ao aviso da conta, que fica acima dele. %>
  <% unless current_seller.mercado_pago_account_state == :ready %>
    <%= render "seller_portal/mercado_pago_connections/required_banner" %>
  <% end %>

  <% unless current_seller.approved? %>
    <section class="rounded-2xl border border-amber-300 bg-amber-50 px-6 py-5">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-700">Ação necessária</p>
      <h2 class="mt-1 text-xl font-bold text-amber-950">Cadastro em análise</h2>
      <%# Enquanto não há conta aceita, o próximo passo é da vendedora, não da
          plataforma: o admin nem consegue aprovar (`approve!`). %>
      <% if current_seller.mercado_pago_account_state == :ready %>
        <p class="mt-2 text-sm text-amber-800">A plataforma ainda precisa concluir a validação. Produtos não podem ser publicados enquanto o cadastro estiver <%= t(current_seller.status, scope: "sellers.statuses").downcase %>.</p>
      <% else %>
        <p class="mt-2 text-sm text-amber-800">Conecte uma Conta Vendedor real do Mercado Pago (aviso acima) para a plataforma poder analisar o cadastro. Produtos não podem ser publicados enquanto o cadastro estiver <%= t(current_seller.status, scope: "sellers.statuses").downcase %>.</p>
      <% end %>
    </section>
  <% end %>

  <%# Só enquanto não há conexão (nunca conectou ou foi desconectado): é onde
      aparecem as opções de Conectar. Com a conta conectada, o box com
      Reconectar e Desconectar mora em "Conta Vendedor no Mercado Pago" (e em
      "Dados do Ateliê"), e o painel fica limpo. %>
  <% unless current_seller.mercado_pago_connected? %>
    <%= render "seller_portal/mercado_pago_connections/banner" %>
  <% end %>

  <%# O que pede ação hoje, em frases e não em números soltos: o artesão abre o
      painel para saber se tem pedido para enviar. Só aparecem as linhas com algo. %>
  <section class="seller-card" aria-labelledby="todo-title">
    <h2 id="todo-title" class="text-xl font-bold text-stone-950">O que fazer agora</h2>
    <% todo = [
      ([ @to_prepare_count, @to_prepare_count == 1 ? "pedido pago para preparar e enviar" : "pedidos pagos para preparar e enviar", "Ver pedidos", seller_orders_path, true ] if @to_prepare_count.positive?),
      ([ @low_stock_count, @low_stock_count == 1 ? "produto com estoque baixo" : "produtos com estoque baixo", "Ver produtos", seller_products_path, false ] if @low_stock_count.positive?),
      ([ @awaiting_payment_count, @awaiting_payment_count == 1 ? "pedido aguardando o pagamento do cliente" : "pedidos aguardando o pagamento do cliente", "Acompanhar", seller_orders_path, false ] if @awaiting_payment_count.positive?)
    ].compact %>
    <% if todo.any? %>
      <ul class="mt-4 divide-y divide-brand-100">
        <% todo.each do |count, text, action, path, urgent| %>
          <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3">
            <p class="text-sm text-stone-700"><strong class="text-lg font-black <%= urgent ? 'text-brand-700' : 'text-stone-950' %>"><%= count %></strong> <%= text %></p>
            <%= link_to action, path, class: "inline-flex min-h-11 items-center text-sm font-bold text-stone-700 underline decoration-stone-300 underline-offset-4 hover:text-brand-600" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm leading-6 text-stone-600">Nada pendente agora. Quando um pedido for pago, ele aparece aqui para você preparar.</p>
    <% end %>
  </section>

  <section aria-labelledby="numbers-title">
    <div class="mb-4 flex items-end justify-between gap-4">
      <h2 id="numbers-title" class="text-2xl font-bold">Seus números</h2>
      <p class="text-sm text-stone-500">Desde a abertura do ateliê</p>
    </div>
    <div class="grid gap-px overflow-hidden rounded-2xl border border-brand-100 bg-brand-100 sm:grid-cols-2 lg:grid-cols-5">
      <% [
        ["Produtos", @products_count],
        ["Publicados", @active_products_count],
        ["Estoque baixo", @low_stock_count],
        ["Pedidos", @orders_count],
        ["Líquido em vendas", format_price(@seller_revenue_cents), "Já sem a comissão da EloShop"]
      ].each do |label, value, note| %>
        <div class="bg-white px-5 py-6"><p class="text-xs font-semibold uppercase tracking-wider text-stone-500"><%= label %></p><p class="mt-2 text-2xl font-black tracking-tight text-stone-950"><%= value %></p><% if note %><p class="mt-1 text-xs text-stone-500"><%= note %></p><% end %></div>
      <% end %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
    <div class="seller-card-lg">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold">Produtos recentes</h2>
        <%= link_to "Ver todos", seller_products_path, class: "inline-flex min-h-11 items-center text-sm font-bold text-stone-700 underline decoration-stone-300 underline-offset-4 hover:text-brand-600" %>
      </div>

      <% if @recent_products.any? %>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <% @recent_products.each do |product| %>
            <%= link_to seller_product_path(product), class: "group flex min-w-0 items-center gap-4 rounded-2xl border border-brand-100 p-3 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md" do %>
              <span class="grid size-20 shrink-0 place-items-center overflow-hidden rounded-xl bg-[#eee7da] text-2xl text-stone-400">
                <% if product.main_image.attached? %><%= image_tag product.main_image.variant(resize_to_fill: [240, 240]), alt: product.name, class: "h-full w-full object-cover" %><% else %><span aria-hidden="true">✦</span><% end %>
              </span>
              <span class="min-w-0"><strong class="block truncate text-sm text-stone-950"><%= product.name %></strong><span class="mt-1 block text-xs text-stone-500"><%= t(product.status, scope: "products.statuses") %> · <%= product.stock_quantity %> em estoque</span><span class="mt-2 block text-sm font-bold"><%= format_price(product.price_cents) %></span></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="mt-6 rounded-2xl border border-dashed border-stone-300 px-6 py-10 text-center"><p class="font-semibold">Sua primeira peça começa aqui.</p><%= link_to "Cadastrar produto", new_seller_product_path, class: "mt-3 inline-block text-sm font-bold text-brand-600 underline underline-offset-4" %></div>
      <% end %>
    </div>

    <div class="rounded-[2rem] bg-[#5c1a0b] p-6 text-white shadow-sm sm:p-8">
      <div class="flex items-center justify-between gap-4"><h2 class="text-2xl font-bold">Últimos pedidos</h2><%= link_to "Ver todos", seller_orders_path, class: "inline-flex min-h-11 items-center text-sm font-bold text-white/80 underline underline-offset-4 hover:text-white" %></div>
      <% if @recent_seller_orders.any? %>
        <ol class="mt-5 divide-y divide-white/15">
          <% @recent_seller_orders.each do |seller_order| %>
            <li><%= link_to seller_order_path(seller_order.order), class: "flex items-center justify-between gap-4 py-4 first:pt-0" do %><span><strong class="block text-sm">Pedido #<%= seller_order.order_id %></strong><span class="mt-1 block text-xs text-white/60"><%= seller_order.order.customer.name %> · <%= l(seller_order.created_at.to_date, format: :short) %></span></span><span class="text-right"><strong class="block text-sm"><%= format_price(seller_order.seller_amount_cents) %></strong><span class="mt-1 block text-xs text-[#d8bd8d]"><%= t(seller_order.status, scope: "seller_orders.statuses") %></span></span><% end %></li>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-6 text-sm leading-6 text-white/65">Quando sua primeira venda chegar, ela aparecerá aqui com o valor a receber e o status da operação.</p>
      <% end %>
    </div>
  </section>

  <%= render "seller_portal/tours/call" if current_seller.tour_completed_at? %>
</div>
