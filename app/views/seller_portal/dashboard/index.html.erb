<% content_for :title, "Visão geral | #{current_seller.name}" %>

<div class="space-y-8">
  <section class="grid min-h-[31rem] gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,0.78fr)]">
    <article class="group relative isolate min-h-[25rem] overflow-hidden rounded-[2rem] bg-[#273b31] text-white shadow-sm lg:min-h-full">
      <% if @featured_product&.main_image&.attached? %>
        <%= image_tag @featured_product.main_image.variant(resize_to_fill: [1200, 760]), alt: @featured_product.name, class: "absolute inset-0 -z-20 h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]" %>
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/75 via-black/35 to-transparent"></div>
      <% else %>
        <div class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_75%_25%,#d7c7a1_0,transparent_27%),radial-gradient(circle_at_75%_72%,#9bac91_0,transparent_28%),linear-gradient(135deg,#273b31,#526d5d)]"></div>
        <div class="absolute right-[12%] top-[12%] -z-10 size-40 rotate-6 border-[1.25rem] border-white/15 sm:size-64"></div>
        <div class="absolute bottom-[8%] right-[32%] -z-10 size-28 -rotate-12 border-[0.8rem] border-[#e7cfa5]/30 sm:size-44"></div>
      <% end %>

      <div class="flex h-full max-w-2xl flex-col justify-end p-7 sm:p-10 lg:p-12">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-[#f2d49f]">Seu ateliê na EloShop</p>
        <h1 class="max-w-xl text-4xl font-black leading-[0.98] tracking-tight sm:text-5xl lg:text-6xl">Crie, publique e acompanhe cada venda.</h1>
        <p class="mt-5 max-w-lg text-sm leading-6 text-white/80 sm:text-base">Tudo que você precisa para transformar peças autorais em uma vitrine viva — sem perder de vista estoque, pedidos e recebimentos.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <%= link_to "Adicionar nova peça", new_seller_product_path, class: "rounded-full bg-white px-6 py-3 text-sm font-bold text-[#24372d] transition hover:bg-[#f3e4c9]" %>
          <%= link_to "Gerenciar catálogo", seller_products_path, class: "rounded-full border border-white/40 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10" %>
        </div>
      </div>
    </article>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
      <%= link_to seller_products_path, class: "group relative min-h-56 overflow-hidden rounded-[2rem] bg-[#ead9b8] p-7 text-[#2a332d] shadow-sm" do %>
        <span class="text-xs font-bold uppercase tracking-[0.18em]">Catálogo</span>
        <strong class="mt-4 block max-w-56 text-3xl leading-none">Dê destaque às suas histórias.</strong>
        <span class="mt-6 inline-flex border-b-2 border-current pb-1 text-sm font-bold">Ver produtos</span>
        <span class="absolute -bottom-12 -right-8 size-44 rounded-full bg-[#d09a63] transition duration-500 group-hover:scale-110"></span>
        <span class="absolute bottom-8 right-10 grid size-20 rotate-6 place-items-center border-8 border-white/65 text-3xl">✦</span>
      <% end %>

      <%= link_to seller_orders_path, class: "group relative min-h-56 overflow-hidden rounded-[2rem] bg-[#dfe8df] p-7 text-[#23382d] shadow-sm" do %>
        <span class="text-xs font-bold uppercase tracking-[0.18em]">Operação</span>
        <strong class="mt-4 block text-3xl leading-none"><%= @pending_orders_count %> <%= @pending_orders_count == 1 ? "pedido espera" : "pedidos esperam" %> por você.</strong>
        <span class="mt-6 inline-flex border-b-2 border-current pb-1 text-sm font-bold">Acompanhar pedidos</span>
        <svg viewBox="0 0 120 120" class="absolute -bottom-7 -right-5 size-36 text-[#88a78f] transition duration-500 group-hover:-translate-y-2" fill="none" stroke="currentColor" stroke-width="12" aria-hidden="true"><path d="M25 42h70l-8 58H33L25 42Z"/><path d="M42 44V30a18 18 0 0 1 36 0v14"/></svg>
      <% end %>
    </div>
  </section>

  <% unless current_seller.approved? %>
    <section class="rounded-2xl border border-amber-300 bg-amber-50 px-6 py-5">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-700">Ação necessária</p>
      <h2 class="mt-1 text-xl font-bold text-amber-950">Cadastro em análise</h2>
      <p class="mt-2 text-sm text-amber-800">A plataforma ainda precisa concluir a validação. Produtos não podem ser publicados enquanto o cadastro estiver <%= current_seller.status %>.</p>
    </section>
  <% end %>

  <section aria-labelledby="numbers-title">
    <div class="mb-4 flex items-end justify-between gap-4">
      <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">Hoje no ateliê</p><h2 id="numbers-title" class="mt-1 text-2xl font-bold">Seus números</h2></div>
      <p class="hidden text-sm text-stone-500 sm:block">Visão acumulada da operação</p>
    </div>
    <div class="grid gap-px overflow-hidden rounded-2xl border border-stone-200 bg-stone-200 sm:grid-cols-2 lg:grid-cols-5">
      <% [
        ["Produtos", @products_count],
        ["Publicados", @active_products_count],
        ["Estoque baixo", @low_stock_count],
        ["Pedidos", @orders_count],
        ["Líquido em vendas", number_to_currency(@seller_revenue_cents.fdiv(100))]
      ].each do |label, value| %>
        <div class="bg-white px-5 py-6"><p class="text-xs font-semibold uppercase tracking-wider text-stone-500"><%= label %></p><p class="mt-2 text-2xl font-black tracking-tight text-stone-950"><%= value %></p></div>
      <% end %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
    <div class="rounded-[2rem] bg-white p-6 shadow-sm sm:p-8">
      <div class="flex items-center justify-between gap-4">
        <div><p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Sua coleção</p><h2 class="mt-1 text-2xl font-bold">Produtos recentes</h2></div>
        <%= link_to "Ver todos", seller_products_path, class: "text-sm font-bold text-stone-700 underline decoration-stone-300 underline-offset-4 hover:text-brand-600" %>
      </div>

      <% if @recent_products.any? %>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <% @recent_products.each do |product| %>
            <%= link_to seller_product_path(product), class: "group flex min-w-0 items-center gap-4 rounded-2xl border border-stone-200 p-3 transition hover:-translate-y-0.5 hover:border-stone-300 hover:shadow-md" do %>
              <span class="grid size-20 shrink-0 place-items-center overflow-hidden rounded-xl bg-[#eee7da] text-2xl text-stone-400">
                <% if product.main_image.attached? %><%= image_tag product.main_image.variant(resize_to_fill: [240, 240]), alt: product.name, class: "h-full w-full object-cover" %><% else %>✦<% end %>
              </span>
              <span class="min-w-0"><strong class="block truncate text-sm text-stone-950"><%= product.name %></strong><span class="mt-1 block text-xs text-stone-500"><%= t(product.status, scope: "products.statuses") %> · <%= product.stock_quantity %> em estoque</span><span class="mt-2 block text-sm font-bold"><%= number_to_currency(product.price_cents.fdiv(100)) %></span></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="mt-6 rounded-2xl border border-dashed border-stone-300 px-6 py-10 text-center"><p class="font-semibold">Sua primeira peça começa aqui.</p><%= link_to "Cadastrar produto", new_seller_product_path, class: "mt-3 inline-block text-sm font-bold text-brand-600 underline underline-offset-4" %></div>
      <% end %>
    </div>

    <div class="rounded-[2rem] bg-[#1f3128] p-6 text-white shadow-sm sm:p-8">
      <div class="flex items-center justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-[0.16em] text-[#d8bd8d]">Últimas vendas</p><h2 class="mt-1 text-2xl font-bold">Pedidos</h2></div><%= link_to "Ver todos", seller_orders_path, class: "text-sm font-bold text-white/80 underline underline-offset-4 hover:text-white" %></div>
      <% if @recent_seller_orders.any? %>
        <ol class="mt-5 divide-y divide-white/15">
          <% @recent_seller_orders.each do |seller_order| %>
            <li><%= link_to seller_order_path(seller_order.order), class: "flex items-center justify-between gap-4 py-4 first:pt-0" do %><span><strong class="block text-sm">Pedido #<%= seller_order.order_id %></strong><span class="mt-1 block text-xs text-white/60"><%= seller_order.order.customer.name %> · <%= l(seller_order.created_at.to_date, format: :short) %></span></span><span class="text-right"><strong class="block text-sm"><%= number_to_currency(seller_order.seller_amount_cents.fdiv(100)) %></strong><span class="mt-1 block text-xs text-[#d8bd8d]"><%= t(seller_order.status, scope: "seller_orders.statuses") %></span></span><% end %></li>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-6 text-sm leading-6 text-white/65">Quando sua primeira venda chegar, ela aparecerá aqui com o valor a receber e o status da operação.</p>
      <% end %>
    </div>
  </section>

  <section class="flex flex-col justify-between gap-5 rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:p-8">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Recebimentos e verificação</p>
      <h2 class="mt-1 text-2xl font-bold">Mercado Pago</h2>
      <% if current_seller.mercado_pago_connected? %>
        <p class="mt-2 text-sm leading-6 text-stone-600">Conta conectada em <%= l(current_seller.mercado_pago_connected_at, format: :short) %>. Identificador: <%= current_seller.mercado_pago_user_id %>. Ambiente: <%= current_seller.mercado_pago_live_mode? ? "produção" : "teste" %>. A verificação de identidade acontece no Mercado Pago.</p>
      <% elsif @mercado_pago_oauth_configured %>
        <% if @mercado_pago_oauth_sandbox %><p class="mt-2 text-sm leading-6 text-amber-700"><strong>Ambiente de teste:</strong> conecte uma conta TESTUSER do tipo Vendedor. Esta conexão não permite aprovação nem vendas reais.</p><% else %><p class="mt-2 text-sm leading-6 text-stone-600">Conclua a identificação da sua conta no Mercado Pago e autorize a EloShop a processar suas vendas.</p><% end %>
      <% else %>
        <p class="mt-2 text-sm leading-6 text-amber-700">A conexão aguarda a configuração da aplicação Mercado Pago pela plataforma.</p>
      <% end %>
    </div>
    <div class="shrink-0">
      <% if current_seller.mercado_pago_connected? %>
        <%= button_to "Desconectar", seller_mercado_pago_connection_path, method: :delete, class: "rounded-full border border-red-200 px-6 py-3 text-sm font-bold text-red-700 hover:bg-red-50", form: { data: { turbo_confirm: "Desconectar a conta e suspender a publicação dos produtos?" } } %>
      <% elsif @mercado_pago_oauth_configured %>
        <%= link_to(@mercado_pago_oauth_sandbox ? "Conectar conta de teste" : "Conectar Mercado Pago", seller_mercado_pago_connect_path, class: "inline-flex rounded-full bg-[#25382d] px-6 py-3 text-sm font-bold text-white hover:bg-[#17251d]", data: { turbo: false }) %>
      <% end %>
    </div>
  </section>
</div>
