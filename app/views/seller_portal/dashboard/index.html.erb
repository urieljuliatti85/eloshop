<% content_for :title, "Visão geral | #{current_seller.name}" %>

<div class="space-y-8" data-controller="back-to-menu">
  <%# Sem botão "Novo produto" no topo: o atalho já está no menu lateral, e
      o topo é dos Primeiros passos e do menu desta página. %>
  <header>
    <h1 class="text-3xl font-black tracking-tight text-stone-950">Visão geral</h1>
    <p class="mt-1 text-sm text-stone-600"><%= current_seller.name %></p>
  </header>

  <% setup_pending = !@getting_started_steps.values.all? %>

  <%# Atalhos para as áreas desta página. "Primeiros passos" só enquanto o
      bloco existe. Cada área tem `scroll-mt` para o topo fixo do painel não
      cobrir o título ao pular para ela. %>
  <% sections = [
    ([ "Primeiros passos", "primeiros-passos" ] if setup_pending),
    [ "O que fazer agora", "o-que-fazer-agora" ],
    [ "Seus números", "seus-numeros" ],
    [ "Produtos recentes", "produtos-recentes" ],
    [ "Últimos pedidos", "ultimos-pedidos" ]
  ].compact %>
  <nav id="nesta-pagina" aria-label="Nesta página" class="-mt-4 scroll-mt-40 sm:scroll-mt-28" data-back-to-menu-target="menu">
    <ul class="flex flex-wrap gap-2">
      <% sections.each do |label, anchor| %>
        <li><a href="#<%= anchor %>" class="inline-flex min-h-11 items-center rounded-full border border-brand-100 bg-white px-4 text-sm font-semibold text-stone-700 transition hover:border-brand-300 hover:text-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"><%= label %></a></li>
      <% end %>
    </ul>
  </nav>

  <%# Enquanto falta alguma etapa, os Primeiros passos ficam no topo, acima
      até do trabalho do dia. O frame
      existe mesmo com o cadastro pronto: quem conclui a última etapa por
      dentro dele recebe o frame vazio, em vez de um erro de conteúdo ausente. %>
  <%= turbo_frame_tag "primeiros-passos", data: { turbo_action: "advance" }, class: (setup_pending ? "block scroll-mt-40 sm:scroll-mt-28" : "hidden") do %>
    <%= render "seller_portal/dashboard/setup", steps: @getting_started_steps, current: @getting_started_current_step if setup_pending %>
  <% end %>
  <%= render "seller_portal/dashboard/todo" %>

  <%# Estoque baixo não entra aqui: já é uma linha de "O que fazer agora". %>
  <section id="seus-numeros" class="scroll-mt-40 sm:scroll-mt-28" aria-labelledby="numbers-title">
    <div class="mb-4 flex items-end justify-between gap-4">
      <h2 id="numbers-title" class="text-2xl font-bold">Seus números</h2>
      <p class="text-sm text-stone-500">Desde a abertura do ateliê</p>
    </div>
    <div class="grid gap-px overflow-hidden rounded-2xl border border-brand-100 bg-brand-100 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        ["Produtos", @products_count],
        ["Publicados", @active_products_count, "de #{@products_count} #{@products_count == 1 ? 'produto' : 'produtos'}"],
        ["Pedidos", @orders_count],
        ["Líquido em vendas", format_price(@seller_revenue_cents), "Já sem a comissão da EloShop"]
      ].each do |label, value, note| %>
        <%# "Publicados" no verde do status "Publicado": o que está à venda. %>
        <% published = label == "Publicados" %>
        <div class="bg-white px-5 py-6"><p class="text-xs font-semibold uppercase tracking-wider text-stone-500"><%= label %></p><p class="mt-2 text-2xl font-black tracking-tight <%= published ? 'text-emerald-700' : 'text-stone-950' %>"><%= value %></p><% if note %><p class="mt-1 text-xs text-stone-500"><%= note %></p><% end %></div>
      <% end %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
    <div id="produtos-recentes" class="seller-card-lg scroll-mt-40 sm:scroll-mt-28">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold">Produtos recentes</h2>
        <%= link_to "Ver todos", seller_products_path, class: "inline-flex min-h-11 items-center text-sm font-bold text-stone-700 underline decoration-stone-300 underline-offset-4 hover:text-brand-600" %>
      </div>

      <% if @recent_products.any? %>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <% @recent_products.each do |product| %>
            <%# Peça publicada (à venda) com borda verde: o mesmo verde do selo
                "Publicado" da lista de produtos, que diz o status em texto. %>
            <%= link_to seller_product_path(product), class: "group flex min-w-0 items-center gap-4 rounded-2xl border p-3 transition hover:-translate-y-0.5 hover:shadow-md #{product.active? ? 'border-emerald-300 bg-emerald-50/40 hover:border-emerald-400' : 'border-brand-100 hover:border-brand-300'}" do %>
              <%= render "seller_portal/products/thumbnail", product: product, large: true %>
              <span class="min-w-0"><strong class="block truncate text-sm text-stone-950"><%= product.name %></strong><span class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1"><%= seller_product_status_badge(product) %><span class="text-xs text-stone-600"><%= product.stock_quantity %> em estoque</span></span><span class="mt-2 block text-sm font-bold"><%= format_price(product.price_cents) %></span></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="mt-6 rounded-2xl border border-dashed border-stone-300 px-6 py-10 text-center"><p class="font-semibold">Sua primeira peça começa aqui.</p><%= link_to "Novo produto", new_seller_product_path, class: "mt-3 inline-block text-sm font-bold text-brand-600 underline underline-offset-4" %></div>
      <% end %>
    </div>

    <div id="ultimos-pedidos" class="scroll-mt-40 rounded-[2rem] bg-[#5c1a0b] p-6 text-white shadow-sm sm:scroll-mt-28 sm:p-8">
      <div class="flex items-center justify-between gap-4"><h2 class="text-2xl font-bold">Últimos pedidos</h2><%= link_to "Ver todos", seller_orders_path, class: "inline-flex min-h-11 items-center text-sm font-bold text-white/80 underline underline-offset-4 hover:text-white" %></div>
      <% if @recent_seller_orders.any? %>
        <ol class="mt-5 divide-y divide-white/15">
          <% @recent_seller_orders.each do |seller_order| %>
            <li><%= link_to seller_order_path(seller_order.order), class: "flex items-center justify-between gap-4 py-4 first:pt-0" do %><span><strong class="block text-sm">Pedido #<%= seller_order.order_id %></strong><span class="mt-1 block text-xs text-white/60"><%= seller_order.order.customer.name %> · <%= l(seller_order.created_at.to_date, format: :short) %></span></span><span class="text-right"><strong class="block text-sm"><%= format_price(seller_order.seller_net_amount_cents) %></strong><span class="mt-1 block text-xs text-[#d8bd8d]"><%= t(seller_order.status, scope: "seller_orders.statuses") %></span></span><% end %></li>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-6 text-sm leading-6 text-white/65">Quando sua primeira venda chegar, ela aparecerá aqui com o valor a receber e o status da operação.</p>
      <% end %>
    </div>
  </section>

  <%# Botões flutuantes, num contêiner só para ficarem alinhados (e, último
      filho, sem a margem do `space-y`). Alinhados pela base: o "Voltar ao
      topo" (`mb-1.5`) fica centrado na bolinha, abaixo do rótulo do tour. O "Voltar ao topo" volta ao menu de qualquer
      ponto da página no celular: fica no fim (ordem de leitura) e só aparece
      (back_to_menu_controller) quando o menu sai da tela. %>
  <div class="fixed right-4 bottom-[calc(1rem+var(--seller-tabs-height,0px))] z-30 flex items-end gap-3 sm:right-6 sm:bottom-6">
    <a href="#nesta-pagina" hidden data-back-to-menu-target="button" class="mb-1.5 inline-flex min-h-11 items-center gap-1.5 rounded-full bg-stone-950 px-4 text-sm font-bold text-white shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 sm:hidden">
      <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 15V5m-5 5 5-5 5 5"/></svg>
      <span>Voltar ao topo</span>
    </a>
    <%= render "seller_portal/tours/bubble" %>
  </div>
</div>
