  <fieldset>
    <legend class="text-sm font-semibold text-stone-700">Paleta</legend>
    <div class="mt-3 grid grid-cols-3 gap-2">
      <% SellerTheme::PALETTES.each do |key, palette| %>
        <%= theme_choice(form, :theme_palette, key, palette[:label]) do %>
          <span class="block h-full w-full" style="background: linear-gradient(135deg, <%= palette[:from] %>, <%= palette[:to] %>)"></span>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend class="text-sm font-semibold text-stone-700">Fonte</legend>
    <div class="mt-3 grid grid-cols-3 gap-2">
      <% SellerTheme::FONTS.each do |key, font| %>
        <%= theme_choice(form, :theme_font, key, font[:label]) do %>
          <span class="text-3xl text-stone-800" style="font-family: <%= font[:stack] %>">Aa</span>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend class="text-sm font-semibold text-stone-700">Fonte dos títulos</legend>
    <div class="mt-3 grid grid-cols-3 gap-2">
      <% SellerTheme::HEADING_FONTS.each do |key, heading| %>
        <%= theme_choice(form, :theme_heading_font, key, heading[:label]) do %>
          <% if heading[:stack] %>
            <span class="text-3xl text-stone-800" style="font-family: <%= heading[:stack] %>">Aa</span>
          <% else %>
            <span class="text-xs font-semibold text-stone-500">= texto</span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <%# As miniaturas de "tom da paleta" e "escuro" usam a paleta salva: a do rascunho só
      aparece na prévia ao lado. %>
  <fieldset>
    <legend class="text-sm font-semibold text-stone-700">Fundo da página</legend>
    <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
      <% saved = SellerTheme::PALETTES[current_seller.theme_palette] || SellerTheme::PALETTES.fetch(SellerTheme::DEFAULTS[:palette]) %>
      <% SellerTheme::BACKGROUNDS.each do |key, background| %>
        <%= theme_choice(form, :theme_background, key, background[:label]) do %>
          <span class="block h-full w-full bg-white" style="--atelier-soft:<%= saved[:soft] %>;--atelier-from:<%= saved[:from] %>;<%= SellerTheme.page_background_style(key) %>"></span>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend class="text-sm font-semibold text-stone-700">Ornamento entre as seções</legend>
    <div class="mt-3 grid grid-cols-3 gap-2">
      <% SellerTheme::ORNAMENTS.each do |key, ornament| %>
        <%= theme_choice(form, :theme_ornament, key, ornament[:label]) do %>
          <% if (style = SellerTheme.ornament_style(key)) %>
            <span class="block w-full bg-stone-600" style="<%= style %>"></span>
          <% else %>
            <span class="block h-px w-4/5 bg-stone-300"></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend class="text-sm font-semibold text-stone-700">Cor própria</legend>
    <label class="mt-3 flex min-h-11 cursor-pointer items-center gap-3 text-sm text-stone-700">
      <%= check_box_tag :use_custom_color, "1", current_seller.theme_accent_color.present?, data: { theme_editor_target: "useCustomColor" }, class: "size-5" %>
      Usar uma cor minha no lugar da paleta
    </label>
    <div class="mt-2 flex items-center gap-3">
      <%= form.color_field :theme_accent_color, value: current_seller.theme_accent_color || SellerTheme::PALETTES.dig(current_seller.theme_palette, :accent),
            data: { theme_editor_target: "customColor" }, class: "h-12 w-20 cursor-pointer rounded-xl border border-stone-300 bg-white p-1" %>
      <p data-theme-editor-target="contrastHint" aria-live="polite" class="text-xs text-stone-500"></p>
    </div>
    <p class="mt-1 text-xs text-stone-500">Precisa ser escura o bastante para o texto continuar legível (contraste mínimo de 4,5:1).</p>
  </fieldset>
