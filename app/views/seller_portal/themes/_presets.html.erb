  <p class="text-sm text-stone-500">Um ponto de partida. Aplique um e ajuste o que quiser nas outras abas.</p>
  <div class="grid grid-cols-2 gap-3">
    <% SellerTheme::PRESETS.each do |key, preset| %>
      <% palette = SellerTheme::PALETTES.fetch(preset[:palette]) %>
      <button type="button" data-action="theme-editor#applyPreset" data-preset="<%= key %>"
              class="flex min-h-11 cursor-pointer flex-col gap-2 rounded-2xl border border-stone-200 bg-white p-2.5 text-left transition hover:border-stone-400 focus-visible:ring-3 focus-visible:ring-brand-300">
        <span class="block h-14 rounded-xl" style="background: linear-gradient(135deg, <%= palette[:from] %>, <%= palette[:to] %>)">
          <span class="block p-2 text-lg font-black text-white/90" style="font-family: <%= SellerTheme::FONTS.dig(preset[:font], :stack) %>">Aa</span>
        </span>
        <span class="text-sm font-bold text-stone-800"><%= preset[:label] %></span>
        <span class="text-xs leading-tight text-stone-500"><%= palette[:label] %> · <%= SellerTheme::FONTS.dig(preset[:font], :label) %></span>
      </button>
    <% end %>
  </div>
