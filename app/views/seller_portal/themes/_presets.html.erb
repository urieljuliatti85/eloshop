  <%# Filtro só da lista: sem `name`, não vai no formulário, e o editor não o
      conta como alteração do tema. %>
  <div>
    <label for="theme_preset_filter" class="text-sm font-semibold text-stone-700">Filtrar por tema</label>
    <select id="theme_preset_filter" class="seller-input mt-2"
            data-action="change->theme-editor#filterPresets input->theme-editor#filterPresets" aria-describedby="theme_preset_count">
      <option value="">Todos os temas</option>
      <optgroup label="Categoria da loja">
        <% SellerTheme::PRESET_CATEGORIES.each do |key, category| %>
          <option value="<%= key %>"><%= category[:label] %></option>
        <% end %>
      </optgroup>
      <optgroup label="Estilo">
        <option value="<%= SellerTheme::DARK_PRESETS_FILTER %>">Fundo escuro</option>
      </optgroup>
    </select>
    <p id="theme_preset_count" class="mt-1 text-xs text-stone-500" aria-live="polite" data-theme-editor-target="presetCount"><%= SellerTheme::PRESETS.size %> temas</p>
  </div>
  <p class="text-sm text-stone-500">Um ponto de partida. Aplique um e ajuste o que quiser nas outras abas.</p>
  <% short = ->(label) { label.split(" (").first } %>
  <div class="grid grid-cols-2 gap-3">
    <% SellerTheme::PRESETS.each do |key, preset| %>
      <% palette = SellerTheme::PALETTES.fetch(preset[:palette]) %>
      <%# `aria-pressed` diz se o formulário está exatamente neste tema; o
          editor recalcula a cada mudança. %>
      <button type="button" data-action="theme-editor#applyPreset" data-preset="<%= key %>" data-theme-editor-target="preset" aria-pressed="false"
              data-filters="<%= SellerTheme.preset_filters(key).join(" ") %>"
              class="group flex min-h-11 cursor-pointer flex-col gap-2 rounded-2xl border border-stone-200 bg-white p-2.5 text-left transition hover:border-stone-400 focus-visible:ring-3 focus-visible:ring-brand-300 aria-pressed:border-stone-900 aria-pressed:ring-2 aria-pressed:ring-stone-900">
        <%# Miniatura: o topo na cor da paleta sobre o fundo da página, com o
            ornamento embaixo quando o tema tem um. %>
        <span class="relative flex h-16 flex-col overflow-hidden rounded-xl bg-white ring-1 ring-stone-200"
              style="--atelier-soft:<%= palette[:soft] %>;--atelier-from:<%= palette[:from] %>;<%= SellerTheme.page_background_style(preset[:background]) %>">
          <span class="m-1.5 mb-0 block flex-1 rounded-lg" style="background: linear-gradient(135deg, <%= palette[:from] %>, <%= palette[:to] %>)">
            <span class="block px-2 py-1 text-lg font-black text-white/90" style="font-family: <%= SellerTheme::HEADING_FONTS.dig(preset[:heading_font], :stack) || SellerTheme::FONTS.dig(preset[:font], :stack) %>">Aa</span>
          </span>
          <% if (ornament = SellerTheme.ornament_style(preset[:ornament])) %>
            <span class="mx-1.5 my-1 block" style="background-color: <%= SellerTheme.dark?(preset[:background]) ? palette[:soft] : palette[:accent] %>;<%= ornament %>;height:10px"></span>
          <% else %>
            <span class="block h-3"></span>
          <% end %>
          <span class="absolute right-1.5 top-1.5 hidden rounded-full bg-white px-2 py-0.5 text-[0.6875rem] font-bold text-stone-900 group-aria-pressed:inline">Aplicado</span>
        </span>
        <span class="text-sm font-bold text-stone-800"><%= preset[:label] %></span>
        <span class="text-xs leading-tight text-stone-500">
          <%= palette[:label] %> · <%= SellerTheme::FONTS.dig(preset[:font], :label) %><br>
          <%= short.(SellerTheme::LAYOUTS[preset[:layout]]) %> · topo <%= short.(SellerTheme::HEROES[preset[:hero]]).downcase %>
          <% extras = [ ("fundo #{SellerTheme::BACKGROUNDS.dig(preset[:background], :label).downcase}" unless preset[:background] == "branco"),
                        (SellerTheme::ORNAMENTS.dig(preset[:ornament], :label).downcase unless preset[:ornament] == "nenhum"),
                        ("título #{SellerTheme::HEADING_FONTS.dig(preset[:heading_font], :label).downcase}" unless preset[:heading_font] == "igual") ].compact %>
          <% if extras.any? %><br><%= extras.join(" · ") %><% end %>
        </span>
      </button>
    <% end %>
  </div>
