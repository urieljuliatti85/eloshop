<% content_for :title, "Primeiros passos | #{current_seller.name}" %>
<%# Fluxo guiado no padrão do painel: a faixa mostra as cinco etapas (as
    feitas com o traço verde) e abre uma etapa por vez. A
    etapa vem da URL; sem ela, a próxima pendente. As ações continuam nas
    telas de sempre (Dados do Ateliê, conexão do Mercado Pago, novo produto). %>
<%
  titles = SellerPortal::GettingStartedController::STEP_TITLES
  short_titles = SellerPortal::GettingStartedController::STEP_SHORT_TITLES
  slugs = SellerPortal::GettingStartedController::STEP_SLUGS
%>

<div class="max-w-3xl space-y-6">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-black tracking-tight text-stone-950">Primeiros passos</h1>
      <p class="mt-1 text-sm text-stone-600"><%= @completed_steps_count %> de <%= @steps.size %> etapas concluídas</p>
    </div>
    <button type="button" data-action="tour#start" class="seller-button seller-button--secondary">Fazer tour pelo painel</button>
  </header>

  <%= render "seller_portal/getting_started/strip", steps: @steps, current_step: @current_step %>

  <% if @current_step %>
    <% number = @steps.keys.index(@current_step) + 1 %>
    <section class="seller-card-lg" aria-labelledby="etapa-title">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h2 id="etapa-title" class="text-2xl font-bold leading-tight text-stone-950"><span class="text-brand-700"><%= number %>.</span> <%= titles[@current_step] %></h2>
        <% if @steps[@current_step] %><span class="seller-badge bg-emerald-100 text-emerald-800">Feito</span><% end %>
      </div>
      <%= render "seller_portal/getting_started/steps/#{@current_step}", done: @steps[@current_step] %>
      <% if @steps[@current_step] && @next_pending_step %>
        <p class="mt-6 border-t border-brand-100 pt-5">
          <%= link_to "Próxima etapa: #{short_titles[@next_pending_step]}", panel_path(:getting_started, etapa: slugs[@next_pending_step]), class: "seller-button seller-button--primary" %>
        </p>
      <% end %>
    </section>
  <% else %>
    <section class="seller-card-lg text-center" aria-labelledby="etapa-title">
      <span class="seller-badge bg-emerald-100 text-emerald-800">Ateliê pronto</span>
      <h2 id="etapa-title" class="mt-4 text-2xl font-bold text-stone-950">Todas as etapas estão feitas</h2>
      <p class="mx-auto mt-2 max-w-md text-base leading-7 text-stone-700">Seus produtos podem ser publicados e vendidos. O dia a dia do ateliê fica na visão geral.</p>
      <%= link_to "Ir para a visão geral", panel_path(:root), class: "seller-button seller-button--primary mt-5" %>
    </section>
  <% end %>
</div>
