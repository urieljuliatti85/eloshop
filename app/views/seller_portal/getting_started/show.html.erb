<% content_for :title, "Primeiros passos | #{current_seller.name}" %>
<%# Fluxo guiado no mundo do caderno de encomendas: a folha lista as cinco
    etapas (as feitas riscadas e carimbadas) e abre uma etapa por vez. A
    etapa vem da URL; sem ela, a próxima pendente. As ações continuam nas
    telas de sempre (Dados do Ateliê, conexão do Mercado Pago, novo produto). %>
<%
  titles = {
    address: "Preencha o endereço do ateliê",
    mercado_pago: "Conecte sua conta do Mercado Pago",
    pix_key: "Cadastre uma chave PIX no Mercado Pago",
    product: "Cadastre seu primeiro produto",
    approval: "Entenda como você recebe"
  }
  short_titles = {
    address: "Endereço do ateliê",
    mercado_pago: "Conta do Mercado Pago",
    pix_key: "Chave PIX",
    product: "Primeira peça",
    approval: "Aprovação e recebimento"
  }
  slugs = SellerPortal::GettingStartedController::STEP_SLUGS
%>

<div class="caderno max-w-3xl">
  <header class="caderno-capa">
    <h1 class="font-caderno-mao text-4xl leading-none">Primeiros passos</h1>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <p class="text-sm font-bold"><%= @completed_steps_count %> de <%= @steps.size %> etapas concluídas</p>
      <button type="button" data-action="tour#start" class="inline-flex min-h-11 cursor-pointer items-center rounded-full border border-white/40 px-4 text-sm font-bold text-white transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Fazer tour pelo painel</button>
    </div>
  </header>

  <div class="caderno-folha">
    <ol class="caderno-indice" aria-label="Etapas para preparar o ateliê">
      <% @steps.each_with_index do |(step, done), index| %>
        <% current = step == @current_step %>
        <li>
          <%= link_to seller_getting_started_path(etapa: slugs[step]), aria: { current: (current ? "step" : nil) }, class: (current ? "font-bold" : "") do %>
            <span class="flex min-w-0 items-baseline gap-3">
              <span class="w-4 shrink-0 text-sm text-stone-500" aria-hidden="true"><%= index + 1 %></span>
              <span class="<%= done ? 'text-stone-500 line-through decoration-caderno-carimbo decoration-2' : '' %>"><%= short_titles[step] %></span>
              <% if done %><span class="sr-only">(feita)</span><% end %>
            </span>
            <% if done %>
              <span class="caderno-carimbo" aria-hidden="true">Feito</span>
            <% elsif current %>
              <span class="font-caderno-mao text-xl leading-none text-caderno-capa">agora</span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ol>

    <% if @current_step %>
      <% number = @steps.keys.index(@current_step) + 1 %>
      <section class="mt-6 border-t-2 border-caderno-tinta pt-6" aria-labelledby="etapa-title">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <h2 id="etapa-title" class="text-2xl font-bold leading-tight sm:text-3xl"><span class="text-caderno-capa"><%= number %>.</span> <%= titles[@current_step] %></h2>
          <% if @steps[@current_step] %><span class="caderno-carimbo caderno-carimbo--grande">Feito</span><% end %>
        </div>
        <%# A pauta começa abaixo do título da etapa, alinhada à primeira linha
            do texto (passo de 28px, o leading-7). %>
        <div class="caderno-pauta">
          <%= render "seller_portal/getting_started/steps/#{@current_step}", done: @steps[@current_step] %>
        </div>
        <% if @steps[@current_step] && @next_pending_step %>
          <p class="mt-6 border-t border-caderno-pauta pt-4">
            <%= link_to "Próxima etapa: #{short_titles[@next_pending_step]}", seller_getting_started_path(etapa: slugs[@next_pending_step]), class: "caderno-botao" %>
          </p>
        <% end %>
      </section>
    <% else %>
      <section class="mt-6 border-t-2 border-caderno-tinta pt-6 text-center" aria-labelledby="etapa-title">
        <span class="caderno-carimbo caderno-carimbo--grande">Ateliê pronto</span>
        <h2 id="etapa-title" class="mt-5 text-2xl font-bold">Todas as etapas estão feitas</h2>
        <p class="mx-auto mt-2 max-w-md text-base leading-7 text-stone-700">Seus produtos podem ser publicados e vendidos. O dia a dia do ateliê fica na visão geral.</p>
        <%= link_to "Ir para a visão geral", seller_root_path, class: "caderno-botao mt-5" %>
      </section>
    <% end %>
  </div>
</div>
