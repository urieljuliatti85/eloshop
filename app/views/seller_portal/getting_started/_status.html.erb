<span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold <%= completed ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
  <% if completed %>
    <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
  <% end %>
  <%= completed ? "Concluído" : "Pendente" %>
</span>
