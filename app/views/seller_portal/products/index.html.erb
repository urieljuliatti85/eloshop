<div class="space-y-6">
  <header class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-black tracking-tight">Produtos</h1>
    <%= link_to "Novo produto", new_seller_product_path, class: "seller-button seller-button--primary" %>
  </header>
  <% if params[:q].present? %><p class="text-sm text-ink-muted">Resultados para “<%= params[:q] %>” · <%= link_to "Limpar busca", seller_products_path, class: "font-semibold text-brand-600 underline underline-offset-4" %></p><% end %>

  <% if @products.empty? %>
    <div class="seller-card text-center">
      <% if params[:q].present? %>
        <p class="font-semibold text-stone-950">Nenhum produto encontrado.</p>
        <p class="mt-1 text-sm text-stone-600">Confira a grafia ou busque pelo SKU.</p>
      <% else %>
        <p class="font-semibold text-stone-950">Sua primeira peça começa aqui.</p>
        <p class="mt-1 text-sm text-stone-600">Você pode salvar como rascunho e publicar depois.</p>
        <%= link_to "Novo produto", new_seller_product_path, class: "seller-button seller-button--primary mt-5" %>
      <% end %>
    </div>
  <% else %>
    <%= form_with url: bulk_discontinue_seller_products_path, method: :patch, data: { turbo_confirm: "Descontinuar os produtos selecionados? Essa ação não pode ser desfeita.", controller: "bulk-select" } do %>
      <label class="-ml-3 mb-2 flex min-h-11 w-fit cursor-pointer items-center gap-2 px-3 text-sm font-semibold text-ink-muted">
        <input type="checkbox" data-bulk-select-target="selectAll" data-action="bulk-select#toggleAll" class="size-4 rounded border-brand-200">
        Selecionar todos
      </label>

      <%# Cartões até telas largas e tabela só a partir de xl: com foto, preço e
          dois selos, a tabela precisa de espaço — no tablet ela passava da
          largura e escondia "Detalhes" atrás de uma rolagem lateral. %>
      <div class="grid gap-3 xl:hidden">
        <% @products.each do |product| %>
          <% stock_label, stock_classes = seller_stock_badge(product) %>
          <div class="flex items-center gap-1 rounded-2xl border border-brand-100 bg-white p-2 shadow-sm">
            <label class="grid size-11 shrink-0 cursor-pointer place-items-center">
              <input type="checkbox" name="product_ids[]" value="<%= product.id %>" data-bulk-select-target="row" data-action="bulk-select#refresh" class="size-4 rounded border-brand-200">
              <span class="sr-only">Selecionar <%= product.name %></span>
            </label>
            <%= link_to seller_product_path(product), class: "flex min-w-0 flex-1 items-center gap-3 py-1 pr-2" do %>
              <%= render "seller_portal/products/thumbnail", product: product %>
              <span class="min-w-0">
                <span class="block truncate font-semibold text-stone-950"><%= product.name %></span>
                <span class="mt-0.5 block text-sm font-bold text-stone-800"><%= "a partir de " if product.has_variants? %><%= format_price(product.starting_price_cents) %></span>
                <span class="mt-2 flex flex-wrap gap-1.5">
                  <%= seller_product_status_badge(product) %>
                  <span class="seller-badge <%= stock_classes %>"><%= stock_label %></span>
                </span>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="hidden overflow-x-auto rounded-2xl border border-brand-100 bg-white shadow-sm xl:block">
        <table class="w-full text-left text-sm">
          <thead class="bg-brand-50/60 text-ink-muted">
            <tr>
              <th class="w-10 p-4"><span class="sr-only">Selecionar</span></th>
              <th class="p-4">Produto</th>
              <th class="p-4">Preço</th>
              <th class="p-4">Status</th>
              <th class="p-4">Estoque</th>
              <th class="p-4"><span class="sr-only">Ações</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-100">
            <% @products.each do |product| %>
              <% stock_label, stock_classes = seller_stock_badge(product) %>
              <tr>
                <td class="p-2">
                  <label class="grid size-11 cursor-pointer place-items-center">
                    <input type="checkbox" name="product_ids[]" value="<%= product.id %>" data-bulk-select-target="row" data-action="bulk-select#refresh" class="size-4 rounded border-brand-200">
                    <span class="sr-only">Selecionar <%= product.name %></span>
                  </label>
                </td>
                <td class="p-4">
                  <div class="flex items-center gap-3">
                    <%= render "seller_portal/products/thumbnail", product: product %>
                    <div class="min-w-0">
                      <p class="font-semibold text-stone-950"><%= product.name %></p>
                      <p class="mt-0.5 text-xs text-ink-muted">SKU <%= product.sku %></p>
                    </div>
                  </div>
                </td>
                <td class="whitespace-nowrap p-4 font-semibold"><%= "a partir de " if product.has_variants? %><%= format_price(product.starting_price_cents) %></td>
                <td class="p-4"><%= seller_product_status_badge(product) %></td>
                <td class="p-4"><span class="seller-badge <%= stock_classes %>"><%= stock_label %></span></td>
                <td class="p-4 text-right"><%= link_to "Detalhes", seller_product_path(product), class: "inline-flex min-h-11 items-center font-semibold text-brand-600" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# Ações em massa só com algo selecionado, presas ao pé da tela (no
          celular, ao alcance do polegar). Sem JS a barra fica sempre visível,
          e o servidor continua validando a seleção. %>
      <div class="sticky bottom-0 z-20 -mx-4 mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-brand-100 bg-white/95 px-4 py-3 shadow-[0_-8px_24px_rgba(120,40,10,0.08)] sm:mx-0 sm:rounded-2xl sm:border" data-bulk-select-target="bar">
        <span class="text-sm font-semibold text-stone-800" data-bulk-select-target="count" aria-live="polite"></span>
        <div class="flex flex-wrap gap-2">
          <button type="submit" formaction="<%= bulk_unpublish_seller_products_path %>" data-turbo-confirm="Esconder os produtos selecionados da vitrine?" data-bulk-select-target="action" class="inline-flex min-h-11 cursor-pointer items-center rounded-full border border-stone-200 bg-stone-50 px-4 py-2 text-sm font-semibold text-stone-700 disabled:cursor-not-allowed disabled:opacity-50">Esconder</button>
          <button type="submit" data-bulk-select-target="action" class="inline-flex min-h-11 cursor-pointer items-center rounded-full border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 disabled:cursor-not-allowed disabled:opacity-50">Descontinuar</button>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
