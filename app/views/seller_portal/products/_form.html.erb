<%= form_with model: [ :seller, product ], class: "grid gap-5 rounded-2xl bg-white p-6 shadow-sm" do |form| %>
  <% if product.errors.any? %><div class="rounded-xl bg-red-50 p-4 text-sm text-red-700"><ul class="list-disc pl-5"><% product.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div><%= form.label :name, "Nome" %><%= form.text_field :name, required: true, class: "mt-2 w-full rounded-xl border-gray-300" %></div>
  <div><%= form.label :description, "Descrição" %><%= form.text_area :description, rows: 6, class: "mt-2 w-full rounded-xl border-gray-300" %></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :sku, "SKU" %><%= form.text_field :sku, required: true, class: "mt-2 w-full rounded-xl border-gray-300" %></div><div><%= form.label :price_cents, "Preço em centavos" %><%= form.number_field :price_cents, min: 0, required: true, class: "mt-2 w-full rounded-xl border-gray-300" %></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :availability_type, "Disponibilidade" %><%= form.select :availability_type, [["Estoque padrão", "standard"], ["Peça única", "one_of_a_kind"], ["Sob encomenda", "made_to_order"]], {}, class: "mt-2 w-full rounded-xl border-gray-300" %></div><div><%= form.label :stock_quantity, "Estoque" %><%= form.number_field :stock_quantity, min: 0, class: "mt-2 w-full rounded-xl border-gray-300" %></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :production_time_min_days, "Produção mínima (dias úteis)" %><%= form.number_field :production_time_min_days, min: 1, class: "mt-2 w-full rounded-xl border-gray-300" %></div><div><%= form.label :production_time_max_days, "Produção máxima (dias úteis)" %><%= form.number_field :production_time_max_days, min: 1, class: "mt-2 w-full rounded-xl border-gray-300" %></div></div>
  <div><%= form.label :category_id, "Categoria" %><%= form.select :category_id, options_for_select(@category_tree.categories.map { |category| [@category_tree.breadcrumb_name(category), category.id] }, product.category_id), { include_blank: "Sem categoria" }, class: "mt-2 w-full rounded-xl border-gray-300" %></div>
  <div><%= form.label :main_image, "Imagem principal" %><%= form.file_field :main_image, accept: "image/png,image/jpeg,image/webp", class: "mt-2 block w-full" %></div>
  <div><%= form.label :images, "Galeria de imagens" %><%= form.file_field :images, multiple: true, accept: "image/png,image/jpeg,image/webp", class: "mt-2 block w-full" %><p class="mt-2 text-sm text-ink-muted">PNG, JPEG ou WEBP, até 5 MB por foto e 10 fotos no total.</p></div>
  <%= form.hidden_field :currency, value: product.currency.presence || "BRL" %>
  <%= form.submit "Salvar produto", class: "cursor-pointer rounded-full bg-brand-500 px-6 py-3 font-semibold text-white" %>
<% end %>
