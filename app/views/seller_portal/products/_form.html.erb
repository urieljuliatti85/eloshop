<%
  label_class = "text-sm font-semibold text-stone-700"
  made_to_order = product.availability_type_made_to_order?
  field_class = "seller-input mt-2"
  file_class = "mt-2 block w-full rounded-xl border border-dashed border-stone-300 bg-brand-50/30 p-3 text-sm file:mr-3 file:cursor-pointer file:rounded-full file:border-0 file:bg-stone-900 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white"
  section_class = "grid gap-5 border-t border-brand-100 pt-6"
%>
<%# Seções na ordem em que o artesão pensa a peça: o que ela é (com a foto
    logo depois do nome — para o artesão a foto é o produto), quanto custa e
    quando sai, e como chega. Campos, ids e regras de obrigatoriedade são os
    mesmos de antes (required-fields e o servidor). %>
<%= form_with model: [ :seller, product ], class: "seller-card-lg grid gap-6", html: { novalidate: true }, data: { controller: "required-fields", action: "submit->required-fields#validate focusout->required-fields#touch input->required-fields#touch change->required-fields#touch" } do |form| %>
  <p class="text-xs text-stone-500"><span class="text-red-600" aria-hidden="true">*</span> Campo obrigatório · <span class="font-semibold text-stone-700">Para publicar</span>: pode salvar como rascunho sem ele</p>
  <% if product.errors.any? %><div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"><ul class="list-disc pl-5"><% product.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>

  <section class="grid gap-5" aria-labelledby="product-section-piece">
    <h2 id="product-section-piece" class="text-lg font-bold text-stone-950">A peça</h2>
    <div><%= form.label :name, class: label_class do %>Nome<%= required_marker %><% end %><%= form.text_field :name, aria: field_error_aria(form, :name), required: true, data: { required_fields_target: "field" }, class: field_class %><%= field_error(form, :name) %></div>
    <div><%= form.label :main_image, "Foto principal", class: label_class %><%= form.file_field :main_image, aria: field_error_aria(form, :main_image), accept: "image/png,image/jpeg,image/webp", class: file_class %><%= field_error(form, :main_image) %><p class="mt-1 text-xs text-stone-500">Pode enviar a foto direto do celular: ela é reduzida automaticamente e mantém a qualidade para ampliar.</p></div>
    <div><%= form.label :images, "Mais fotos", class: label_class %><%= form.file_field :images, aria: field_error_aria(form, :images), multiple: true, accept: "image/png,image/jpeg,image/webp", class: file_class %><%= field_error(form, :images) %><p class="mt-1 text-xs text-stone-500">PNG, JPEG ou WEBP, até 5 MB por foto e <%= Product::IMAGES_MAX_COUNT %> fotos no total.</p></div>
    <div><%= form.label :description, "Descrição", class: label_class %><%= form.text_area :description, aria: field_error_aria(form, :description), rows: 6, class: field_class %><%= field_error(form, :description) %></div>
    <div><%= form.label :category_id, class: label_class do %>Categoria <%= publish_marker %><% end %><%= form.select :category_id, options_for_select(category_tree.breadcrumb_options, product.category_id), { include_blank: "Selecione uma categoria" }, aria: field_error_aria(form, :category_id), data: { required_fields_target: "field", publish_required: true }, class: field_class %><%= field_error(form, :category_id) %><p class="mt-1 text-xs text-stone-500">É como o cliente encontra o seu produto.</p></div>
    <%= render "seller_portal/category_suggestions/field" %>
  </section>

  <section class="<%= section_class %>" aria-labelledby="product-section-price">
    <h2 id="product-section-price" class="text-lg font-bold text-stone-950">Preço e disponibilidade</h2>
    <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :price, class: label_class do %>Preço (R$)<%= required_marker %><% end %><%= form.text_field :price, aria: field_error_aria(form, :price), value: price_field_value(form.object.price_cents), inputmode: "decimal", placeholder: "0,00", data: { controller: "price-input", action: "input->price-input#format", required_fields_target: "field" }, required: true, class: field_class %><%= field_error(form, :price) %></div><div><%= form.label :sku, "Código da peça (SKU, opcional)", class: label_class %><%= form.text_field :sku, aria: field_error_aria(form, :sku), placeholder: "Em branco, a EloShop gera", class: field_class %><%= field_error(form, :sku) %></div></div>
    <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :availability_type, "Disponibilidade", class: label_class %><%= form.select :availability_type, [["Estoque padrão", "standard"], ["Peça única", "one_of_a_kind"], ["Sob encomenda", "made_to_order"]], {}, aria: field_error_aria(form, :availability_type), data: { required_fields_target: "trigger", action: "change->required-fields#refresh" }, class: field_class %><%= field_error(form, :availability_type) %></div><div data-required-fields-target="group" data-hidden-when="made_to_order" <%= "hidden" if made_to_order %>><%= form.label :stock_quantity, "Estoque", class: label_class %><%= form.number_field :stock_quantity, aria: field_error_aria(form, :stock_quantity), min: 0, max: (1 if product.availability_type_one_of_a_kind?), data: { required_fields_target: "field", max_when: "one_of_a_kind", max_limit: 1, max_message: "Peça única: use 0 ou 1." }, class: field_class %><%= field_error(form, :stock_quantity) %></div></div>
    <%# Prazo de produção só existe para sob encomenda: o grupo aparece e some
        com a disponibilidade (required-fields#refresh). %>
    <div class="grid gap-5 sm:grid-cols-2" data-required-fields-target="group" data-required-when="made_to_order" <%= "hidden" unless made_to_order %>><div><%= form.label :production_time_min_days, class: label_class do %>Produção mínima (dias úteis)<%= required_marker(visible: made_to_order) %><% end %><%= form.number_field :production_time_min_days, aria: field_error_aria(form, :production_time_min_days), min: 1, required: made_to_order, data: { required_fields_target: "field", required_when: "made_to_order" }, class: field_class %><%= field_error(form, :production_time_min_days) %></div><div><%= form.label :production_time_max_days, class: label_class do %>Produção máxima (dias úteis)<%= required_marker(visible: made_to_order) %><% end %><%= form.number_field :production_time_max_days, aria: field_error_aria(form, :production_time_max_days), min: 1, required: made_to_order, data: { required_fields_target: "field", required_when: "made_to_order" }, class: field_class %><%= field_error(form, :production_time_max_days) %></div></div>
  </section>

  <section class="<%= section_class %>" aria-labelledby="product-section-shipping">
    <h2 id="product-section-shipping" class="text-lg font-bold text-stone-950">Envio</h2>
    <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :weight_grams, class: label_class do %>Peso (g) <%= publish_marker %><% end %><%= form.number_field :weight_grams, aria: field_error_aria(form, :weight_grams), min: 1, data: { required_fields_target: "field", publish_required: true }, class: field_class %><%= field_error(form, :weight_grams) %></div><div><%= form.label :length_cm, class: label_class do %>Comprimento (cm) <%= publish_marker %><% end %><%= form.number_field :length_cm, aria: field_error_aria(form, :length_cm), min: 1, data: { required_fields_target: "field", publish_required: true }, class: field_class %><%= field_error(form, :length_cm) %></div><div><%= form.label :width_cm, class: label_class do %>Largura (cm) <%= publish_marker %><% end %><%= form.number_field :width_cm, aria: field_error_aria(form, :width_cm), min: 1, data: { required_fields_target: "field", publish_required: true }, class: field_class %><%= field_error(form, :width_cm) %></div><div><%= form.label :height_cm, class: label_class do %>Altura (cm) <%= publish_marker %><% end %><%= form.number_field :height_cm, aria: field_error_aria(form, :height_cm), min: 1, data: { required_fields_target: "field", publish_required: true }, class: field_class %><%= field_error(form, :height_cm) %></div></div>
    <%# O frete é definido pelo vendedor e exigido para publicar (ou frete
        grátis). A faixa "outros estados" é opcional: vazia, o valor do
        estado vale para todo o Brasil. %>
    <% origin_state = form.object.seller&.origin_state.presence %>
    <div>
      <p class="text-sm font-semibold text-stone-700">Frete deste produto <%= publish_marker %></p>
      <p class="mt-1 text-xs leading-5 text-stone-500">Você define quanto o cliente paga de frete, por unidade. Para publicar, preencha o frete para o seu estado ou marque frete grátis.</p>
      <p class="mt-2 text-xs leading-5 text-stone-600"><strong>Quanto cobrar?</strong> Simule o envio desta peça na <%= link_to "SuperFrete", "https://web.superfrete.com", target: "_blank", rel: "noopener noreferrer", class: "font-semibold underline" %> com o peso e as medidas acima: uma vez para um CEP do seu estado e outra para um CEP distante. É mais ou menos o que você vai pagar pela etiqueta — cobrar menos que isso sai do seu bolso.</p>
    </div>
    <%= render "seller_portal/shared/shipping_in_development" %>
    <fieldset class="space-y-3">
      <legend class="text-sm font-semibold text-stone-800">Para o seu estado<%= " (#{origin_state})" if origin_state %></legend>
      <div class="grid gap-5 sm:grid-cols-2">
        <div><%= form.label :fixed_shipping, "Valor por unidade (R$)", class: label_class %><%= form.text_field :fixed_shipping, aria: field_error_aria(form, :fixed_shipping), value: price_field_value(form.object.fixed_shipping_cents), inputmode: "decimal", placeholder: "20,00", data: { controller: "price-input", action: "input->price-input#format" }, class: field_class %><%= field_error(form, :fixed_shipping) %></div>
        <div><%= form.label :fixed_shipping_estimated_days, "Prazo máximo (dias úteis)", class: label_class %><%= form.number_field :fixed_shipping_estimated_days, aria: field_error_aria(form, :fixed_shipping_estimated_days), min: 1, step: 1, placeholder: "8", class: field_class %><%= field_error(form, :fixed_shipping_estimated_days) %></div>
      </div>
    </fieldset>
    <fieldset class="space-y-3">
      <legend class="text-sm font-semibold text-stone-800">Para outros estados <span class="font-normal text-stone-500">(opcional)</span></legend>
      <p class="text-xs leading-5 text-stone-500">Deixe vazio para cobrar o mesmo valor em todo o Brasil.<% unless origin_state %> Sem o endereço de origem do ateliê, o checkout usa o maior valor e o maior prazo das duas faixas.<% end %></p>
      <div class="grid gap-5 sm:grid-cols-2">
        <div><%= form.label :fixed_shipping_interstate, "Valor por unidade (R$)", class: label_class %><%= form.text_field :fixed_shipping_interstate, aria: field_error_aria(form, :fixed_shipping_interstate), value: price_field_value(form.object.fixed_shipping_interstate_cents), inputmode: "decimal", placeholder: "35,00", data: { controller: "price-input", action: "input->price-input#format" }, class: field_class %><%= field_error(form, :fixed_shipping_interstate) %></div>
        <div><%= form.label :fixed_shipping_interstate_estimated_days, "Prazo máximo (dias úteis)", class: label_class %><%= form.number_field :fixed_shipping_interstate_estimated_days, aria: field_error_aria(form, :fixed_shipping_interstate_estimated_days), min: 1, step: 1, placeholder: "12", class: field_class %><%= field_error(form, :fixed_shipping_interstate_estimated_days) %></div>
      </div>
    </fieldset>
    <label class="flex cursor-pointer items-start gap-3">
      <%= form.check_box :local_pickup_enabled, class: "mt-1 size-4 rounded border-stone-300 text-brand-500 focus:ring-brand-400" %>
      <span><span class="block text-sm font-semibold text-stone-800">Permitir retirada gratuita deste produto</span><span class="mt-1 block text-xs leading-5 text-stone-500">A retirada aparece no checkout somente quando todos os produtos do carrinho permitirem.</span></span>
    </label>
    <%# Sem confirm(): em navegador de aplicativo (Instagram, Facebook) ele
        responde "não" sem aparecer, e a caixa desmarcava sozinha — o ateliê
        não conseguia oferecer frete grátis. O aviso de custo aparece na página
        ao marcar (CSS :has, sem JavaScript) e fica visível até salvar. %>
    <%# O botão Marcar/Desmarcar é um alvo de toque maior que a caixa (16 px)
        e fica fora do <label>: dentro dele, o clique também acionaria o
        label e desfaria a marcação. O texto acompanha o estado da caixa por
        CSS, então já vem certo antes do JavaScript. %>
    <div class="group grid gap-3" data-controller="checkbox-toggle">
      <div class="flex items-start justify-between gap-3">
        <label class="flex cursor-pointer items-start gap-3">
          <%= form.check_box :free_shipping, class: "mt-1 size-4 rounded border-stone-300 text-brand-500 focus:ring-brand-400", data: { checkbox_toggle_target: "checkbox" } %>
          <span><span class="block text-sm font-semibold text-stone-800">Frete grátis para este produto</span><span class="mt-1 block text-xs leading-5 text-stone-500">O cliente não paga frete. <strong>Você assume o custo do envio</strong>: o valor é descontado do seu repasse, não da comissão da EloShop.</span></span>
        </label>
        <button type="button" data-action="checkbox-toggle#toggle" aria-controls="<%= form.field_id(:free_shipping) %>"
                class="inline-flex min-h-11 shrink-0 items-center rounded-full border border-stone-300 bg-white px-4 text-sm font-semibold text-stone-800 shadow-sm transition hover:bg-stone-50 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand-500 group-has-[:checked]:border-brand-500 group-has-[:checked]:text-brand-700">
          <span class="group-has-[:checked]:hidden">Marcar<span class="sr-only"> frete grátis</span></span>
          <span class="hidden group-has-[:checked]:inline">Desmarcar<span class="sr-only"> frete grátis</span></span>
        </button>
      </div>
      <p class="hidden items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900 group-has-[:checked]:flex" data-free-shipping-notice>
        <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 9v4m0 3.5h.01M10.3 4.3 2.6 17.6A2 2 0 0 0 4.3 20.6h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/></svg>
        <span><strong>Frete grátis ativado.</strong> Você assume o custo do envio deste produto: o valor da etiqueta é descontado do seu repasse, não da comissão da EloShop.</span>
      </p>
    </div>
  </section>

  <%= form.hidden_field :currency, value: product.currency.presence || "BRL" %>
  <div class="flex flex-col gap-3 border-t border-brand-100 pt-6 sm:flex-row sm:items-center">
    <%= form.submit "Salvar produto", class: "seller-button seller-button--primary justify-center" %>
    <% if product.new_record? %>
      <p class="text-sm text-stone-600">O produto é salvo como rascunho. Você publica na página dele.</p>
    <% end %>
  </div>
<% end %>
<%= render "seller_portal/category_suggestions/form" %>
