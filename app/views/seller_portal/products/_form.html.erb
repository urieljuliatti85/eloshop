<%
  field_class = "mt-2 w-full rounded-xl border border-stone-300 bg-brand-50/30 px-3 py-2 text-sm outline-none transition focus:border-brand-400 focus:bg-white focus:ring-3 focus:ring-brand-100"
%>
<%= form_with model: [ :seller, product ], class: "grid gap-5 rounded-[2rem] border border-brand-100 bg-white p-6 shadow-[0_1px_2px_rgba(120,40,10,0.03),0_16px_40px_rgba(120,40,10,0.05)] sm:p-8" do |form| %>
  <% if product.errors.any? %><div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"><ul class="list-disc pl-5"><% product.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div><%= form.label :name, "Nome", class: "text-sm font-semibold text-stone-700" %><%= form.text_field :name, required: true, class: field_class %></div>
  <div><%= form.label :description, "Descrição", class: "text-sm font-semibold text-stone-700" %><%= form.text_area :description, rows: 6, class: field_class %></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :sku, "SKU", class: "text-sm font-semibold text-stone-700" %><%= form.text_field :sku, required: true, class: field_class %></div><div><%= form.label :price, "Preço (R$)", class: "text-sm font-semibold text-stone-700" %><%= form.text_field :price, value: price_field_value(form.object.price_cents), inputmode: "decimal", placeholder: "0,00", data: { controller: "price-input", action: "input->price-input#format" }, required: true, class: field_class %></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :availability_type, "Disponibilidade", class: "text-sm font-semibold text-stone-700" %><%= form.select :availability_type, [["Estoque padrão", "standard"], ["Peça única", "one_of_a_kind"], ["Sob encomenda", "made_to_order"]], {}, class: field_class %></div><div><%= form.label :stock_quantity, "Estoque", class: "text-sm font-semibold text-stone-700" %><%= form.number_field :stock_quantity, min: 0, class: field_class %></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :production_time_min_days, "Produção mínima (dias úteis)", class: "text-sm font-semibold text-stone-700" %><%= form.number_field :production_time_min_days, min: 1, class: field_class %></div><div><%= form.label :production_time_max_days, "Produção máxima (dias úteis)", class: "text-sm font-semibold text-stone-700" %><%= form.number_field :production_time_max_days, min: 1, class: field_class %></div></div>
  <div class="grid gap-5 sm:grid-cols-4"><div><%= form.label :weight_grams, "Peso (g)", class: "text-sm font-semibold text-stone-700" %><%= form.number_field :weight_grams, min: 1, class: field_class %></div><div><%= form.label :length_cm, "Comprimento (cm)", class: "text-sm font-semibold text-stone-700" %><%= form.number_field :length_cm, min: 1, class: field_class %></div><div><%= form.label :width_cm, "Largura (cm)", class: "text-sm font-semibold text-stone-700" %><%= form.number_field :width_cm, min: 1, class: field_class %></div><div><%= form.label :height_cm, "Altura (cm)", class: "text-sm font-semibold text-stone-700" %><%= form.number_field :height_cm, min: 1, class: field_class %></div></div>
  <fieldset class="rounded-2xl border border-brand-100 bg-brand-50/40 p-5">
    <legend class="px-2 text-sm font-semibold text-stone-700">Frete deste produto</legend>
    <p class="mb-4 text-xs leading-5 text-stone-500">O valor é aplicado a cada unidade. Deixe valor e prazo vazios para usar o cálculo estimado da EloShop.</p>
    <div class="grid gap-5 sm:grid-cols-2">
      <div><%= form.label :fixed_shipping, "Valor fixo por unidade (R$)", class: "text-sm font-semibold text-stone-700" %><%= form.text_field :fixed_shipping, value: price_field_value(form.object.fixed_shipping_cents), inputmode: "decimal", placeholder: "20,00", data: { controller: "price-input", action: "input->price-input#format" }, class: field_class %></div>
      <div><%= form.label :fixed_shipping_estimated_days, "Prazo máximo (dias úteis)", class: "text-sm font-semibold text-stone-700" %><%= form.number_field :fixed_shipping_estimated_days, min: 1, step: 1, placeholder: "8", class: field_class %></div>
    </div>
    <label class="mt-5 flex cursor-pointer items-start gap-3">
      <%= form.check_box :local_pickup_enabled, class: "mt-1 size-4 rounded border-stone-300 text-brand-500 focus:ring-brand-400" %>
      <span><span class="block text-sm font-semibold text-stone-800">Permitir retirada gratuita deste produto</span><span class="mt-1 block text-xs leading-5 text-stone-500">A retirada aparece no checkout somente quando todos os produtos do carrinho permitirem.</span></span>
    </label>
  </fieldset>
  <div><%= form.label :category_id, "Categoria", class: "text-sm font-semibold text-stone-700" %><%= form.select :category_id, options_for_select(category_tree.categories.map { |category| [category_tree.breadcrumb_name(category), category.id] }, product.category_id), { include_blank: "Sem categoria" }, class: field_class %></div>
  <div><%= form.label :main_image, "Imagem principal", class: "text-sm font-semibold text-stone-700" %><%= form.file_field :main_image, accept: "image/png,image/jpeg,image/webp", class: "mt-2 block w-full text-sm" %></div>
  <div><%= form.label :images, "Galeria de imagens", class: "text-sm font-semibold text-stone-700" %><%= form.file_field :images, multiple: true, accept: "image/png,image/jpeg,image/webp", class: "mt-2 block w-full text-sm" %><p class="mt-2 text-sm text-stone-500">PNG, JPEG ou WEBP, até 5 MB por foto e 10 fotos no total.</p></div>
  <%= form.hidden_field :currency, value: product.currency.presence || "BRL" %>
  <%= form.submit "Salvar produto", class: "cursor-pointer rounded-full bg-brand-500 px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-brand-600" %>
<% end %>
