<% content_for :title, "Ateliê | #{current_seller.name}" %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">Seu ateliê</p>
      <h1 class="mt-1 text-3xl font-bold">Dados do ateliê</h1>
      <p class="mt-2 text-sm text-stone-500">Como o seu ateliê aparece na loja e como você recebe pelas vendas.</p>
    </div>
    <%= link_to "Editar dados", edit_seller_atelier_path, class: "rounded-full bg-brand-500 px-6 py-3 text-sm font-bold text-white transition hover:bg-brand-600" %>
  </header>

  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
    <dl class="grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">Nome</dt>
        <dd class="mt-1 text-lg font-bold text-stone-950"><%= current_seller.name %></dd>
      </div>

      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">Situação</dt>
        <dd class="mt-1 text-lg font-bold text-stone-950"><%= t(current_seller.status, scope: "sellers.statuses") %></dd>
      </div>

      <%# Sem endereço o frete real não tem origem — o aviso é para o vendedor
          saber o que falta antes de a plataforma ligar o cálculo. %>
      <div class="sm:col-span-2">
        <dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">De onde você envia</dt>
        <dd class="mt-1">
          <% if current_seller.origin_address_complete? %>
            <p class="text-stone-950">
              <%= current_seller.origin_street %>, <%= current_seller.origin_number %><%= " — #{current_seller.origin_complement}" if current_seller.origin_complement.present? %>
            </p>
            <p class="text-sm text-stone-600">
              <%= current_seller.origin_neighborhood %> — <%= current_seller.origin_city %>/<%= current_seller.origin_state %>
              · CEP <%= current_seller.origin_zip_code %>
            </p>
          <% else %>
            <p class="text-stone-500">Ainda não informado. É o endereço usado para calcular o frete das suas vendas.</p>
          <% end %>
        </dd>
      </div>

      <%# O slug não é editável: ele já está nas URLs públicas dos produtos, e
          trocá-lo quebraria links que alguém compartilhou. %>
      <div class="sm:col-span-2">
        <dt class="text-xs font-semibold uppercase tracking-wider text-stone-500">Endereço na loja</dt>
        <dd class="mt-1">
          <% if current_seller.approved? %>
            <%= link_to seller_url(current_seller.slug), seller_path(current_seller.slug), class: "font-medium text-brand-600 underline underline-offset-4 hover:text-brand-700" %>
          <% else %>
            <span class="text-stone-500">A vitrine fica pública quando o ateliê for aprovado.</span>
          <% end %>
        </dd>
      </div>
    </dl>
  </section>

  <section class="flex flex-col justify-between gap-5 rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:p-8">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Recebimentos e verificação</p>
      <h2 class="mt-1 text-2xl font-bold">Mercado Pago</h2>
      <% if current_seller.mercado_pago_connected? %>
        <p class="mt-2 text-sm leading-6 text-stone-600">Conta conectada em <%= l(current_seller.mercado_pago_connected_at, format: :short) %>. Identificador: <%= current_seller.mercado_pago_user_id %>. Ambiente: <%= current_seller.mercado_pago_live_mode? ? "produção" : "teste" %>. A verificação de identidade acontece no Mercado Pago.</p>
      <% elsif @mercado_pago_oauth_configured %>
        <% if @mercado_pago_oauth_sandbox %><p class="mt-2 text-sm leading-6 text-amber-700"><strong>Ambiente de teste:</strong> conecte uma conta TESTUSER do tipo Vendedor. Esta conexão não permite aprovação nem vendas reais.</p><% else %><p class="mt-2 text-sm leading-6 text-stone-600">Conclua a identificação da sua conta no Mercado Pago e autorize a EloShop a processar suas vendas.</p><% end %>
      <% else %>
        <p class="mt-2 text-sm leading-6 text-amber-700">A conexão aguarda a configuração da aplicação Mercado Pago pela plataforma.</p>
      <% end %>
    </div>
    <div class="shrink-0">
      <% if current_seller.mercado_pago_connected? %>
        <%= button_to "Desconectar", seller_mercado_pago_connection_path, method: :delete, class: "rounded-full border border-red-200 px-6 py-3 text-sm font-bold text-red-700 hover:bg-red-50", form: { data: { turbo_confirm: "Desconectar a conta e suspender a publicação dos produtos?" } } %>
      <% elsif @mercado_pago_oauth_configured %>
        <%= link_to(@mercado_pago_oauth_sandbox ? "Conectar conta de teste" : "Conectar Mercado Pago", seller_mercado_pago_connect_path, class: "inline-flex rounded-full bg-[#7a2410] px-6 py-3 text-sm font-bold text-white hover:bg-[#4a1508]", data: { turbo: false }) %>
      <% end %>
    </div>
  </section>
</div>
