<% content_for :title, "Editar ateliê | #{current_seller.name}" %>

<div class="max-w-2xl space-y-8">
  <header>
    <h1 class="text-3xl font-black tracking-tight">Editar dados</h1>
  </header>

  <%= form_with model: current_seller, url: seller_atelier_path, method: :patch, class: "space-y-5 rounded-[2rem] border border-brand-100 bg-white p-6 shadow-[0_1px_2px_rgba(120,40,10,0.03),0_16px_40px_rgba(120,40,10,0.05)] sm:p-8" do |form| %>
    <% if current_seller.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
        <ul class="list-inside list-disc">
          <% current_seller.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Nome do ateliê", class: "seller-label" %>
      <%= form.text_field :name, required: true, class: "seller-input min-h-11" %>
      <p class="mt-1 text-xs text-stone-500">É o nome que aparece nas suas peças e na sua vitrine.</p>
    </div>

    <%# Dados do proprietário: opcionais para quem já opera sem eles (ver
        Seller#owner_full_name/cpf, validados só na criação). O CPF nunca é
        reexibido em texto pleno — o campo fica em branco mesmo quando já
        existe um cadastrado, e só é gravado se o vendedor digitar algo novo
        (ver Seller#cpf=). %>
    <fieldset class="border-t border-stone-200 pt-6">
      <legend class="sr-only">Dados do proprietário</legend>
      <p class="text-sm font-semibold text-stone-700">Dados do proprietário</p>
      <p class="mt-1 mb-4 text-xs text-stone-500">Não aparecem na loja. Usados para identificar quem responde pelo ateliê.</p>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :owner_full_name, "Nome completo", class: "seller-label" %>
          <%= form.text_field :owner_full_name, class: "seller-input min-h-11" %>
        </div>

        <div>
          <%= form.label :cpf, "CPF", class: "seller-label" %>
          <%= form.text_field :cpf, value: nil, inputmode: "numeric", placeholder: current_seller.masked_cpf || "000.000.000-00", class: "seller-input min-h-11" %>
          <% if current_seller.masked_cpf.present? %>
            <p class="mt-1 text-xs text-stone-500">Deixe em branco para manter o CPF já cadastrado.</p>
          <% end %>
        </div>
      </div>
    </fieldset>

    <%# Endereço de onde a peça é despachada — não é o endereço de cobrança
        nem aparece na loja. Continua opcional enquanto a entrega fixa e o
        fallback não precisam de origem; quem preencher precisa completar,
        porque meio endereço não atende ao provedor. %>
    <fieldset class="border-t border-stone-200 pt-6">
      <legend class="sr-only">Endereço de origem</legend>
      <p class="text-sm font-semibold text-stone-700">De onde você envia</p>
      <p class="mt-1 mb-4 text-xs text-stone-500">Usado para calcular o frete das suas vendas. Não aparece na loja.</p>

      <%= render "seller_portal/ateliers/origin_address_fields", form: form %>
    </fieldset>

    <div class="flex gap-3">
      <%= form.submit "Salvar", class: "cursor-pointer rounded-full bg-brand-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-brand-700" %>
      <%= link_to "Cancelar", seller_atelier_path, class: "rounded-full border border-brand-200 px-6 py-3 text-sm font-bold text-stone-700 transition hover:bg-brand-50" %>
    </div>
  <% end %>
</div>
