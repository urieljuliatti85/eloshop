<% content_for :title, "Editar ateliê | #{current_seller.name}" %>

<div class="max-w-2xl space-y-8">
  <header>
    <h1 class="text-3xl font-black tracking-tight">Editar dados</h1>
  </header>

  <%= form_with model: current_seller, url: seller_atelier_path, method: :patch, class: "space-y-5 rounded-[2rem] border border-brand-100 bg-white p-6 shadow-[0_1px_2px_rgba(120,40,10,0.03),0_16px_40px_rgba(120,40,10,0.05)] sm:p-8" do |form| %>
    <% if current_seller.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
        <ul class="list-inside list-disc">
          <% current_seller.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Nome do ateliê", class: "seller-label" %>
      <%= form.text_field :name, required: true, class: "seller-input min-h-11" %>
      <p class="mt-1 text-xs text-stone-500">É o nome que aparece nas suas peças e na sua vitrine.</p>
    </div>

    <%# Tema da vitrine pública. Tudo opcional: sem capa, a vitrine usa a foto
        da peça mais recente. Só mostra o que já foi gravado (um envio recusado
        volta anexado, mas sem blob). Remover é um checkbox porque um campo de arquivo
        vazio não diz se o vendedor quer manter ou apagar a imagem atual. %>
    <% file_class = "mt-2 block w-full rounded-xl border border-dashed border-stone-300 bg-brand-50/30 p-3 text-sm file:mr-3 file:cursor-pointer file:rounded-full file:border-0 file:bg-stone-900 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white" %>
    <fieldset class="border-t border-stone-200 pt-6">
      <legend class="sr-only">Aparência da vitrine</legend>
      <p class="text-sm font-semibold text-stone-700">Aparência da vitrine</p>
      <p class="mt-1 mb-4 text-xs text-stone-500">Logo, capa e rodapé da página pública do seu ateliê. PNG, JPEG ou WEBP, até 5 MB.</p>

      <div class="space-y-5">
        <div>
          <%= form.label :logo, "Logo", class: "seller-label" %>
          <% if current_seller.logo.attached? && current_seller.logo.blob.persisted? %>
            <div class="mt-2 flex items-center gap-4">
              <%= image_tag current_seller.logo.variant(resize_to_fill: [ 96, 96 ]), alt: "Logo atual do ateliê", class: "size-16 rounded-full border border-stone-200 object-cover" %>
              <label class="flex items-center gap-2 text-sm text-stone-600">
                <%= check_box_tag :remove_logo, "1", false, class: "size-4" %> Remover logo
              </label>
            </div>
          <% end %>
          <%= form.file_field :logo, accept: "image/png,image/jpeg,image/webp", class: file_class %>
          <p class="mt-1 text-xs text-stone-500">Imagem quadrada funciona melhor.</p>
        </div>

        <div>
          <%= form.label :cover_image, "Capa (topo da vitrine)", class: "seller-label" %>
          <% if current_seller.cover_image.attached? && current_seller.cover_image.blob.persisted? %>
            <div class="mt-2 space-y-2">
              <%= image_tag current_seller.cover_image.variant(resize_to_fill: [ 640, 240 ]), alt: "Capa atual do ateliê", class: "h-24 w-full max-w-sm rounded-xl border border-stone-200 object-cover" %>
              <label class="flex items-center gap-2 text-sm text-stone-600">
                <%= check_box_tag :remove_cover_image, "1", false, class: "size-4" %> Remover capa
              </label>
            </div>
          <% end %>
          <%= form.file_field :cover_image, accept: "image/png,image/jpeg,image/webp", class: file_class %>
          <p class="mt-1 text-xs text-stone-500">Imagem larga (paisagem). Sem capa, usamos a foto da sua peça mais recente.</p>
        </div>

        <div>
          <%= form.label :footer_text, "Mensagem do rodapé", class: "seller-label" %>
          <%= form.text_area :footer_text, rows: 3, maxlength: Seller::FOOTER_TEXT_MAX_LENGTH, class: "seller-input" %>
          <p class="mt-1 text-xs text-stone-500">Aparece no fim da sua vitrine. Ex.: horários de produção, uma frase sobre o seu processo. Até <%= Seller::FOOTER_TEXT_MAX_LENGTH %> caracteres.</p>
        </div>
      </div>
    </fieldset>

    <%# Dados do proprietário: opcionais para quem já opera sem eles (ver
        Seller#owner_full_name/cpf, validados só na criação). O CPF nunca é
        reexibido em texto pleno — o campo fica em branco mesmo quando já
        existe um cadastrado, e só é gravado se o vendedor digitar algo novo
        (ver Seller#cpf=). %>
    <fieldset class="border-t border-stone-200 pt-6">
      <legend class="sr-only">Dados do proprietário</legend>
      <p class="text-sm font-semibold text-stone-700">Dados do proprietário</p>
      <p class="mt-1 mb-4 text-xs text-stone-500">Não aparecem na loja. Usados para identificar quem responde pelo ateliê.</p>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :owner_full_name, "Nome completo", class: "seller-label" %>
          <%= form.text_field :owner_full_name, class: "seller-input min-h-11" %>
        </div>

        <div>
          <%= form.label :cpf, "CPF", class: "seller-label" %>
          <%= form.text_field :cpf, value: nil, inputmode: "numeric", placeholder: current_seller.masked_cpf || "000.000.000-00", class: "seller-input min-h-11" %>
          <% if current_seller.masked_cpf.present? %>
            <p class="mt-1 text-xs text-stone-500">Deixe em branco para manter o CPF já cadastrado.</p>
          <% end %>
        </div>
      </div>
    </fieldset>

    <%# Endereço de onde a peça é despachada — não é o endereço de cobrança
        nem aparece na loja. Continua opcional enquanto a entrega fixa e o
        fallback não precisam de origem; quem preencher precisa completar,
        porque meio endereço não atende ao provedor. %>
    <fieldset class="border-t border-stone-200 pt-6">
      <legend class="sr-only">Endereço de origem</legend>
      <p class="text-sm font-semibold text-stone-700">De onde você envia</p>
      <p class="mt-1 mb-4 text-xs text-stone-500">Usado para calcular o frete das suas vendas. Não aparece na loja.</p>

      <div class="grid gap-4 sm:grid-cols-6"
           data-controller="postal-code"
           data-postal-code-url-value="<%= seller_atelier_postal_code_path(cep: "00000000") %>"
           data-postal-code-search-url-value="<%= seller_atelier_postal_codes_path %>">
        <div class="sm:col-span-2">
          <%= form.label :origin_zip_code, "CEP", class: "seller-label" %>
          <%= form.text_field :origin_zip_code, inputmode: "numeric", placeholder: "00000-000", data: { postal_code_target: "zipCode", action: "input->postal-code#lookup" }, class: "seller-input min-h-11" %>
        </div>

        <div class="sm:col-span-4">
          <%= form.label :origin_street, "Rua", class: "seller-label" %>
          <div class="relative">
            <%= form.text_field :origin_street, data: { postal_code_target: "street", action: "input->postal-code#search" }, class: "seller-input min-h-11" %>
            <div data-postal-code-target="suggestions"
                 role="listbox"
                 hidden
                 class="absolute z-20 mt-1 max-h-64 w-full overflow-y-auto rounded-xl border border-stone-200 bg-white shadow-lg"></div>
          </div>
        </div>

        <div class="sm:col-span-2">
          <%= form.label :origin_number, "Número", class: "seller-label" %>
          <%= form.text_field :origin_number, class: "seller-input min-h-11" %>
        </div>

        <div class="sm:col-span-4">
          <%= form.label :origin_complement, "Complemento (opcional)", class: "seller-label" %>
          <%= form.text_field :origin_complement, class: "seller-input min-h-11" %>
        </div>

        <div class="sm:col-span-3">
          <%= form.label :origin_neighborhood, "Bairro", class: "seller-label" %>
          <%= form.text_field :origin_neighborhood, data: { postal_code_target: "neighborhood" }, class: "seller-input min-h-11" %>
        </div>

        <div class="sm:col-span-2">
          <%= form.label :origin_city, "Cidade", class: "seller-label" %>
          <%= form.text_field :origin_city, data: { postal_code_target: "city", action: "input->postal-code#search" }, class: "seller-input min-h-11" %>
        </div>

        <div class="sm:col-span-1">
          <%= form.label :origin_state, "UF", class: "seller-label" %>
          <%= form.text_field :origin_state, maxlength: 2, data: { postal_code_target: "state", action: "input->postal-code#search" }, class: "min-h-11 w-full rounded-xl border border-stone-300 bg-brand-50/30 px-3 py-2 text-sm uppercase outline-none transition focus:border-brand-400 focus:bg-white focus:ring-3 focus:ring-brand-100" %>
        </div>

        <p data-postal-code-target="status" aria-live="polite" class="min-h-5 text-xs text-stone-500 sm:col-span-6"></p>
      </div>
    </fieldset>

    <div class="flex gap-3">
      <%= form.submit "Salvar", class: "cursor-pointer rounded-full bg-brand-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-brand-700" %>
      <%= link_to "Cancelar", seller_atelier_path, class: "rounded-full border border-brand-200 px-6 py-3 text-sm font-bold text-stone-700 transition hover:bg-brand-50" %>
    </div>
  <% end %>
</div>
