<%= form_with model: [ :seller, product, personalization_option ], class: "grid gap-5 rounded-2xl bg-white p-6 shadow-sm" do |form| %>
  <% if personalization_option.errors.any? %>
    <div class="rounded-xl bg-red-50 p-4 text-sm text-red-700">
      <ul class="list-disc pl-5">
        <% personalization_option.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div><%= form.label :label, "Nome do campo" %><%= form.text_field :label, required: true, class: "mt-2 w-full rounded-xl border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %></div>
  <div><%= form.label :max_length, "Máximo de caracteres" %><%= form.number_field :max_length, min: 1, class: "mt-2 w-full rounded-xl border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %></div>
  <label class="flex items-center gap-3"><%= form.checkbox :required, class: "rounded border-gray-300" %><span>Preenchimento obrigatório</span></label>
  <%= form.submit "Salvar personalização", class: "cursor-pointer rounded-full bg-brand-500 px-6 py-3 font-semibold text-white" %>
<% end %>
