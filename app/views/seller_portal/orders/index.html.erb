<div class="space-y-6">
  <h1 class="text-3xl font-black tracking-tight">Pedidos</h1>

  <% if @seller_orders.empty? %>
    <div class="seller-card text-center">
      <p class="font-semibold text-stone-950">Nenhum pedido ainda.</p>
      <p class="mt-1 text-sm text-stone-600">Quando um cliente comprar uma peça sua, o pedido aparece aqui com o valor a receber.</p>
    </div>
  <% else %>
    <%# Cartões no celular, tabela a partir de sm: as colunas não cabem em
        390px — com overflow-hidden a coluna "Detalhes" ficava fora de alcance,
        deixando o pedido inacessível pelo celular. Cancelar mora no detalhe do
        pedido: aqui era o único botão de cada cartão, um toque destrutivo na
        zona do polegar. %>
    <div class="grid gap-3 sm:hidden">
      <% @seller_orders.each do |seller_order| %>
        <% order = seller_order.order %>
        <% preparing = seller_order_fulfillment_state(seller_order) == :preparing %>
        <%= link_to seller_order_path(order), class: "block rounded-2xl border bg-white p-4 shadow-sm #{preparing ? 'border-amber-300' : 'border-brand-100'}" do %>
          <div class="flex items-baseline justify-between gap-3">
            <p class="font-semibold text-stone-950">Pedido #<%= order.id %></p>
            <p class="text-sm font-bold"><%= format_price(seller_order.seller_net_amount_cents) %></p>
          </div>
          <p class="mt-1 truncate text-sm text-ink-muted"><%= order.customer.name %> · <%= l(order.created_at.to_date, format: :short) %></p>
          <p class="mt-3 flex flex-wrap items-center gap-2">
            <%= render "seller_portal/orders/badges", seller_order: seller_order %>
          </p>
        <% end %>
      <% end %>
    </div>

    <div class="hidden overflow-x-auto rounded-2xl border border-brand-100 bg-white shadow-sm sm:block">
      <table class="w-full text-left text-sm">
        <thead class="bg-brand-50/60 text-ink-muted">
          <tr>
            <th class="p-4">Pedido</th>
            <th class="p-4">Cliente</th>
            <th class="p-4">Andamento</th>
            <th class="p-4">A receber</th>
            <th class="p-4">Data</th>
            <th class="p-4"><span class="sr-only">Ações</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-brand-100">
          <% @seller_orders.each do |seller_order| %>
            <% order = seller_order.order %>
            <tr class="<%= 'bg-amber-50/60' if seller_order_fulfillment_state(seller_order) == :preparing %>">
              <td class="p-4 font-semibold">#<%= order.id %></td>
              <td class="p-4"><%= order.customer.name %></td>
              <td class="p-4"><div class="flex flex-wrap gap-2"><%= render "seller_portal/orders/badges", seller_order: seller_order %></div></td>
              <td class="whitespace-nowrap p-4 font-semibold"><%= format_price(seller_order.seller_net_amount_cents) %></td>
              <td class="whitespace-nowrap p-4"><%= l(order.created_at.to_date, format: :short) %></td>
              <td class="p-4 text-right"><%= link_to "Detalhes", seller_order_path(order), class: "inline-flex min-h-11 items-center font-semibold text-brand-600" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
