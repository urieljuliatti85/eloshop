<div class="space-y-6"><header><p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Operação</p><h1 class="mt-2 text-3xl font-bold">Pedidos</h1></header><div class="overflow-hidden rounded-2xl bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-stone-50"><tr><th class="p-4">Pedido</th><th class="p-4">Cliente</th><th class="p-4">Status</th><th class="p-4">A receber</th><th class="p-4">Data</th><th></th></tr></thead><tbody class="divide-y divide-gray-100"><% @seller_orders.each do |seller_order| %><% order = seller_order.order %><tr><td class="p-4 font-semibold">#<%= order.id %></td><td class="p-4"><%= order.customer.name %></td><td class="p-4"><%= seller_order.status.humanize %></td><td class="p-4"><%= number_to_currency((seller_order.seller_amount_cents - seller_order.refunded_amount_cents + seller_order.platform_fee_refunded_cents).fdiv(100)) %></td><td class="p-4"><%= l(order.created_at.to_date, format: :short) %></td><td class="p-4 text-right"><%= link_to "Detalhes", seller_order_path(order), class: "font-semibold text-brand-600" %></td></tr><% end %></tbody></table></div></div>
