<div class="space-y-6"><header><%= link_to "← Pedidos", seller_orders_path, class: "text-sm font-semibold text-brand-600" %><h1 class="mt-3 text-3xl font-bold">Pedido #<%= @order.id %></h1><p class="mt-2 text-ink-muted"><%= @order.status.humanize %> · <%= @order.customer.name %></p></header><section class="rounded-2xl bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Itens do seu ateliê</h2><ul class="mt-4 divide-y divide-gray-100"><% @order_items.each do |item| %><li class="flex justify-between gap-4 py-4"><div><p class="font-semibold"><%= item.product_name %></p><p class="text-sm text-ink-muted"><%= item.quantity %> × <%= number_to_currency(item.unit_price_cents.fdiv(100)) %></p></div><p class="font-semibold"><%= number_to_currency(item.subtotal_cents.fdiv(100)) %></p></li><% end %></ul></section></div>
