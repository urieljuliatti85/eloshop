<%
  seller_order_status_classes = {
    "pending" => "bg-stone-100 text-stone-600",
    "confirmed" => "bg-emerald-100 text-emerald-800",
    "cancelled" => "bg-amber-100 text-amber-800",
    "partially_refunded" => "bg-amber-100 text-amber-800",
    "refunded" => "bg-amber-100 text-amber-800"
  }
  shipment = @seller_order.shipment
  address = @order.shipping_address_snapshot
  payment = @order.payments.max_by(&:created_at)
%>

<div class="space-y-6">
  <header>
    <%= link_to "← Pedidos", seller_orders_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-brand-600" %>
    <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Acompanhamento</p>
        <h1 class="mt-1 text-3xl font-black tracking-tight">Pedido #<%= @order.id %></h1>
        <p class="mt-2 text-sm text-ink-muted"><%= @order.customer.name %> · <%= l(@order.created_at, format: :short) %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= seller_order_status_classes[@seller_order.status] %>"><%= t(@seller_order.status, scope: "seller_orders.statuses") %></span>
        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= seller_order_fulfillment_badge_classes(@seller_order) %>"><%= seller_order_fulfillment_label(@seller_order) %></span>
      </div>
    </div>
  </header>

  <section class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm sm:p-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Linha do tempo</p>
        <h2 class="mt-1 text-xl font-bold">Da confirmação à entrega</h2>
      </div>
      <% if shipment %>
        <p class="text-sm text-ink-muted"><%= shipment.carrier %> · <%= shipment.service %></p>
      <% end %>
    </div>

    <ol class="mt-6 grid gap-3 sm:grid-cols-4" aria-label="Acompanhamento do pedido">
      <% seller_order_timeline_steps(@seller_order).each do |step| %>
        <% current = step[:state] == :current %>
        <% complete = step[:state] == :complete %>
        <li class="relative rounded-2xl border p-4 <%= current ? 'border-brand-400 bg-brand-50' : complete ? 'border-emerald-200 bg-emerald-50/60' : 'border-stone-200 bg-stone-50' %>" aria-current="<%= current ? 'step' : 'false' %>">
          <div class="flex items-center gap-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-full text-sm font-black <%= current ? 'bg-brand-500 text-white' : complete ? 'bg-emerald-600 text-white' : 'bg-stone-200 text-stone-500' %>" aria-hidden="true"><%= complete ? "✓" : "•" %></span>
            <p class="font-semibold <%= step[:state] == :upcoming ? 'text-stone-500' : 'text-stone-950' %>"><%= step[:label] %></p>
          </div>
          <% if step[:time] %>
            <p class="mt-3 text-xs text-ink-muted"><%= l(step[:time], format: :short) %></p>
          <% elsif current %>
            <p class="mt-3 text-xs font-semibold text-brand-700">Etapa atual</p>
          <% end %>
        </li>
      <% end %>
    </ol>

    <% if @seller_order.pending? %>
      <p class="mt-5 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900">Aguarde a confirmação do pagamento antes de preparar e enviar este pedido.</p>
    <% elsif @seller_order.cancelled? || @seller_order.refunded? %>
      <p class="mt-5 rounded-xl bg-stone-100 px-4 py-3 text-sm text-stone-700">Este pedido não pode mais avançar na entrega.</p>
    <% elsif shipment&.pending? %>
      <% if shipment.local_pickup? %>
        <%= button_to "Marcar como pronto para retirada",
              ship_seller_order_path(@order), method: :patch,
              class: "mt-5 inline-flex min-h-11 cursor-pointer items-center rounded-full bg-brand-500 px-6 py-3 text-sm font-bold text-white hover:bg-brand-600",
              form: { data: { turbo_confirm: "O pedido já está pronto para o cliente retirar?" } } %>
      <% else %>
        <%= form_with url: ship_seller_order_path(@order), method: :patch, class: "mt-5 rounded-2xl border border-brand-100 bg-brand-50/50 p-4 sm:p-5" do |form| %>
          <h3 class="text-lg font-bold">Detalhes do Envio</h3>
          <p class="mt-1 text-sm text-ink-muted">Informe como o pedido foi enviado. O código de rastreamento é opcional.</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <%= form.label :carrier, "Transportadora", class: "block text-sm font-semibold text-ink" %>
              <%= form.text_field :carrier, value: shipment.carrier, required: true, autocomplete: "organization",
                    class: "mt-1 block min-h-11 w-full rounded-xl border-brand-200 bg-white px-3 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500",
                    placeholder: "Ex.: Correios" %>
            </div>
            <div>
              <%= form.label :service, "Modalidade", class: "block text-sm font-semibold text-ink" %>
              <%= form.text_field :service, value: shipment.service, required: true, autocomplete: "off",
                    class: "mt-1 block min-h-11 w-full rounded-xl border-brand-200 bg-white px-3 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500",
                    placeholder: "Ex.: SEDEX ou PAC" %>
            </div>
          </div>
          <div class="mt-4">
            <%= form.label :tracking_code, "Código de rastreamento (opcional)", class: "block text-sm font-semibold text-ink" %>
            <%= form.text_field :tracking_code, value: shipment.tracking_code, autocomplete: "off",
                  class: "mt-1 block min-h-11 w-full rounded-xl border-brand-200 bg-white px-3 text-sm shadow-sm focus:border-brand-500 focus:ring-brand-500",
                  placeholder: "Ex.: AA123456789BR" %>
          </div>
          <%= form.submit "Marcar como enviado",
                class: "mt-5 inline-flex min-h-11 cursor-pointer items-center rounded-full bg-brand-500 px-6 py-3 text-sm font-bold text-white hover:bg-brand-600" %>
        <% end %>
      <% end %>
    <% elsif shipment&.shipped? %>
      <% if shipment.customer_reported_delivered_at.present? %>
        <p class="mt-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
          O cliente avisou que recebeu em <%= l(shipment.customer_reported_delivered_at, format: :short) %>. Confirme abaixo para fechar a entrega.
        </p>
      <% end %>
      <%= button_to(shipment.local_pickup? ? "Confirmar retirada" : "Confirmar entrega",
            deliver_seller_order_path(@order), method: :patch,
            class: "mt-5 inline-flex min-h-11 cursor-pointer items-center rounded-full bg-brand-500 px-6 py-3 text-sm font-bold text-white hover:bg-brand-600",
            form: { data: { turbo_confirm: shipment.local_pickup? ? "Confirma que o cliente retirou o pedido?" : "Confirma que o pedido foi entregue?" } }) %>
    <% end %>
    <% if @seller_order.accepts_messages? %>
      <%= link_to "Fale com o cliente", seller_order_messages_path(@order),
            class: "mt-5 inline-flex min-h-11 items-center rounded-full border border-brand-200 px-6 py-3 text-sm font-bold text-brand-700 hover:bg-brand-50" %>
    <% end %>
  </section>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)]">
    <section class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-bold">Itens do seu ateliê</h2>
      <ul class="mt-4 divide-y divide-brand-100">
        <% @order_items.each do |item| %>
          <li class="flex justify-between gap-4 py-4">
            <div>
              <p class="font-semibold"><%= item.product_name %></p>
              <p class="text-sm text-ink-muted"><%= item.quantity %> × <%= format_price(item.unit_price_cents) %></p>
              <% if item.production_time_snapshot.present? %><p class="mt-1 text-xs text-ink-muted">Produção: <%= item.production_time_snapshot %></p><% end %>
            </div>
            <p class="font-semibold"><%= format_price(item.subtotal_cents) %></p>
          </li>
        <% end %>
      </ul>
      <dl class="mt-6 space-y-2 border-t border-brand-100 pt-5 text-sm">
        <% if payment %>
          <div class="flex justify-between"><dt>Meio de pagamento</dt><dd class="font-semibold"><%= payment_method_label(payment) %></dd></div>
        <% end %>
        <div class="flex justify-between"><dt>Subtotal após descontos</dt><dd><%= format_price(@seller_order.commission_base_cents) %></dd></div>
        <div class="flex justify-between"><dt>Comissão EloShop (15%)</dt><dd>− <%= format_price(@seller_order.platform_fee_cents) %></dd></div>
        <div class="flex justify-between"><dt>Frete</dt><dd><%= format_price(@seller_order.shipping_cents) %></dd></div>
        <div class="flex justify-between border-t border-brand-100 pt-2 font-bold"><dt>Valor do artesão</dt><dd><%= format_price(@seller_order.seller_amount_cents) %></dd></div>
      </dl>
    </section>

    <aside class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-bold"><%= shipment&.local_pickup? ? "Dados para retirada" : "Endereço de entrega" %></h2>
      <address class="mt-4 not-italic text-sm leading-6 text-ink-muted">
        <p class="font-semibold text-ink"><%= @order.customer.name %></p>
        <p><%= [address["street"], address["number"]].compact_blank.join(", ") %></p>
        <% if address["complement"].present? %><p><%= address["complement"] %></p><% end %>
        <p><%= [address["neighborhood"], address["city"]].compact_blank.join(" — ") %><%= "/#{address['state']}" if address["state"].present? %></p>
        <% if address["zip_code"].present? %><p>CEP <%= address["zip_code"] %></p><% end %>
      </address>
      <% if shipment %>
        <dl class="mt-5 space-y-2 border-t border-brand-100 pt-5 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">Modalidade</dt><dd class="text-right font-semibold"><%= shipment.carrier %> — <%= shipment.service %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">Prazo estimado</dt><dd class="font-semibold"><%= shipping_estimate_label(shipment) %></dd></div>
          <% if shipment.tracking_code.present? %><div class="flex justify-between gap-4"><dt class="text-ink-muted">Rastreamento</dt><dd class="font-semibold"><%= shipment.tracking_code %></dd></div><% end %>
        </dl>
      <% end %>
    </aside>
  </div>
</div>
