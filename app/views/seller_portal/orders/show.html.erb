<div class="space-y-6"><header><%= link_to "← Pedidos", seller_orders_path, class: "text-sm font-semibold text-brand-600" %><h1 class="mt-3 text-3xl font-bold">Pedido #<%= @order.id %></h1><p class="mt-2 text-ink-muted"><%= @seller_order.status.humanize %> · <%= @order.customer.name %></p></header><section class="rounded-2xl bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Itens do seu ateliê</h2><ul class="mt-4 divide-y divide-gray-100"><% @order_items.each do |item| %><li class="flex justify-between gap-4 py-4"><div><p class="font-semibold"><%= item.product_name %></p><p class="text-sm text-ink-muted"><%= item.quantity %> × <%= number_to_currency(item.unit_price_cents.fdiv(100)) %></p></div><p class="font-semibold"><%= number_to_currency(item.subtotal_cents.fdiv(100)) %></p></li><% end %></ul><dl class="mt-6 space-y-2 border-t pt-5 text-sm"><div class="flex justify-between"><dt>Subtotal após descontos</dt><dd><%= number_to_currency(@seller_order.commission_base_cents.fdiv(100)) %></dd></div><div class="flex justify-between"><dt>Comissão EloShop (15%)</dt><dd>− <%= number_to_currency(@seller_order.platform_fee_cents.fdiv(100)) %></dd></div><div class="flex justify-between"><dt>Frete</dt><dd><%= number_to_currency(@seller_order.shipping_cents.fdiv(100)) %></dd></div><div class="flex justify-between border-t pt-2 font-bold"><dt>Valor do artesão</dt><dd><%= number_to_currency(@seller_order.seller_amount_cents.fdiv(100)) %></dd></div></dl></section></div>
