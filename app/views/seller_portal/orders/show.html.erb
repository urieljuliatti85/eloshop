<%
  seller_order_status_classes = {
    "pending" => "bg-stone-100 text-stone-600",
    "confirmed" => "bg-emerald-100 text-emerald-800",
    "cancelled" => "bg-amber-100 text-amber-800",
    "partially_refunded" => "bg-amber-100 text-amber-800",
    "refunded" => "bg-amber-100 text-amber-800"
  }
%>
<div class="space-y-6"><header><%= link_to "← Pedidos", seller_orders_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-brand-600" %><h1 class="mt-3 text-3xl font-black tracking-tight">Pedido #<%= @order.id %></h1><p class="mt-3 flex items-center gap-2 text-sm text-ink-muted"><span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= seller_order_status_classes[@seller_order.status] %>"><%= t(@seller_order.status, scope: "seller_orders.statuses") %></span> <%= @order.customer.name %></p></header><section class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm"><h2 class="text-xl font-bold">Itens do seu ateliê</h2><ul class="mt-4 divide-y divide-brand-100"><% @order_items.each do |item| %><li class="flex justify-between gap-4 py-4"><div><p class="font-semibold"><%= item.product_name %></p><p class="text-sm text-ink-muted"><%= item.quantity %> × <%= format_price(item.unit_price_cents) %></p></div><p class="font-semibold"><%= format_price(item.subtotal_cents) %></p></li><% end %></ul><dl class="mt-6 space-y-2 border-t border-brand-100 pt-5 text-sm"><div class="flex justify-between"><dt>Subtotal após descontos</dt><dd><%= format_price(@seller_order.commission_base_cents) %></dd></div><div class="flex justify-between"><dt>Comissão EloShop (15%)</dt><dd>− <%= format_price(@seller_order.platform_fee_cents) %></dd></div><div class="flex justify-between"><dt>Frete</dt><dd><%= format_price(@seller_order.shipping_cents) %></dd></div><div class="flex justify-between border-t border-brand-100 pt-2 font-bold"><dt>Valor do artesão</dt><dd><%= format_price(@seller_order.seller_amount_cents) %></dd></div></dl></section></div>
