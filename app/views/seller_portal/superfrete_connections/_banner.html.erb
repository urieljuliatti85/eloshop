<section class="relative flex flex-col justify-between gap-5 overflow-hidden rounded-[2rem] border border-brand-100 bg-white p-6 shadow-[0_1px_2px_rgba(120,40,10,0.03),0_16px_40px_rgba(120,40,10,0.05)] sm:flex-row sm:items-start sm:p-8">
  <span class="pointer-events-none absolute -right-8 -top-10 size-40 rounded-full bg-brand-50" aria-hidden="true"></span>
  <span class="pointer-events-none absolute -right-2 -top-2 size-24 rounded-full bg-brand-100/70" aria-hidden="true"></span>
  <div class="relative flex max-w-3xl items-start gap-4">
    <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-[#7a2410] text-white" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
    </span>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Frete</p>
      <h2 class="mt-1 text-2xl font-bold">SuperFrete</h2>
    <% if current_seller.superfrete_connected? %>
      <p class="mt-2 text-sm leading-6 text-stone-600">
        Conta conectada<%= " (#{current_seller.superfrete_account_email})" if current_seller.superfrete_account_email.present? %>
        em <%= l(current_seller.superfrete_connected_at, format: :short) %>. Ambiente: <%= current_seller.superfrete_sandbox? ? "teste" : "produção" %>.
        As etiquetas são pagas pela carteira dessa conta.
      </p>
      <%= render "seller_portal/shared/shipping_preference" %>
    <% elsif @superfrete_connection_available %>
      <p class="mt-2 text-sm leading-6 text-stone-600">Conecte a sua conta da SuperFrete para cotar o frete na hora, pelo CEP do cliente, com PAC, SEDEX e Mini Envios. A conta e a carteira continuam suas.</p>
    <% else %>
      <div class="mt-3"><%= render "seller_portal/shared/shipping_in_development" %></div>
    <% end %>
    </div>
  </div>
  <div class="relative shrink-0">
    <% if current_seller.superfrete_connected? %>
      <%= button_to "Desconectar", seller_superfrete_connection_path, method: :delete, class: "min-h-11 rounded-full border border-red-200 px-6 py-3 text-sm font-bold text-red-700 hover:bg-red-50", form: { data: { turbo_confirm: "Desconectar a conta? O frete volta a usar o valor que você definiu em cada produto." } } %>
    <% elsif @superfrete_connection_available %>
      <%= link_to "Conectar SuperFrete", seller_superfrete_connect_path, class: "inline-flex min-h-11 items-center rounded-full bg-[#7a2410] px-6 py-3 text-sm font-bold text-white hover:bg-[#5f1c0c]", data: { turbo: false } %>
    <% end %>
  </div>
</section>
