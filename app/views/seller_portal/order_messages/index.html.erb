<div class="space-y-6">
  <header>
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Atendimento</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight">Mensagens</h1>
    <p class="mt-2 max-w-2xl text-sm text-ink-muted">Converse com clientes sobre pedidos com pagamento confirmado.</p>
  </header>

  <% if @seller_orders.empty? %>
    <div class="rounded-3xl border border-brand-100 bg-white p-8 text-center shadow-sm">
      <p class="font-semibold text-ink">Nenhuma conversa disponível</p>
      <p class="mt-2 text-sm text-ink-muted">Os pedidos pagos aparecerão aqui.</p>
    </div>
  <% else %>
    <div class="divide-y divide-brand-100 overflow-hidden rounded-3xl border border-brand-100 bg-white shadow-sm">
      <% @seller_orders.each do |seller_order| %>
        <% order = seller_order.order %>
        <% last_message = seller_order.order_messages.max_by(&:created_at) %>
        <%= link_to seller_order_messages_path(order), class: "flex min-h-20 items-center justify-between gap-4 px-5 py-4 transition hover:bg-brand-50/60" do %>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-bold text-ink">Pedido #<%= order.id %></p>
              <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800"><%= t(seller_order.status, scope: "seller_orders.statuses") %></span>
            </div>
            <p class="mt-1 truncate text-sm font-medium text-stone-700"><%= order.customer.name %></p>
            <p class="mt-1 truncate text-sm text-ink-muted"><%= last_message&.body || "Nenhuma mensagem ainda" %></p>
          </div>
          <span class="shrink-0 text-sm font-semibold text-brand-600">Abrir conversa →</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
