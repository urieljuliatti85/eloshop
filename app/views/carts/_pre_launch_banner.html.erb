<%# Pré-cadastro para o comprador: o carrinho é onde ele descobre que ainda
    não dá para fechar a compra. Mesmo cartão dos avisos do artesão
    (seller_portal/shared/_pre_launch_banner), com o convite aos favoritos. %>
<section class="relative mt-8 overflow-hidden rounded-[1.75rem] bg-brand-600 text-white" aria-labelledby="pre-launch-cart-title">
  <span class="pointer-events-none absolute inset-2 rounded-[1.4rem] border-2 border-dashed border-white/45 sm:inset-3" aria-hidden="true"></span>

  <div class="relative flex max-w-3xl flex-col items-start gap-4 px-7 py-8 sm:px-10 sm:py-10">
    <p class="rounded-full bg-white/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em]">Vendas em breve</p>

    <h2 id="pre-launch-cart-title" class="text-2xl font-black leading-tight tracking-tight sm:text-3xl">A EloShop abre as vendas em breve.</h2>

    <p class="text-base leading-relaxed text-white/90">
      Estamos recebendo os ateliês e preparando a loja. As compras abrem até meados de novembro de 2026. Até lá, salve nos favoritos as peças que você gostou para encontrá-las fácil quando abrir.
    </p>

    <%= link_to "Explorar peças", products_path,
          class: "inline-flex min-h-11 items-center rounded-full bg-white px-7 py-3 text-sm font-semibold text-brand-600 shadow-sm transition hover:bg-brand-50" %>
  </div>
</section>
