<div class="w-full">
  <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Sacola</p>
  <h1 class="mt-1 text-4xl font-bold text-ink">Carrinho</h1>

  <% if @cart.cart_items.empty? %>
    <p class="mt-8 text-ink-muted">Seu carrinho está vazio.</p>
    <%= link_to "Ver produtos", products_path, class: "mt-4 inline-block text-brand-600 hover:underline" %>
  <% else %>
    <div class="mt-10 grid grid-cols-1 gap-16 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="hidden grid-cols-[88px_1fr_110px_140px_100px] gap-4 border-b border-gray-200 pb-4 text-xs font-semibold uppercase tracking-wider text-ink-muted sm:grid">
          <span></span>
          <span>Produto</span>
          <span class="text-right">Preço</span>
          <span class="text-center">Qtd.</span>
          <span class="text-right">Total</span>
        </div>

        <div class="divide-y divide-gray-100">
          <% @cart.cart_items.includes({ product: :seller }, :product_variant).each do |item| %>
            <div class="grid grid-cols-[88px_1fr] items-center gap-4 py-8 sm:grid-cols-[88px_1fr_110px_140px_100px]">
              <div class="relative h-22 w-22 flex-none overflow-hidden rounded-xl bg-gray-50">
                <% if item.product.main_image.attached? %>
                  <%= image_tag item.product.main_image, class: "h-full w-full object-cover", alt: item.product.name %>
                <% end %>

                <%= button_to "×", cart_item_path(item), method: :delete,
                      class: "absolute -right-2 -top-2 flex h-6 w-6 cursor-pointer items-center justify-center rounded-full bg-white text-ink shadow hover:bg-red-50 hover:text-red-700",
                      form: { aria: { label: "Remover #{item.product.name}" } } %>
              </div>

              <div>
                <%= link_to item.product.name, product_path(item.product.seller, item.product.slug), class: "font-semibold text-ink hover:text-brand-600" %>
                <% if item.product_variant %>
                  <p class="text-sm text-ink-muted"><%= item.product_variant.to_label %></p>
                <% end %>
                <% item.personalization_entries.each do |entry| %>
                  <p class="text-sm text-ink-muted"><%= entry[:label] %>: <%= entry[:value] %></p>
                <% end %>
                <p class="mt-1 text-sm text-ink-muted sm:hidden">
                  <%= format_price(item.unit_price_cents) %>
                </p>
              </div>

              <p class="hidden text-right text-sm text-ink-muted sm:block">
                <%= format_price(item.unit_price_cents) %>
              </p>

              <div class="flex items-center gap-3 sm:justify-center">
                <% if item.quantity > 1 %>
                  <%= button_to "−", cart_item_path(item), method: :patch, params: { quantity: item.quantity - 1 },
                        class: "flex h-7 w-7 cursor-pointer items-center justify-center rounded-full border border-gray-300 text-ink hover:border-brand-500 hover:text-brand-600" %>
                <% else %>
                  <span class="flex h-7 w-7 items-center justify-center rounded-full border border-gray-100 text-gray-300">−</span>
                <% end %>

                <span class="w-6 text-center text-sm font-medium text-ink"><%= item.quantity %></span>

                <%= button_to "+", cart_item_path(item), method: :patch, params: { quantity: item.quantity + 1 },
                      class: "flex h-7 w-7 cursor-pointer items-center justify-center rounded-full border border-gray-300 text-ink hover:border-brand-500 hover:text-brand-600" %>
              </div>

              <p class="text-right font-medium text-ink"><%= format_price(item.subtotal_cents) %></p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="lg:col-span-1">
        <div class="sticky top-24 border-t border-gray-200 pt-8">
          <% if @cart.coupon %>
            <div class="flex items-center justify-between text-sm">
              <span class="text-ink-muted">Cupom <strong><%= @cart.coupon.code %></strong></span>
              <%= button_to "Remover", remove_coupon_cart_path, method: :delete, class: "text-brand-600 hover:underline" %>
            </div>
            <p class="mt-1 flex justify-between text-sm text-ink-muted">
              <span>Desconto</span>
              <span>-<%= format_price(@cart.discount_cents) %></span>
            </p>
          <% else %>
            <%= form_with url: apply_coupon_cart_path, method: :post, class: "flex gap-2" do %>
              <%= text_field_tag :code, nil, placeholder: "Cupom de desconto", class: "min-w-0 flex-1 rounded-full border border-gray-300 px-4 py-2 text-sm" %>
              <%= submit_tag "Aplicar", class: "rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold hover:border-brand-500" %>
            <% end %>
          <% end %>

          <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-ink-muted">Total do carrinho</p>
          <p class="mt-2 text-3xl font-bold text-ink">
            <%= number_to_currency((@cart.subtotal_cents - @cart.discount_cents) / 100.0) %>
          </p>
          <p class="mt-1 text-sm text-ink-muted">Frete calculado no checkout.</p>

          <%= link_to "Finalizar compra", new_order_path, class: "mt-8 block w-full rounded-full bg-brand-500 px-8 py-4 text-center text-sm font-semibold text-white hover:bg-brand-600" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
