<div class="mx-auto w-full max-w-3xl">
  <div class="mb-8"><%= render "orders/checkout_steps", current: 3 %></div>

  <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_18rem]">
    <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Pedido #<%= @order.id %></p>

      <% if @payment %>
        <h1 class="mb-2 mt-1 text-2xl font-bold text-ink">
          <%= @payment.pix? ? "Finalize com PIX" : "Pagamento com cartão" %>
        </h1>
        <p class="mb-6 text-sm text-ink-muted">Total a pagar: <%= format_price(@payment.amount_cents) %></p>

        <%= render "payment",
                   payment: @payment,
                   order: @order,
                   simulated_gateway: @simulated_gateway,
                   webhook_secret: @webhook_secret %>
      <% else %>
        <h1 class="mb-2 mt-1 text-2xl font-bold text-ink">Como você quer pagar?</h1>
        <p class="mb-6 text-sm text-ink-muted">Total a pagar: <%= format_price(@order.total_cents) %></p>

        <% seller = @order.seller_order.seller %>
        <%# O botão de cartão e a seção do Brick precisam ficar sob o MESMO
            data-controller: Stimulus só liga um data-action ao controller
            que o contém. Com o botão fora deste elemento o clique não
            chegava a showCard e nada acontecia na tela. %>
        <div data-controller="payment-method-choice">
          <div class="grid gap-4 sm:grid-cols-2">
            <%= form_with url: order_payment_path(@order), method: :post do |form| %>
              <%= form.hidden_field :payment_method, value: "pix" %>
              <%= form.submit "Pagar com PIX",
                              class: "w-full rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700 cursor-pointer" %>
            <% end %>

            <% if seller.mercado_pago_card_payments_available? %>
              <button type="button" data-action="click->payment-method-choice#showCard"
                      class="w-full rounded-full border border-brand-500 px-6 py-3 text-sm font-semibold text-brand-600 hover:bg-brand-50">
                Pagar com cartão de crédito
              </button>
            <% end %>
          </div>

          <% if seller.mercado_pago_card_payments_available? %>
            <%# O Brick só é montado (via data-controller) depois de exibido —
                não no carregamento da página: o SDK precisa medir o
                container, e um elemento display:none tem dimensão zero,
                fazendo os iframes internos do Brick renderizarem quebrados. %>
            <template data-payment-method-choice-target="cardTemplate">
              <div data-controller="card-payment-brick"
                   data-card-payment-brick-public-key-value="<%= seller.mercado_pago_public_key %>"
                   data-card-payment-brick-amount-value="<%= @order.total_cents / 100.0 %>"
                   data-card-payment-brick-form-url-value="<%= order_payment_path(@order) %>"
                   data-card-payment-brick-csp-nonce-value="<%= content_security_policy_nonce %>">
                <p data-card-payment-brick-target="error" hidden class="mb-4 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-800"></p>
                <div data-card-payment-brick-target="container"></div>
              </div>
            </template>
            <div data-payment-method-choice-target="cardSection" class="mt-6"></div>
            <script src="https://sdk.mercadopago.com/js/v2" nonce="<%= content_security_policy_nonce %>"></script>
          <% end %>
        </div>
      <% end %>

      <%# Afirmações verificáveis no código: o cartão é digitado no Card Payment
          Brick (iframe do Mercado Pago) e o backend só recebe o token. %>
      <div class="mt-8 border-t border-gray-100 pt-5 text-sm leading-6 text-ink-muted">
        <p><span class="font-semibold text-ink">Pagamento processado pelo Mercado Pago.</span> O valor vai direto para o ateliê.</p>
        <p class="mt-1">No cartão, você digita os dados no formulário do próprio Mercado Pago: a EloShop não recebe nem guarda o número do cartão ou o código de segurança.</p>
      </div>
    </section>

    <aside class="rounded-2xl bg-brand-50 p-5">
      <h2 class="font-semibold text-ink">Seu pedido</h2>
      <ul class="mt-4 divide-y divide-brand-200 text-sm">
        <% @order.order_items.each do |item| %>
          <li class="py-3 first:pt-0">
            <div class="flex justify-between gap-3"><span class="font-medium text-ink"><%= item.product_name %> × <%= item.quantity %></span><span class="whitespace-nowrap"><%= format_price(item.subtotal_cents) %></span></div>
            <% item.personalization_entries.each do |entry| %><p class="mt-1 text-xs text-ink-muted"><%= entry[:label] %>: <%= entry[:value] %></p><% end %>
          </li>
        <% end %>
      </ul>
      <dl class="mt-4 space-y-2 border-t border-brand-200 pt-4 text-sm">
        <div class="flex justify-between gap-3 text-ink-muted"><dt>Produtos</dt><dd class="whitespace-nowrap"><%= format_price(@order.subtotal_cents) %></dd></div>
        <% if @order.discount_cents.positive? %>
          <div class="flex justify-between gap-3 text-green-800"><dt>Desconto</dt><dd class="whitespace-nowrap">− <%= format_price(@order.discount_cents) %></dd></div>
        <% end %>
        <div class="flex justify-between gap-3 text-ink-muted"><dt>Frete</dt><dd class="whitespace-nowrap"><%= @order.shipping_cents.zero? ? "Grátis" : format_price(@order.shipping_cents) %></dd></div>
        <div class="flex justify-between gap-3 border-t border-brand-200 pt-3 text-base font-bold text-ink"><dt>Total</dt><dd class="whitespace-nowrap"><%= format_price(@order.total_cents) %></dd></div>
      </dl>
      <%= link_to "Ver detalhes do pedido", order_path(@order), class: "mt-5 block text-sm font-semibold text-brand-600 hover:underline" %>
    </aside>
  </div>
</div>
