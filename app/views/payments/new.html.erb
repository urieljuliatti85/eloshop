<div class="w-full max-w-md">
  <h1 class="mb-2 text-2xl font-bold text-ink">Pagamento — Pedido #<%= @order.id %></h1>
  <p class="mb-6 text-sm text-ink-muted">Valor: <%= number_to_currency(@payment.amount_cents / 100.0) %></p>

  <%= render "payment",
             payment: @payment,
             order: @order,
             simulated_gateway: @simulated_gateway,
             webhook_secret: @webhook_secret %>
</div>
