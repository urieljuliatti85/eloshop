<div class="w-full max-w-md">
  <h1 class="text-2xl font-bold mb-2">Pagamento — Pedido #<%= @order.id %></h1>
  <p class="mb-4 text-sm text-gray-600">Valor: <%= number_to_currency(@payment.amount_cents / 100.0, unit: "BRL") %></p>

  <% if @payment.paid? %>
    <p class="text-green-700">Pagamento aprovado.</p>
  <% elsif @payment.failed? %>
    <p class="text-red-700 mb-4">Pagamento recusado.</p>
    <%= link_to "Tentar novamente", new_order_payment_path(@order), class: "underline" %>
  <% else %>
    <p class="mb-6 text-gray-600">
      Este é um gateway de pagamento simulado (não há integração real ainda — ver <code>docs/payments.md</code>).
      Use os botões abaixo para simular a resposta do gateway.
    </p>

    <div class="flex gap-4">
      <%= form_with url: fake_gateway_webhook_path, method: :post do |form| %>
        <%= form.hidden_field :event_id, value: SecureRandom.hex(10) %>
        <%= form.hidden_field :external_id, value: @payment.external_id %>
        <%= form.hidden_field :status, value: "approved" %>
        <%= form.hidden_field :secret, value: @webhook_secret %>
        <%= form.submit "Aprovar pagamento", class: "bg-green-700 text-white px-4 py-2 rounded" %>
      <% end %>

      <%= form_with url: fake_gateway_webhook_path, method: :post do |form| %>
        <%= form.hidden_field :event_id, value: SecureRandom.hex(10) %>
        <%= form.hidden_field :external_id, value: @payment.external_id %>
        <%= form.hidden_field :status, value: "declined" %>
        <%= form.hidden_field :secret, value: @webhook_secret %>
        <%= form.submit "Recusar pagamento", class: "bg-red-700 text-white px-4 py-2 rounded" %>
      <% end %>
    </div>
  <% end %>
</div>
