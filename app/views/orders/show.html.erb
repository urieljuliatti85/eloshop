<% payment = @order.payments.max_by(&:created_at) %>

<div class="mx-auto w-full max-w-4xl">
  <%= link_to "← Meus pedidos", orders_path, class: "mb-6 inline-block text-sm font-semibold text-brand-600 hover:underline" %>

  <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Acompanhamento</p>
      <h1 class="mt-1 text-3xl font-black tracking-tight text-ink">Pedido #<%= @order.id %></h1>
      <p class="mt-2 text-sm text-ink-muted"><%= @order.customer.name %> · <%= l(@order.created_at, format: :short) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= order_status_badge_classes(@order) %>"><%= t(@order.status, scope: "orders.statuses") %></span>
      <%# Enquanto o pagamento não entra, o estado de entrega repetia o mesmo
          "Aguardando pagamento" do selo ao lado. %>
      <% unless @order.pending? %>
        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= seller_order_fulfillment_badge_classes(@seller_order) %>"><%= seller_order_fulfillment_label(@seller_order) %></span>
      <% end %>
    </div>
  </header>

  <% if payment %>
    <p class="mt-4 inline-block rounded-full bg-mist-100 px-4 py-2 text-sm text-ink">
      <%= payment_summary_label(payment) %>
    </p>
  <% end %>

  <% if @seller_order.production_started? %>
    <p class="mt-4 inline-block rounded-full bg-mist-100 px-4 py-2 text-sm text-ink">
      Produção iniciada em <span class="font-semibold"><%= l(@seller_order.production_started_at, format: :short) %></span>
    </p>
  <% end %>

  <% shipment = @seller_order.shipment %>
  <section class="mt-6 rounded-2xl border border-brand-100 bg-white p-5 shadow-sm sm:p-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Linha do tempo</p>
        <h2 class="mt-1 text-xl font-bold text-ink">Da confirmação à entrega</h2>
      </div>
      <% if shipment %>
        <p class="text-sm text-ink-muted"><%= @seller_order.seller.name %> · <%= shipment.carrier %> · <%= shipment.service %></p>
      <% end %>
    </div>

    <ol class="mt-6 grid gap-3 sm:grid-cols-4" aria-label="Acompanhamento do pedido">
      <% seller_order_timeline_steps(@seller_order).each do |step| %>
        <% current = step[:state] == :current %>
        <% complete = step[:state] == :complete %>
        <li class="relative rounded-2xl border p-4 <%= current ? 'border-brand-400 bg-brand-50' : complete ? 'border-emerald-200 bg-emerald-50/60' : 'border-stone-200 bg-stone-50' %>" aria-current="<%= current ? 'step' : 'false' %>">
          <div class="flex items-center gap-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-full text-sm font-black <%= current ? 'bg-brand-600 text-white' : complete ? 'bg-emerald-600 text-white' : 'bg-stone-200 text-stone-500' %>" aria-hidden="true"><%= complete ? "✓" : "•" %></span>
            <p class="font-semibold <%= step[:state] == :upcoming ? 'text-stone-500' : 'text-stone-950' %>"><%= step[:label] %></p>
          </div>
          <% if step[:time] %>
            <p class="mt-3 text-xs text-ink-muted"><%= l(step[:time], format: :short) %></p>
          <% elsif current %>
            <p class="mt-3 text-xs font-semibold text-brand-700">Etapa atual</p>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <% if shipment&.shipped? && !shipment.local_pickup? %>
    <section class="mt-6 rounded-2xl border border-brand-100 bg-white p-5 shadow-sm sm:p-6">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Detalhes do Envio</p>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-ink-muted">Transportadora</dt>
          <dd class="font-semibold text-ink"><%= shipment.carrier %></dd>
        </div>
        <div>
          <dt class="text-ink-muted">Modalidade</dt>
          <dd class="font-semibold text-ink"><%= shipment.service %></dd>
        </div>
        <% if shipment.tracking_code.present? %>
          <div class="sm:col-span-2">
            <dt class="text-ink-muted">Código de rastreamento</dt>
            <dd class="font-semibold text-ink"><%= shipment.tracking_code %></dd>
          </div>
        <% end %>
      </dl>
    </section>
  <% end %>

  <div class="mb-8 mt-6 flex flex-wrap gap-3">
    <% if @order.pending? %>
      <%= link_to "Pagar agora", new_order_payment_path(@order), class: "inline-block w-fit rounded-full bg-brand-600 px-8 py-3 text-sm font-semibold text-white hover:bg-brand-700" %>
    <% end %>

    <%# Pedido pago não se cancela por aqui (Orders::Cancel recusa e manda
        usar reembolso): o caminho é a solicitação com protocolo (ADR 008). %>
    <% open_withdrawal = @seller_order.return_requests.open.kind_withdrawal.first %>
    <% if open_withdrawal %>
      <%= link_to order_return_request_path(@order, open_withdrawal),
            class: "inline-flex min-h-11 items-center rounded-full bg-amber-50 px-6 text-sm font-semibold text-amber-900 hover:bg-amber-100" do %>
        Você pediu para desistir desta compra (<span class="whitespace-nowrap"><%= open_withdrawal.protocol %></span>) · acompanhar
      <% end %>
    <% elsif ReturnRequest.available_kinds(@seller_order).any? %>
      <%= link_to "Desistir da compra ou relatar um problema", new_order_return_request_path(@order),
            class: "inline-flex min-h-11 items-center rounded-full border border-red-200 px-6 text-sm font-semibold text-red-700 hover:bg-red-50" %>
    <% elsif @order.pending? %>
      <%= button_to "Cancelar pedido", cancel_order_path(@order), method: :post,
            class: "inline-block w-fit rounded-full border border-red-200 px-8 py-3 text-sm font-semibold text-red-700 hover:bg-red-50",
            form: { data: { turbo_confirm: "Cancelar este pedido?" } } %>
    <% end %>

    <% if @seller_order.shipment&.shipped? && @seller_order.shipment.customer_reported_delivered_at.blank? %>
      <%= button_to(@seller_order.shipment.local_pickup? ? "Confirmar retirada" : "Confirmar recebimento",
            deliver_order_path(@order), method: :patch,
            class: "inline-block w-fit rounded-full bg-brand-600 px-8 py-3 text-sm font-semibold text-white hover:bg-brand-700",
            form: { data: { turbo_confirm: @seller_order.shipment.local_pickup? ? "Avisar o ateliê que você retirou o pedido?" : "Avisar o ateliê que você recebeu o pedido?" } }) %>
    <% elsif @seller_order.shipment&.shipped? %>
      <p class="inline-flex items-center rounded-full bg-emerald-50 px-6 py-3 text-sm font-semibold text-emerald-800">
        Você avisou o ateliê que recebeu em <%= l(@seller_order.shipment.customer_reported_delivered_at, format: :short) %>.
      </p>
    <% end %>

    <% if @seller_order.accepts_messages? %>
      <%= link_to "Falar com o ateliê", order_messages_path(@order), class: "inline-flex min-h-11 items-center rounded-full border border-brand-200 px-6 text-sm font-semibold text-brand-700 hover:bg-brand-50" %>
    <% end %>
  </div>

  <% if (return_requests = @seller_order.return_requests.order(created_at: :desc).to_a).any? %>
    <section class="mb-8" aria-labelledby="return-requests-title">
      <h2 id="return-requests-title" class="mb-3 font-semibold text-ink">Solicitações</h2>
      <ul class="divide-y divide-gray-200 border-y border-gray-200">
        <% return_requests.each do |return_request| %>
          <li>
            <%= link_to order_return_request_path(@order, return_request), class: "flex min-h-11 items-center justify-between gap-3 py-3 text-sm hover:text-brand-700" do %>
              <span><span class="font-semibold text-ink"><%= return_request.protocol %></span> · <%= return_request.kind_label %></span>
              <span class="text-ink-muted"><%= return_request.status_label %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <h2 class="mb-3 font-semibold text-ink">Itens</h2>
  <div class="divide-y divide-gray-200 border-y border-gray-200">
    <% @order.order_items.each do |item| %>
      <div class="flex items-center justify-between py-3 text-sm">
        <div>
          <p class="text-ink"><%= item.product_name %> <span class="text-ink-muted">x<%= item.quantity %></span></p>
          <% if item.variant_label.present? %>
            <p class="text-ink-muted"><%= item.variant_label %></p>
          <% end %>
          <% item.personalization_entries.each do |entry| %>
            <p class="text-ink-muted"><%= entry[:label] %>: <%= entry[:value] %></p>
          <% end %>
          <% if item.production_time_snapshot.present? %>
            <p class="text-ink-muted">Prazo de produção: <%= item.production_time_snapshot %></p>
          <% end %>
        </div>
        <p class="text-ink"><%= format_price(item.subtotal_cents) %></p>
      </div>
    <% end %>
  </div>

  <div class="mt-4 space-y-2 text-sm">
    <div class="flex justify-between text-ink-muted">
      <span>Subtotal</span>
      <span><%= format_price(@order.subtotal_cents) %></span>
    </div>
    <% if @order.coupon %>
      <div class="flex justify-between text-ink-muted">
        <span>Cupom <%= @order.coupon.code %></span>
        <span>-<%= format_price(@order.discount_cents) %></span>
      </div>
    <% end %>
    <div class="flex justify-between text-ink-muted">
      <span>Frete</span>
      <span><%= format_price(@order.shipping_cents) %></span>
    </div>
    <% if @order.shipment %>
      <div class="flex justify-between text-ink-muted">
        <%# Só o transporte: o prazo de produção de cada peça sob encomenda
            aparece no item, e o envio começa depois dele. %>
        <span>Transporte · <%= @order.shipment.service %><%= " (depois da produção)" if @order.order_items.any? { |item| item.production_time_snapshot.present? } %></span>
        <span><%= shipping_estimate_label(@order.shipment) %></span>
      </div>
    <% end %>
    <div class="flex justify-between text-base font-semibold text-ink">
      <span>Total</span>
      <span><%= format_price(@order.total_cents) %></span>
    </div>
  </div>

  <h2 class="mb-2 mt-8 font-semibold text-ink">Endereço de entrega</h2>
  <p class="text-sm text-ink-muted">
    <span class="block font-semibold text-ink"><%= @order.recipient_display_name %></span>
    <%= @order.shipping_address_snapshot["street"] %>, <%= @order.shipping_address_snapshot["number"] %>
    - <%= @order.shipping_address_snapshot["city"] %>/<%= @order.shipping_address_snapshot["state"] %>
  </p>
</div>
