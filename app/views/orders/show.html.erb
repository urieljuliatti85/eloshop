<div class="w-full max-w-2xl">
  <% if notice %>
    <p class="mb-6 rounded bg-green-50 px-4 py-3 text-sm text-green-800"><%= notice %></p>
  <% end %>

  <h1 class="mb-2 text-2xl font-bold text-ink">Pedido #<%= @order.id %></h1>
  <p class="mb-6 text-sm text-ink-muted">Status: <%= @order.status %></p>

  <% if @order.pending? %>
    <%= link_to "Pagar agora", new_order_payment_path(@order), class: "mb-8 inline-block w-fit rounded-full bg-brand-500 px-8 py-3 text-sm font-semibold text-white hover:bg-brand-600" %>
  <% end %>

  <h2 class="mb-3 font-semibold text-ink">Itens</h2>
  <div class="divide-y divide-gray-200 border-y border-gray-200">
    <% @order.order_items.each do |item| %>
      <div class="flex items-center justify-between py-3 text-sm">
        <div>
          <p class="text-ink"><%= item.product_name %> <span class="text-ink-muted">x<%= item.quantity %></span></p>
          <% if item.variant_label.present? %>
            <p class="text-ink-muted"><%= item.variant_label %></p>
          <% end %>
          <% if item.production_time_snapshot.present? %>
            <p class="text-ink-muted">Prazo de produção: <%= item.production_time_snapshot %></p>
          <% end %>
        </div>
        <p class="text-ink"><%= number_to_currency(item.subtotal_cents / 100.0, unit: "BRL") %></p>
      </div>
    <% end %>
  </div>

  <div class="mt-4 space-y-2 text-sm">
    <div class="flex justify-between text-ink-muted">
      <span>Subtotal</span>
      <span><%= number_to_currency(@order.subtotal_cents / 100.0, unit: "BRL") %></span>
    </div>
    <div class="flex justify-between text-ink-muted">
      <span>Frete</span>
      <span><%= number_to_currency(@order.shipping_cents / 100.0, unit: "BRL") %></span>
    </div>
    <div class="flex justify-between text-base font-semibold text-ink">
      <span>Total</span>
      <span><%= number_to_currency(@order.total_cents / 100.0, unit: "BRL") %></span>
    </div>
  </div>

  <h2 class="mb-2 mt-8 font-semibold text-ink">Endereço de entrega</h2>
  <p class="text-sm text-ink-muted">
    <%= @order.shipping_address_snapshot["street"] %>, <%= @order.shipping_address_snapshot["number"] %>
    - <%= @order.shipping_address_snapshot["city"] %>/<%= @order.shipping_address_snapshot["state"] %>
  </p>
</div>
