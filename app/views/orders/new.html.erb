<div class="mx-auto w-full max-w-6xl">
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Checkout seguro</p>
    <h1 class="mt-2 text-3xl font-bold text-ink">Revise e confirme seu pedido</h1>
    <div class="mt-6"><%= render "orders/checkout_steps", current: 2 %></div>
  </header>

  <% if @addresses.empty? %>
    <section class="max-w-2xl rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-ink">Cadastre o endereço de entrega</h2>
      <p class="mt-2 text-sm text-ink-muted">Você voltará automaticamente para esta revisão depois de salvar.</p>
      <%= link_to "Cadastrar endereço", new_address_path(return_to: new_order_path), class: "mt-6 inline-block rounded-full bg-brand-600 px-7 py-3 text-sm font-semibold text-white hover:bg-brand-700" %>
    </section>
  <% else %>
    <% production_max_days = @cart.production_time_max_days %>
    <%= form_with url: orders_path,
          class: "grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_24rem]",
          data: { controller: "checkout", checkout_subtotal_value: @cart.subtotal_cents - @cart.discount_cents } do |form| %>
      <div class="space-y-6">
        <section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Entrega</p>
              <h2 class="mt-1 text-xl font-semibold text-ink">Escolha o endereço</h2>
            </div>
            <%= link_to "+ Novo endereço", new_address_path(return_to: new_order_path), class: "text-sm font-semibold text-brand-600 hover:underline" %>
          </div>

          <div class="mt-5 space-y-3">
            <% @addresses.each do |address| %>
              <% quote = @shipping_quotes[address]&.first %>
              <label class="flex items-start gap-3 rounded-2xl border border-gray-200 px-4 py-4 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 <%= 'opacity-60' unless quote %>">
                <%= radio_button_tag :address_id, address.id, address == @selected_address,
                      disabled: quote.nil?, required: true, class: "mt-1",
                      data: { checkout_target: "address", action: "change->checkout#selectAddress", shipping_cents: quote&.shipping_cents } %>
                <span class="min-w-0 flex-1 text-sm">
                  <span class="block font-semibold text-ink"><%= address.street %>, <%= address.number %></span>
                  <span class="mt-1 block text-ink-muted"><%= [address.neighborhood, address.city, address.state].compact_blank.join(" · ") %> · CEP <%= address.zip_code %></span>
                  <% if quote %>
                    <span class="mt-2 block font-medium text-ink">A partir de <%= format_price(quote.shipping_cents) %> · <%= checkout_delivery_estimate_label(quote, production_max_days) %></span>
                  <% else %>
                    <span class="mt-2 block font-medium text-red-700">Não entregamos neste endereço. Escolha outro ou cadastre um novo.</span>
                  <% end %>
                </span>
              </label>
            <% end %>
          </div>
        </section>

        <%# A escolha só aparece quando há mais de uma modalidade: cotações do
            provedor ou entrega acompanhada de retirada no ateliê. As opções são
            cotadas por CEP, então cada endereço tem o próprio grupo; só o do
            endereço marcado fica visível e habilitado, e é o único enviado. %>
        <% @addresses.each do |address| %>
          <% options = @shipping_quotes[address] || [] %>
          <% active = address == @selected_address %>
          <div data-checkout-target="optionGroup" data-address-id="<%= address.id %>" <%= "hidden" unless active %>>
            <% if options.size > 1 %>
              <section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Frete</p>
                <h2 class="mt-1 text-xl font-semibold text-ink">Escolha como receber</h2>

                <div class="mt-5 space-y-3">
                  <% options.each_with_index do |option, index| %>
                    <label class="flex items-start gap-3 rounded-2xl border border-gray-200 px-4 py-4 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
                      <%= radio_button_tag :shipping_quote_id, option.id, active && index.zero?, required: true, disabled: !active, class: "mt-1",
                            id: "shipping_quote_#{address.id}_#{option.id}",
                            data: { checkout_target: "shippingOption", action: "change->checkout#update", shipping_cents: option.shipping_cents } %>
                      <span class="min-w-0 flex-1 text-sm">
                        <span class="block font-semibold text-ink"><%= option.carrier %> · <%= option.service %></span>
                        <span class="mt-1 block text-ink-muted"><%= checkout_delivery_estimate_label(option, production_max_days) %> · <%= format_price(option.shipping_cents) %></span>
                      </span>
                    </label>
                  <% end %>
                </div>
              </section>
            <% elsif options.one? %>
              <%= hidden_field_tag :shipping_quote_id, options.first.id, id: nil, disabled: !active %>
            <% end %>
          </div>
        <% end %>

        <section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Produtos</p>
          <h2 class="mt-1 text-xl font-semibold text-ink">Itens do pedido</h2>
          <ul class="mt-5 divide-y divide-gray-100">
            <% @cart.cart_items.includes({ product: :seller }, :product_variant).each do |item| %>
              <li class="flex justify-between gap-4 py-4 first:pt-0 last:pb-0">
                <div>
                  <p class="font-semibold text-ink"><%= item.product.name %></p>
                  <p class="text-sm text-ink-muted"><%= item.product.seller.name %> · <%= pluralize(item.quantity, "unidade") %></p>
                  <% if item.product_variant %><p class="text-sm text-ink-muted"><%= item.product_variant.to_label %></p><% end %>
                  <% item.personalization_entries.each do |entry| %>
                    <p class="text-sm text-ink-muted"><%= entry[:label] %>: <%= entry[:value] %></p>
                  <% end %>
                  <% if (production = item.product.production_time_range) %>
                    <p class="text-sm font-medium text-ink">Sob encomenda: produção de <%= production %></p>
                  <% end %>
                </div>
                <p class="whitespace-nowrap font-semibold text-ink"><%= format_price(item.subtotal_cents) %></p>
              </li>
            <% end %>
          </ul>
        </section>
      </div>

      <aside class="rounded-2xl bg-brand-50 p-6 lg:sticky lg:top-24">
        <h2 class="text-xl font-semibold text-ink">Resumo</h2>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex justify-between text-ink-muted"><dt>Produtos</dt><dd><%= format_price(@cart.subtotal_cents) %></dd></div>
          <% if @cart.coupon %>
            <div class="flex justify-between text-green-800"><dt>Cupom <%= @cart.coupon.code %></dt><dd>− <%= format_price(@cart.discount_cents) %></dd></div>
          <% end %>
          <div class="flex justify-between text-ink-muted"><dt>Frete</dt><dd data-checkout-target="shipping"><%= @shipping ? format_price(@shipping_cents) : "Escolha o endereço" %></dd></div>
          <div class="flex justify-between border-t border-brand-200 pt-4 text-lg font-bold text-ink"><dt>Total</dt><dd data-checkout-target="total"><%= @shipping ? number_to_currency((@cart.subtotal_cents - @cart.discount_cents + @shipping_cents).fdiv(100)) : "—" %></dd></div>
        </dl>

        <%= form.submit "Ir para pagamento", disabled: @selected_address.nil?, class: "mt-6 w-full cursor-pointer rounded-full bg-brand-600 px-8 py-4 text-sm font-semibold text-white hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-50" %>
        <% if @selected_address.nil? %>
          <p class="mt-3 text-center text-sm leading-5 text-ink">Escolha um endereço com entrega disponível para continuar.</p>
        <% end %>
        <p class="mt-3 text-center text-xs leading-5 text-ink-muted">Antes de criar o pedido, conferimos de novo estoque, desconto e frete.</p>
        <%= link_to "← Voltar ao carrinho", cart_path, class: "mt-5 block text-center text-sm font-semibold text-brand-600 hover:underline" %>
      </aside>
    <% end %>
  <% end %>
</div>
