<div class="mx-auto w-full max-w-4xl">
  <header class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Sua conta</p>
      <h1 class="mt-2 text-3xl font-bold text-ink">Meus pedidos</h1>
      <p class="mt-2 text-sm text-ink-muted">Acompanhe pagamentos e consulte os detalhes das suas compras.</p>
    </div>
    <%= link_to "Continuar comprando", products_path, class: "mt-3 w-fit rounded-full border border-gray-200 px-5 py-2.5 text-sm font-semibold text-ink transition hover:border-brand-500 hover:text-brand-600 sm:mt-0" %>
  </header>

  <% if @orders.any? %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <article class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-lg font-bold text-ink">Pedido #<%= order.id %></h2>
                <span class="rounded-full px-3 py-1 text-xs font-semibold <%= order.confirmed? ? "bg-green-100 text-green-800" : order.cancelled? ? "bg-red-100 text-red-800" : "bg-amber-100 text-amber-800" %>">
                  <%= t("orders.statuses.#{order.status}") %>
                </span>
              </div>
              <p class="mt-2 text-sm text-ink-muted">
                <%= l(order.created_at.to_date, format: :short) %> ·
                <%= pluralize(order.order_items.size, "item", "itens") %>
              </p>
            </div>

            <div class="flex items-center justify-between gap-5 sm:justify-end">
              <p class="text-lg font-bold text-ink"><%= format_price(order.total_cents) %></p>
              <%= link_to "Ver detalhes", order_path(order), class: "rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-3xl border border-dashed border-gray-300 bg-sand-50 px-6 py-16 text-center">
      <h2 class="text-xl font-bold text-ink">Você ainda não fez nenhum pedido</h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-ink-muted">Conheça as peças dos nossos artesãos e encontre algo feito especialmente para você.</p>
      <%= link_to "Explorar a loja", products_path, class: "mt-6 inline-block rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-600" %>
    </div>
  <% end %>
</div>
