<%# Quem recebe o pedido (Checkout::Recipient). O CPF só é obrigatório com
    entrega: a etiqueta exige, a retirada no ateliê não gera etiqueta. O
    checkout_controller liga e desliga o `required` conforme a modalidade
    marcada; quem decide de verdade é o servidor. %>
<% pickup = @shipping&.local_pickup? %>
<% field_class = ->(attribute) { "w-full rounded-xl border px-3 py-2 focus:border-brand-500 focus:outline-none #{recipient.errors[attribute].any? ? 'border-red-500' : 'border-gray-300'}" } %>
<section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="recipient_heading">
  <p class="text-xs font-semibold uppercase tracking-wider text-brand-600">Destinatário</p>
  <h2 id="recipient_heading" class="mt-1 text-xl font-semibold text-ink">Quem vai receber</h2>
  <p class="mt-2 text-sm text-ink-muted">Os Correios pedem nome e CPF de quem recebe na etiqueta. Usamos esses dados só para o envio deste pedido.</p>

  <div class="mt-5 flex flex-col gap-4">
    <div>
      <%= label_tag "recipient_name", "Nome completo", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= text_field_tag "recipient[name]", recipient.name, id: "recipient_name", required: true, maxlength: Checkout::Recipient::NAME_MAX_LENGTH,
            autocomplete: "name", class: field_class.call(:name),
            aria: { invalid: (recipient.errors[:name].any? || nil), describedby: ("recipient_name_error" if recipient.errors[:name].any?) } %>
      <% if recipient.errors[:name].any? %>
        <p id="recipient_name_error" class="mt-1 text-sm text-red-700"><%= recipient.errors[:name].first %></p>
      <% end %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div data-controller="cpf-input">
        <%= label_tag "recipient_cpf", "CPF", class: "mb-1 block text-sm font-medium text-ink" %>
        <%= text_field_tag "recipient[cpf]", Cpf.format(recipient.cpf), id: "recipient_cpf", required: !pickup,
              inputmode: "numeric", autocomplete: "off", maxlength: 14, placeholder: "000.000.000-00",
              class: field_class.call(:cpf),
              data: { cpf_input_target: "input", checkout_target: "cpf", action: "input->cpf-input#format blur->cpf-input#validate" },
              aria: { invalid: (recipient.errors[:cpf].any? || nil), describedby: "recipient_cpf_requirement recipient_cpf_check#{' recipient_cpf_error' if recipient.errors[:cpf].any?}" } %>
        <p id="recipient_cpf_requirement" class="mt-1 text-xs text-ink-muted" data-checkout-target="cpfRequirement"><%= pickup ? "Opcional na retirada no ateliê." : "Obrigatório para entrega." %></p>
        <p id="recipient_cpf_check" class="mt-1 text-sm text-red-700" data-cpf-input-target="message" hidden></p>
        <% if recipient.errors[:cpf].any? %>
          <p id="recipient_cpf_error" class="mt-1 text-sm text-red-700"><%= recipient.errors[:cpf].first %></p>
        <% end %>
      </div>

      <div>
        <%= label_tag "recipient_phone", "Telefone (opcional)", class: "mb-1 block text-sm font-medium text-ink" %>
        <%= telephone_field_tag "recipient[phone]", recipient.phone, id: "recipient_phone", inputmode: "tel", autocomplete: "tel-national",
              maxlength: 20, placeholder: "(27) 99999-9999", class: field_class.call(:phone),
              aria: { invalid: (recipient.errors[:phone].any? || nil), describedby: ("recipient_phone_error" if recipient.errors[:phone].any?) } %>
        <% if recipient.errors[:phone].any? %>
          <p id="recipient_phone_error" class="mt-1 text-sm text-red-700"><%= recipient.errors[:phone].first %></p>
        <% end %>
      </div>
    </div>
  </div>
</section>
