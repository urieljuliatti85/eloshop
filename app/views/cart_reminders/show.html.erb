<% content_for :title, "Lembretes de carrinho — EloShop" %>

<div class="mx-auto w-full max-w-md rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
  <h1 class="text-2xl font-bold text-ink">Lembretes de carrinho</h1>
  <% if @customer.cart_reminder_emails? %>
    <p class="mt-3 text-ink-muted">Quer parar de receber e-mails quando você deixar itens no carrinho?</p>
    <%= button_to "Parar de receber lembretes", cart_reminder_unsubscribe_path(params[:token]), method: :delete,
          class: "mt-6 cursor-pointer rounded-full bg-brand-500 px-6 py-3 font-semibold text-white hover:bg-brand-600" %>
  <% else %>
    <p class="mt-3 text-ink-muted">Você já não recebe lembretes de carrinho da EloShop.</p>
  <% end %>
</div>
