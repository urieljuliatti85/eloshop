<% if pagination.total_pages > 1 %>
  <%# No celular os números de página saem (o "Página X de Y" já situa) e a
    linha pode quebrar: sem isso a paginação passava da largura da tela, o
    documento alargava e o celular reduzia o zoom da página inteira. %>
  <nav class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 px-1 py-2" aria-label="Paginação">
    <p class="text-sm text-slate-500">
      Página <%= pagination.current_page %> de <%= pagination.total_pages %>
      <span class="text-slate-400">(<%= pluralize(pagination.total_count, "item", plural: "itens") %>)</span>
    </p>
    <div class="flex items-center gap-2">
      <%= link_to "Anterior", url_for(request.query_parameters.merge(page: pagination.current_page - 1)),
            class: "admin-button admin-button--secondary #{'pointer-events-none opacity-40' if pagination.first_page?}",
            aria: (pagination.first_page? ? { disabled: "true" } : {}) %>

      <% if pagination.total_pages > 1 %>
        <div class="hidden items-center gap-1 sm:flex">
          <% pagination.page_window.each do |page| %>
            <% if page.nil? %>
              <span class="px-1 text-sm text-slate-400" aria-hidden="true">…</span>
            <% elsif page == pagination.current_page %>
              <span class="admin-button admin-button--primary pointer-events-none min-w-10 px-0" aria-current="page"><%= page %></span>
            <% else %>
              <%= link_to page, url_for(request.query_parameters.merge(page: page)), class: "admin-button admin-button--secondary min-w-10 px-0" %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%= link_to "Próxima", url_for(request.query_parameters.merge(page: pagination.current_page + 1)),
            class: "admin-button admin-button--secondary #{'pointer-events-none opacity-40' if pagination.last_page?}",
            aria: (pagination.last_page? ? { disabled: "true" } : {}) %>
    </div>
  </nav>
<% end %>
