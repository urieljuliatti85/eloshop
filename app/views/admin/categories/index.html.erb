<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="admin-section-label mb-2">Organização do catálogo</p>
      <h1>Categorias</h1>
      <p class="mt-2 text-sm text-slate-500">Estruture como os clientes encontram os produtos.</p>
    </div>
    <%= link_to "Nova categoria", new_admin_category_path, class: "admin-button admin-button--brand" %>
  </header>

  <% if @categories.any? %>
    <div class="admin-table-wrap">
      <table>
        <thead><tr><th>Categoria</th><th>Categoria pai</th><th>Na loja</th><th>Produtos</th><th><span class="sr-only">Ações</span></th></tr></thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td class="font-semibold text-slate-900"><%= @category_tree.breadcrumb_name(category) %></td>
              <td><%= @category_tree.parent(category)&.name || "Categoria principal" %></td>
              <%# Uma categoria ativa sob um pai desabilitado também não
                  aparece na loja — a coluna mostra o efeito, não só a flag. %>
              <td>
                <% if category.active? %>
                  <%= admin_status_badge(hidden_category_ids.include?(category.id) ? "inactive" : "active",
                        label: hidden_category_ids.include?(category.id) ? "Oculta pelo pai" : "Visível") %>
                <% else %>
                  <%= admin_status_badge("inactive", label: "Desabilitada") %>
                <% end %>
              </td>
              <td><span class="admin-badge admin-badge--neutral"><%= product_counts.fetch(category.id, 0) %></span></td>
              <td>
                <div class="flex justify-end gap-2">
                  <%= link_to "Editar", edit_admin_category_path(category), class: "admin-button admin-button--secondary" %>
                  <%= button_to "Excluir", admin_category_path(category), method: :delete, class: "admin-button admin-button--danger", form: { data: { turbo_confirm: "Excluir esta categoria?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty-state">Nenhuma categoria cadastrada.</div>
  <% end %>
</div>
