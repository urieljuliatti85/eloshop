<%= form_with model: [ :admin, coupon ], class: "admin-form" do |form| %>
  <% if coupon.errors.any? %>
    <div class="admin-flash admin-flash--danger">
      <ul>
        <% coupon.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :code, "Código" %>
    <%= form.text_field :code, class: "w-full" %>
  </div>

  <div>
    <%= form.label :discount_type, "Tipo de desconto" %>
    <%= form.select :discount_type,
          options_for_select([ [ "Percentual", "percentage" ], [ "Valor fixo", "fixed" ] ], form.object.discount_type),
          {}, class: "w-full" %>
  </div>

  <div>
    <%= form.label :percentage, "Percentual (1 a 100, quando percentual)" %>
    <%= form.number_field :percentage, class: "w-full" %>
  </div>

  <div>
    <%= form.label :amount, "Valor fixo em R$ (quando valor fixo)" %>
    <%= form.text_field :amount, value: price_field_value(form.object.amount_cents),
          inputmode: "decimal", placeholder: "0,00", data: { controller: "price-input", action: "input->price-input#format" }, class: "w-full" %>
  </div>

  <div>
    <%= form.label :minimum_subtotal, "Subtotal mínimo em R$ (opcional)" %>
    <%= form.text_field :minimum_subtotal, value: price_field_value(form.object.minimum_subtotal_cents),
          inputmode: "decimal", placeholder: "0,00", data: { controller: "price-input", action: "input->price-input#format" }, class: "w-full" %>
  </div>

  <div>
    <%= form.label :max_uses, "Limite total de usos (opcional)" %>
    <%= form.number_field :max_uses, class: "w-full" %>
  </div>

  <div>
    <%= form.label :starts_at, "Início da validade (opcional)" %>
    <%= form.datetime_field :starts_at, class: "w-full" %>
  </div>

  <div>
    <%= form.label :expires_at, "Fim da validade (opcional)" %>
    <%= form.datetime_field :expires_at, class: "w-full" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :active %>
    <%= form.label :active, "Ativo" %>
  </div>

  <%= form.submit "Salvar cupom", class: "admin-button admin-button--brand" %>
<% end %>
