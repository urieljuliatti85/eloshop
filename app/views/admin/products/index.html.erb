<div class="w-full">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Produtos</h1>
    <%= link_to "Novo produto", new_admin_product_path, class: "bg-black text-white px-4 py-2 rounded" %>
  </div>

  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="border-b">
        <th class="py-2">Nome</th>
        <th class="py-2">SKU</th>
        <th class="py-2">Preço</th>
        <th class="py-2">Estoque</th>
        <th class="py-2">Status</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr class="border-b">
          <td class="py-2"><%= product.name %></td>
          <td class="py-2"><%= product.sku %></td>
          <td class="py-2"><%= number_to_currency(product.price_cents / 100.0, unit: product.currency) %></td>
          <td class="py-2"><%= product.stock_quantity %></td>
          <td class="py-2"><%= product.status %></td>
          <td class="py-2"><%= link_to "Ver", admin_product_path(product) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
