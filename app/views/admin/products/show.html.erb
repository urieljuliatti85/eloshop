<div class="w-full max-w-xl">
  <h1 class="text-2xl font-bold mb-2"><%= @product.name %></h1>
  <p class="mb-4 text-sm text-gray-600">Status: <%= @product.status %></p>

  <% if @product.main_image.attached? %>
    <%= image_tag @product.main_image, class: "mb-4 max-w-xs" %>
  <% end %>

  <% if @product.images.attached? %>
    <div class="mb-6">
      <p class="font-semibold mb-2">Galeria (<%= @product.images.count %>/<%= Product::IMAGES_MAX_COUNT %>)</p>
      <div class="flex flex-wrap gap-3">
        <% @product.images.each do |image| %>
          <div class="relative">
            <%= image_tag image, class: "h-24 w-24 object-cover rounded border" %>
            <%= button_to "×", admin_product_product_image_path(@product, image),
                  method: :delete, class: "absolute -right-2 -top-2 h-6 w-6 rounded-full bg-white border text-red-700",
                  form: { data: { turbo_confirm: "Remover esta imagem?" } } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <dl class="grid grid-cols-2 gap-y-2 mb-6">
    <dt class="font-semibold">SKU</dt>
    <dd><%= @product.sku %></dd>

    <dt class="font-semibold">Preço</dt>
    <dd><%= number_to_currency(@product.price_cents / 100.0) %></dd>

    <dt class="font-semibold">Estoque</dt>
    <dd><%= @product.stock_quantity %></dd>

    <dt class="font-semibold">Descrição</dt>
    <dd><%= @product.description %></dd>

    <dt class="font-semibold">Categoria</dt>
    <dd><%= @product.category&.breadcrumb_name || "Sem categoria" %></dd>
  </dl>

  <div class="flex gap-2">
    <%= link_to "Editar", edit_admin_product_path(@product), class: "border px-3 py-1 rounded" %>

    <% if @product.draft? %>
      <%= button_to "Publicar", publish_admin_product_path(@product), method: :patch, class: "border px-3 py-1 rounded" %>
    <% elsif @product.active? %>
      <%= button_to "Despublicar", unpublish_admin_product_path(@product), method: :patch, class: "border px-3 py-1 rounded" %>
    <% elsif @product.sold_out? %>
      <%= button_to "Marcar como ativo", publish_admin_product_path(@product), method: :patch, class: "border px-3 py-1 rounded" %>
    <% end %>

    <% unless @product.discontinued? %>
      <%= button_to "Descontinuar", discontinue_admin_product_path(@product), method: :patch, class: "border px-3 py-1 rounded text-red-700" %>
    <% end %>
  </div>

  <% if @product.availability_type_standard? %>
    <div class="mt-8">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold">Variantes</h2>
        <%= link_to "Nova variante", new_admin_product_product_variant_path(@product), class: "border px-3 py-1 rounded text-sm" %>
      </div>

      <% if @product.product_variants.any? %>
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b">
              <th class="py-2">Combinação</th>
              <th class="py-2">SKU</th>
              <th class="py-2">Preço</th>
              <th class="py-2">Estoque</th>
              <th class="py-2">Ativa</th>
              <th class="py-2"></th>
            </tr>
          </thead>
          <tbody>
            <% @product.product_variants.each do |variant| %>
              <tr class="border-b">
                <td class="py-2"><%= variant.to_label %></td>
                <td class="py-2"><%= variant.sku %></td>
                <td class="py-2"><%= number_to_currency(variant.price_cents / 100.0) %></td>
                <td class="py-2"><%= variant.stock_quantity %></td>
                <td class="py-2"><%= variant.active? ? "Sim" : "Não" %></td>
                <td class="py-2">
                  <%= link_to "Editar", edit_admin_product_product_variant_path(@product, variant), class: "underline" %>
                  <%= button_to "Excluir", admin_product_product_variant_path(@product, variant), method: :delete, class: "text-red-700 underline ml-2", form: { data: { turbo_confirm: "Excluir esta variante?" } } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-sm text-gray-600">Nenhuma variante cadastrada.</p>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold">Personalização</h2>
      <%= link_to "Novo campo", new_admin_product_personalization_option_path(@product), class: "border px-3 py-1 rounded text-sm" %>
    </div>

    <% if @product.personalization_options.any? %>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b">
            <th class="py-2">Campo</th>
            <th class="py-2">Obrigatório</th>
            <th class="py-2">Limite de caracteres</th>
            <th class="py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% @product.personalization_options.each do |option| %>
            <tr class="border-b">
              <td class="py-2"><%= option.label %></td>
              <td class="py-2"><%= option.required? ? "Sim" : "Não" %></td>
              <td class="py-2"><%= option.max_length %></td>
              <td class="py-2">
                <%= link_to "Editar", edit_admin_product_personalization_option_path(@product, option), class: "underline" %>
                <%= button_to "Excluir", admin_product_personalization_option_path(@product, option), method: :delete, class: "text-red-700 underline ml-2", form: { data: { turbo_confirm: "Excluir este campo?" } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-600">Nenhum campo de personalização cadastrado.</p>
    <% end %>
  </div>
</div>
