<div class="space-y-8">
  <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <%= link_to "← Voltar para produtos", admin_products_path, class: "admin-link mb-3 inline-block text-sm" %>
      <p class="admin-section-label mb-2">Produto</p>
      <div class="flex flex-wrap items-center gap-3"><h1><%= @product.name %></h1><%= admin_status_badge(@product.status) %></div>
      <p class="mt-2 text-sm text-slate-500">SKU <%= @product.sku %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Editar", edit_admin_product_path(@product), class: "admin-button admin-button--secondary" %>
      <% if @product.draft? || @product.sold_out? %>
        <%= button_to "Publicar", publish_admin_product_path(@product), method: :patch, class: "admin-button admin-button--brand" %>
      <% elsif @product.active? %>
        <%= button_to "Despublicar", unpublish_admin_product_path(@product), method: :patch, class: "admin-button admin-button--secondary" %>
      <% end %>
      <% unless @product.discontinued? %>
        <%= button_to "Descontinuar", discontinue_admin_product_path(@product), method: :patch, class: "admin-button admin-button--danger" %>
      <% end %>
    </div>
  </header>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(19rem,0.7fr)_minmax(0,1.3fr)]">
    <div class="space-y-6">
      <section class="admin-card overflow-hidden">
        <div class="aspect-square bg-[#f3efe6]">
          <% if @product.main_image.attached? %>
            <%= image_tag @product.main_image, class: "h-full w-full object-cover", alt: @product.name %>
          <% else %>
            <div class="grid h-full place-items-center text-sm font-semibold text-slate-400">Sem imagem principal</div>
          <% end %>
        </div>
        <% if @product.images.attached? %>
          <div class="border-t border-slate-100 p-5">
            <div class="mb-3 flex items-center justify-between"><h2>Galeria</h2><span class="text-xs text-slate-500"><%= @product.images.count %>/<%= Product::IMAGES_MAX_COUNT %></span></div>
            <div class="grid grid-cols-4 gap-3">
              <% @product.images.each do |image| %>
                <div class="relative aspect-square">
                  <%= image_tag image, class: "h-full w-full rounded-xl border border-slate-200 object-cover", alt: "" %>
                  <%= button_to "×", admin_product_product_image_path(@product, image), method: :delete,
                        class: "absolute -right-2 -top-2 grid size-7 place-items-center rounded-full border border-rose-200 bg-white font-bold text-rose-700 shadow-sm",
                        form: { data: { turbo_confirm: "Remover esta imagem?" } }, aria: { label: "Remover imagem" } %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    </div>

    <div class="space-y-6">
      <section class="admin-card p-5 sm:p-6">
        <p class="admin-section-label">Informações comerciais</p>
        <dl class="mt-5 grid gap-5 sm:grid-cols-2">
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Preço</dt><dd class="mt-1 text-xl font-semibold text-slate-950"><%= number_to_currency(@product.price_cents.fdiv(100)) %></dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estoque</dt><dd class="mt-1 text-xl font-semibold text-slate-950"><%= @product.stock_quantity %> un.</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Categoria</dt><dd class="mt-1 text-sm font-semibold text-slate-800"><%= @product.category&.breadcrumb_name || "Sem categoria" %></dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Disponibilidade</dt><dd class="mt-1 text-sm font-semibold text-slate-800"><%= @product.availability_type.humanize %></dd></div>
          <div class="sm:col-span-2"><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Descrição</dt><dd class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600"><%= @product.description.presence || "Sem descrição." %></dd></div>
        </dl>
      </section>

      <% if @product.availability_type_standard? %>
        <section class="admin-card overflow-hidden">
          <div class="admin-card-header"><div><p class="admin-section-label">Catálogo</p><h2 class="mt-1">Variantes</h2></div><%= link_to "Nova variante", new_admin_product_product_variant_path(@product), class: "admin-button admin-button--secondary" %></div>
          <% if @product.product_variants.any? %>
            <div class="overflow-x-auto"><table><thead><tr><th>Combinação</th><th>SKU</th><th>Preço</th><th>Estoque</th><th>Status</th><th></th></tr></thead><tbody>
              <% @product.product_variants.each do |variant| %>
                <tr><td class="font-semibold text-slate-900"><%= variant.to_label %></td><td class="font-mono text-xs"><%= variant.sku %></td><td><%= number_to_currency(variant.price_cents.fdiv(100)) %></td><td><%= variant.stock_quantity %></td><td><%= admin_status_badge(variant.active? ? "active" : "inactive") %></td><td><div class="flex justify-end gap-2"><%= link_to "Editar", edit_admin_product_product_variant_path(@product, variant), class: "admin-link" %><%= button_to "Excluir", admin_product_product_variant_path(@product, variant), method: :delete, class: "text-sm font-semibold text-rose-700", form: { data: { turbo_confirm: "Excluir esta variante?" } } %></div></td></tr>
              <% end %>
            </tbody></table></div>
          <% else %>
            <p class="m-5 admin-empty-state">Nenhuma variante cadastrada.</p>
          <% end %>
        </section>
      <% end %>

      <section class="admin-card overflow-hidden">
        <div class="admin-card-header"><div><p class="admin-section-label">Experiência do produto</p><h2 class="mt-1">Personalização</h2></div><%= link_to "Novo campo", new_admin_product_personalization_option_path(@product), class: "admin-button admin-button--secondary" %></div>
        <% if @product.personalization_options.any? %>
          <div class="overflow-x-auto"><table><thead><tr><th>Campo</th><th>Obrigatório</th><th>Limite</th><th></th></tr></thead><tbody>
            <% @product.personalization_options.each do |option| %>
              <tr><td class="font-semibold text-slate-900"><%= option.label %></td><td><%= admin_status_badge(option.required? ? "active" : "inactive", label: option.required? ? "Sim" : "Não") %></td><td><%= option.max_length %> caracteres</td><td><div class="flex justify-end gap-2"><%= link_to "Editar", edit_admin_product_personalization_option_path(@product, option), class: "admin-link" %><%= button_to "Excluir", admin_product_personalization_option_path(@product, option), method: :delete, class: "text-sm font-semibold text-rose-700", form: { data: { turbo_confirm: "Excluir este campo?" } } %></div></td></tr>
            <% end %>
          </tbody></table></div>
        <% else %>
          <p class="m-5 admin-empty-state">Nenhum campo de personalização cadastrado.</p>
        <% end %>
      </section>
    </div>
  </div>
</div>
