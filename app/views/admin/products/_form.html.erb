<%= form_with model: [ :admin, product ], class: "flex flex-col gap-4 w-full max-w-xl" do |form| %>
  <% if product.errors.any? %>
    <div class="text-red-700">
      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nome" %>
    <%= form.text_field :name, class: "border rounded w-full px-2 py-1" %>
  </div>

  <div>
    <%= form.label :description, "Descrição" %>
    <%= form.text_area :description, class: "border rounded w-full px-2 py-1" %>
  </div>

  <div>
    <%= form.label :price_cents, "Preço (em centavos)" %>
    <%= form.number_field :price_cents, class: "border rounded w-full px-2 py-1" %>
  </div>

  <div>
    <%= form.label :currency, "Moeda" %>
    <%= form.text_field :currency, value: form.object.currency || "BRL", class: "border rounded w-full px-2 py-1" %>
  </div>

  <div>
    <%= form.label :sku, "SKU" %>
    <%= form.text_field :sku, class: "border rounded w-full px-2 py-1" %>
  </div>

  <div>
    <%= form.label :stock_quantity, "Estoque" %>
    <%= form.number_field :stock_quantity, class: "border rounded w-full px-2 py-1" %>
  </div>

  <div>
    <%= form.label :main_image, "Imagem principal" %>
    <%= form.file_field :main_image, accept: "image/png,image/jpeg,image/webp" %>
  </div>

  <%= form.submit "Salvar", class: "bg-black text-white px-4 py-2 rounded w-fit" %>
<% end %>
