<%# Cadastros mais recentes no topo do dashboard: clientes e artesãos. O selo
    do artesão é o status (já na linha), não a etapa de cadastro
    (`seller_onboarding_badge`), que custaria duas queries por artesão. %>
<section class="grid gap-6 lg:grid-cols-2" aria-label="Cadastros recentes">
  <section class="admin-card p-5 sm:p-6" aria-labelledby="recent-customers-title">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="admin-section-label">Relacionamento</p>
        <h2 id="recent-customers-title" class="mt-1">Últimos clientes cadastrados</h2>
      </div>
      <%= link_to "Ver todos", admin_customers_path, class: "admin-link shrink-0 text-sm" %>
    </div>
    <% if customers.any? %>
      <ul class="mt-5 divide-y divide-slate-100">
        <% customers.each do |customer| %>
          <li class="flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0">
            <div class="min-w-0">
              <%= link_to customer.name, admin_customer_path(customer), class: "block truncate text-sm font-semibold text-slate-800 hover:text-brand-600" %>
              <p class="truncate text-xs text-slate-500"><%= customer.email %></p>
            </div>
            <time class="shrink-0 whitespace-nowrap text-xs text-slate-500" datetime="<%= customer.created_at.iso8601 %>" title="<%= l(customer.created_at, format: "%d/%m/%Y às %H:%M") %>">
              há <%= time_ago_in_words(customer.created_at) %>
            </time>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-5 text-sm text-slate-500">Nenhum cliente cadastrado ainda.</p>
    <% end %>
  </section>

  <section class="admin-card p-5 sm:p-6" aria-labelledby="recent-sellers-title">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="admin-section-label">Marketplace</p>
        <h2 id="recent-sellers-title" class="mt-1">Últimos artesãos cadastrados</h2>
      </div>
      <%= link_to "Ver todos", admin_sellers_path, class: "admin-link shrink-0 text-sm" %>
    </div>
    <% if sellers.any? %>
      <ul class="mt-5 divide-y divide-slate-100">
        <% sellers.each do |seller| %>
          <li class="flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0">
            <div class="min-w-0">
              <%= link_to seller.name, admin_seller_path(seller), class: "block truncate text-sm font-semibold text-slate-800 hover:text-brand-600" %>
              <p class="truncate text-xs text-slate-500"><%= seller.users.first&.email_address || seller.owner_full_name %></p>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-1">
              <%= admin_status_badge(seller.status) %>
              <time class="whitespace-nowrap text-xs text-slate-500" datetime="<%= seller.created_at.iso8601 %>" title="<%= l(seller.created_at, format: "%d/%m/%Y às %H:%M") %>">
                há <%= time_ago_in_words(seller.created_at) %>
              </time>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-5 text-sm text-slate-500">Nenhum artesão cadastrado ainda.</p>
    <% end %>
  </section>
</section>
