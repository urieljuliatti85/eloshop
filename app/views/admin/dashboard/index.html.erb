<div class="space-y-8">
  <header class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="admin-section-label mb-2">Visão geral</p>
      <h1>Dashboard</h1>
      <p class="mt-2 text-sm text-slate-500">Acompanhe o que precisa de atenção na operação da loja.</p>
    </div>
    <%= link_to "Ver loja", root_path, class: "admin-button admin-button--secondary" %>
  </header>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-label="Indicadores principais">
    <article class="admin-stat-card">
      <p class="admin-section-label relative z-10">Pedidos pendentes</p>
      <p class="admin-stat-value relative z-10"><%= @pending_orders_count %></p>
      <%= link_to "Ver pedidos", admin_orders_path, class: "admin-link relative z-10 mt-3 inline-block text-sm" %>
    </article>
    <article class="admin-stat-card">
      <p class="admin-section-label relative z-10">Estoque baixo</p>
      <p class="admin-stat-value relative z-10"><%= @low_stock_products.count %></p>
      <%= link_to "Gerenciar produtos", admin_products_path, class: "admin-link relative z-10 mt-3 inline-block text-sm" %>
    </article>
    <article class="admin-stat-card sm:col-span-2 xl:col-span-1">
      <p class="admin-section-label relative z-10">Avaliações pendentes</p>
      <p class="admin-stat-value relative z-10"><%= @pending_reviews_count %></p>
      <%= link_to "Moderar avaliações", admin_reviews_path(status: "pending"), class: "admin-link relative z-10 mt-3 inline-block text-sm" %>
    </article>
  </section>

  <section class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(20rem,0.75fr)]">
    <div class="admin-card overflow-hidden">
      <div class="admin-card-header">
        <div>
          <p class="admin-section-label">Operação</p>
          <h2 class="mt-1">Pedidos pendentes</h2>
        </div>
        <%= link_to "Ver todos", admin_orders_path, class: "admin-link text-sm" %>
      </div>

      <% if @pending_orders.any? %>
        <div class="overflow-x-auto">
          <table>
            <thead>
              <tr>
                <th>Pedido</th>
                <th>Cliente</th>
                <th>Pagamento</th>
                <th>Total</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @pending_orders.each do |order| %>
                <% payment = order.payments.max_by(&:created_at) %>
                <tr>
                  <td class="font-semibold text-slate-900">#<%= order.id %></td>
                  <td><%= order.customer.name %></td>
                  <td><%= payment ? admin_status_badge(payment.status) : admin_status_badge("pending", label: "Não iniciado") %></td>
                  <td class="font-semibold text-slate-900"><%= number_to_currency(order.total_cents.fdiv(100)) %></td>
                  <td class="text-right"><%= link_to "Ver", admin_order_path(order), class: "admin-link" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="m-5 admin-empty-state">Nenhum pedido pendente.</p>
      <% end %>
    </div>

    <div class="space-y-6">
      <section class="admin-card p-5 sm:p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="admin-section-label">Inventário</p>
            <h2 class="mt-1">Estoque baixo</h2>
          </div>
          <span class="admin-badge admin-badge--warning"><%= @low_stock_products.count %></span>
        </div>
        <% if @low_stock_products.any? %>
          <ul class="mt-5 divide-y divide-slate-100">
            <% @low_stock_products.first(5).each do |product| %>
              <li class="flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0">
                <%= link_to product.name, admin_product_path(product), class: "min-w-0 truncate text-sm font-semibold text-slate-800 hover:text-brand-600" %>
                <span class="whitespace-nowrap text-xs font-semibold text-amber-700"><%= product.stock_quantity %> un.</span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-5 text-sm text-slate-500">Nenhum produto com estoque baixo.</p>
        <% end %>
      </section>

      <section class="admin-card p-5 sm:p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="admin-section-label">Catálogo</p>
            <h2 class="mt-1">Produtos esgotados</h2>
          </div>
          <span class="admin-badge admin-badge--danger"><%= @sold_out_products.count %></span>
        </div>
        <% if @sold_out_products.any? %>
          <ul class="mt-5 divide-y divide-slate-100">
            <% @sold_out_products.first(5).each do |product| %>
              <li class="py-3 first:pt-0 last:pb-0">
                <%= link_to product.name, admin_product_path(product), class: "text-sm font-semibold text-slate-800 hover:text-brand-600" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-5 text-sm text-slate-500">Nenhum produto esgotado.</p>
        <% end %>
      </section>
    </div>
  </section>

  <section class="admin-card overflow-hidden">
    <div class="admin-card-header">
      <div>
        <p class="admin-section-label">Comunidade</p>
        <h2 class="mt-1">Avaliações aguardando moderação</h2>
      </div>
      <%= link_to "Ver todas", admin_reviews_path(status: "pending"), class: "admin-link text-sm" %>
    </div>
    <% if @pending_reviews.any? %>
      <div class="overflow-x-auto">
        <table>
          <thead><tr><th>Produto</th><th>Cliente</th><th>Nota</th><th></th></tr></thead>
          <tbody>
            <% @pending_reviews.each do |review| %>
              <tr>
                <td class="font-semibold text-slate-900"><%= review.product.name %></td>
                <td><%= review.customer.name %></td>
                <td><span class="text-amber-500" aria-label="<%= review.rating %> de 5 estrelas"><%= "★" * review.rating %></span></td>
                <td class="text-right"><%= link_to "Moderar", admin_reviews_path(status: "pending"), class: "admin-link" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="m-5 admin-empty-state">Nenhuma avaliação aguardando moderação.</p>
    <% end %>
  </section>
</div>
