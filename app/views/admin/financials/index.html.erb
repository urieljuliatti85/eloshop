<div class="space-y-8">
  <header>
    <p class="admin-section-label mb-2">Operação financeira</p>
    <h1>Financials</h1>
    <p class="mt-2 text-sm text-slate-500">Status da integração com o Mercado Pago, valores da plataforma e contas que exigem ação.</p>
  </header>

  <section class="admin-card overflow-hidden" aria-labelledby="integration-title">
    <div class="admin-card-header">
      <div>
        <p class="admin-section-label">Plataforma</p>
        <h2 id="integration-title" class="mt-1">Integração Mercado Pago</h2>
      </div>
      <%= admin_status_badge(@integration_ready ? "active" : "pending", label: @integration_ready ? "Operacional" : "Requer atenção") %>
    </div>

    <dl class="grid gap-px bg-slate-100 sm:grid-cols-2 xl:grid-cols-4">
      <div class="bg-white p-5">
        <dt class="text-sm text-slate-500">Gateway de produção</dt>
        <dd class="mt-2"><%= admin_status_badge(@gateway_active ? "active" : "inactive", label: @gateway_active ? "Mercado Pago ativo" : "Não ativo") %></dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-sm text-slate-500">OAuth do marketplace</dt>
        <dd class="mt-2"><%= admin_status_badge(@oauth_configured ? "active" : "inactive", label: @oauth_configured ? "Configurado" : "Não configurado") %></dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-sm text-slate-500">Webhook assinado</dt>
        <dd class="mt-2"><%= admin_status_badge(@webhook_configured ? "active" : "inactive", label: @webhook_configured ? "Configurado" : "Não configurado") %></dd>
      </div>
      <div class="bg-white p-5">
        <dt class="text-sm text-slate-500">Ambiente</dt>
        <dd class="mt-2 font-semibold text-slate-900"><%= @sandbox ? "Teste" : "Produção" %></dd>
      </div>
    </dl>

    <div class="border-t border-slate-100 px-5 py-4 text-sm text-slate-500 sm:px-6">
      Último webhook do Mercado Pago processado:
      <strong class="text-slate-800"><%= @last_webhook_at ? l(@last_webhook_at, format: :short) : "nenhum registrado" %></strong>.
      Nenhuma credencial secreta é exibida nesta página.
    </div>
  </section>

  <section class="admin-card overflow-hidden" aria-labelledby="financial-summary-title">
    <div class="admin-card-header">
      <div>
        <p class="admin-section-label">Pedidos confirmados</p>
        <h2 id="financial-summary-title" class="mt-1">Movimentação financeira</h2>
      </div>
      <span class="admin-badge admin-badge--neutral"><%= @payment_attempts_count %> tentativas MP</span>
    </div>

    <div class="grid gap-4 p-5 sm:grid-cols-2 xl:grid-cols-3 sm:p-6">
      <article class="admin-stat-card">
        <p class="admin-section-label relative z-10">Vendas líquidas</p>
        <p class="admin-stat-value relative z-10"><%= format_price(@net_sales_cents) %></p>
        <p class="relative z-10 mt-3 text-sm text-slate-500">Total confirmado após reembolsos.</p>
      </article>
      <article class="admin-stat-card">
        <p class="admin-section-label relative z-10">Comissão EloShop</p>
        <p class="admin-stat-value relative z-10"><%= format_price(@platform_fee_cents) %></p>
        <p class="relative z-10 mt-3 text-sm text-slate-500">Comissão líquida após reembolsos.</p>
      </article>
      <article class="admin-stat-card">
        <p class="admin-section-label relative z-10">Valor dos artesãos</p>
        <p class="admin-stat-value relative z-10"><%= format_price(@seller_net_cents) %></p>
        <p class="relative z-10 mt-3 text-sm text-slate-500">Valor líquido destinado aos vendedores.</p>
      </article>
    </div>

    <dl class="grid gap-px border-t border-slate-100 bg-slate-100 sm:grid-cols-3">
      <div class="flex items-center justify-between gap-4 bg-white px-5 py-4 sm:px-6">
        <dt class="text-sm text-slate-500">Em andamento</dt>
        <dd class="admin-badge admin-badge--warning"><%= @payments_in_progress_count %></dd>
      </div>
      <div class="flex items-center justify-between gap-4 bg-white px-5 py-4 sm:px-6">
        <dt class="text-sm text-slate-500">Confirmados</dt>
        <dd class="admin-badge admin-badge--success"><%= @successful_payments_count %></dd>
      </div>
      <div class="flex items-center justify-between gap-4 bg-white px-5 py-4 sm:px-6">
        <dt class="text-sm text-slate-500">Falharam</dt>
        <dd class="admin-badge admin-badge--danger"><%= @failed_payments_count %></dd>
      </div>
    </dl>
  </section>

  <section class="admin-card overflow-hidden" aria-labelledby="reconciliation-title">
    <div class="admin-card-header gap-4">
      <div>
        <p class="admin-section-label">Relatório oficial</p>
        <h2 id="reconciliation-title" class="mt-1">Conciliação Mercado Pago</h2>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-3">
        <% if @official_report %>
          <%= admin_status_badge("active", label: "Conciliado") %>
        <% elsif @sales_report_configured %>
          <%= admin_status_badge("pending", label: "Aguardando atualização") %>
        <% else %>
          <%= admin_status_badge("inactive", label: "Não configurado") %>
        <% end %>

        <% if @sales_report_configured %>
          <%= button_to "Atualizar relatório", admin_financials_reconciliation_path,
                method: :post,
                class: "admin-button admin-button--primary" %>
        <% end %>
      </div>
    </div>

    <% if !@sales_report_configured %>
      <div class="border-b border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-900 sm:px-6">
        Adicione <code class="font-semibold">MERCADO_PAGO_MARKETPLACE_ACCESS_TOKEN</code> às variáveis do serviço web no Railway para habilitar a leitura do relatório oficial. O valor do token nunca aparece no Admin.
      </div>
    <% elsif @official_report %>
      <div class="border-b border-slate-100 px-5 py-4 text-sm text-slate-500 sm:px-6">
        Última atualização: <strong class="text-slate-800"><%= l(@official_report.fetched_at, format: :short) %></strong>
        · <%= @official_report.entries.size %> registros oficiais.
        A data de liberação vem da consulta individual do pagamento, pois não faz parte do relatório de vendas.
      </div>
    <% else %>
      <div class="border-b border-slate-100 px-5 py-4 text-sm text-slate-500 sm:px-6">
        A integração está configurada. Clique em “Atualizar relatório” para buscar o demonstrativo mais recente do Mercado Pago.
      </div>
    <% end %>

    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm sm:p-5">
      <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="admin-section-label">Filtros</p>
          <h3 class="mt-1 text-base font-semibold text-slate-900">Conciliação por período e vendedor</h3>
        </div>
        <%= link_to "Exportar CSV", admin_financials_export_path(@filters), class: "admin-button admin-button--secondary" %>
      </div>

      <%= form_with url: admin_financials_path, method: :get, class: "space-y-4" do |form| %>
        <div class="grid gap-3 md:grid-cols-4 xl:grid-cols-5">
          <div>
            <%= form.label :date_from, "De", class: "mb-1 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500" %>
            <%= form.date_field :date_from, value: @filters[:date_from], class: "admin-input" %>
          </div>
          <div>
            <%= form.label :date_to, "Até", class: "mb-1 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500" %>
            <%= form.date_field :date_to, value: @filters[:date_to], class: "admin-input" %>
          </div>
          <div>
            <%= form.label :seller_id, "Artesão", class: "mb-1 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500" %>
            <%= form.select :seller_id,
                  options_for_select(@sellers, @filters[:seller_id]),
                  { include_blank: "Todos" },
                  class: "admin-input" %>
          </div>
          <div>
            <%= form.label :release_status, "Liberação", class: "mb-1 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500" %>
            <%= form.select :release_status,
                  [["Todos", "all"], ["Liberados", "released"], ["Pendentes", "pending"]],
                  { selected: @filters[:release_status].presence || "all" },
                  class: "admin-input" %>
          </div>
          <div class="flex items-end">
            <%= form.submit "Filtrar", class: "admin-button admin-button--primary w-full" %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @reconciliation_rows.any? %>
      <div class="overflow-x-auto">
        <table>
          <thead>
            <tr>
              <th>Venda</th>
              <th>Artesão</th>
              <th class="text-right">Valor</th>
              <th class="text-right">Comissão</th>
              <th class="text-right">Tarifa MP</th>
              <th class="text-right">Líquido artesão</th>
              <th>Liberação</th>
              <th>Fonte</th>
            </tr>
          </thead>
          <tbody>
            <% @reconciliation_rows.each do |row| %>
              <tr>
                <td>
                  <% if row.fetch(:payment) %>
                    <%= link_to "Pedido ##{row.fetch(:sale_reference)}", admin_order_path(row.fetch(:payment).order), class: "font-semibold text-slate-900 hover:text-amber-700" %>
                  <% else %>
                    <span class="font-semibold text-slate-900">Venda <%= row.fetch(:sale_reference) %></span>
                  <% end %>
                  <p class="mt-1 text-xs text-slate-500"><%= row.fetch(:sold_at) ? l(row.fetch(:sold_at), format: :short) : "Data não informada" %></p>
                </td>
                <td class="font-medium text-slate-800"><%= row.fetch(:artisan) %></td>
                <td class="text-right font-medium"><%= row.fetch(:gross_cents).nil? ? "—" : format_price(row.fetch(:gross_cents)) %></td>
                <td class="text-right"><%= row.fetch(:commission_cents).nil? ? "—" : format_price(row.fetch(:commission_cents)) %></td>
                <td class="text-right"><%= row.fetch(:processor_fee_cents).nil? ? "—" : format_price(row.fetch(:processor_fee_cents)) %></td>
                <td class="text-right font-semibold text-slate-900"><%= row.fetch(:net_cents).nil? ? "—" : format_price(row.fetch(:net_cents)) %></td>
                <td>
                  <% if row.fetch(:release_at) %>
                    <span class="font-medium text-slate-800"><%= l(row.fetch(:release_at), format: :short) %></span>
                  <% else %>
                    <span class="text-slate-400">Não informada</span>
                  <% end %>
                </td>
                <td>
                  <% if row.fetch(:official) %>
                    <%= admin_status_badge("active", label: "Mercado Pago") %>
                  <% else %>
                    <%= admin_status_badge("pending", label: "Somente EloShop") %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="m-5 admin-empty-state">Ainda não há pagamentos do Mercado Pago para conciliar.</p>
    <% end %>
  </section>

  <% if @seller_summary.any? %>
    <section class="admin-card overflow-hidden" aria-labelledby="seller-summary-title">
      <div class="admin-card-header">
        <div>
          <p class="admin-section-label">Resumo executivo</p>
          <h2 id="seller-summary-title" class="mt-1">Resumo por vendedor</h2>
        </div>
        <span class="admin-badge admin-badge--neutral"><%= @seller_summary.size %> artesãos</span>
      </div>

      <div class="overflow-x-auto">
        <table>
          <thead>
            <tr>
              <th>Artesão</th>
              <th class="text-right">Vendas</th>
              <th class="text-right">Comissão</th>
              <th class="text-right">Tarifa MP</th>
              <th class="text-right">Líquido</th>
              <th class="text-right">Liberados</th>
              <th class="text-right">Pendentes</th>
            </tr>
          </thead>
          <tbody>
            <% @seller_summary.each do |entry| %>
              <tr>
                <td class="font-medium text-slate-800"><%= entry[:name] %></td>
                <td class="text-right"><%= format_price(entry[:gross_cents]) %></td>
                <td class="text-right"><%= format_price(entry[:commission_cents]) %></td>
                <td class="text-right"><%= format_price(entry[:processor_fee_cents]) %></td>
                <td class="text-right font-semibold text-slate-900"><%= format_price(entry[:net_cents]) %></td>
                <td class="text-right"><%= entry[:released_count] %></td>
                <td class="text-right"><%= entry[:pending_count] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section class="admin-card overflow-hidden" aria-labelledby="seller-pendencies-title">
    <div class="admin-card-header">
      <div>
        <p class="admin-section-label">Marketplace</p>
        <h2 id="seller-pendencies-title" class="mt-1">Artesãos com pendências</h2>
      </div>
      <span class="admin-badge <%= @seller_pendencies.any? ? 'admin-badge--warning' : 'admin-badge--success' %>"><%= @seller_pendencies.count %></span>
    </div>

    <% if @seller_pendencies.any? %>
      <div class="overflow-x-auto">
        <table>
          <thead>
            <tr>
              <th>Artesão</th>
              <th>Conta Mercado Pago</th>
              <th>Meios disponíveis</th>
              <th>Pendências</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @seller_pendencies.each do |entry| %>
              <% seller = entry.fetch(:seller) %>
              <tr>
                <td>
                  <p class="font-semibold text-slate-900"><%= seller.name %></p>
                  <div class="mt-1"><%= admin_status_badge(seller.status) %></div>
                </td>
                <td>
                  <% if seller.mercado_pago_connected? %>
                    <span class="font-semibold text-emerald-700">Conectada</span>
                    <p class="mt-1 text-xs text-slate-500">
                      <% if seller.mercado_pago_test_account == true %>
                        TESTUSER
                      <% elsif seller.mercado_pago_test_account == false %>
                        Conta de produção
                      <% else %>
                        Tipo não confirmado
                      <% end %>
                    </p>
                  <% else %>
                    <span class="font-semibold text-amber-700">Não conectada</span>
                  <% end %>
                </td>
                <td class="text-sm text-slate-600">
                  <p>PIX: <strong><%= seller.mercado_pago_connected? ? "disponível" : "indisponível" %></strong></p>
                  <p class="mt-1">Cartão: <strong><%= seller.mercado_pago_card_payments_available? ? "disponível" : "indisponível" %></strong></p>
                </td>
                <td>
                  <ul class="space-y-1 text-sm text-slate-600">
                    <% entry.fetch(:issues).each do |issue| %>
                      <li>• <%= issue %></li>
                    <% end %>
                  </ul>
                </td>
                <td class="text-right"><%= link_to "Ver artesão", admin_seller_path(seller), class: "admin-button admin-button--secondary" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="m-5 admin-empty-state">Todos os artesãos estão prontos para receber pagamentos.</p>
    <% end %>
  </section>
</div>
