<div class="w-full">
  <h1 class="text-2xl font-bold mb-6">Clientes</h1>

  <%= form_with url: admin_customers_path, method: :get, class: "mb-6 flex gap-2" do %>
    <%= text_field_tag :query, params[:query], placeholder: "Buscar por nome ou e-mail", class: "border rounded px-2 py-1 flex-1" %>
    <%= submit_tag "Buscar", class: "border rounded px-4 py-1" %>
  <% end %>

  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="border-b">
        <th class="py-2">Nome</th>
        <th class="py-2">E-mail</th>
        <th class="py-2">Pedidos</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @customers.each do |customer| %>
        <tr class="border-b">
          <td class="py-2"><%= customer.name %></td>
          <td class="py-2"><%= customer.email %></td>
          <td class="py-2"><%= customer.orders.count %></td>
          <td class="py-2"><%= link_to "Ver", admin_customer_path(customer) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @customers.none? %>
    <p class="text-sm text-gray-600 mt-4">Nenhum cliente encontrado.</p>
  <% end %>
</div>
