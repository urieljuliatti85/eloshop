<div class="space-y-8">
  <header>
    <p class="admin-section-label mb-2">Relacionamento</p>
    <h1>Clientes</h1>
    <p class="mt-2 text-sm text-slate-500">Consulte dados de contato e histórico de compras.</p>
  </header>

  <%= form_with url: admin_customers_path, method: :get, class: "admin-card flex flex-col gap-3 p-4 sm:flex-row" do %>
    <div class="flex-1">
      <%= label_tag :query, "Buscar clientes", class: "sr-only" %>
      <%= text_field_tag :query, params[:query], placeholder: "Nome ou e-mail" %>
    </div>
    <%= submit_tag "Buscar", class: "admin-button admin-button--primary" %>
    <% if params[:query].present? %><%= link_to "Limpar", admin_customers_path, class: "admin-button admin-button--secondary" %><% end %>
  <% end %>

  <% if @customers.any? %>
    <div class="admin-table-wrap">
      <table>
        <thead><tr><th>Cliente</th><th>E-mail</th><th>Pedidos</th><th>Desde</th><th><span class="sr-only">Ações</span></th></tr></thead>
        <tbody>
          <% @customers.each do |customer| %>
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  <span class="grid size-10 shrink-0 place-items-center rounded-full bg-amber-100 text-xs font-bold text-amber-800"><%= customer.name.first.upcase %></span>
                  <span class="font-semibold text-slate-900"><%= customer.name %></span>
                </div>
              </td>
              <td><%= customer.email %></td>
              <td><span class="admin-badge admin-badge--neutral"><%= customer.orders.size %></span></td>
              <td class="whitespace-nowrap text-slate-500"><%= l(customer.created_at.to_date, format: :short) %></td>
              <td class="text-right"><%= link_to "Ver cliente", admin_customer_path(customer), class: "admin-button admin-button--secondary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty-state">Nenhum cliente encontrado.</div>
  <% end %>
</div>
