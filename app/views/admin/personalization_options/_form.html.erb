<%= form_with model: [ :admin, product, personalization_option ], class: "admin-form" do |form| %>
  <% if personalization_option.errors.any? %>
    <div class="admin-flash admin-flash--danger">
      <ul>
        <% personalization_option.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :label, "Nome do campo" %>
    <%= form.text_field :label, placeholder: "Ex: Nome gravado", class: "w-full" %>
  </div>

  <div>
    <%= form.label :max_length, "Limite de caracteres" %>
    <%= form.number_field :max_length, class: "w-full" %>
  </div>

  <div>
    <%= form.label :required, "Obrigatório" %>
    <%= form.check_box :required %>
  </div>

  <%= form.submit "Salvar campo", class: "admin-button admin-button--brand" %>
<% end %>
