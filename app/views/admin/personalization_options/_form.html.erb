<%= form_with model: [ :admin, product, personalization_option ], class: "flex flex-col gap-4 w-full max-w-xl" do |form| %>
  <% if personalization_option.errors.any? %>
    <div class="text-red-700">
      <ul>
        <% personalization_option.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :label, "Nome do campo" %>
    <%= form.text_field :label, placeholder: "Ex: Nome gravado", class: "border rounded w-full px-2 py-1" %>
  </div>

  <div>
    <%= form.label :max_length, "Limite de caracteres" %>
    <%= form.number_field :max_length, class: "border rounded w-full px-2 py-1" %>
  </div>

  <div>
    <%= form.label :required, "Obrigatório" %>
    <%= form.check_box :required %>
  </div>

  <%= form.submit "Salvar", class: "bg-black text-white px-4 py-2 rounded w-fit" %>
<% end %>
