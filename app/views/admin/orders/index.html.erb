<div class="space-y-8">
  <header>
    <p class="admin-section-label mb-2">Operação</p>
    <h1>Pedidos</h1>
    <p class="mt-2 text-sm text-slate-500">Acompanhe compras, pagamentos e dados de entrega.</p>
  </header>

  <section class="grid gap-3 sm:grid-cols-3" aria-label="Resumo dos pedidos">
    <% [["Pendente", "pending", "admin-badge--warning"], ["Confirmado", "confirmed", "admin-badge--success"], ["Cancelado", "cancelled", "admin-badge--danger"]].each do |label, status, tone| %>
      <article class="admin-card flex items-center justify-between gap-4 px-5 py-4">
        <span class="text-sm font-semibold text-slate-600"><%= label %></span>
        <span class="admin-badge <%= tone %>"><%= @order_counts.fetch(status, 0) %></span>
      </article>
    <% end %>
  </section>

  <%= form_with url: admin_orders_path, method: :get, class: "admin-card flex flex-wrap items-end gap-3 p-4" do %>
    <div>
      <%= label_tag :order_id, "Pedido", class: "sr-only" %>
      <%= text_field_tag :order_id, params[:order_id], placeholder: "Nº do pedido", class: "w-full" %>
    </div>
    <div>
      <%= label_tag :customer, "Cliente", class: "sr-only" %>
      <%= text_field_tag :customer, params[:customer], placeholder: "Nome ou e-mail do cliente", class: "w-full" %>
    </div>
    <div>
      <%= label_tag :seller_id, "Ateliê", class: "sr-only" %>
      <%= select_tag :seller_id, options_from_collection_for_select(@sellers, :id, :name, params[:seller_id]), include_blank: "Todos os ateliês", class: "w-full" %>
    </div>
    <div>
      <%= label_tag :payment_status, "Pagamento", class: "sr-only" %>
      <%= select_tag :payment_status,
            options_for_select(
              [["Todos os pagamentos", nil], ["Não iniciado", "not_started"]] + Payment.statuses.keys.map { |status| [AdminHelper::ADMIN_STATUS_LABELS.fetch(status, status.humanize), status] },
              params[:payment_status]
            ), class: "w-full" %>
    </div>
    <div>
      <%= label_tag :date, "Data", class: "sr-only" %>
      <%= text_field_tag :date, params[:date], placeholder: "dd/mm/aaaa", class: "w-full" %>
    </div>
    <div class="flex gap-2">
      <%= submit_tag "Filtrar", class: "admin-button admin-button--primary" %>
      <%= link_to "Limpar", admin_orders_path, class: "admin-button admin-button--secondary" %>
    </div>
  <% end %>

  <% if @orders.any? %>
    <div class="admin-table-wrap">
      <table>
        <thead>
          <tr>
            <th><%= admin_sort_header "Pedido", "id" %></th>
            <th><%= admin_sort_header "Cliente", "customer" %></th>
            <th>Ateliê</th>
            <th>E-mail do Ateliê</th>
            <th><%= admin_sort_header "Status", "status" %></th>
            <th>Pagamento</th>
            <th>Entrega</th>
            <th><%= admin_sort_header "Total", "total" %></th>
            <th><%= admin_sort_header "Data", "date" %></th>
            <th><span class="sr-only">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <% payment = order.payments.max_by(&:created_at) %>
            <% seller = order.seller_orders.first&.seller %>
            <tr>
              <td class="font-semibold text-slate-950">#<%= order.id %></td>
              <td>
                <div class="flex items-center gap-3">
                  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-amber-100 text-xs font-bold text-amber-800"><%= order.customer.name.first.upcase %></span>
                  <span class="min-w-0">
                    <span class="block truncate font-semibold text-slate-800"><%= order.customer.name %></span>
                    <span class="block truncate text-xs text-slate-500"><%= order.customer.email %></span>
                  </span>
                </div>
              </td>
              <td><%= seller ? link_to(seller.name, admin_seller_path(seller), class: "admin-link") : "—" %></td>
              <td class="text-slate-500"><%= seller&.users&.first&.email_address || "—" %></td>
              <td><%= admin_status_badge(order.status) %></td>
              <td><%= payment ? admin_status_badge(payment.status) : admin_status_badge("pending", label: "Não iniciado") %></td>
              <td><%= order.shipment ? admin_status_badge(order.shipment.status) : "—" %></td>
              <td class="font-semibold text-slate-950"><%= format_price(order.total_cents) %></td>
              <td class="whitespace-nowrap text-slate-500"><%= l(order.created_at.to_date, format: :short) %></td>
              <td class="text-right">
                <div class="flex justify-end gap-2">
                  <%= link_to "Detalhes", admin_order_path(order), class: "admin-button admin-button--secondary" %>
                  <% if order.pending? || order.confirmed? %>
                    <%= button_to "Cancelar", cancel_admin_order_path(order), method: :post,
                          class: "admin-button admin-button--danger",
                          form: { data: { turbo_confirm: "Cancelar este pedido e devolver o estoque?" } } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "admin/shared/pagination", pagination: @pagination %>
  <% elsif params[:order_id].present? || params[:customer].present? || params[:seller_id].present? || params[:payment_status].present? || params[:date].present? %>
    <div class="admin-empty-state">
      <p>Nenhum pedido encontrado para os filtros aplicados.</p>
      <%= link_to "Limpar filtros", admin_orders_path, class: "admin-button admin-button--secondary mt-4" %>
    </div>
  <% else %>
    <div class="admin-empty-state">Nenhum pedido foi criado ainda.</div>
  <% end %>
</div>
