<% payment = @order.payments.max_by(&:created_at) %>
<% address = @order.shipping_address_snapshot %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <%= link_to "← Voltar para pedidos", admin_orders_path, class: "admin-link mb-3 inline-block text-sm" %>
      <p class="admin-section-label mb-2">Detalhes do pedido</p>
      <div class="flex flex-wrap items-center gap-3">
        <h1>Pedido #<%= @order.id %></h1>
        <%= admin_status_badge(@order.status) %>
      </div>
      <p class="mt-2 text-sm text-slate-500">Criado em <%= l(@order.created_at, format: :short) %></p>
    </div>
  </header>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.35fr)_minmax(21rem,0.65fr)]">
    <div class="space-y-6">
      <section class="admin-card overflow-hidden">
        <div class="admin-card-header">
          <div>
            <p class="admin-section-label">Compra</p>
            <h2 class="mt-1">Itens do pedido</h2>
          </div>
          <span class="text-sm text-slate-500"><%= pluralize(@order.order_items.sum(&:quantity), "item", plural: "itens") %></span>
        </div>

        <ul class="divide-y divide-slate-100">
          <% @order.order_items.each do |item| %>
            <li class="flex gap-4 p-5 sm:p-6">
              <div class="grid size-16 shrink-0 place-items-center overflow-hidden rounded-xl bg-[#f5f1e8] text-xs font-bold text-slate-400">
                <% if item.product.main_image.attached? %>
                  <%= image_tag item.product.main_image, class: "h-full w-full object-cover", alt: "" %>
                <% else %>
                  <%= item.product_name.first.upcase %>
                <% end %>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                  <div>
                    <p class="font-semibold text-slate-900"><%= item.product_name %></p>
                    <p class="mt-1 text-xs text-slate-500">SKU <%= item.sku %></p>
                  </div>
                  <p class="whitespace-nowrap font-semibold text-slate-950"><%= number_to_currency(item.subtotal_cents.fdiv(100)) %></p>
                </div>
                <p class="mt-2 text-sm text-slate-600"><%= item.quantity %> × <%= number_to_currency(item.unit_price_cents.fdiv(100)) %></p>
                <% if item.variant_label.present? %>
                  <p class="mt-1 text-sm text-slate-500">Variante: <%= item.variant_label %></p>
                <% end %>
                <% if item.production_time_snapshot.present? %>
                  <p class="mt-1 text-sm text-slate-500">Produção: <%= item.production_time_snapshot %></p>
                <% end %>
                <% if item.personalization_entries.any? %>
                  <dl class="mt-3 grid gap-1 rounded-xl bg-slate-50 p-3 text-sm">
                    <% item.personalization_entries.each do |entry| %>
                      <div><dt class="inline font-semibold text-slate-700"><%= entry[:label] %>:</dt> <dd class="inline text-slate-600"><%= entry[:value] %></dd></div>
                    <% end %>
                  </dl>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>

      <section class="admin-card p-5 sm:p-6">
        <p class="admin-section-label">Entrega</p>
        <h2 class="mt-1">Endereço do pedido</h2>
        <address class="mt-4 not-italic text-sm leading-6 text-slate-600">
          <p class="font-semibold text-slate-900"><%= @order.customer.name %></p>
          <p><%= [address["street"], address["number"]].compact_blank.join(", ") %></p>
          <% if address["complement"].present? %><p><%= address["complement"] %></p><% end %>
          <p><%= [address["neighborhood"], address["city"]].compact_blank.join(" — ") %><%= "/#{address['state']}" if address["state"].present? %></p>
          <% if address["zip_code"].present? %><p>CEP <%= address["zip_code"] %></p><% end %>
        </address>
        <% if @order.shipment %>
          <div class="mt-5 border-t border-slate-100 pt-5 text-sm text-slate-600">
            <p><span class="font-semibold text-slate-800">Modalidade:</span> <%= @order.shipment.carrier %> — <%= @order.shipment.service %></p>
            <p class="mt-1"><span class="font-semibold text-slate-800">Prazo estimado:</span> <%= @order.shipment.estimated_days %> dias úteis</p>
          </div>
        <% end %>
      </section>
    </div>

    <aside class="admin-card overflow-hidden xl:sticky xl:top-28">
      <div class="border-b border-slate-100 p-5 sm:p-6">
        <p class="admin-section-label">Cliente</p>
        <div class="mt-4 flex items-center gap-3">
          <span class="grid size-12 place-items-center rounded-full bg-amber-100 font-bold text-amber-800"><%= @order.customer.name.first.upcase %></span>
          <div class="min-w-0">
            <p class="truncate font-semibold text-slate-900"><%= @order.customer.name %></p>
            <p class="truncate text-sm text-slate-500"><%= @order.customer.email %></p>
          </div>
        </div>
        <%= link_to "Ver cliente", admin_customer_path(@order.customer), class: "admin-link mt-4 inline-block text-sm" %>
      </div>

      <div class="border-b border-slate-100 p-5 sm:p-6">
        <div class="flex items-center justify-between gap-4">
          <p class="admin-section-label">Pagamento</p>
          <%= payment ? admin_status_badge(payment.status) : admin_status_badge("pending", label: "Não iniciado") %>
        </div>
        <% if payment %>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Gateway</dt><dd class="font-semibold text-slate-800"><%= payment.gateway.humanize %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Valor</dt><dd class="font-semibold text-slate-800"><%= number_to_currency(payment.amount_cents.fdiv(100)) %></dd></div>
          </dl>
        <% else %>
          <p class="mt-4 text-sm text-slate-500">Nenhuma tentativa de pagamento registrada.</p>
        <% end %>
      </div>

      <div class="p-5 sm:p-6">
        <p class="admin-section-label mb-4">Resumo</p>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-slate-500">Subtotal</dt><dd class="font-medium"><%= number_to_currency(@order.subtotal_cents.fdiv(100)) %></dd></div>
          <% if @order.discount_cents.positive? %>
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Desconto<%= " (#{@order.coupon.code})" if @order.coupon %></dt><dd class="font-medium text-emerald-700">− <%= number_to_currency(@order.discount_cents.fdiv(100)) %></dd></div>
          <% end %>
          <div class="flex justify-between gap-4"><dt class="text-slate-500">Frete</dt><dd class="font-medium"><%= number_to_currency(@order.shipping_cents.fdiv(100)) %></dd></div>
          <div class="flex justify-between gap-4 border-t border-slate-200 pt-4 text-base"><dt class="font-semibold text-slate-900">Total</dt><dd class="text-xl font-semibold text-slate-950"><%= number_to_currency(@order.total_cents.fdiv(100)) %></dd></div>
        </dl>
      </div>
    </aside>
  </div>
</div>
