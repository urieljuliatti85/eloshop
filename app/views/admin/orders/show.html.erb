<% payment = @order.payments.max_by(&:created_at) %>
<% address = @order.shipping_address_snapshot %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <%= link_to "← Voltar para pedidos", admin_orders_path, class: "admin-link mb-3 inline-block text-sm" %>
      <p class="admin-section-label mb-2">Detalhes do pedido</p>
      <div class="flex flex-wrap items-center gap-3">
        <h1>Pedido #<%= @order.id %></h1>
        <%= admin_status_badge(@order.status) %>
      </div>
      <p class="mt-2 text-sm text-slate-500">Criado em <%= l(@order.created_at, format: :short) %></p>
    </div>
    <% if @order.pending? || @order.confirmed? %>
      <%= button_to "Cancelar pedido", cancel_admin_order_path(@order), method: :post,
            class: "admin-button admin-button--danger",
            form: { data: { turbo_confirm: "Cancelar este pedido e devolver o estoque?" } } %>
    <% end %>
  </header>

  <%# A solicitação aberta vem antes do reembolso: é nela que o comprador vê a
      resposta e o protocolo (ADR 008). %>
  <% open_return_requests = @order.seller_orders.flat_map { |seller_order| seller_order.return_requests.open.to_a } %>
  <% if open_return_requests.any? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <% open_return_requests.each do |return_request| %>
        <p>
          Solicitação aberta: <%= link_to return_request.protocol, admin_return_request_path(return_request), class: "admin-link" %>
          (<%= return_request.kind_label.downcase %>, responder até <%= l(return_request.respond_by, format: :short) %>).
          Depois de reembolsar aqui, registre o desfecho na solicitação para o comprador ser avisado.
        </p>
      <% end %>
    </div>
  <% end %>

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1.35fr)_minmax(21rem,0.65fr)]">
    <div class="space-y-6">
      <section class="admin-card overflow-hidden">
        <div class="admin-card-header">
          <div>
            <p class="admin-section-label">Compra</p>
            <h2 class="mt-1">Itens do pedido</h2>
          </div>
          <span class="text-sm text-slate-500"><%= pluralize(@order.order_items.sum(&:quantity), "item", plural: "itens") %></span>
        </div>

        <ul class="divide-y divide-slate-100">
          <% @order.order_items.each do |item| %>
            <li class="flex gap-4 p-5 sm:p-6">
              <div class="grid size-16 shrink-0 place-items-center overflow-hidden rounded-xl bg-[#f5f1e8] text-xs font-bold text-slate-400">
                <% if item.product.main_image.attached? %>
                  <%= image_tag item.product.main_image, class: "h-full w-full object-cover", alt: "" %>
                <% else %>
                  <%= item.product_name.first.upcase %>
                <% end %>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                  <div>
                    <p class="font-semibold text-slate-900"><%= item.product_name %></p>
                    <p class="mt-1 text-xs text-slate-500">SKU <%= item.sku %></p>
                  </div>
                  <p class="whitespace-nowrap font-semibold text-slate-950"><%= format_price(item.subtotal_cents) %></p>
                </div>
                <p class="mt-2 text-sm text-slate-600"><%= item.quantity %> × <%= format_price(item.unit_price_cents) %></p>
                <% if item.variant_label.present? %>
                  <p class="mt-1 text-sm text-slate-500">Variante: <%= item.variant_label %></p>
                <% end %>
                <% if item.production_time_snapshot.present? %>
                  <p class="mt-1 text-sm text-slate-500">Produção: <%= item.production_time_snapshot %></p>
                <% end %>
                <% if item.personalization_entries.any? %>
                  <dl class="mt-3 grid gap-1 rounded-xl bg-slate-50 p-3 text-sm">
                    <% item.personalization_entries.each do |entry| %>
                      <div><dt class="inline font-semibold text-slate-700"><%= entry[:label] %>:</dt> <dd class="inline text-slate-600"><%= entry[:value] %></dd></div>
                    <% end %>
                  </dl>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>

      <section class="admin-card p-5 sm:p-6">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="admin-section-label">Entrega</p>
            <h2 class="mt-1">Endereço do pedido</h2>
          </div>
          <% if @order.shipment %><%= admin_status_badge(@order.shipment.status) %><% end %>
        </div>
        <address class="mt-4 not-italic text-sm leading-6 text-slate-600">
          <p class="font-semibold text-slate-900"><%= @order.recipient_display_name %></p>
          <% if @order.masked_recipient_cpf %><p>CPF <%= @order.masked_recipient_cpf %></p><% end %>
          <% if @order.recipient_phone.present? %><p><%= format_phone(@order.recipient_phone) %></p><% end %>
          <p><%= [address["street"], address["number"]].compact_blank.join(", ") %></p>
          <% if address["complement"].present? %><p><%= address["complement"] %></p><% end %>
          <p><%= [address["neighborhood"], address["city"]].compact_blank.join(" — ") %><%= "/#{address['state']}" if address["state"].present? %></p>
          <% if address["zip_code"].present? %><p>CEP <%= address["zip_code"] %></p><% end %>
        </address>
        <% if @order.shipment %>
          <div class="mt-5 border-t border-slate-100 pt-5 text-sm text-slate-600">
            <p><span class="font-semibold text-slate-800">Modalidade:</span> <%= @order.shipment.carrier %> — <%= @order.shipment.service %></p>
            <p class="mt-1"><span class="font-semibold text-slate-800">Prazo:</span> <%= shipping_estimate_label(@order.shipment) %></p>
          </div>
        <% end %>
      </section>

      <section class="admin-card p-5 sm:p-6">
        <p class="admin-section-label">Acompanhamento técnico</p>
        <h2 class="mt-1">Linha do tempo</h2>

        <% if @order_events.any? %>
          <ol class="mt-4 space-y-4">
            <% @order_events.each do |event| %>
              <li class="flex gap-4 border-l-2 <%= event.failure? ? 'border-rose-300' : 'border-slate-200' %> pl-4">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="font-semibold text-slate-900"><%= t(event.kind, scope: "order_events.kinds") %></p>
                    <% if event.status.present? %><%= admin_status_badge(event.status) %><% end %>
                  </div>
                  <p class="mt-0.5 text-xs text-slate-500"><%= l(event.created_at, format: :short) %></p>
                  <% if event.failure? %>
                    <p class="mt-2 rounded-lg bg-rose-50 p-2 text-sm text-rose-800">
                      <span class="font-semibold"><%= event.error_class %>:</span> <%= event.error_message %>
                    </p>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="mt-4 text-sm text-slate-500">Nenhum evento registrado ainda.</p>
        <% end %>
      </section>
    </div>

    <aside class="admin-card overflow-hidden xl:sticky xl:top-28">
      <div class="border-b border-slate-100 p-5 sm:p-6">
        <p class="admin-section-label">Cliente</p>
        <div class="mt-4 flex items-center gap-3">
          <span class="grid size-12 place-items-center rounded-full bg-amber-100 font-bold text-amber-800"><%= @order.customer.name.first.upcase %></span>
          <div class="min-w-0">
            <p class="truncate font-semibold text-slate-900"><%= @order.customer.name %></p>
            <p class="truncate text-sm text-slate-500"><%= @order.customer.email %></p>
          </div>
        </div>
        <%= link_to "Ver cliente", admin_customer_path(@order.customer), class: "admin-link mt-4 inline-block text-sm" %>
      </div>

      <div class="border-b border-slate-100 p-5 sm:p-6">
        <div class="flex items-center justify-between gap-4">
          <p class="admin-section-label">Pagamento</p>
          <%= payment ? admin_status_badge(payment.status) : admin_status_badge("pending", label: "Não iniciado") %>
        </div>
        <% if payment %>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Meio de pagamento</dt><dd class="font-semibold text-slate-800"><%= payment_method_label(payment) %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Gateway</dt><dd class="font-semibold text-slate-800"><%= payment.gateway.humanize %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Valor</dt><dd class="font-semibold text-slate-800"><%= format_price(payment.amount_cents) %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Comissão EloShop</dt><dd class="font-semibold text-slate-800"><%= format_price(payment.application_fee_cents) %></dd></div>
            <% if payment.processor_fee_cents.present? %>
              <div class="flex justify-between gap-4"><dt class="text-slate-500">Tarifa Mercado Pago</dt><dd class="font-semibold text-slate-800"><%= format_price(payment.processor_fee_cents) %></dd></div>
            <% end %>
            <% if @release_date %>
              <div class="flex justify-between gap-4">
                <dt class="text-slate-500">Liberação do dinheiro</dt>
                <dd class="font-semibold text-slate-800">
                  <%= @release_date.future? ? "Prevista para #{l(@release_date.in_time_zone.to_date)}" : "Liberado em #{l(@release_date.in_time_zone.to_date)}" %>
                </dd>
              </div>
            <% end %>
            <% if payment.refunded_amount_cents.positive? %>
              <div class="flex justify-between gap-4"><dt class="text-slate-500">Reembolsado</dt><dd class="font-semibold text-rose-700">− <%= format_price(payment.refunded_amount_cents) %></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-slate-500">Comissão devolvida</dt><dd class="font-semibold text-slate-800"><%= format_price(payment.application_fee_refunded_cents) %></dd></div>
            <% end %>
          </dl>
          <% if payment.paid? || payment.partially_refunded? %>
            <%= form_with url: refund_admin_order_path(@order), method: :post, class: "mt-5 space-y-3 border-t border-slate-100 pt-5" do |form| %>
              <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
              <% if payment.chargeback_reported? %>
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900" role="alert">
                  <p class="font-semibold">O comprador contestou este pagamento no cartão (chargeback).</p>
                  <p class="mt-1">Se a contestação for aceita, o dinheiro já volta ao comprador por ela. Confira a disputa no Mercado Pago antes de reembolsar.</p>
                  <label class="mt-2 flex items-start gap-2">
                    <%= form.check_box :chargeback_acknowledged, { class: "mt-0.5" }, "1", "0" %>
                    <span>Conferi a disputa e confirmo o reembolso mesmo assim.</span>
                  </label>
                </div>
              <% end %>
              <%= form.label :amount, "Reembolso (R$)", class: "block text-sm font-semibold text-slate-700" %>
              <%= form.text_field :amount, inputmode: "decimal", placeholder: number_with_precision(payment.remaining_refundable_cents.fdiv(100), precision: 2, separator: ","), class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" %>
              <p class="text-xs text-slate-500">Em branco, reembolsa o saldo total de <%= format_price(payment.remaining_refundable_cents) %>.</p>
              <%= form.submit "Solicitar reembolso", class: "rounded-xl bg-rose-700 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-800", data: { turbo_confirm: "Confirma o reembolso deste pagamento?" } %>
            <% end %>

            <details class="mt-5 border-t border-slate-100 pt-5 text-sm">
              <summary class="cursor-pointer font-semibold text-slate-700">O Mercado Pago não consegue devolver? Registrar reembolso feito por outro meio</summary>
              <p class="mt-2 text-slate-600">Use só depois de devolver o dinheiro ao comprador por transferência ou PIX, quando o Mercado Pago recusa (ateliê sem saldo) ou o pagamento passou de 180 dias. Nada é cobrado nem devolvido por aqui: o registro fecha o pedido, a comissão e avisa comprador e ateliê.</p>
              <%= form_with url: manual_refund_admin_order_path(@order), method: :post, class: "mt-3 space-y-3" do |form| %>
                <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
                <% if payment.chargeback_reported? %>
                  <label class="flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 p-3 text-amber-900">
                    <%= form.check_box :chargeback_acknowledged, { class: "mt-0.5" }, "1", "0" %>
                    <span>Este pagamento tem chargeback. Conferi a disputa e confirmo o registro mesmo assim.</span>
                  </label>
                <% end %>
                <%= form.label :amount, "Valor devolvido (R$)", for: "manual_refund_amount", class: "block font-semibold text-slate-700" %>
                <%= form.text_field :amount, id: "manual_refund_amount", inputmode: "decimal", placeholder: number_with_precision(payment.remaining_refundable_cents.fdiv(100), precision: 2, separator: ","), class: "w-full rounded-xl border border-slate-200 px-3 py-2" %>
                <%= form.label :manual_reference, "Comprovante (identificador do PIX ou da transferência)", for: "manual_refund_reference", class: "block font-semibold text-slate-700" %>
                <%= form.text_field :manual_reference, id: "manual_refund_reference", required: true, minlength: 3, maxlength: 500, class: "w-full rounded-xl border border-slate-200 px-3 py-2" %>
                <%= form.submit "Registrar reembolso feito por outro meio", class: "rounded-xl border border-rose-300 px-4 py-2 font-semibold text-rose-800 hover:bg-rose-50", data: { turbo_confirm: "O dinheiro já foi devolvido ao comprador por fora do Mercado Pago? Este registro não pode ser desfeito." } %>
              <% end %>
            </details>
          <% end %>
          <% manual_refunds = payment.payment_refunds.select(&:settled_by_manual?) %>
          <% if manual_refunds.any? %>
            <div class="mt-5 border-t border-slate-100 pt-5 text-sm">
              <p class="font-semibold text-slate-700">Reembolsos feitos por outro meio</p>
              <ul class="mt-2 space-y-1 text-slate-600">
                <% manual_refunds.each do |manual| %>
                  <li><%= format_price(manual.amount_cents) %> em <%= l(manual.created_at, format: :short) %> — <%= manual.manual_reference %> (<%= manual.recorded_by&.email_address %>)</li>
                <% end %>
              </ul>
            </div>
          <% end %>
        <% else %>
          <p class="mt-4 text-sm text-slate-500">Nenhuma tentativa de pagamento registrada.</p>
        <% end %>
      </div>

      <div class="p-5 sm:p-6">
        <p class="admin-section-label mb-4">Resumo</p>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-slate-500">Subtotal</dt><dd class="font-medium"><%= format_price(@order.subtotal_cents) %></dd></div>
          <% if @order.discount_cents.positive? %>
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Desconto<%= " (#{@order.coupon.code})" if @order.coupon %></dt><dd class="font-medium text-emerald-700">− <%= format_price(@order.discount_cents) %></dd></div>
          <% end %>
          <div class="flex justify-between gap-4"><dt class="text-slate-500">Frete</dt><dd class="font-medium"><%= format_price(@order.shipping_cents) %></dd></div>
          <div class="flex justify-between gap-4 border-t border-slate-200 pt-4 text-base"><dt class="font-semibold text-slate-900">Total</dt><dd class="text-xl font-semibold text-slate-950"><%= format_price(@order.total_cents) %></dd></div>
        </dl>
        <% if @order.seller_orders.one? %>
          <% seller_order = @order.seller_order %>
          <dl class="mt-5 space-y-3 border-t border-slate-200 pt-4 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Artesão</dt><dd class="font-medium"><%= seller_order.seller.name %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Comissão (<%= fee_rate_label(seller_order.platform_fee_rate_bps) %>)</dt><dd class="font-medium"><%= format_price(seller_order.platform_fee_cents) %></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-slate-500">Valor do artesão</dt><dd class="font-medium"><%= format_price(seller_order.seller_amount_cents) %></dd></div>
          </dl>
        <% end %>
      </div>
    </aside>
  </div>
</div>
