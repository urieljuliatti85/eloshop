<div class="space-y-8">
  <header>
    <p class="admin-section-label mb-2">Comunidade</p>
    <h1>Avaliações</h1>
    <p class="mt-2 text-sm text-slate-500">Modere comentários e preserve a confiança no catálogo.</p>
  </header>

  <nav class="flex flex-wrap gap-2" aria-label="Filtrar avaliações">
    <% [["Todas", nil], ["Pendentes", "pending"], ["Aprovadas", "approved"], ["Rejeitadas", "rejected"]].each do |label, status| %>
      <% active = params[:status].presence == status %>
      <%= link_to label, admin_reviews_path(status: status), class: "admin-button #{active ? 'admin-button--primary' : 'admin-button--secondary'}", aria: { current: ("page" if active) } %>
    <% end %>
  </nav>

  <% if @reviews.any? %>
    <div class="admin-table-wrap">
      <table>
        <thead><tr><th>Produto</th><th>Cliente</th><th>Nota</th><th>Comentário</th><th>Origem</th><th>Status</th><th><span class="sr-only">Ações</span></th></tr></thead>
        <tbody>
          <% @reviews.each do |review| %>
            <tr>
              <td class="font-semibold text-slate-900"><%= review.product.name %></td>
              <td><%= review.customer.name %></td>
              <td><span class="whitespace-nowrap text-amber-500" aria-label="<%= review.rating %> de 5 estrelas"><%= "★" * review.rating %><span class="text-slate-200"><%= "★" * (5 - review.rating) %></span></span></td>
              <td class="max-w-sm text-slate-600"><%= truncate(review.comment, length: 100) %></td>
              <td><span class="admin-badge <%= review.verified_purchase? ? 'admin-badge--success' : 'admin-badge--neutral' %>"><%= review.verified_purchase? ? "Compra verificada" : "Não verificada" %></span></td>
              <td><%= admin_status_badge(review.status) %></td>
              <td>
                <div class="flex justify-end gap-2">
                  <% if review.pending? || review.rejected? %>
                    <%= button_to "Aprovar", approve_admin_review_path(review), method: :patch, class: "admin-button admin-button--secondary", form: { data: { turbo: false } } %>
                  <% end %>
                  <% if review.pending? || review.approved? %>
                    <%= button_to "Rejeitar", reject_admin_review_path(review), method: :patch, class: "admin-button admin-button--danger", form: { data: { turbo: false } } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty-state">Nenhuma avaliação encontrada.</div>
  <% end %>
</div>
