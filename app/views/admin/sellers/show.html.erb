<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <%= link_to "← Voltar para artesãos", admin_sellers_path, class: "admin-link mb-3 inline-block text-sm" %>
      <p class="admin-section-label">Marketplace</p>
      <h1><%= @seller.name %></h1>
      <p class="mt-2 text-sm text-slate-500"><%= @seller.users.first&.email_address %></p>
    </div>
    <% if @seller.approved? %>
      <%= button_to "Suspender", suspend_admin_seller_path(@seller), method: :patch, class: "admin-button admin-button--danger" %>
    <% end %>
  </header>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="admin-card p-6">
      <p class="admin-section-label">Status da plataforma</p>
      <div class="mt-2"><%= admin_status_badge(@seller.status) %></div>
      <p class="mt-4 text-sm text-slate-500">Aprovado em: <%= @seller.approved_at ? l(@seller.approved_at, format: :short) : "—" %></p>
    </section>

    <section class="admin-card p-6">
      <p class="admin-section-label">Mercado Pago</p>
      <% if @seller.mercado_pago_connected? %>
        <p class="mt-2 font-semibold text-emerald-700">Conta conectada</p>
        <p class="mt-2 text-sm text-slate-500">ID do vendedor: <%= @seller.mercado_pago_user_id %></p>
        <p class="mt-1 text-sm text-slate-500">Ambiente: <%= @seller.mercado_pago_live_mode? ? "Produção" : "Teste" %></p>
        <p class="mt-1 text-sm text-slate-500">Conectada em: <%= l(@seller.mercado_pago_connected_at, format: :short) %></p>
      <% else %>
        <p class="mt-2 font-semibold text-amber-700">Conta ainda não conectada</p>
        <p class="mt-2 text-sm text-slate-500">Envie este link para o artesão conectar a própria conta Mercado Pago (a EloShop nunca vê a senha dele):</p>
        <p class="mt-2 break-all rounded border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-xs text-slate-600"><%= seller_atelier_url %></p>
      <% end %>
    </section>
  </div>

  <% unless @seller.approved? %>
    <section class="admin-card p-6">
      <h2>Aprovação do artesão</h2>
      <p class="mt-2 text-sm text-slate-500">O Mercado Pago exige conta de vendedor com identificação KYC nível 6 para o split 1:1. Confirme a situação no ambiente do Mercado Pago; a EloShop não recebe nem armazena os documentos.</p>
      <%# A mesma condição de `Seller#approve!`, e não uma cópia própria: a
          tela desabilitava por `mercado_pago_live_mode?`, que deixou de ser o
          critério quando a aprovação passou a aceitar conta de teste em
          sandbox — o modelo aprovaria e o formulário não deixava nem marcar a
          caixa. Regra de disponibilidade tem fonte única (§19). %>
      <% approvable = @seller.mercado_pago_connected? && @seller.approvable_account? %>
      <%= form_with url: approve_admin_seller_path(@seller), method: :patch, class: "mt-5 space-y-4" do |form| %>
        <label class="flex items-start gap-3 text-sm text-slate-700">
          <%= check_box_tag :kyc_level_6_confirmed, "1", false, required: true, disabled: !approvable, class: "mt-1 rounded border-slate-300" %>
          <span>Confirmo que a conta conectada atende ao KYC nível 6 exigido pelo Mercado Pago.</span>
        </label>
        <%= form.submit "Aprovar artesão", disabled: !approvable, class: "admin-button admin-button--brand disabled:cursor-not-allowed disabled:opacity-50" %>
      <% end %>
    </section>
  <% end %>

  <div class="admin-card overflow-hidden">
    <div class="admin-card-header"><h2>Produtos</h2></div>
    <table class="admin-table">
      <thead><tr><th>Produto</th><th>SKU</th><th>Status</th></tr></thead>
      <tbody>
        <% @products.each do |product| %>
          <tr><td><%= link_to product.name, admin_product_path(product), class: "admin-link" %></td><td><%= product.sku %></td><td><%= admin_status_badge(product.status) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
