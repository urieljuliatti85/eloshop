<div class="space-y-6">
  <header class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="admin-section-label">Marketplace</p>
      <h1>Artesãos</h1>
    </div>
    <p class="text-sm text-slate-500">Aprove ou suspenda vendedores antes que seus produtos sejam publicados.</p>
  </header>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm">
      <div class="flex items-center justify-between gap-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-800">Em risco</p>
        <span class="inline-flex h-2.5 w-2.5 rounded-full bg-amber-500"></span>
      </div>
      <p class="mt-2 text-3xl font-black text-amber-900"><%= @sellers_in_risk %></p>
      <p class="mt-1 text-sm text-amber-800/80">Aprovados sem aceite atual</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 shadow-sm">
      <div class="flex items-center justify-between gap-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Termos pendentes</p>
        <span class="inline-flex h-2.5 w-2.5 rounded-full bg-slate-400"></span>
      </div>
      <p class="mt-2 text-3xl font-black text-slate-900"><%= @terms_pending_sellers_count %></p>
      <p class="mt-1 text-sm text-slate-600">Artesãos que precisam confirmar</p>
    </div>
    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4 shadow-sm">
      <div class="flex items-center justify-between gap-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-rose-800">Suspensos</p>
        <span class="inline-flex h-2.5 w-2.5 rounded-full bg-rose-500"></span>
      </div>
      <p class="mt-2 text-3xl font-black text-rose-900"><%= @suspended_sellers_count %></p>
      <p class="mt-1 text-sm text-rose-800/80">Vendedores bloqueados</p>
    </div>
  </div>

  <nav class="flex flex-wrap gap-2" aria-label="Filtrar artesãos por status e termos comerciais">
    <% [
      ["Todos", nil, nil],
      ["Aprovados", "approved", nil],
      ["Pendentes", "pending", nil],
      ["Suspensos", "suspended", nil],
      ["Termos aceitos", nil, "accepted"],
      ["Termos pendentes", nil, "pending_terms"]
    ].each do |label, status, terms| %>
      <% active = params[:status].presence == status && params[:terms].presence == terms %>
      <%= link_to label, admin_sellers_path(status: status, terms: terms), class: "admin-button #{active ? 'admin-button--primary' : 'admin-button--secondary'}", aria: { current: ("page" if active) } %>
    <% end %>
  </nav>

  <div class="admin-card overflow-hidden">
    <table class="admin-table">
      <thead><tr><th>Ateliê</th><th>Proprietário</th><th>Contato</th><th>Status</th><th>Vitrine</th><th>Termos</th><th>Produtos</th><th></th></tr></thead>
      <tbody>
        <% @sellers.each do |seller| %>
          <% acceptance = seller.latest_terms_acceptance %>
          <% terms_label = seller.terms_accepted? ? (acceptance&.terms_version.present? ? "Aceito v#{acceptance.terms_version}" : "Aceito") : "Pendente" %>
          <% terms_status = seller.terms_accepted? ? "active" : "pending" %>
          <tr>
            <td class="font-semibold"><%= seller.name %></td>
            <td>
              <% if seller.owner_full_name.present? %>
                <%= seller.owner_full_name %><br>
                <span class="text-xs text-slate-500"><%= seller.cpf_for_admin || "CPF não informado" %></span>
              <% else %>
                <span class="text-slate-400">Não informado</span>
              <% end %>
            </td>
            <td><%= seller.users.first&.email_address || "—" %></td>
            <td><%= admin_status_badge(seller.status) %></td>
            <td><%= admin_status_badge(seller.hidden? ? "hidden" : "visible", label: seller.hidden? ? "Escondida" : "Exibida") %></td>
            <td><%= admin_status_badge(terms_status, label: terms_label) %></td>
            <td><%= seller.products.size %></td>
            <td class="text-right"><%= link_to "Detalhes", admin_seller_path(seller), class: "admin-link" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
