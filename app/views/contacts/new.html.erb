<div class="w-full max-w-xl">
  <h1 class="mb-2 text-2xl font-bold text-ink">Fale com a gente</h1>
  <p class="mb-8 text-ink-muted">
    Dúvidas sobre um produto, prazo de produção ou seu pedido? Manda sua mensagem que a gente responde por e-mail.
  </p>

  <%= form_with model: @contact_message, url: contact_path, class: "flex flex-col gap-4" do |form| %>
    <% if @contact_message.errors.any? %>
      <div class="rounded bg-red-50 px-4 py-3 text-sm text-red-800">
        <ul class="list-inside list-disc">
          <% @contact_message.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Seu nome", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.text_field :name, class: "w-full rounded border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :email, "E-mail", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.email_field :email, class: "w-full rounded border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :subject, "Assunto (opcional)", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.text_field :subject, class: "w-full rounded border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :message, "Mensagem", class: "mb-1 block text-sm font-medium text-ink" %>
      <%= form.text_area :message, rows: 5, class: "w-full rounded border border-gray-300 px-3 py-2 focus:border-brand-500 focus:outline-none" %>
    </div>

    <%= form.submit "Enviar", class: "mt-2 w-fit rounded bg-brand-500 px-8 py-3 text-sm font-semibold text-white hover:bg-brand-600 cursor-pointer" %>
  <% end %>
</div>
