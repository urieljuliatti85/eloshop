#!/bin/bash -e

# A Railway monta o volume persistente pertencendo ao root, mas a aplicação
# roda como uid 1000 e precisa escrever nele (Active Storage). Sem isto,
# /rails/storage nunca é gravável: as imagens de produto ficam órfãs no banco
# e respondem 404, e o seed falha com EACCES.
#
# O container inicia como root apenas para ajustar o dono do mount e larga o
# privilégio em seguida — nada da aplicação, nem db:prepare, nem db:seed, roda
# como root.
#
# Detalhes que importam:
#   * `exec` preserva o PID 1; sem ele o setpriv viraria processo intermediário
#     e o SIGTERM do shutdown deixaria de chegar ao Rails.
#   * a guarda de uid torna o script reentrante: depois do exec ele roda de
#     novo como uid 1000, cai fora deste bloco e segue o fluxo normal.
#   * setpriv vem do util-linux, já presente na imagem base — gosu exigiria
#     instalar pacote, e su/runuser abrem shell intermediário, complicando
#     sinal e código de saída.
#   * chown sem -R de propósito: basta o dono do ponto de montagem, porque o
#     Active Storage cria os subdiretórios e diretório novo herda o dono de
#     quem o criou. Um -R ficaria lento a cada boot com o volume cheio.
if [ "$(id -u)" = "0" ]; then
  storage_path="${RAILS_STORAGE_PATH:-/rails/storage}"
  mkdir -p "${storage_path}"
  chown rails:rails "${storage_path}"

  exec setpriv --reuid=1000 --regid=1000 --init-groups -- "$0" "$@"
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  # db:prepare só executa db:seed na criação inicial do banco. Reaplicar
  # o seed em todo boot é seguro: em produção só cria SKUs que ainda não
  # existem e anexa imagem se a peça ainda não tiver capa.
  #
  # Falha de seed NÃO derruba a aplicação. Com `set -e`, qualquer exceção
  # aqui matava o container e a Railway entrava em crash loop — foi o que
  # aconteceu quando o seed passou a escrever de fato no volume e esbarrou
  # em EACCES (o container roda como uid 1000 e o volume é montado como
  # root). Catálogo desatualizado é um problema menor que a loja fora do ar,
  # então o erro é registrado e o boot continua.
  ./bin/rails db:seed || echo "AVISO: db:seed falhou; seguindo com o boot. Catálogo pode estar desatualizado."

  # Railway (Fase 20) atribui a porta dinamicamente via $PORT — o Thruster
  # (bin/thrust) escuta em HTTP_PORT (padrão 80), então precisa apontar pra
  # essa porta em runtime. Sem $PORT definida (Kamal, Docker local), cai no
  # padrão de sempre.
  export HTTP_PORT="${PORT:-80}"
fi

exec "${@}"
